<Window x:Class="TPVC.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de TPVC v1.3.1" 
        Height="440" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{StaticResource ThemeBg}" 
            BorderBrush="{StaticResource ThemeBorder}" 
            BorderThickness="1.5" 
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de Título Superior Personalizada -->
            <Border Grid.Row="0" 
                    Background="{StaticResource ThemeSurface}" 
                    CornerRadius="14,14,0,0" 
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Médico -->
                        <Border Background="{StaticResource ThemeAccent}" 
                                CornerRadius="6" 
                                Width="24" Height="24" 
                                Margin="0,0,10,0">
                            <TextBlock Text="+" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="#FFFFFF" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="0,-2,0,0" />
                        </Border>
                        <TextBlock Text="TPVC" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center" />
                        <TextBlock Text=" • Asistente de Instalación" FontSize="13" Foreground="{StaticResource ThemeTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Botón Cerrar -->
                    <Button Grid.Column="1" 
                            Click="CloseButton_Click" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource ThemeTextMuted}" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Width="30" Height="30" 
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6">
                                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- VISTA 1: INICIO (SOLO EL BOTÓN DE INSTALAR)                               -->
            <!-- ========================================================================= -->
            <Grid x:Name="View1_Welcome" Grid.Row="1" Margin="36,24,36,28" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado con Logotipo -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Border Background="{StaticResource ThemeSurface}" 
                            BorderBrush="{StaticResource ThemeAccent}" 
                            BorderThickness="2" 
                            CornerRadius="24" 
                            Width="76" Height="76" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,16">
                        <TextBlock Text="🩺" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="TPVC - Consultorio Médico" 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="{StaticResource ThemeText}" 
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Border Background="{StaticResource ThemeSurfaceSubtle}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="Versión 1.3.1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ThemeAccent}" />
                        </Border>
                        <Border Background="{StaticResource ThemeSurfaceSubtle}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="Windows x64" FontSize="11" Foreground="{StaticResource ThemeTextMuted}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Descripción concisa -->
                <Border Grid.Row="1" 
                        Background="{StaticResource ThemeSurface}" 
                        BorderBrush="{StaticResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20,14" 
                        Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bienvenido al asistente de instalación rápida de TPVC." 
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource ThemeText}" 
                                   Margin="0,0,0,6" />
                        <TextBlock Text="El sistema se configurará automáticamente en su equipo con acceso directo en el Escritorio. Incluye módulo de Punto de Venta, inventario clínico con lotes y catálogo de servicios con insumos normados." 
                                   FontSize="12" 
                                   LineHeight="18" 
                                   Foreground="{StaticResource ThemeTextMuted}" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Botón de Instalar (Único Botón) -->
                <Button Grid.Row="2" 
                        Style="{StaticResource PrimaryButton}" 
                        Click="InstallButton_Click" 
                        Height="48" 
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Instalar" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text=" →" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- VISTA 2: ESTADO (PROGRESO DE INSTALACIÓN)                                 -->
            <!-- ========================================================================= -->
            <Grid x:Name="View2_Progress" Grid.Row="1" Margin="36,30,36,30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,24">
                    <TextBlock Text="Instalando TPVC..." 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="{StaticResource ThemeText}" 
                               Margin="0,0,0,6" />
                    <TextBlock Text="Por favor espere mientras se copian los archivos y se configuran los componentes del sistema." 
                               FontSize="12" 
                               Foreground="{StaticResource ThemeTextMuted}" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Barra y Porcentaje -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatus" 
                                   Grid.Column="0" 
                                   Text="Iniciando instalación..." 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource ThemeText}" 
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtPercentage" 
                                   Grid.Column="1" 
                                   Text="0%" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource ThemeAccent}" />
                    </Grid>

                    <!-- Barra de Progreso Personalizada -->
                    <ProgressBar x:Name="ProgressBarInstall" 
                                 Height="12" 
                                 Value="0" 
                                 Maximum="100" 
                                 Foreground="{StaticResource ThemeAccent}" 
                                 Background="{StaticResource ThemeSurface}" 
                                 BorderThickness="0" />
                </StackPanel>

                <Border Grid.Row="2" 
                        Background="{StaticResource ThemeSurface}" 
                        BorderBrush="{StaticResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,10">
                    <TextBlock Text="🔒 La instalación se realiza de forma segura por usuario sin requerir elevación administrativa." 
                               FontSize="11" 
                               Foreground="{StaticResource ThemeTextMuted}" 
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- VISTA 3: FINALIZAR (CHECK BOX POR DEFECTO EN LANZAR APP + FINALIZAR)      -->
            <!-- ========================================================================= -->
            <Grid x:Name="View3_Finish" Grid.Row="1" Margin="36,24,36,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado de Éxito -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,16">
                    <Border Background="#064E3B" 
                            BorderBrush="{StaticResource ThemeSuccess}" 
                            BorderThickness="2" 
                            CornerRadius="26" 
                            Width="72" Height="72" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,14">
                        <TextBlock Text="✓" 
                                   FontSize="36" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource ThemeSuccess}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="¡Instalación Completada!" 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="{StaticResource ThemeText}" 
                               HorizontalAlignment="Center" />

                    <TextBlock Text="TPVC v1.3.1 se ha instalado con éxito en su equipo." 
                               FontSize="12" 
                               Foreground="{StaticResource ThemeTextMuted}" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Resumen y Checkbox de Lanzamiento por Defecto -->
                <Border Grid.Row="1" 
                        Background="{StaticResource ThemeSurface}" 
                        BorderBrush="{StaticResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20,16" 
                        Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Se han generado los accesos directos en el Escritorio y Menú Inicio." 
                                   FontSize="12" 
                                   Foreground="{StaticResource ThemeTextMuted}" 
                                   Margin="0,0,0,14" />

                        <!-- Checkbox con Selección por Defecto en Lanzar App -->
                        <CheckBox x:Name="ChkLaunchApp" 
                                  IsChecked="True" 
                                  Cursor="Hand" 
                                  VerticalContentAlignment="Center">
                            <TextBlock Text="Iniciar TPVC ahora" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="{StaticResource ThemeText}" 
                                       Margin="6,0,0,0" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Botón Finalizar -->
                <Button Grid.Row="2" 
                        Style="{StaticResource SuccessButton}" 
                        Click="FinishButton_Click" 
                        Height="48" 
                        HorizontalAlignment="Stretch">
                    <TextBlock Text="Finalizar" FontWeight="Bold" FontSize="15" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
