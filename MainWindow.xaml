<Window x:Class="TPVC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TPVC.ViewModels"
        xmlns:views="clr-namespace:TPVC.Views"
        mc:Ignorable="d"
        Title="TPVC - Control de Inventario para Consultorio Médico" 
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground}">

    <Window.Resources>
        <!-- DataTemplates para resolución automática de Vistas según el ViewModel -->
        <DataTemplate DataType="{x:Type vm:MainHubViewModel}">
            <views:MainHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicalRecordsViewModel}">
            <views:MedicalRecordsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationShellViewModel}">
            <views:ConfigurationShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchesViewModel}">
            <views:BatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <views:MovementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Área Principal de Contenido Dinámico a Ancho Completo -->
        <ContentControl Grid.Row="0" Content="{Binding CurrentView}" />

        <!-- Barra Inferior Discreta (Datos sincronizados y versión del sistema para consulta de un vistazo) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource ThemeSurface}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="0,1,0,0" 
                Padding="24,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identificador del Sistema y Versión Exacta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitle}" 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock Text="  •  " 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeAccent}" />
                </StackPanel>

                <!-- Indicador discreto de sincronización de datos -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource ThemeSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Datos sincronizados" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
