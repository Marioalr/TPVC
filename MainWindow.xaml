<Window x:Class="TPVC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TPVC.ViewModels"
        xmlns:views="clr-namespace:TPVC.Views"
        xmlns:helpers="clr-namespace:TPVC.Helpers"
        xmlns:services="clr-namespace:TPVC.Services"
        mc:Ignorable="d"
        Title="TPVC - Control de Inventario para Consultorio Médico" 
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeText}">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ToggleCommandPaletteCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ToggleCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates para resolución automática de Vistas según el ViewModel -->
        <DataTemplate DataType="{x:Type vm:MainHubViewModel}">
            <views:MainHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicalRecordsViewModel}">
            <views:MedicalRecordsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationShellViewModel}">
            <views:ConfigurationShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchesViewModel}">
            <views:BatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <views:MovementsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Área Principal de Contenido Dinámico a Ancho Completo -->
        <ContentControl Grid.Row="0" Content="{Binding CurrentView, Converter={StaticResource CachedView}}" />

        <!-- Barra Inferior Discreta (Datos sincronizados y versión del sistema para consulta de un vistazo) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource ThemeSurface}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="0,1,0,0" 
                Padding="24,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identificador del Sistema y Versión Exacta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitle}" 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock Text="  •  " 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeAccentForeground}" />
                </StackPanel>

                <!-- Acceso rápido a Paleta de Comandos (Ctrl + K) -->
                <Button Grid.Column="1"
                        Command="{Binding ToggleCommandPaletteCommand}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        Padding="10,3"
                        Margin="0,0,16,0"
                        FocusVisualStyle="{StaticResource DsFocusVisual}"
                        AutomationProperties.Name="Búsqueda rápida"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <helpers:Icon Data="{StaticResource IcoSearch}" Width="12" Height="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Búsqueda rápida" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1">
                            <TextBlock Text="Ctrl + K" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Indicador interactivo de sincronización Turso Cloud / Local -->
                <Button Grid.Column="2" 
                        Command="{Binding OpenTursoSyncCommand}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,2"
                        FocusVisualStyle="{StaticResource DsFocusVisual}"
                        AutomationProperties.Name="Estado de la sincronización"
                        ToolTip="{Binding TursoStatusToolTip}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Style="{StaticResource SyncStatusDot}" Tag="{Binding TursoStatus}" />
                        <TextBlock Text="{Binding TursoStatusText}" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- OVERLAY: PALETA GLOBAL DE COMANDOS (Ctrl + K) -->
        <!-- ============================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" 
              Panel.ZIndex="999"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVis}}">
            <!-- Fondo oscuro translúcido con desenfoque / click para cerrar -->
            <Border Background="{DynamicResource ThemeOverlay}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseCommandPaletteCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- Contenedor flotante de la paleta -->
            <Border Width="650" 
                    MaxHeight="520"
                    VerticalAlignment="Top" 
                    Margin="0,70,0,0"
                    Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.3" Direction="270" Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de búsqueda -->
                    <Border Grid.Row="0" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,0,0,1" 
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <helpers:Icon Grid.Column="0" 
                                          Data="{StaticResource IcoSearch}" 
                                          Width="18" Height="18" 
                                          Foreground="{DynamicResource ThemeTextSecondary}" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,12,0" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="PaletteSearchTextBox" 
                                         Text="{Binding PaletteSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         Foreground="{DynamicResource ThemeText}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource ThemeText}"
                                         SelectionBrush="{DynamicResource ThemeAccent}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Buscar en la paleta de comandos"
                                         PreviewKeyDown="PaletteSearchTextBox_PreviewKeyDown" />

                                <!-- Placeholder cuando el texto está vacío -->
                                <TextBlock Text="Buscar comando, paciente, medicamento o vista..."
                                           FontSize="14"
                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaletteSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Botón Esc para cerrar -->
                            <Button Grid.Column="2" 
                                    Style="{StaticResource ButtonGhost}"
                                    Command="{Binding CloseCommandPaletteCommand}"
                                    MinHeight="0"
                                    Padding="4"
                                    ToolTip="Cerrar (Esc)"
                                    AutomationProperties.Name="Cerrar la paleta de comandos"
                                    VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="6,2">
                                    <TextBlock Text="Esc" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Lista de Resultados -->
                    <Grid Grid.Row="1">
                        <!-- Mensaje si no hay resultados -->
                        <Border Visibility="{Binding PaletteResults.Count, Converter={StaticResource ComparisonToVis}, ConverterParameter=0}"
                                Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <helpers:Icon Data="{StaticResource IcoSearch}" Width="28" Height="28" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="No se encontraron coincidencias" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" />
                                <TextBlock Text="Intenta con otro término (ej. paciente, medicamento, lote, consulta)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="PaletteResultsListBox"
                                 ItemsSource="{Binding PaletteResults}"
                                 SelectedItem="{Binding SelectedPaletteItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="360"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="6,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" 
                                                        Background="{TemplateBinding Background}" 
                                                        CornerRadius="8" 
                                                        Padding="12,8"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                    </Trigger>
                                                    <!-- El resultado que abre Enter: fondo de selección y borde de foco (no igual al hover) -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" 
                                                          Command="{Binding DataContext.SelectPaletteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                          CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono de categoría -->
                                        <Border Grid.Column="0" 
                                                Width="34" Height="34" 
                                                CornerRadius="8" 
                                                Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <helpers:Icon Data="{Binding Icon, Converter={StaticResource ResourceLookup}}" 
                                                          Width="16" Height="16" 
                                                          Foreground="{DynamicResource ThemeAccentForeground}" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Título y subtítulo -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource ThemeText}" />
                                                <Border Margin="8,0,0,0" 
                                                        Padding="6,1" 
                                                        CornerRadius="4" 
                                                        Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" 
                                                               FontSize="10" 
                                                               FontWeight="Medium" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                       Margin="0,2,0,0" 
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Badge opcional -->
                                        <Border Grid.Column="2" 
                                                Visibility="{Binding Badge, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                BorderBrush="{DynamicResource ThemeFocus}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="7,2" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource ThemeAccentForeground}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Pie con atajos y guía de teclado -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,1,0,0" 
                            CornerRadius="0,0,14,14"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Navegar" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,4,0" />
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                    <TextBlock Text="↑ / ↓" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                </Border>

                                <TextBlock Text="Seleccionar" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,4,0" />
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                    <TextBlock Text="Enter" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                </Border>

                                <TextBlock Text="Cerrar" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,4,0" />
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding PaletteResults.Count, StringFormat='{}{0} resultado(s)'}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- OVERLAY: ASISTENTE DE PRIMER ARRANQUE -->
        <!-- ============================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" 
              Panel.ZIndex="1000"
              Visibility="{Binding IsFirstRunWizardOpen, Converter={StaticResource BoolToVis}}">
            <!-- Fondo oscuro -->
            <Border Background="{DynamicResource ThemeOverlay}" />

            <!-- Contenedor del Asistente -->
            <Border Width="650" 
                    MaxHeight="680"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ThemeCard}"
                    BorderBrush="{DynamicResource ThemeFocus}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.4" Direction="270" Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de Bienvenida -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ThemeAccentStrong}" 
                                    CornerRadius="10" 
                                    Width="38" Height="38" 
                                    Margin="0,0,12,0">
                                <helpers:Icon Data="{StaticResource IcoPulse}" Width="20" Height="20" Foreground="{DynamicResource ThemeAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="¡Bienvenido a TPVC Consultorio!" 
                                           FontSize="19" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Text="Asistente de configuración inicial para su consultorio médico." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Formulario de Configuración Inicial -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Alerta de Error si faltan datos obligatorios -->
                            <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,14" Visibility="{Binding WizardErrorMessage, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoAlert}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding WizardErrorMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Sección 1: Datos del Médico -->
                            <TextBlock Text="1. DATOS DEL MÉDICO TITULAR (NOM-004-SSA3)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentForeground}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Nombre Completo del Médico:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardDoctorName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Cédula Profesional:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardDoctorLicense, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                    <TextBlock Text="Especialidad:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardDoctorSpecialty, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                    <TextBlock Text="Teléfono Contacto:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardClinicPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Sección 2: Datos del Consultorio -->
                            <TextBlock Text="2. DATOS DEL CONSULTORIO O CLÍNICA" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentForeground}" Margin="0,6,0,8" />
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Nombre del Consultorio / Clínica:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardClinicName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Text="Dirección / Domicilio:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding WizardClinicAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Sección 3: Modo de Inicio (Base Vacía vs Demostración) -->
                            <TextBlock Text="3. MODO DE INICIO DEL SISTEMA" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentForeground}" Margin="0,6,0,8" />
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <RadioButton GroupName="StartupModeGroup" Style="{StaticResource FieldRadio}" 
                                                 IsChecked="{Binding WizardSeedDemoData, Converter={StaticResource InverseBool}}" 
                                                 Margin="0,0,0,10">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Empezar vacío (Recomendado para consultorio real)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                            <TextBlock Text="Inicia sin pacientes ni medicamentos ficticios. El catálogo y expedientes estarán listos para que capture solo su información real." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="StartupModeGroup" Style="{StaticResource FieldRadio}" 
                                                 IsChecked="{Binding WizardSeedDemoData}" 
                                                 Margin="0,4,0,0">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Empezar con datos de demostración" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                            <TextBlock Text="Carga 4 pacientes de prueba y 9 medicamentos muestra para evaluar o probar las funciones del software." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botón de Finalización -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonPrimary}" 
                                Command="{Binding CompleteFirstRunWizardCommand}" 
                                Padding="20,10" 
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <helpers:Icon Data="{StaticResource IcoCheck}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Completar Configuración y Empezar" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- AVISOS BREVES (se van solos, no piden clic)  -->
        <!-- ============================================ -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="2"
                      Panel.ZIndex="1100"
                      ItemsSource="{Binding Notifications.Items}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,48"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:Notification}">
                    <Border Style="{StaticResource Toast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <helpers:Icon x:Name="KindIcon" Data="{StaticResource IcoCheck}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource ButtonIconToast}"
                                    Width="28" Height="28"
                                    Margin="8,0,-4,0"
                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Cerrar aviso"
                                    AutomationProperties.Name="Cerrar aviso">
                                <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                            <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource IcoInfo}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource IcoAlert}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource IcoAlert}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
