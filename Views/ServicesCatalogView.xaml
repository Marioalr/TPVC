<UserControl x:Class="TPVC.Views.ServicesCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ServicesCatalogViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Servicios: lo que se cobra (consulta, curación, inyección…), su precio y los insumos que   -->
    <!-- se agregan solos. Se editan en un panel lateral; desactivar lo quita del POS y la consulta. -->
    <Grid>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Servicios" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="Precios de consulta y procedimientos, y los insumos que usa cada uno" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding NewServiceCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                        <TextBlock Text="Nuevo servicio" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Grid Margin="0,0,0,10">
                    <TextBox Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar servicio por nombre, código o descripción"
                             AutomationProperties.Name="Buscar servicio" />
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel>
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter, Mode=TwoWay}"
                             AutomationProperties.Name="Categorías" Margin="0,0,12,0" />
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,0,6" IsChecked="{Binding ShowInactive}" Content="Mostrar desactivados" />
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox x:Name="ServicesList" Style="{StaticResource PlainList}" Padding="8,6" ItemsSource="{Binding FilteredServices}"
                             MouseDoubleClick="ServicesList_MouseDoubleClick" AutomationProperties.Name="Servicios">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClinicalService}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource BadgeWarning}" Margin="8,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="Desactivado" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} min · {2} insumo(s)">
                                                    <Binding Path="Code" />
                                                    <Binding Path="EstimatedDurationMinutes" />
                                                    <Binding Path="DefaultProducts.Count" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextDetail}" Text="{Binding Category}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Content="Editar"
                                                Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonGhost}" MinHeight="0" Padding="10,5" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Desactivar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Activar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Ningún servicio con estos filtros."
                               Visibility="{Binding FilteredServices.Count, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= PANEL: ALTA / EDICIÓN ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="480" Panel.ZIndex="50"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding EditorTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseEditorCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,16">
                        <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding EditorError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding EditorError}" TextWrapping="Wrap" />
                        </Border>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Código" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre *" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Ej. Aplicación de inyección" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Categoría" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{x:Static vm:ServicesCatalogViewModel.DefaultCategories}" SelectedItem="{Binding EditCategory}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Precio ($) *" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding EditPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Minutos" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding EditDuration, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción" />
                        <TextBox Style="{StaticResource FieldMultiline}" MinHeight="60" Margin="0,0,0,12" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding EditIsActive}" Content="Se ofrece al cobrar (activo)" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardSubtle}" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextSection}" Text="Insumos que usa" />
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                           Text="Se agregan a la cuenta y se descuentan del inventario cada vez que se carga el servicio." />
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Insumo" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Cantidad" />
                                    <ComboBox Grid.Row="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProductToAdd}"
                                              DisplayMemberPath="Name" helpers:TypeAhead.IsEnabled="True" AutomationProperties.Name="Insumo" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                             Text="{Binding NewSupplyQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad" />
                                    <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource ButtonSecondary}" Command="{Binding AddSupplyCommand}" Content="Agregar" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EditSupplies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ServiceDefaultProduct}">
                                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding Product.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar" AutomationProperties.Name="Quitar insumo"
                                                            Command="{Binding DataContext.RemoveSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Sin insumos: solo se cobra el servicio."
                                           Visibility="{Binding EditSupplies.Count, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseEditorCommand}" Content="Cancelar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveServiceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar servicio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
