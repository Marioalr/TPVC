<Window x:Class="TPVC.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TPVC.Helpers"
        Title="Confirmar acción"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontFamilyUi}"
        Foreground="{DynamicResource ThemeText}">

    <!-- ========================================================================= -->
    <!-- CONFIRMACIONES Y ERRORES (DialogService) con los colores del tema.        -->
    <!-- Lo seguro es lo predeterminado: "No" (o "Aceptar") tiene el foco al abrir -->
    <!-- y lo tocan Enter y Esc. "Sí" se elige a propósito.                        -->
    <!-- La ventana no tiene marco de Windows: el margen transparente de la        -->
    <!-- tarjeta deja ver su sombra.                                               -->
    <!-- ========================================================================= -->
    <Border x:Name="DialogCard"
            Style="{StaticResource SheetCard}"
            Margin="32,24,32,44"
            MinWidth="380"
            Padding="24,20"
            MouseLeftButtonDown="OnCardMouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icono: aviso (confirmación) o peligro (error), sobre su fondo suave para que se lea en cualquier tema -->
            <Border x:Name="WarningBadge"
                    Width="40" Height="40" CornerRadius="20"
                    VerticalAlignment="Top" Margin="0,0,16,0"
                    Background="{DynamicResource ThemeWarningSubtle}"
                    TextElement.Foreground="{DynamicResource ThemeWarningText}">
                <helpers:Icon Data="{StaticResource IcoAlert}" Width="22" Height="22" />
            </Border>
            <Border x:Name="ErrorBadge"
                    Visibility="Collapsed"
                    Width="40" Height="40" CornerRadius="20"
                    VerticalAlignment="Top" Margin="0,0,16,0"
                    Background="{DynamicResource ThemeDangerSubtle}"
                    TextElement.Foreground="{DynamicResource ThemeDangerText}">
                <helpers:Icon Data="{StaticResource IcoAlert}" Width="22" Height="22" />
            </Border>

            <StackPanel Grid.Column="1" MaxWidth="440" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource TextSection}" Margin="0,0,0,6" />
                <!-- Un mensaje muy largo (detalle de un error) se desplaza en vez de crecer más que la pantalla -->
                <ScrollViewer MaxHeight="360"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" Style="{StaticResource TextBody}" LineHeight="20" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <!-- Lo seguro: Esc (IsCancel) y Enter (IsDefault) lo tocan y cierra sin confirmar.
                     Sin manejador de clic: IsCancel cierra la ventana modal como "No". -->
                <Button x:Name="SafeButton"
                        Style="{StaticResource ButtonSecondary}"
                        IsCancel="True"
                        IsDefault="True"
                        MinWidth="96"
                        Content="No" />
                <!-- Todas las confirmaciones de la app protegen algo que no se puede deshacer -->
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource ButtonDanger}"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        Content="Sí"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
