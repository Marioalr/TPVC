<UserControl x:Class="TPVC.Views.CatalogBrowserSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Catálogo de la consulta (medicamentos, insumos o servicios): el mismo aspecto que el -->
    <!-- catálogo del Punto de Venta. Enter agrega el primero de la lista.                    -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="900" Height="660" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TextHeading}" Text="{Binding CatalogBrowserTitle}" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding CatalogBrowserSummary}" VerticalAlignment="Bottom" Margin="12,0,0,4" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding CatalogBrowserSubtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseCatalogBrowserCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="24,12,24,10">
                    <TextBox x:Name="CatalogBrowserSearchTextBox" Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                             Text="{Binding CatalogBrowserSearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Nombre, genérico, código o descripción · Enter agrega el primero"
                             AutomationProperties.Name="Buscar en el catálogo">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddFirstFromCatalogBrowserCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Row="2">
                    <!-- Medicamentos o insumos -->
                    <ListBox Style="{StaticResource PlainList}" Padding="16,0"
                             ItemsSource="{Binding CatalogBrowserFilteredProducts}"
                             Visibility="{Binding IsCatalogBrowserServicesMode, Converter={StaticResource InverseBoolToVis}}"
                             AutomationProperties.Name="Productos">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Product}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                    <Binding Path="Code" />
                                                    <Binding Path="GenericName" />
                                                    <Binding Path="Presentation" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource StockBadge}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentStock, StringFormat='Existencias: {0}'}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                    <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Margin="16,0,0,0"
                                            Command="{Binding DataContext.AddProductFromCatalogBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <helpers:Icon Data="{StaticResource IcoPlus}" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Agregar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Servicios -->
                    <ListBox Style="{StaticResource PlainList}" Padding="16,0"
                             ItemsSource="{Binding CatalogBrowserFilteredServices}"
                             Visibility="{Binding IsCatalogBrowserServicesMode, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Servicios">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClinicalService}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} min · {2}">
                                                    <Binding Path="Category" />
                                                    <Binding Path="EstimatedDurationMinutes" />
                                                    <Binding Path="Description" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                    <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Margin="16,0,0,0"
                                            Command="{Binding DataContext.AddServiceFromCatalogBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <helpers:Icon Data="{StaticResource IcoPlus}" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Agregar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Nada coincide con lo escrito."
                               Visibility="{Binding HasNoCatalogBrowserResults, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,12">
                    <TextBlock Style="{StaticResource TextCaption}" Text="Enter agrega el primero · Agregar lo pone en la consulta · Esc cierra" />
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
