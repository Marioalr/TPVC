<UserControl x:Class="TPVC.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DataManagementViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Respaldos y datos: respaldar ahora, volver a un respaldo, importar el catálogo de Excel y   -->
    <!-- restaurar una base completa. Todo pasa por una hoja que explica los pasos; solo reemplazar -->
    <!-- la base completa (lo irreversible) pide escribir CONFIRMAR.                                -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource TextTitle}" Text="Respaldos y datos" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="Copias de seguridad, importar el catálogo y restaurar información" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Respaldo -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ThemeSuccessSubtle}" Margin="0,0,14,0" VerticalAlignment="Top">
                                <helpers:Icon Data="{StaticResource IcoSave}" Foreground="{DynamicResource ThemeSuccessText}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextSection}" Text="{Binding LastBackupText}" />
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Se respalda solo al abrir el programa y antes de importar o restaurar. Guarde de vez en cuando una copia en una USB." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Style="{StaticResource ButtonGhost}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" ToolTip="{Binding BackupDirectory}">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir carpeta" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ButtonPrimary}" Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBool}}">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                        <TextBlock Text="Respaldar ahora" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Respaldos guardados" Margin="0,0,0,6" />
                            <ListBox Style="{StaticResource PlainList}" MaxHeight="300" ItemsSource="{Binding Backups}" AutomationProperties.Name="Respaldos guardados">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BackupEntry}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding DateText}" />
                                                <TextBlock Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TextDetail}" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    Content="Volver a este"
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Importar / restaurar -->
                <UniformGrid Grid.Row="2" Columns="2">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,0">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ThemeInfoSubtle}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <helpers:Icon Data="{StaticResource IcoPill}" Foreground="{DynamicResource ThemeInfoText}" />
                            </Border>
                            <TextBlock Style="{StaticResource TextSection}" Text="Importar catálogo de Excel" />
                            <TextBlock Style="{StaticResource TextDetail}" TextWrapping="Wrap" Margin="0,4,0,14"
                                       Text="Medicamentos, plantillas de receta, dosis pediátricas y datos del médico desde la hoja de Excel (.xlsx) o un CSV. Lo que ya existe se actualiza; no se borra nada." />
                            <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding StartImportExcelCommand}" IsEnabled="{Binding CanImport}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                                    <TextBlock Text="Elegir archivo…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20" Margin="8,0,0,0">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ThemeWarningSubtle}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <helpers:Icon Data="{StaticResource IcoRefresh}" Foreground="{DynamicResource ThemeWarningText}" />
                            </Border>
                            <TextBlock Style="{StaticResource TextSection}" Text="Restaurar base de datos" />
                            <TextBlock Style="{StaticResource TextDetail}" TextWrapping="Wrap" Margin="0,4,0,14"
                                       Text="Reemplaza toda la información por la de otro archivo .db (por ejemplo, la de otra computadora). Antes se guarda un respaldo de la actual." />
                            <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding StartRestoreFromFileCommand}" IsEnabled="{Binding CanImport}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                                    <TextBlock Text="Elegir archivo…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <!-- ======================= HOJA: IMPORTAR / RESTAURAR ======================= -->
        <Grid Panel.ZIndex="60" Visibility="{Binding IsImportSheetOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SheetScrim}" />
            <Border Style="{StaticResource SheetCard}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding ImportSheetTitle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextHeading}" Text="{Binding ImportSheetTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseImportSheetCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}">
                            <helpers:Icon Data="{StaticResource IcoClose}" />
                        </Button>
                    </Grid>

                    <!-- Archivo elegido -->
                    <Border Style="{StaticResource CardSubtle}" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding ImportFileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportFilePath}" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding ImportFileDetail}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Paso 1: confirmar -->
                    <StackPanel Visibility="{Binding IsConfirmStep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Qué va a pasar" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ImportSteps}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ImportStep}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeInfoSubtle}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Number}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextBody}" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding RequiresTypedConfirmation, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Todo lo registrado después de la fecha de ese archivo se pierde (queda solo en el respaldo previo). Para continuar escriba CONFIRMAR." />
                            </Border>
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" CharacterCasing="Upper"
                                     Text="{Binding ImportConfirmWord, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="CONFIRMAR" AutomationProperties.Name="Escriba CONFIRMAR" Margin="0,0,0,14" />
                        </StackPanel>
                        <Border Style="{StaticResource Notice}" Margin="0,0,0,14" Visibility="{Binding RequiresTypedConfirmation, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock TextWrapping="Wrap" Text="Si algo no queda bien puede volver al respaldo previo desde esta misma página." />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseImportSheetCommand}" Content="Cancelar" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}" />
                            <Button Command="{Binding ExecuteImportCommand}" IsEnabled="{Binding CanProceedWithImport}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                        <Setter Property="Content" Value="Importar" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDatabaseRestore}" Value="True">
                                                <Setter Property="Content" Value="Reemplazar la base" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                <Setter Property="Content" Value="Trabajando…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Paso 2: resultado -->
                    <StackPanel Visibility="{Binding HasImportResult, Converter={StaticResource BoolToVis}}">
                        <Border Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource NoticeSuccess}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImportResult.Success}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ImportResult.Message}" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ImportResultLines}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <helpers:Icon Data="{StaticResource IcoCheck}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource ThemeSuccessText}" />
                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Right" Command="{Binding CloseImportSheetCommand}" Content="Listo" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
