<UserControl x:Class="TPVC.Views.VitalSignsChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Evolución de signos vitales en la ficha: últimos valores, gráfica y tabla. Los colores -->
    <!-- de cada serie salen del tema (contrastan en claro y oscuro); el texto siempre es el    -->
    <!-- color normal y el color de la serie solo marca la muestra, la línea y el punto.      -->
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PointDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Stroke" Value="{DynamicResource ThemeCard}" />
            <Setter Property="Fill" Value="{DynamicResource ThemeChartWeight}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeriesName}" Value="Presión Sistólica">
                    <Setter Property="Fill" Value="{DynamicResource ThemeChartSystolic}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeriesName}" Value="Presión Diastólica">
                    <Setter Property="Fill" Value="{DynamicResource ThemeChartDiastolic}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeriesName}" Value="Glucosa">
                    <Setter Property="Fill" Value="{DynamicResource ThemeChartGlucose}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Encabezado y filtro -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextSection}" Text="Evolución de signos vitales" />
                <TextBlock Style="{StaticResource TextCaption}" Text="Peso, tensión arterial y glucosa a lo largo de las consultas" />
            </StackPanel>
            <ListBox Grid.Column="1" Style="{StaticResource ChipList}" VerticalAlignment="Center"
                     ItemsSource="{Binding VitalSignsFilterOptions}"
                     SelectedItem="{Binding VitalSignsFilterLabel, Mode=TwoWay}"
                     AutomationProperties.Name="Mostrar en la gráfica" />
        </Grid>

        <!-- Últimos valores -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartWeight}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Último peso" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextMono}" FontSize="18" FontWeight="Bold" Text="{Binding LatestWeightFormatted}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartSystolic}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Última T/A" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextMono}" FontSize="18" FontWeight="Bold" Text="{Binding LatestBPFormatted}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="Óptima &lt; 120/80" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartGlucose}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Última glucosa" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextMono}" FontSize="18" FontWeight="Bold" Text="{Binding LatestGlucoseFormatted}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="Ayuno 70–100 mg/dL" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" Text="IMC" />
                    <TextBlock Style="{StaticResource TextMono}" FontSize="18" FontWeight="Bold" Text="{Binding LatestIMCFormatted}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="Normal 18.5–24.9" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Gráfica -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartWeight}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Peso (kg)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartSystolic}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="T/A sistólica" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartDiastolic}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="T/A diastólica (punteada)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Swatch}" Fill="{DynamicResource ThemeChartGlucose}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Glucosa (mg/dL)" />
                    </StackPanel>
                </WrapPanel>

                <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="8" Height="220" ClipToBounds="True">
                    <Grid>
                        <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Hacen falta al menos dos consultas con signos vitales para ver la tendencia."
                                   Visibility="{Binding HasEnoughPointsForChart, Converter={StaticResource InverseBoolToVis}}" />

                        <Canvas Visibility="{Binding HasEnoughPointsForChart, Converter={StaticResource BoolToVis}}">
                            <Line X1="30" Y1="40" X2="620" Y2="40" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="3,3" StrokeThickness="1" />
                            <Line X1="30" Y1="100" X2="620" Y2="100" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="3,3" StrokeThickness="1" />
                            <Line X1="30" Y1="160" X2="620" Y2="160" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="3,3" StrokeThickness="1" />
                            <Polyline Points="{Binding WeightPolylinePoints}" Stroke="{DynamicResource ThemeChartWeight}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                            <Polyline Points="{Binding SystolicPolylinePoints}" Stroke="{DynamicResource ThemeChartSystolic}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                            <Polyline Points="{Binding DiastolicPolylinePoints}" Stroke="{DynamicResource ThemeChartDiastolic}" StrokeThickness="2" StrokeDashArray="2,2" StrokeLineJoin="Round" />
                            <Polyline Points="{Binding GlucosePolylinePoints}" Stroke="{DynamicResource ThemeChartGlucose}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                        </Canvas>

                        <ItemsControl ItemsSource="{Binding ChartPoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:VitalSignsChartPoint}">
                                    <Canvas Margin="-5,-5,0,0">
                                        <Ellipse Style="{StaticResource PointDot}" ToolTip="{Binding ValueLabel}" />
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tabla de mediciones -->
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <TextBlock Style="{StaticResource TextSection}" Text="Todas las mediciones" Margin="16,14,16,10" />
                <Border Background="{DynamicResource ThemeSurfaceSubtle}" Padding="16,6">
                    <Grid TextElement.Foreground="{DynamicResource ThemeTextSecondary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextLabel}" Text="Fecha" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextLabel}" Text="Peso" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextLabel}" Text="T/A" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextLabel}" Text="Glucosa" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TextLabel}" Text="FC" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TextLabel}" Text="Temp" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TextLabel}" Text="IMC" />
                    </Grid>
                </Border>
                <!-- Lista con su propio desplazamiento: solo se crean los renglones visibles -->
                <ItemsControl ItemsSource="{Binding VitalSignsEvolutionPoints}" MaxHeight="240"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:VitalSignsEvolutionPoint}">
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid TextElement.FontSize="{StaticResource FontSizeDetail}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FormattedDate}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding WeightText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding BloodPressureText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding GlucoseText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding HeartRate, TargetNullValue='--'}" />
                                    <TextBlock Grid.Column="5" Text="{Binding TempText}" />
                                    <TextBlock Grid.Column="6" Text="{Binding BMI, StringFormat='{}{0:F1}', TargetNullValue='--'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
