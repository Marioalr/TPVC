<UserControl x:Class="TPVC.Views.PosTicketSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!-- Ticket de la venta recién cobrada (o reimpresión desde el historial): vista previa del -->
    <!-- ticket térmico con los colores del tema. Enter pasa a la siguiente venta.            -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="480" MaxHeight="760" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Avatar}" Width="40" Height="40" Margin="0,0,12,0"
                            Background="{DynamicResource ThemeSuccessSubtle}" TextElement.Foreground="{DynamicResource ThemeSuccessText}"
                            Visibility="{Binding IsFreshSaleTicket, Converter={StaticResource BoolToVis}}">
                        <helpers:Icon Data="{StaticResource IcoCheck}" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextHeading}">
                                    <Setter Property="Text" Value="Ticket" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFreshSaleTicket}" Value="True">
                                            <Setter Property="Text" Value="Venta cobrada" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextMono}" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding CurrentReceipt.Folio}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding CloseTicketModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardSubtle}" Margin="24,0,24,12" Padding="20,18" TextElement.FontFamily="{StaticResource FontFamilyMono}"
                            TextElement.FontSize="{StaticResource FontSizeDetail}">
                        <StackPanel>
                            <TextBlock Text="{Binding ClinicProfileName}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DoctorNameWithTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DoctorSpecialtyAndLicense}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Text="{Binding ClinicAddressAndPhone}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeTextSecondary}" Visibility="{Binding ClinicAddressAndPhone, Converter={StaticResource BoolToVis}}" />

                            <Rectangle Height="1" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="4 3" Margin="0,12" SnapsToDevicePixels="True" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Folio" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,2" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.Folio}" TextAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Fecha" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentReceipt.Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="Cliente" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentReceipt.PatientName}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Text="Pago" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentReceipt.PaymentMethod}" TextAlignment="Right" />
                            </Grid>

                            <Rectangle Height="1" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="4 3" Margin="0,12" SnapsToDevicePixels="True" />

                            <ItemsControl ItemsSource="{Binding CurrentReceipt.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SaleReceiptItem}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{DynamicResource ThemeTextSecondary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} × {1:C2}" ConverterCulture="es-MX">
                                                            <Binding Path="Quantity" />
                                                            <Binding Path="UnitPrice" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:C2}, ConverterCulture=es-MX}" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Stroke="{DynamicResource ThemeBorderStrong}" StrokeDashArray="4 3" Margin="0,6,0,12" SnapsToDevicePixels="True" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.TotalAmount, StringFormat={}{0:C2}, ConverterCulture=es-MX}" FontWeight="Bold" FontSize="15" />
                            </Grid>
                            <Grid Margin="0,6,0,0" Visibility="{Binding CurrentReceipt.HasCashDetail, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Recibido" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.CashReceived, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                <TextBlock Grid.Row="1" Text="Cambio" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentReceipt.Change, StringFormat={}{0:C2}, ConverterCulture=es-MX}" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="Gracias por su preferencia" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel>
                        <Border Style="{StaticResource NoticeSuccess}" Margin="0,0,0,10" Padding="12,6"
                                Visibility="{Binding TicketStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TicketStatusMessage}" TextWrapping="Wrap" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ButtonSecondary}" Command="{Binding PrintTicketCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoPrint}" Margin="0,0,8,0" />
                                    <TextBlock Text="Imprimir" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Command="{Binding CloseTicketModalCommand}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Listo" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFreshSaleTicket}" Value="True">
                                                    <Setter Property="Text" Value="Nueva venta (Enter)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
