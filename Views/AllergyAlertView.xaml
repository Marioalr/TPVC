<UserControl x:Class="TPVC.Views.AllergyAlertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pvm="clr-namespace:TPVC.ViewModels.Patients"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pvm:PrescriptionSheetViewModel}">

    <!-- Alerta de alergia al recetar: lo seguro (no recetarlo) es lo que hace Enter o Esc; -->
    <!-- recetarlo de todos modos es una decisión explícita.                              -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="560" BorderBrush="{DynamicResource ThemeDanger}" BorderThickness="2" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Avatar}" Width="48" Height="48" Margin="0,0,14,0"
                            Background="{DynamicResource ThemeDangerSubtle}" TextElement.Foreground="{DynamicResource ThemeDangerText}">
                        <helpers:Icon Data="{StaticResource IcoAlert}" Width="24" Height="24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextHeading}" Foreground="{DynamicResource ThemeDangerText}" Text="{Binding AllergyAlertTitle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Revise antes de recetar: el paciente tiene alergias registradas" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding AllergyAlertMessage}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}" LineHeight="20" />
                    </Border>
                    <Border Style="{StaticResource CardSubtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Alergias registradas en el expediente" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeDangerText}" Text="{Binding AllergyPatientAllergies}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CancelAllergyPrescriptionCommand}" IsDefault="True" MinHeight="44"
                            ToolTip="No agregar este medicamento a la receta (Enter o Esc)">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoClose}" Margin="0,0,8,0" />
                            <TextBlock Text="No recetarlo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonDanger}" Command="{Binding ConfirmOverrideAllergyPrescriptionCommand}" MinHeight="44"
                            ToolTip="Recetar bajo su criterio y responsabilidad">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoAlert}" Margin="0,0,8,0" />
                            <TextBlock Text="Recetar de todos modos" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
