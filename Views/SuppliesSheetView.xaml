<UserControl x:Class="TPVC.Views.SuppliesSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Insumos y material usados en la consulta: se escriben (↑↓ y Enter eligen) y se cargan a -->
    <!-- la cuenta de la consulta en cuanto se agregan.                                       -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="820" MaxHeight="700" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Insumos y material" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Gasas, jeringas, vendas… lo usado se carga a la cuenta de la consulta" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Supplies.OpenSupplyCatalogCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                            ToolTip="Ver todos los insumos del inventario">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSearch}" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding Supplies.CloseSuppliesModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Captura rápida -->
                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Insumo *" />
                            <TextBox x:Name="SupplySearchTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Supplies.SupplySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Escriba para buscar"
                                     PreviewKeyDown="SupplySearchTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="Insumo" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Uso o indicación" />
                            <TextBox x:Name="SupplyInstructionsTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Supplies.SupplyInstructions, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. curación de herida en antebrazo"
                                     PreviewKeyDown="SupplyAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Uso o indicación" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                            <TextBox x:Name="SupplyQuantityTextBox" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                     Text="{Binding Supplies.SupplyQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SupplyAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Cantidad" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0"
                            Visibility="{Binding Supplies.IsSupplyDropdownOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter o clic agrega · Esc cierra" Margin="10,4,10,4" />
                            <ListBox x:Name="SupplySuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="200"
                                     ItemsSource="{Binding Supplies.SupplyProductSuggestions}"
                                     SelectedItem="{Binding Supplies.SelectedSupplyProduct, Mode=TwoWay}"
                                     PreviewKeyDown="SupplySuggestionsListBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="SupplySuggestionsListBox_PreviewMouseLeftButtonUp"
                                     AutomationProperties.Name="Sugerencias de insumos">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Product}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Presentation}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StockBadge}" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockBadgeText}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lo usado en la consulta -->
                <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Margin="24,0,24,0" Padding="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActiveSupplies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PatientSupplyItem}">
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding SupplyName}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Instructions}" TextWrapping="Wrap"
                                                               Visibility="{Binding Instructions, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" FontStyle="Italic" Text="De una consulta anterior: no se cobra en esta"
                                                               Visibility="{Binding IsFromEarlierConsultation, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <!-- Piezas con + / − como en la cuenta del Punto de venta; a mano se aplica con Enter o al salir.
                                                     Lo de una consulta anterior solo se ve (o se quita con la X). -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ButtonIconSecondary}" Width="30" Height="30" ToolTip="Una menos (en 0 se quita)" AutomationProperties.Name="Una pieza menos"
                                                            IsEnabled="{Binding IsFromEarlierConsultation, Converter={StaticResource InverseBool}}"
                                                            Command="{Binding DataContext.Supplies.DecreaseSupplyQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="−" FontSize="16" />
                                                    </Button>
                                                    <TextBox Style="{StaticResource FieldTextBox}" Width="48" MinHeight="30" Height="30" Padding="2,0" Margin="6,0"
                                                             HorizontalContentAlignment="Center" FontWeight="SemiBold"
                                                             Text="{Binding Quantity, Mode=OneWay}"
                                                             IsReadOnly="{Binding IsFromEarlierConsultation}"
                                                             PreviewKeyDown="SupplyLineQuantity_PreviewKeyDown"
                                                             LostKeyboardFocus="SupplyLineQuantity_LostKeyboardFocus"
                                                             AutomationProperties.Name="Piezas usadas" />
                                                    <Button Style="{StaticResource ButtonIconSecondary}" Width="30" Height="30" ToolTip="Una más" AutomationProperties.Name="Una pieza más"
                                                            IsEnabled="{Binding IsFromEarlierConsultation, Converter={StaticResource InverseBool}}"
                                                            Command="{Binding DataContext.Supplies.IncreaseSupplyQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="+" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar (también de la cuenta)" AutomationProperties.Name="Quitar insumo"
                                                        Command="{Binding DataContext.Supplies.RemoveSupplyItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding Session.SelectedPatient.ActiveSupplies.Count, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource TextBody}" Text="Todavía no se ha usado ningún insumo." HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="Escríbalo arriba o ábralo desde el catálogo." HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding Supplies.CloseSuppliesModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding Supplies.SaveSuppliesModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
