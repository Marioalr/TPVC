<UserControl x:Class="TPVC.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera de Punto de Venta -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ThemeAccent}" 
                                CornerRadius="6" 
                                Width="28" Height="28" 
                                Margin="0,0,8,0">
                            <Path Data="{StaticResource IconCart}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Punto de Venta / Farmacia" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Despacho rápido y venta de medicamentos con carrito interactivo y descuento FEFO" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="36,2,0,0" />
                </StackPanel>

                <!-- Botón Volver a Inicio -->
                <Button Grid.Column="1" 
                        Style="{DynamicResource OutlineButton}" 
                        Command="{Binding BackToHubCommand}" 
                        VerticalAlignment="Center" 
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Volver a Inicio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido Principal: Catálogo (Izquierda) + Carrito (Derecha) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- COLUMNA IZQUIERDA: CATÁLOGO DE PRODUCTOS -->
            <!-- ============================================ -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Barra de Búsqueda y Filtro de Categoría -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Buscador -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" 
                                      Data="{StaticResource IconSearch}" 
                                      Fill="{DynamicResource ThemeTextSecondary}" 
                                      Width="13" Height="13" 
                                      Stretch="Uniform" 
                                      Margin="4,0,8,0" 
                                      VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         VerticalAlignment="Center" 
                                         Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Grid.Column="1" 
                                           Text="Buscar por nombre, principio activo o SKU..." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False" 
                                           Margin="4,0,0,0"
                                           Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                            </Grid>
                        </Border>

                        <!-- Selector de Categoría -->
                        <ComboBox Grid.Column="2" 
                                  Style="{DynamicResource ModernComboBox}" 
                                  ItemsSource="{Binding Categories}" 
                                  DisplayMemberPath="Name" 
                                  SelectedItem="{Binding SelectedCategory}" />
                    </Grid>

                    <!-- Lista de Productos en Tarjetas -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Margin="0,0,0,8" 
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Detalles del Producto -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="14" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text=" ❄️" 
                                                               Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}" 
                                                               ToolTip="Requiere cadena de frío" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                    <TextBlock Text="{Binding GenericName}" 
                                                               FontSize="12" 
                                                               FontStyle="Italic" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text=" • " 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Presentation}" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>

                                                <!-- Indicadores de Stock y Ubicación -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Badge de Stock -->
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsLowStock}" Value="True" />
                                                                            <Condition Binding="{Binding IsOutOfStock}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeWarning}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding CurrentStock, StringFormat='Stock: {0}'}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                            <Setter Property="Text" Value="Agotado" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Text="{Binding Location, StringFormat='Ubicación: {0}'}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               VerticalAlignment="Center" 
                                                               Visibility="{Binding Location, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Precio y Botón Agregar -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}" 
                                                           FontWeight="Bold" 
                                                           FontSize="16" 
                                                           Foreground="{DynamicResource ThemeAccent}" 
                                                           HorizontalAlignment="Right" 
                                                           Margin="0,0,0,6" />

                                                <Button Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Padding="12,5" 
                                                        IsEnabled="{Binding IsOutOfStock, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlus}" 
                                                              Fill="{DynamicResource ThemeAccentText}" 
                                                              Width="11" Height="11" 
                                                              Stretch="Uniform" 
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Agregar" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- COLUMNA DERECHA: EL CARRITO DE VENTA -->
            <!-- ============================================ -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Carrito -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCart}" 
                                      Fill="{DynamicResource ThemeAccent}" 
                                      Width="16" Height="16" 
                                      Stretch="Uniform" 
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Carrito de Venta" 
                                           FontWeight="Bold" 
                                           FontSize="16" 
                                           Foreground="{DynamicResource ThemeText}" />
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="10" 
                                        Padding="7,2" 
                                        Margin="8,0,0,0" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCartItems}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeAccentText}" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding ClearCartCommand}" 
                                    Padding="8,4" 
                                    FontSize="11" 
                                    ToolTip="Vaciar todos los artículos del carrito">
                                <TextBlock Text="Vaciar" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Datos del Paciente / Cliente -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Paciente / Cliente:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource ModernTextBox}" 
                                 Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="12" />
                    </StackPanel>

                    <!-- Lista de Artículos en el Carrito -->
                    <Grid Grid.Row="2">
                        <!-- Estado Vacío -->
                        <StackPanel VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Visibility="{Binding Cart.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <Path Data="{StaticResource IconCart}" 
                                  Fill="{DynamicResource ThemeBorder}" 
                                  Width="36" Height="36" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  Margin="0,0,0,10" />
                            <TextBlock Text="Carrito Vacío" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Agregue medicamentos o insumos desde el catálogo" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       HorizontalAlignment="Center" 
                                       TextAlignment="Center" 
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Lista con Scroll -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      Visibility="{Binding Cart.Count, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeSurface}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="10,8" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Fila 1: Nombre y Botón Eliminar -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" 
                                                                   FontWeight="SemiBold" 
                                                                   FontSize="13" 
                                                                   Foreground="{DynamicResource ThemeText}" 
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Presentation}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" 
                                                            Style="{DynamicResource OutlineButton}" 
                                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="6,3" 
                                                            VerticalAlignment="Top" 
                                                            ToolTip="Quitar producto">
                                                        <Path Data="{StaticResource IconTrash}" 
                                                              Fill="{DynamicResource ThemeError}" 
                                                              Width="11" Height="11" 
                                                              Stretch="Uniform" />
                                                    </Button>
                                                </Grid>

                                                <!-- Fila 2: Controles de Cantidad y Subtotal -->
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Controles [-] [Qty] [+] -->
                                                    <Border Grid.Column="0" 
                                                            Background="{DynamicResource ThemeCard}" 
                                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="4" 
                                                            Padding="2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    Width="24" Height="22" 
                                                                    Background="Transparent" 
                                                                    BorderThickness="0" 
                                                                    Cursor="Hand" 
                                                                    Content="−" 
                                                                    FontWeight="Bold" 
                                                                    FontSize="13" 
                                                                    Foreground="{DynamicResource ThemeText}" />
                                                            <TextBlock Text="{Binding Quantity}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12" 
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Center" 
                                                                       MinWidth="24" 
                                                                       TextAlignment="Center" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                            <Button Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    Width="24" Height="22" 
                                                                    Background="Transparent" 
                                                                    BorderThickness="0" 
                                                                    Cursor="Hand" 
                                                                    Content="+" 
                                                                    FontWeight="Bold" 
                                                                    FontSize="13" 
                                                                    Foreground="{DynamicResource ThemeText}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding UnitPrice, StringFormat='@ ${0:N2}'}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               VerticalAlignment="Center" 
                                                               Margin="8,0,0,0" />

                                                    <!-- Subtotal -->
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Subtotal, StringFormat='${0:N2}'}" 
                                                               FontWeight="Bold" 
                                                               FontSize="14" 
                                                               Foreground="{DynamicResource ThemeText}" 
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Pie del Carrito: Totales y Cobro -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Forma de Pago -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Método de pago:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" 
                                          Style="{DynamicResource ModernComboBox}" 
                                          ItemsSource="{Binding PaymentMethods}" 
                                          SelectedItem="{Binding SelectedPaymentMethod}" 
                                          MinWidth="140" />
                            </Grid>

                            <!-- Total General -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL A PAGAR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding TotalCartItems, StringFormat='{}{0} productos seleccionados'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding TotalCartAmount, StringFormat='${0:N2}'}" 
                                               FontWeight="Bold" 
                                               FontSize="24" 
                                               Foreground="{DynamicResource ThemeAccent}" 
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Botón Finalizar Venta -->
                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding ProcessSaleCommand}" 
                                    Padding="14,12" 
                                    FontSize="14" 
                                    FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Cobrar y Despachar Venta" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Notificación Flotante -->
        <Border Grid.Row="2" 
                Visibility="{Binding IsAlertVisible, Converter={StaticResource BoolToVis}}" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessAlert}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{Binding AlertMessage}" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           Foreground="White" 
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" 
                        Command="{Binding DismissAlertCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Cursor="Hand" 
                        Content="✕" 
                        Padding="6,2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
