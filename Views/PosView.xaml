<UserControl x:Class="TPVC.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             d:DesignHeight="860" d:DesignWidth="1366"
             Focusable="True">

    <!-- ======================================================================== -->
    <!-- PUNTO DE VENTA: el buscador es el centro (Enter agrega, "3*para" agrega  -->
    <!-- 3), la cuenta debajo y el cobro a la derecha (el mismo de "Terminar      -->
    <!-- consulta"). Catálogo, servicios, ticket, corte e historial son hojas que -->
    <!-- se crean la primera vez que se abren.                                    -->
    <!-- ======================================================================== -->
    <UserControl.Resources>
        <DataTemplate x:Key="CatalogSheet"><views:PosCatalogSheetView /></DataTemplate>
        <DataTemplate x:Key="ServicesSheet"><views:PosServicesSheetView /></DataTemplate>
        <DataTemplate x:Key="CreateServiceSheet"><views:CreateServiceSheetView /></DataTemplate>
        <DataTemplate x:Key="TicketSheet"><views:PosTicketSheetView /></DataTemplate>
        <DataTemplate x:Key="CashCutSheet"><views:PosCashCutSheetView /></DataTemplate>
        <DataTemplate x:Key="HistorySheet"><views:PosSalesHistorySheetView /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================= BARRA SUPERIOR ======================= -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding BackToHubCommand}" Margin="0,0,16,0" ToolTip="Volver al inicio de la aplicación">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                        <TextBlock Text="Inicio" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextHeading}" Text="Punto de venta" />
                    <TextBlock Style="{StaticResource TextCaption}" Text="Venta de mostrador: medicamentos, insumos y servicios" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding OpenTicketHistoryModalCommand}" Margin="0,0,8,0" ToolTip="Buscar, reimprimir o cancelar tickets">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoHistory}" Margin="0,0,8,0" />
                            <TextBlock Text="Tickets" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding OpenCashCutModalCommand}" ToolTip="Corte de caja del día (F6)">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoChart}" Margin="0,0,8,0" />
                            <TextBlock Text="Corte de caja" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= CONSULTA EN CURSO ======================= -->
            <Border Grid.Row="1" Style="{StaticResource NoticeWarning}" Padding="14,8" Margin="0,0,0,14"
                    Visibility="{Binding HasActiveConsultation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <helpers:Icon Data="{StaticResource IcoClock}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ActiveConsultationBannerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Margin="0,0,8,0"
                            Command="{Binding AddToActiveConsultationCommand}"
                            Visibility="{Binding CanAddToActiveConsultation, Converter={StaticResource BoolToVis}}"
                            ToolTip="Pasa lo de esta venta a la cuenta de la consulta: se cobra al terminarla"
                            Content="Pasar a la cuenta de la consulta" />
                    <Button Grid.Column="3" Style="{StaticResource ButtonPrimary}" MinHeight="0" Padding="14,5" Content="Abrir consulta"
                            Command="{Binding OpenActiveConsultationCommand}" ToolTip="Ir a la consulta en curso: ahí se cobra al terminarla" />
                </Grid>
            </Border>

            <!-- ======================= BUSCADOR + CUENTA | COBRO ======================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Buscador -->
                        <Grid Margin="16,16,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource FieldTextBox}"
                                         Height="48" FontSize="16" Padding="42,8,12,8"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                                         helpers:Field.Placeholder="Nombre, genérico o código · 3*para agrega 3 (F1)"
                                         AutomationProperties.Name="Buscar producto" />
                                <helpers:Icon Data="{StaticResource IcoSearch}" Width="20" Height="20" HorizontalAlignment="Left" Margin="14,0,0,0"
                                              Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Height="48" Margin="10,0,0,0" Command="{Binding OpenCatalogModalCommand}" ToolTip="Ver todo el catálogo por categoría (F2)">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoPill}" Margin="0,0,8,0" />
                                    <TextBlock Text="Catálogo" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Height="48" Margin="8,0,0,0" Command="{Binding OpenServicesModalCommand}" ToolTip="Consultas, curaciones, inyecciones… (F3)">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoSyringe}" Margin="0,0,8,0" />
                                    <TextBlock Text="Servicios" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Cuenta (o cómo empezar) -->
                        <Grid Grid.Row="1">
                            <views:CartLinesView DataContext="{Binding Checkout}"
                                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                        Visibility="{Binding HasCartItems, Converter={StaticResource InverseBoolToVis}}">
                                <Border Style="{StaticResource Avatar}" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <helpers:Icon Data="{StaticResource IcoCart}" Width="24" Height="24" />
                                </Border>
                                <TextBlock Style="{StaticResource TextSection}" Text="Escriba para buscar" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource TextDetail}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14"
                                           Text="Enter agrega el primero. Con el lector de código de barras basta escanear." />
                                <Border Style="{StaticResource CardSubtle}" HorizontalAlignment="Center">
                                    <Grid TextElement.FontSize="{StaticResource FontSizeDetail}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="3*para" Margin="0,0,16,4" />
                                        <TextBlock Grid.Column="1" Text="agrega 3 de lo que empiece con «para»" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="↑ ↓  +  −  Supr" Margin="0,0,16,4" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="con el buscador vacío: elige renglón y ajusta" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="F2  F3" Margin="0,0,16,4" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="catálogo · servicios" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="F5" Margin="0,0,16,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="cobrar" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Sugerencias sobre la cuenta mientras se escribe -->
                            <Border Style="{StaticResource Card}" Padding="6" Margin="16,0,16,0" VerticalAlignment="Top" Panel.ZIndex="10"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#0F172A" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="10,6,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter agrega · Esc cierra" />
                                        <Border Grid.Column="1" Style="{StaticResource BadgeInfo}" Visibility="{Binding HasPendingQuantity, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PendingQuantityText}" />
                                        </Border>
                                    </Grid>
                                    <ListBox x:Name="SuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="420"
                                             ItemsSource="{Binding SearchSuggestions}"
                                             SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                             PreviewMouseLeftButtonUp="SuggestionsListBox_PreviewMouseLeftButtonUp"
                                             AutomationProperties.Name="Sugerencias">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Product}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                                    <Binding Path="Code" />
                                                                    <Binding Path="GenericName" />
                                                                    <Binding Path="Presentation" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource StockBadge}" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentStock, StringFormat='Existencias: {0}'}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Margin="10,10,10,8" Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource TextBody}" Text="Nada coincide con lo escrito." />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Pruebe con el nombre genérico o abra el catálogo (F2)." Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pie de la cuenta -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,10"
                                Visibility="{Binding Checkout.HasItems, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                           Text="Con el buscador vacío: ↑ ↓ eligen el renglón, + y − cambian la cantidad, Supr lo quita." />
                                <Button Grid.Column="1" Style="{StaticResource ButtonDangerGhost}" Command="{Binding ClearCartCommand}" ToolTip="Quitar todo (se puede deshacer)">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoTrash}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Vaciar" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Notice}" Margin="16,0,16,14" Padding="12,6"
                                Visibility="{Binding Checkout.CanUndoClear, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Se vació la cuenta." VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" MinHeight="0" Padding="10,4" Content="Deshacer" Command="{Binding UndoClearCartCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Cobro (el mismo componente que "Terminar consulta") -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <views:PaymentPanelView DataContext="{Binding Checkout}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= HOJAS CON FONDO DIFUSO ======================= -->
        <ContentControl Panel.ZIndex="200" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CatalogSheet}"
                        Visibility="{Binding IsCatalogModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Panel.ZIndex="200" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ServicesSheet}"
                        Visibility="{Binding IsServicesModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Panel.ZIndex="200" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HistorySheet}"
                        Visibility="{Binding IsTicketHistoryModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Panel.ZIndex="200" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CashCutSheet}"
                        Visibility="{Binding IsCashCutModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Panel.ZIndex="300" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CreateServiceSheet}"
                        Visibility="{Binding IsCreateServiceModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Panel.ZIndex="400" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource TicketSheet}"
                        Visibility="{Binding IsTicketModalOpen, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
