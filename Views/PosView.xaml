<UserControl x:Class="TPVC.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             PreviewKeyDown="PosView_PreviewKeyDown"
             Focusable="True">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- FILA 0: CABECERA DE PUNTO DE VENTA -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Margin="0,0,0,14"
                Visibility="{Binding IsEmbeddedInModal, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ThemeAccent}" 
                                CornerRadius="8" 
                                Width="32" Height="32" 
                                Margin="0,0,10,0">
                            <Path Data="{StaticResource IconCart}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="16" Height="16" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Punto de Venta / Farmacia" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Dispensación rápida y cobro de medicamentos con cálculo de totales y deducción automática FEFO" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="42,3,0,0" />
                </StackPanel>

                <!-- Botones de Acción Superior -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Historial de Tickets / Reimpresión / Cancelación -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding OpenTicketHistoryModalCommand}" 
                            VerticalAlignment="Center" 
                            Padding="12,8"
                            Margin="0,0,8,0"
                            ToolTip="Consultar ventas pasadas, reimprimir tickets o procesar cancelaciones/devoluciones con reingreso a inventario">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Historial y Devoluciones" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Corte de Caja Diario -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding OpenCashCutModalCommand}" 
                            VerticalAlignment="Center" 
                            Padding="12,8"
                            Margin="0,0,8,0"
                            ToolTip="Ver corte de caja del día, ingresos por método de pago, servicios vs productos y exportación a CSV">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Corte de Caja" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Volver a Inicio -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding BackToHubCommand}" 
                            VerticalAlignment="Center" 
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Volver a Inicio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- FILA 1: BANNER DE CONSULTA ACTIVA Y BARRA DE BÚSQUEDA -->
        <!-- ============================================ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <!-- Banner Informativo de Consulta Médica Activa -->
            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,9" 
                    Margin="0,0,0,10" 
                    Visibility="{Binding HasActiveConsultation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ThemeSuccess}" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" />
                        <TextBlock Text="CONSULTA MÉDICA ACTIVA:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock Text="{Binding ActiveConsultationPatientName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                        <TextBlock Text=" • Folio: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationFolio}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <!-- Cronómetro activo de consulta -->
                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveConsultationElapsedTime}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text=" • Insumos guardados: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationItemsCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Text=" ($" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationTotalAmount, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Text=")" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource AccentButton}" 
                                Command="{Binding OpenActiveConsultationCommand}" 
                                Padding="12,5" 
                                FontSize="11" 
                                ToolTip="Ir a la consulta en curso: ahí se revisa la cuenta y se cobra al terminar">
                            <TextBlock Text="Abrir consulta" FontSize="11" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra de Búsqueda en Tiempo Real con Dropdown y Acciones -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

            <!-- Búsqueda en Tiempo Real (Input + Menú Desplegable) -->
            <Grid Grid.Column="0">
                <!-- Caja de Texto del Buscador -->
                <Border x:Name="SearchBoxBorder"
                        Background="{DynamicResource ThemeCard}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" 
                              Data="{StaticResource IconSearch}" 
                              Fill="{DynamicResource ThemeAccent}" 
                              Width="15" Height="15" 
                              Stretch="Uniform" 
                              Margin="4,0,10,0" 
                              VerticalAlignment="Center" />

                        <TextBox Grid.Column="1" 
                                 x:Name="SearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 FontSize="13" 
                                 VerticalAlignment="Center" 
                                 Foreground="{DynamicResource ThemeText}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmSelectedSuggestionCommand}" />
                                <KeyBinding Key="Esc" Command="{Binding CloseSearchDropdownCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="1" 
                                   Text="Buscar producto por nombre, principio activo o SKU... (F1)" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   VerticalAlignment="Center" 
                                   IsHitTestVisible="False" 
                                   Margin="2,0,0,0"
                                   Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />

                        <!-- Botón para Limpiar / Cerrar Dropdown -->
                        <Button Grid.Column="2" 
                                Command="{Binding CloseSearchDropdownCommand}" 
                                Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="4" 
                                Foreground="{DynamicResource ThemeTextSecondary}">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Menú Desplegable en Tiempo Real (Dropdown Overlay) -->
                <Border Panel.ZIndex="100" 
                        VerticalAlignment="Top" 
                        Margin="0,46,0,0" 
                        Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeAccent}" 
                        BorderThickness="1.5" 
                        CornerRadius="10" 
                        MaxHeight="360" 
                        Visibility="{Binding IsSearchDropdownOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera del Dropdown -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource ThemeSurfaceSubtle}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="0,0,0,1" 
                                Padding="12,6" 
                                CornerRadius="9,9,0,0">
                            <Grid>
                                <TextBlock Text="Resultados de búsqueda (use ↑ / ↓ para navegar, Enter para agregar):" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           VerticalAlignment="Center" />
                                <Button Command="{Binding CloseSearchDropdownCommand}" 
                                        HorizontalAlignment="Right" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Lista Desplegable de Resultados con Soporte para Navegación por Teclado -->
                        <ListBox Grid.Row="1" 
                                 x:Name="SuggestionsListBox"
                                 ItemsSource="{Binding SearchSuggestions}"
                                 SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="0" 
                                 MaxHeight="300"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource ThemeBorder}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="12,8"
                                                        Cursor="Hand">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="4,0,0,1" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                            <Condition Property="IsSelected" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Nombre y Principio Activo -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text=" ❄️" 
                                                           Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding GenericName, StringFormat='{}Genérico: {0}'}" 
                                                       FontSize="11" 
                                                       FontStyle="Italic" 
                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                       Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Stock Disponible Badge -->
                                        <Border Grid.Column="1" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                Margin="12,0,12,0" 
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLowStock}" Value="True" />
                                                                <Condition Binding="{Binding IsOutOfStock}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource ThemeWarning}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding CurrentStock, StringFormat='Stock: {0}'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                <Setter Property="Text" Value="Agotado" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Precio Unitario -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Price, StringFormat='${0:N2}'}" 
                                                   FontWeight="Bold" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource ThemeAccent}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,14,0" />

                                        <!-- Botón Agregar Directo -->
                                        <Button Grid.Column="3" 
                                                Style="{DynamicResource AccentButton}" 
                                                Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Padding="10,5" 
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding HasStock}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0" />
                                                <TextBlock Text="Agregar" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

            </Grid>

            <!-- Botón Buscar en Catálogo (Abre Ventana Modal de Exploración) -->
            <Button Grid.Column="2" 
                    Style="{DynamicResource AccentButton}" 
                    Command="{Binding OpenCatalogModalCommand}" 
                    Padding="16,8" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBox}" 
                          Fill="{DynamicResource ThemeAccentText}" 
                          Width="13" Height="13" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0" />
                    <TextBlock Text="Buscar en Catálogo (F2)" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Botón Catálogo de Servicios e Insumos (Botón Aparte) -->
            <Button Grid.Column="4" 
                    Style="{DynamicResource AccentButton}" 
                    Command="{Binding OpenServicesModalCommand}" 
                    Padding="16,8" 
                    VerticalAlignment="Center"
                    ToolTip="Abrir catálogo de servicios médicos, honorarios y paquetes de insumos">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconFileMedical}" 
                          Fill="{DynamicResource ThemeAccentText}" 
                          Width="14" Height="14" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0" />
                    <TextBlock Text="Servicios e Insumos" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Botones Vaciar Venta y Deshacer -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource OutlineButton}" 
                        Command="{Binding UndoClearCartCommand}" 
                        Visibility="{Binding CanUndoClearCart, Converter={StaticResource BoolToVis}}"
                        Padding="12,8" 
                        Margin="0,0,8,0"
                        ToolTip="Restaurar los productos eliminados de la venta">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↩️" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Deshacer" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource OutlineButton}" 
                        Command="{Binding ClearCartCommand}" 
                        Padding="14,8" 
                        VerticalAlignment="Center"
                        ToolTip="Vaciar todos los artículos de la venta actual">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTrash}" 
                              Fill="{DynamicResource ThemeError}" 
                              Width="12" Height="12" 
                              Stretch="Uniform" 
                              Margin="0,0,6,0" />
                        <TextBlock Text="Vaciar Venta" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </StackPanel>

        <!-- ============================================ -->
        <!-- FILA 2: ÁREA PRINCIPAL - TABLA DE PRODUCTOS AGREGADOS A LA VENTA -->
        <!-- ============================================ -->
        <Border Grid.Row="2" 
                Background="{DynamicResource ThemeCard}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="16">
            <Grid>
                <!-- ESTADO VACÍO: Cuando no hay productos agregados -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                            CornerRadius="40" 
                            Width="80" Height="80" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,16">
                        <Path Data="{StaticResource IconCart}" 
                              Fill="{DynamicResource ThemeBorder}" 
                              Width="38" Height="38" 
                              Stretch="Uniform" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="La venta actual está vacía" 
                               FontWeight="Bold" 
                               FontSize="18" 
                               Foreground="{DynamicResource ThemeText}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Escriba en la barra superior para buscar en tiempo real o abra el catálogo para agregar medicamentos e insumos." 
                               FontSize="13" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               MaxWidth="480" 
                               Margin="0,6,0,20" />
                    <Button Style="{DynamicResource AccentButton}" 
                            Command="{Binding OpenCatalogModalCommand}" 
                            HorizontalAlignment="Center" 
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBox}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="13" Height="13" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Explorar Catálogo Completo" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- TABLA DE ARTÍCULOS EN LA VENTA (CARRITO) -->
                <Grid Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Tabla -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,0,0,1" 
                            CornerRadius="8" 
                            Padding="14,10" 
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="PRODUCTO / MEDICAMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Grid.Column="1" Text="CÓDIGO / SKU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Grid.Column="2" Text="DISPONIBLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Grid.Column="3" Text="PRECIO UNIT." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Grid.Column="4" Text="CANTIDAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="SUBTOTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="" />
                        </Grid>
                    </Border>

                    <!-- Lista con Scroll de Renglones de la Venta -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14,10" 
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 0: Nombre, Genérico y Presentación -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="14" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text=" ❄️" 
                                                               Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}" 
                                                               ToolTip="Requiere cadena de frío" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding GenericName}" 
                                                               FontSize="11" 
                                                               FontStyle="Italic" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text=" • " 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Presentation}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 1: SKU / Código -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Code}" 
                                                       FontSize="12" 
                                                       FontFamily="Consolas" 
                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                       VerticalAlignment="Center" />

                                            <!-- 2: Stock Disponible / Tipo -->
                                            <TextBlock Grid.Column="2" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding AvailableStock, StringFormat='{}{0} disp.'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsService}" Value="True">
                                                                <Setter Property="Text" Value="🩺 Servicio" />
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 3: Precio Unitario -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding UnitPrice, StringFormat='${0:N2}'}" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource ThemeText}" 
                                                       VerticalAlignment="Center" />

                                            <!-- 4: Controles de Cantidad [-] [Qty] [+] -->
                                            <Border Grid.Column="4" 
                                                    Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="4,2" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Width="28" Height="26" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Cursor="Hand" 
                                                            Content="−" 
                                                            FontWeight="Bold" 
                                                            FontSize="14" 
                                                            Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding Quantity}" 
                                                               FontWeight="Bold" 
                                                               FontSize="13" 
                                                               VerticalAlignment="Center" 
                                                               HorizontalAlignment="Center" 
                                                               MinWidth="32" 
                                                               TextAlignment="Center" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <Button Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Width="28" Height="26" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Cursor="Hand" 
                                                            Content="+" 
                                                            FontWeight="Bold" 
                                                            FontSize="14" 
                                                            Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 5: Subtotal -->
                                            <TextBlock Grid.Column="5" 
                                                       Text="{Binding Subtotal, StringFormat='${0:N2}'}" 
                                                       FontWeight="Bold" 
                                                       FontSize="15" 
                                                       Foreground="{DynamicResource ThemeAccent}" 
                                                       HorizontalAlignment="Right" 
                                                       VerticalAlignment="Center" />

                                            <!-- 6: Botón Eliminar -->
                                            <Button Grid.Column="6" 
                                                    Style="{DynamicResource OutlineButton}" 
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,6" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center" 
                                                    ToolTip="Quitar de la venta">
                                                <Path Data="{StaticResource IconTrash}" 
                                                      Fill="{DynamicResource ThemeError}" 
                                                      Width="12" Height="12" 
                                                      Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- FILA 3: BARRA INFERIOR CON DATOS Y BOTÓN DE COBRAR EN LA ESQUINA DERECHA -->
        <!-- ============================================ -->
        <Border Grid.Row="3" 
                Background="{DynamicResource ThemeCard}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="18,14" 
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Panel Izquierdo: Paciente, Forma de Pago y Contador -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Paciente / Cliente -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Paciente / Cliente:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource ModernTextBox}" 
                                 Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="210" 
                                 FontSize="12" />
                    </StackPanel>

                    <!-- Método de Pago -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Método de Pago:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,4" />
                        <ComboBox Style="{DynamicResource ModernComboBox}" 
                                  ItemsSource="{Binding PaymentMethods}" 
                                  SelectedItem="{Binding SelectedPaymentMethod}" 
                                  Width="160" 
                                  FontSize="12" />
                    </StackPanel>

                    <!-- Efectivo Recibido y Cambio Calculado (Solo si Efectivo) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                Visibility="{Binding SelectedPaymentMethod, Converter={StaticResource ComparisonToVis}, ConverterParameter=Efectivo}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Efectivo Recibido:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{DynamicResource ModernTextBox}"
                                     Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="105" 
                                     Padding="8,5"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeSuccess}" 
                                CornerRadius="6" 
                                Padding="10,6" 
                                VerticalAlignment="Bottom"
                                Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Cambio: " FontSize="11" Foreground="White" />
                                <TextBlock Text="{Binding ChangeDue, StringFormat='${0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Contador de Artículos en Venta -->
                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8" 
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Artículos: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Text="{Binding TotalCartItems}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Panel Derecho: TOTAL A PAGAR Y BOTÓN DE COBRAR (Esquina Inferior Derecha) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Resumen del Total -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="TOTAL A PAGAR" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalCartAmount, StringFormat='${0:N2}'}" 
                                   FontWeight="Bold" 
                                   FontSize="28" 
                                   Foreground="{DynamicResource ThemeAccent}" 
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Botón Agregar a Consulta Activa (Modo Estándar) -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding AddToActiveConsultationCommand}" 
                            Padding="18,14" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            VerticalAlignment="Center" 
                            Margin="0,0,12,0" 
                            Visibility="{Binding IsEmbeddedInModal, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                            ToolTip="Guarda los insumos de esta venta en la consulta activa del paciente para liquidarse al terminar">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFileMedical}" 
                                  Fill="{DynamicResource ThemeAccent}" 
                                  Width="15" Height="15" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Agregar a Consulta Activa" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Agregar a Consulta Activa (Modo Modal Embebido) -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding AddToActiveConsultationCommand}" 
                            Padding="16,14" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            VerticalAlignment="Center" 
                            Margin="0,0,12,0" 
                            Visibility="{Binding IsEmbeddedInModal, Converter={StaticResource BoolToVis}}"
                            ToolTip="Guarda los insumos y servicios de esta venta en la consulta activa del paciente sin cobrar aún">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFileMedical}" 
                                  Fill="{DynamicResource ThemeAccent}" 
                                  Width="15" Height="15" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Guardar en Consulta" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Destacado de Cobro en la Esquina Inferior Derecha (Siempre disponible) -->
                    <Button Style="{DynamicResource AccentButton}" 
                            Command="{Binding ProcessSaleCommand}" 
                            Padding="24,14" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            VerticalAlignment="Center" 
                            ToolTip="Cobrar los medicamentos, insumos y consultas cargadas en el ticket">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCheck}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="16" Height="16" 
                                  Stretch="Uniform" 
                                  Margin="0,0,10,0" />
                            <TextBlock Text="Cobrar y Despachar Venta (F5)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- FILA 4: BARRA DE NOTIFICACIÓN FLOTANTE (ALERTA) -->
        <!-- ============================================ -->
        <Border Grid.Row="4" 
                Visibility="{Binding IsAlertVisible, Converter={StaticResource BoolToVis}}" 
                CornerRadius="8" 
                Padding="14,9" 
                Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessAlert}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{Binding AlertMessage}" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           Foreground="White" 
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" 
                        Command="{Binding DismissAlertCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Cursor="Hand" 
                        Content="✕" 
                        Padding="6,2" />
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MODAL / VENTANA DE CATÁLOGO GENERAL DE PRODUCTOS -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#AA000000" 
                Visibility="{Binding IsCatalogModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="200">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="960" 
                    MaxHeight="680" 
                    MinHeight="500" 
                    Margin="24" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Ventana Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconBox}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Catálogo Completo de Productos e Insumos" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Explore todos los insumos disponibles y presione '+ Agregar' para incorporarlos a la venta actual." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,2,0,0" />
                        </StackPanel>

                        <!-- Botón Cerrar Ventana -->
                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCatalogModalCommand}" 
                                Padding="10,6" 
                                VerticalAlignment="Center">
                            <TextBlock Text="✕ Cerrar" FontWeight="Bold" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Filtros de Búsqueda y Categoría dentro de la Ventana Modal -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Buscador dentro del Modal -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" 
                                      Data="{StaticResource IconSearch}" 
                                      Fill="{DynamicResource ThemeTextSecondary}" 
                                      Width="13" Height="13" 
                                      Stretch="Uniform" 
                                      Margin="4,0,8,0" 
                                      VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" 
                                         x:Name="CatalogSearchTextBox"
                                         Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         VerticalAlignment="Center" 
                                         Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Grid.Column="1" 
                                           Text="Filtrar por nombre, principio activo o código..." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False" 
                                           Margin="4,0,0,0"
                                           Visibility="{Binding CatalogSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                            </Grid>
                        </Border>

                        <!-- Selector de Categoría dentro del Modal -->
                        <ComboBox Grid.Column="2" 
                                  Style="{DynamicResource ModernComboBox}" 
                                  ItemsSource="{Binding Categories}" 
                                  DisplayMemberPath="Name" 
                                  SelectedItem="{Binding CatalogSelectedCategory}" />
                    </Grid>

                    <!-- Lista de Productos en Tarjetas (Catálogo Completo) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CatalogFilteredProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Margin="0,0,0,8" 
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Información del Producto -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="14" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text=" ❄️" 
                                                               Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}" 
                                                               ToolTip="Requiere cadena de frío" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                    <TextBlock Text="{Binding GenericName}" 
                                                               FontSize="12" 
                                                               FontStyle="Italic" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text=" • " 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Presentation}" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>

                                                <!-- Stock y Ubicación -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsLowStock}" Value="True" />
                                                                            <Condition Binding="{Binding IsOutOfStock}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeWarning}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding CurrentStock, StringFormat='Stock: {0}'}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                            <Setter Property="Text" Value="Agotado" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock Text="{Binding Location, StringFormat='Ubicación: {0}'}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               VerticalAlignment="Center" 
                                                               Visibility="{Binding Location, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Precio y Botón Agregar -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}" 
                                                           FontWeight="Bold" 
                                                           FontSize="16" 
                                                           Foreground="{DynamicResource ThemeAccent}" 
                                                           HorizontalAlignment="Right" 
                                                           Margin="0,0,0,6" />

                                                <Button Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Padding="14,6" 
                                                        IsEnabled="{Binding HasStock}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlus}" 
                                                              Fill="{DynamicResource ThemeAccentText}" 
                                                              Width="11" Height="11" 
                                                              Stretch="Uniform" 
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="+ Agregar" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pie de la Ventana Modal -->
                    <Border Grid.Row="3" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,1,0,0" 
                            Padding="0,14,0,0" 
                            Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="En la venta actual: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Text="{Binding TotalCartItems, StringFormat='{}{0} productos'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Text="  •  Total acumulado: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Text="{Binding TotalCartAmount, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right" 
                                    Style="{DynamicResource AccentButton}" 
                                    Command="{Binding CloseCatalogModalCommand}" 
                                    Padding="20,8">
                                <TextBlock Text="Listo / Ver Venta" FontWeight="SemiBold" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: CATÁLOGO DE SERVICIOS CLÍNICOS E INSUMOS MÉDICOS                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#AA000000" 
                Visibility="{Binding IsServicesModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="210">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="1060" 
                    MaxHeight="720" 
                    MinHeight="540" 
                    Margin="24" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Ventana Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconFileMedical}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Catálogo de Servicios Clínicos e Insumos Médicos" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Seleccione un procedimiento médico para agregarlo a la venta o consulta activa junto con sus insumos predeterminados." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,2,0,0" />
                        </StackPanel>

                        <!-- Botones Cabecera -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding OpenCreateServiceModalCommand}" 
                                    Margin="0,0,10,0" 
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource ThemeAccentText}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Crear Servicio" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseServicesModalCommand}" 
                                    Padding="10,6">
                                <TextBlock Text="✕ Cerrar" FontWeight="Bold" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filtros de Búsqueda y Categorías -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <!-- Buscador de Servicios -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" 
                                      Data="{StaticResource IconSearch}" 
                                      Fill="{DynamicResource ThemeTextSecondary}" 
                                      Width="13" Height="13" 
                                      Stretch="Uniform" 
                                      Margin="4,0,8,0" 
                                      VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" 
                                         x:Name="ServiceSearchTextBox"
                                         Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         VerticalAlignment="Center" 
                                         Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Grid.Column="1" 
                                           Text="Buscar servicio por nombre, código o categoría (ej. Consulta, Curación, Sutura)..." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False" 
                                           Margin="4,0,0,0"
                                           Visibility="{Binding ServiceSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                            </Grid>
                        </Border>

                        <!-- Selector de Categoría dentro del Modal -->
                        <ComboBox Grid.Column="2" 
                                  Style="{DynamicResource ModernComboBox}" 
                                  ItemsSource="{Binding ServiceCategories}" 
                                  SelectedItem="{Binding ServiceCategoryFilter, Mode=TwoWay}" />
                    </Grid>

                    <!-- Contenido Central: Maestro (Servicios) y Detalle (Insumos + Carga) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Lista de Servicios Disponibles (Izquierda) -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding FilteredServices}" 
                                         SelectedItem="{Binding SelectedService, Mode=TwoWay}" 
                                         Background="Transparent" 
                                         BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="itemBorder" 
                                                                Background="{DynamicResource ThemeCard}" 
                                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="8" 
                                                                Padding="12,10" 
                                                                Cursor="Hand">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Code}" 
                                                               FontSize="11" 
                                                               FontWeight="Bold" 
                                                               Foreground="{DynamicResource ThemeAccent}" />
                                                    <Border Grid.Column="1" 
                                                            Background="{DynamicResource ThemeBorder}" 
                                                            CornerRadius="4" 
                                                            Padding="6,1">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Bold" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource ThemeText}" 
                                                           TextWrapping="Wrap" 
                                                           Margin="0,0,0,4" />

                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="12" 
                                                                   Foreground="{DynamicResource ThemeSuccess}" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding EstimatedDurationMinutes, StringFormat='{}{0} min'}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1" 
                                                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                            BorderBrush="{DynamicResource ThemeAccent}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="4" 
                                                            Padding="5,1">
                                                        <TextBlock Text="{Binding DefaultProducts.Count, StringFormat='📦 {0} insumos'}" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <!-- Detalle del Servicio Seleccionado e Insumos Vinculados (Derecha) -->
                        <Border Grid.Column="2" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="16">
                            <Grid>
                                <!-- Vista cuando no hay servicio seleccionado -->
                                <StackPanel VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" 
                                            Visibility="{Binding SelectedService, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                    <Path Data="{StaticResource IconFileMedical}" 
                                          Fill="{DynamicResource ThemeBorder}" 
                                          Width="44" Height="44" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,0,0,12" />
                                    <TextBlock Text="Seleccione un Servicio Clínico" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Haga clic en un servicio de la lista izquierda para consultar sus detalles y paquete de insumos asociados." 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Detalle del Servicio Seleccionado -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              Visibility="{Binding SelectedService, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <!-- Tarjeta de Encabezado de Servicio -->
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="16" 
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="{DynamicResource ThemeAccent}" 
                                                                CornerRadius="4" 
                                                                Padding="6,2" 
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding SelectedService.Code}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource ThemeAccentText}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource ThemeBorder}" 
                                                                CornerRadius="4" 
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding SelectedService.Category}" 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding SelectedService.Name}" 
                                                               FontWeight="Bold" 
                                                               FontSize="18" 
                                                               Foreground="{DynamicResource ThemeText}" 
                                                               Margin="0,2,0,6" />

                                                    <TextBlock Text="{Binding SelectedService.Description}" 
                                                               FontSize="12" 
                                                               LineHeight="18" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Precio y Tiempo -->
                                                <Border Grid.Column="1" 
                                                        Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="8" 
                                                        Padding="16,10" 
                                                        Margin="14,0,0,0" 
                                                        VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Honorario" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding SelectedService.Price, StringFormat='${0:N2}'}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="20" 
                                                                   Foreground="{DynamicResource ThemeSuccess}" 
                                                                   HorizontalAlignment="Center" 
                                                                   Margin="0,2,0,2" />
                                                        <TextBlock Text="{Binding SelectedService.EstimatedDurationMinutes, StringFormat='⏱ {0} minutos'}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Insumos y Medicamentos Incluidos por Defecto -->
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="16" 
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="📦 Insumos y Medicamentos por Defecto del Servicio" 
                                                           FontWeight="Bold" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource ThemeText}" 
                                                           Margin="0,0,0,4" />
                                                <TextBlock Text="Estos insumos se descontarán automáticamente del inventario (regla FEFO) al efectuarse este servicio:" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                                           Margin="0,0,0,12" />

                                                <!-- Aviso cuando no hay insumos vinculados -->
                                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                        CornerRadius="6" 
                                                        Padding="12,10" 
                                                        Visibility="{Binding SelectedService.DefaultProducts.Count, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="Este servicio clínico no tiene insumos o medicamentos por defecto configurados. Solo se cobrará el honorario." 
                                                               FontStyle="Italic" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </Border>

                                                <!-- Lista de Insumos -->
                                                <ItemsControl ItemsSource="{Binding SelectedService.DefaultProducts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource ThemeSurface}" 
                                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="12,8" 
                                                                    Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Product.Name}" 
                                                                                   FontWeight="SemiBold" 
                                                                                   FontSize="12" 
                                                                                   Foreground="{DynamicResource ThemeText}" />
                                                                        <TextBlock Text="{Binding Instructions, StringFormat='Indicación: {0}'}" 
                                                                                   FontSize="11" 
                                                                                   FontStyle="Italic" 
                                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                                   Visibility="{Binding Instructions, Converter={StaticResource BoolToVis}}" 
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>

                                                                    <Border Grid.Column="1" 
                                                                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                            BorderBrush="{DynamicResource ThemeAccent}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="4" 
                                                                            Padding="8,3" 
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0} piezas'}" 
                                                                                   FontWeight="Bold" 
                                                                                   FontSize="11" 
                                                                                   Foreground="{DynamicResource ThemeAccent}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Botones de Acción para Cargar el Servicio -->
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="14">
                                            <WrapPanel HorizontalAlignment="Right">
                                                <!-- Cargar solo honorario -->
                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding AddServiceOnlyToCartCommand}" 
                                                        CommandParameter="{Binding SelectedService}" 
                                                        Margin="0,0,8,0" 
                                                        Padding="14,8" 
                                                        ToolTip="Carga al ticket únicamente la tarifa del servicio sin los insumos asociados">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFileMedical}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource ThemeText}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Cargar Solo Honorario" FontSize="12" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Cargar a Consulta Activa -->
                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding AddServiceToActiveConsultationCommand}" 
                                                        CommandParameter="{Binding SelectedService}" 
                                                        Margin="0,0,8,0" 
                                                        Padding="14,8" 
                                                        ToolTip="Guarda el servicio y sus insumos en la consulta médica activa sin cobrar de inmediato">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🩺" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Cargar a Consulta Activa" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Cargar Servicio e Insumos al Ticket -->
                                                <Button Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding AddServiceToCartCommand}" 
                                                        CommandParameter="{Binding SelectedService}" 
                                                        Padding="16,8" 
                                                        ToolTip="Agrega el servicio y sus insumos predeterminados al ticket de venta actual">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCart}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource ThemeAccentText}" Margin="0,0,8,0" />
                                                        <TextBlock Text="Cargar a Venta (Servicio + Insumos)" FontSize="12" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Pie de la Ventana Modal -->
                    <Border Grid.Row="3" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,1,0,0" 
                            Padding="0,14,0,0" 
                            Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="En la venta actual: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Text="{Binding TotalCartItems, StringFormat='{}{0} renglones'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Text="  •  Total acumulado: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Text="{Binding TotalCartAmount, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right" 
                                    Style="{DynamicResource AccentButton}" 
                                    Command="{Binding CloseServicesModalCommand}" 
                                    Padding="20,8">
                                <TextBlock Text="Listo / Ver Venta" FontWeight="SemiBold" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: CREAR NUEVO SERVICIO CLÍNICO CON INSUMOS POR DEFECTO (POS)         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#CC000000" 
                Visibility="{Binding IsCreateServiceModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="220">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="720" 
                    MaxHeight="650" 
                    Margin="24" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Background="{DynamicResource ThemeAccent}" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="🩺 NUEVO SERVICIO" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeAccentText}" />
                            </Border>
                            <TextBlock Text="Crear Servicio Clínico y Asignar Insumos" 
                                       FontWeight="Bold" 
                                       FontSize="17" 
                                       Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                        <TextBlock Text="Ingresa los datos generales del servicio médico e incluye los productos e insumos de inventario que se consumirán por defecto." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </StackPanel>

                    <!-- Formulario con Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Código y Nombre -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Código / Folio *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceCode, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nombre del Servicio Clínico *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Categoría, Precio y Duración -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Categoría" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox Style="{DynamicResource ModernComboBox}"
                                              ItemsSource="{Binding ServiceCategories}" 
                                              SelectedItem="{Binding NewServiceCategory}" 
                                              Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Precio ($ MXN)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServicePrice, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Duración (min)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceDuration, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Descripción -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Descripción y Alcance Clínico" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewServiceDescription, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Height="60" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Padding="10,6" />
                            </StackPanel>

                            <!-- Sección: Asociar Insumos por Defecto -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14" 
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📦 Paquete de Insumos Predeterminados para este Servicio" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource ThemeText}" 
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Selecciona insumos del inventario que se añadirán a este servicio:" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               Margin="0,0,0,10" />

                                    <!-- Selector para agregar nuevo insumo al servicio -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Producto -->
                                        <ComboBox Grid.Column="0" 
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding AvailableProductsForService}" 
                                                  SelectedItem="{Binding SelectedProductForService}" 
                                                  DisplayMemberPath="Name" 
                                                  Height="36" />

                                        <!-- Cantidad -->
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 HorizontalContentAlignment="Center" 
                                                 Padding="6,6" 
                                                 ToolTip="Cantidad de unidades requeridas" />

                                        <!-- Indicación -->
                                        <TextBox Grid.Column="4" 
                                                 Text="{Binding NewProductInstructions, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="8,6" 
                                                 ToolTip="Instrucciones clínicas o nota (opcional)" />

                                        <!-- Botón Agregar Insumo -->
                                        <Button Grid.Column="6" 
                                                Style="{DynamicResource AccentButton}" 
                                                Command="{Binding AddProductToNewServiceCommand}" 
                                                Padding="12,6">
                                            <TextBlock Text="+ Agregar" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>

                                    <!-- Lista de insumos vinculados al nuevo servicio -->
                                    <ItemsControl ItemsSource="{Binding NewServiceDefaultProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="10,6" 
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                            <TextBlock Text="{Binding Instructions}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ThemeTextSecondary}" Visibility="{Binding Instructions, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1" 
                                                                Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                CornerRadius="4" 
                                                                Padding="6,2" 
                                                                Margin="8,0,8,0" 
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0} pza(s)'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                                        </Border>

                                                        <Button Grid.Column="2" 
                                                                Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.RemoveProductFromNewServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="6,2" 
                                                                ToolTip="Quitar de este servicio">
                                                            <TextBlock Text="✕" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeError}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Aviso cuando no hay nada agregado aún -->
                                    <TextBlock Text="No has agregado ningún insumo a este servicio aún." 
                                               FontStyle="Italic" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0" 
                                               Visibility="{Binding NewServiceDefaultProducts.Count, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones de Acción del Modal -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCreateServiceModalCommand}" 
                                Margin="0,0,10,0" 
                                Padding="16,8">
                            <TextBlock Text="Cancelar" FontSize="13" />
                        </Button>

                        <Button Style="{DynamicResource AccentButton}" 
                                Command="{Binding SaveNewServiceAsyncCommand}" 
                                Padding="20,8">
                            <TextBlock Text="Guardar Servicio" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL / VISTA SIMULADORA DE TICKET DE COMPRA (DESPACHO DE VENTA)          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#B3000000" 
                Visibility="{Binding IsTicketModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF" 
                    BorderBrush="#94A3B8" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="460" 
                    MaxHeight="720" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra Superior del Ticket -->
                    <Border Grid.Row="0" 
                            Background="#0F172A" 
                            CornerRadius="12,12,0,0" 
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="✓ VENTA DESPACHADA" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                                <TextBlock Text="Comprobante de Pago / Ticket" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Command="{Binding CloseTicketModalCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Foreground="#94A3B8" 
                                    FontSize="14" 
                                    FontWeight="Bold" 
                                    Cursor="Hand"
                                    Padding="4"
                                    ToolTip="Cerrar ticket">
                                <TextBlock Text="✕" Foreground="#E2E8F0" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Cuerpo del Ticket Térmico Simulado (Con Scroll si hay muchos productos) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0" Padding="26,18,26,14">
                        <StackPanel TextElement.FontFamily="Consolas, Segoe UI, sans-serif">
                            <!-- Logotipo y Nombre del Consultorio -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="🩺" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ClinicProfileName}" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Foreground="#0F172A" 
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Atención Médica Integral &amp; Farmacia" 
                                           FontSize="11" 
                                           FontStyle="Italic" 
                                           Foreground="#475569" 
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ClinicAddressAndPhone}" 
                                           FontSize="10" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" 
                                           Visibility="{Binding ClinicAddressAndPhone, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding DoctorNameWithTitle}" 
                                           FontSize="10.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="#334155" 
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DoctorSpecialtyAndLicense}" 
                                           FontSize="10" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Línea de Guiones de Corte Térmico -->
                            <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" 
                                       FontSize="11" 
                                       Foreground="#94A3B8" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8" />

                            <!-- Metadatos de la Venta (Folio, Fecha, Paciente, etc.) -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="FOLIO:" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,8,3" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentReceipt.Folio}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="FECHA:" FontSize="10" Foreground="#475569" Margin="0,0,8,3" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentReceipt.Date, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" FontSize="10" Foreground="#475569" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="PACIENTE:" FontSize="10" Foreground="#475569" Margin="0,0,8,3" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentReceipt.PatientName}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="MÉTODO PAGO:" FontSize="10" Foreground="#475569" Margin="0,0,8,3" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentReceipt.PaymentMethod}" FontSize="10" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ATENDIÓ:" FontSize="10" Foreground="#475569" Margin="0,0,8,3" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentReceipt.Cashier}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Línea Divisoria -->
                            <TextBlock Text="=============================================================" 
                                       FontSize="10" 
                                       Foreground="#94A3B8" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,4,0,6" />

                            <!-- Cabecera de Columnas del Ticket -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CANT" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                                <TextBlock Grid.Column="2" Text="P.UNIT" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" 
                                       FontSize="10" 
                                       Foreground="#CBD5E1" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,6" />

                            <!-- Lista de Partidas Cobradas en el Ticket -->
                            <ItemsControl ItemsSource="{Binding CurrentReceipt.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Cantidad -->
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Quantity, StringFormat='{}{0}x'}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold" 
                                                           Foreground="#0F172A" 
                                                           VerticalAlignment="Top" />

                                                <!-- Nombre y Genérico -->
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="11" 
                                                               FontWeight="Bold" 
                                                               Foreground="#0F172A" 
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding GenericName}" 
                                                               FontSize="9.5" 
                                                               FontStyle="Italic" 
                                                               Foreground="#64748B" 
                                                               TextWrapping="Wrap" 
                                                               Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Precio Unitario -->
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding UnitPrice, StringFormat='${0:N2}'}" 
                                                           FontSize="10.5" 
                                                           Foreground="#475569" 
                                                           HorizontalAlignment="Right" 
                                                           VerticalAlignment="Top" />

                                                <!-- Subtotal -->
                                                <TextBlock Grid.Column="3" 
                                                           Text="{Binding Subtotal, StringFormat='${0:N2}'}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold" 
                                                           Foreground="#0F172A" 
                                                           HorizontalAlignment="Right" 
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Línea de Totales -->
                            <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" 
                                       FontSize="10" 
                                       Foreground="#94A3B8" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,4,0,8" />

                            <!-- Desglose de Totales -->
                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total de Artículos:" FontSize="10.5" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.TotalItems, StringFormat='{}{0} pieza(s)'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>

                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Subtotal Farmacia:" FontSize="10.5" Foreground="#475569" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.TotalAmount, StringFormat='${0:N2}'}" FontSize="10.5" Foreground="#475569" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="IVA (Tasa 0% Medicamentos):" FontSize="10" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="$0.00" FontSize="10" Foreground="#64748B" />
                                </Grid>

                                <!-- TOTAL GENERAL COBRADO DESTACADO -->
                                <Border Background="#F1F5F9" BorderBrush="#0F172A" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TOTAL COBRADO:" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentReceipt.TotalAmount, StringFormat='${0:N2} MXN'}" FontWeight="Bold" FontSize="17" Foreground="#0284C7" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Línea de Cierre -->
                            <TextBlock Text="=============================================================" 
                                       FontSize="10" 
                                       Foreground="#94A3B8" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10" />

                            <!-- Pie del Ticket -->
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="*** ¡GRACIAS POR SU PREFERENCIA! ***" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="#0F172A" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,3" />
                                <TextBlock Text="Conserve este comprobante para cualquier aclaración." 
                                           FontSize="9.5" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Medicamentos despachados bajo estricto control sanitario FEFO." 
                                           FontSize="9" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,1,0,8" />

                                <!-- Código de Barras Simulado -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="|||||| | |||||||||| | ||||| | |||||||| | ||||||" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="#1E293B" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentReceipt.Folio, StringFormat='* {0} *'}" 
                                           FontSize="9" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Barra Inferior de Acciones del Ticket -->
                    <Border Grid.Row="2" 
                            Background="#F8FAFC" 
                            BorderBrush="#E2E8F0" 
                            BorderThickness="0,1,0,0" 
                            CornerRadius="0,0,12,12" 
                            Padding="18,12">
                        <StackPanel>
                            <!-- Aviso si se envió a imprimir -->
                            <Border Background="#ECFDF5" 
                                    BorderBrush="#10B981" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,6" 
                                    Margin="0,0,0,10" 
                                    Visibility="{Binding TicketStatusMessage, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✓ " FontWeight="Bold" Foreground="#059669" />
                                    <TextBlock Text="{Binding TicketStatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#059669" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Botón Imprimir Ticket -->
                                <Button Grid.Column="0" 
                                        Style="{DynamicResource OutlineButton}" 
                                        Command="{Binding PrintTicketCommand}" 
                                        Padding="14,9" 
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🖨️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Imprimir Ticket" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Botón Nueva Venta / Cerrar Ticket -->
                                <Button Grid.Column="2" 
                                        Style="{DynamicResource AccentButton}" 
                                        Command="{Binding CloseTicketModalCommand}" 
                                        Padding="14,9" 
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✓" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Nueva Venta / Cerrar" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
        <!-- ============================================ -->
        <!-- MODAL DE SELECCIÓN DE PACIENTE PARA INICIAR CONSULTA ACTIVA -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Grid.RowSpan="5" 
                Background="#AA000000" 
                Visibility="{Binding IsSelectPatientModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="560" 
                    Margin="24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconFileMedical}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Iniciar Consulta Médica Activa" 
                                           FontSize="17" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="No hay ninguna consulta activa en curso. Seleccione el paciente para iniciarla y guardar estos insumos:" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       TextWrapping="Wrap"
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseSelectPatientModalCommand}" 
                                Padding="8,4" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Formulario de Selección -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,18">
                        <!-- Selector de Paciente -->
                        <TextBlock Text="Paciente para la consulta:" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,6" />
                        <ComboBox Style="{DynamicResource ModernComboBox}" 
                                  ItemsSource="{Binding AvailablePatientsForConsultation}" 
                                  SelectedItem="{Binding SelectedPatientForConsultation}" 
                                  Margin="0,0,0,14" 
                                  Height="40">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Text=" • " Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding RecordNumber}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text=" (" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding AgeDisplay}" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text=")" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Motivo / Tipo de Consulta -->
                        <TextBlock Text="Motivo o Diagnóstico preliminar de la consulta:" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,6" />
                        <TextBox Style="{DynamicResource ModernTextBox}" 
                                 Text="{Binding NewConsultationChiefComplaint, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" 
                                 Margin="0,0,0,14" />

                        <!-- Nota explicativa -->
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Text="Los insumos y medicamentos del carrito no se cobrarán de inmediato: quedarán guardados en la consulta médica para su posterior liquidación." 
                                           FontSize="11.5" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botones de Acción -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseSelectPatientModalCommand}" 
                                Padding="14,10" 
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="2" 
                                Style="{DynamicResource AccentButton}" 
                                Command="{Binding ConfirmStartConsultationAndAddItemsCommand}" 
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" 
                                      Fill="{DynamicResource ThemeAccentText}" 
                                      Width="14" Height="14" 
                                      Stretch="Uniform" 
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Iniciar Consulta y Cargar Insumos" FontWeight="Bold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================ -->
        <!-- MODAL CORTE DE CAJA DIARIO (F6 / BOTÓN) -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#80000000" 
                Visibility="{Binding IsCashCutModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="680" 
                    MaxHeight="700" 
                    Margin="20" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Corte de Caja Diario" 
                                           FontSize="17" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Resumen de ingresos por método de pago y desglose de servicios vs productos vendidos." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCashCutModalCommand}" 
                                Padding="8,5" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Contenido del Corte -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Selector de Fecha y Botón Refrescar -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fecha de Corte:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding CashCutDate, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{DynamicResource AccentButton}" Command="{Binding LoadCashCutForDateCommand}" Margin="10,0,0,0" Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="Consultar" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Mensaje de Estado / Exportación -->
                            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="{Binding CashCutStatusMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CashCutStatusMessage}" Foreground="#059669" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>

                            <!-- Tarjetas de Totales Destacadas -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL INGRESOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding CurrentCashCut.TotalRevenue, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CurrentCashCut.TotalTickets, StringFormat='{}{0} tickets cobrados'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="FARMACIA (PRODUCTOS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding CurrentCashCut.ProductsRevenue, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CurrentCashCut.ProductsCount, StringFormat='{}{0} piezas vendidas'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="SERVICIOS CLÍNICOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding CurrentCashCut.ServicesRevenue, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding CurrentCashCut.ServicesCount, StringFormat='{}{0} consultas/servicios'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Desglose por Método de Pago -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Desglose por Método de Pago" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8" />
                                    
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💵 Efectivo:" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentCashCut.CashRevenue, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💳 Tarjeta de Débito:" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentCashCut.DebitCardRevenue, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💳 Tarjeta de Crédito:" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentCashCut.CreditCardRevenue, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📱 Transferencia SPEI:" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentCashCut.TransferRevenue, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Resumen de Tickets Cancelados si hay -->
                            <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding CurrentCashCut.CancelledTicketsCount, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " Foreground="#DC2626" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CurrentCashCut.CancelledTicketsCount, StringFormat='Tickets Cancelados/Devueltos: {0}'}" FontWeight="Bold" Foreground="#DC2626" FontSize="11" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding CurrentCashCut.CancelledRevenue, StringFormat='(Monto total devuelto: ${0:N2})'}" Foreground="#DC2626" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="El corte se calcula automáticamente a partir de las ventas registradas." FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding CloseCashCutModalCommand}" Padding="14,7" Margin="0,0,10,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding ExportCashCutCsvCommand}" Padding="14,7" Margin="0,0,10,0" ToolTip="Exportar corte a archivo .CSV para abrir en Excel">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar a CSV" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" Command="{Binding PrintCashCutCommand}" Padding="16,7" ToolTip="Imprimir tira de corte en impresora física de tickets">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖨️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Imprimir Tira de Corte" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================ -->
        <!-- MODAL HISTORIAL DE TICKETS Y DEVOLUCIONES -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#80000000" 
                Visibility="{Binding IsTicketHistoryModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="850" 
                    MaxHeight="720" 
                    Margin="20" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="🧾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Historial de Ventas y Devolución de Tickets" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Reimpresión de tickets por folio y cancelación con devolución de mercancía a inventario." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{DynamicResource OutlineButton}" Command="{Binding CloseTicketHistoryModalCommand}" Padding="8,5" VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Buscar por Folio:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding TicketSearchFolio, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="12" Padding="6,4">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchTicketByFolioCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2" Style="{DynamicResource AccentButton}" Command="{Binding SearchTicketByFolioCommand}" Margin="10,0,0,0" Padding="14,6">
                                    <TextBlock Text="Buscar" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Mensaje de Estado -->
                        <Border Grid.Row="0" Margin="0,48,0,0" Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="{Binding TicketHistoryStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TicketHistoryStatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" TextWrapping="Wrap" />
                        </Border>

                        <!-- Master-Detail Grid -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Lista de Tickets -->
                            <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
                                <ListBox ItemsSource="{Binding RecentSales}" SelectedItem="{Binding SelectedSaleForDetail, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Folio}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                                                        <Border Background="#EF4444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="CANCELADO" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Total, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Right" />

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding PatientName, StringFormat='Paciente: {0}'}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Detalle del Ticket Seleccionado -->
                            <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedSaleForDetail.Folio, StringFormat='Detalle de Ticket: {0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Text="{Binding SelectedSaleForDetail.Date, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SelectedSaleForDetail.PatientName, StringFormat='Paciente: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding SelectedSaleForDetail.PaymentMethod, StringFormat='Método: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />

                                        <!-- Alerta si está cancelado -->
                                        <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0" Visibility="{Binding SelectedSaleForDetail.IsCancelled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="⚠️ TICKET CANCELADO" FontWeight="Bold" FontSize="10" Foreground="#DC2626" />
                                                <TextBlock Text="{Binding SelectedSaleForDetail.CancellationReason, StringFormat='Motivo: {0}'}" FontSize="10" Foreground="#DC2626" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Partidas del Ticket -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedSaleForDetail.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,5,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0}x'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Acciones para este Ticket -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Style="{DynamicResource OutlineButton}" Command="{Binding ReprintSelectedTicketCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Ver y reimprimir el ticket térmico">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖨️" FontSize="12" Margin="0,0,4,0" />
                                                <TextBlock Text="Reimprimir Ticket" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{DynamicResource OutlineButton}" Command="{Binding RequestCancelSaleCommand}" Padding="12,6" ToolTip="Cancelar venta y devolver el stock a almacén" IsEnabled="{Binding CanCancelSelectedSale}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="↩️" FontSize="12" Margin="0,0,4,0" />
                                                <TextBlock Text="Devolver / Cancelar" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeError}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button Style="{DynamicResource OutlineButton}" Command="{Binding CloseTicketHistoryModalCommand}" Padding="16,7" HorizontalAlignment="Right">
                            <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Submodal Confirmar Cancelación y Devolución -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#99000000"
                Visibility="{Binding IsCancelConfirmModalOpen, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="350">
            <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" CornerRadius="12" MaxWidth="440" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Confirmar Devolución y Cancelación" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,10" />
                    <TextBlock Text="Esta acción marcará el ticket como CANCELADO, revertirá el ingreso del corte y regresará automáticamente todas las unidades despachadas al inventario y a sus respectivos lotes." FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    
                    <TextBlock Text="Motivo de la cancelación / devolución:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource OutlineButton}" Command="{Binding CloseCancelConfirmModalCommand}" Padding="12,8">
                            <TextBlock Text="Atrás" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="2" Style="{DynamicResource AccentButton}" Command="{Binding ConfirmCancelSaleCommand}" Padding="12,8" Background="#DC2626">
                            <TextBlock Text="Confirmar Devolución" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

