<UserControl x:Class="TPVC.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppearanceViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Apariencia: modo claro u oscuro, color de acento y colores propios. La vista previa usa la -->
    <!-- misma paleta que la aplicación, así que muestra cómo quedará antes de aplicar.             -->
    <UserControl.Resources>
        <!-- Tarjeta de modo (Claro / Oscuro) marcada cuando es el modo actual -->
        <Style x:Key="ModeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Muestra de color de acento: círculo con palomita cuando está elegido -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <!-- Dibuja su propio anillo de foco -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ThemeTextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ThemeFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource TextTitle}" Text="Apariencia" />
                <TextBlock Style="{StaticResource TextDetail}" Text="Los cambios se aplican al momento en toda la aplicación" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Modo -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Modo" Margin="0,0,0,12" />
                            <UniformGrid Columns="2">
                                <Button Margin="0,0,6,0" Command="{Binding SelectModeCommand}" CommandParameter="Claro" AutomationProperties.Name="Modo claro">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModeCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentMode}" Value="Claro">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="72" Padding="10">
                                            <StackPanel>
                                                <Border Background="#FFFFFF" CornerRadius="4" Height="16" Margin="0,0,0,6" />
                                                <Border Background="#E2E8F0" CornerRadius="3" Height="8" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                                <Border Background="#0369A1" CornerRadius="3" Height="12" Width="44" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                            <helpers:Icon Data="{StaticResource IcoSun}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Claro" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Margin="6,0,0,0" Command="{Binding SelectModeCommand}" CommandParameter="Oscuro" AutomationProperties.Name="Modo oscuro">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModeCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentMode}" Value="Oscuro">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Height="72" Padding="10">
                                            <StackPanel>
                                                <Border Background="#1E293B" CornerRadius="4" Height="16" Margin="0,0,0,6" />
                                                <Border Background="#334155" CornerRadius="3" Height="8" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                                <Border Background="#38BDF8" CornerRadius="3" Height="12" Width="44" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                            <helpers:Icon Data="{StaticResource IcoMoon}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Oscuro" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Text="Está usando colores personalizados. Elija Claro u Oscuro para volver a los colores del programa." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Acento -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Color de acento" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,12" TextWrapping="Wrap"
                                       Text="Botones principales, selección y enlaces. Si un color tiene poco contraste se oscurece o aclara solo." />
                            <ItemsControl ItemsSource="{Binding PaletteOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccentPaletteOption}">
                                        <StackPanel Width="86" Margin="0,0,4,8">
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Hex}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}">
                                                <helpers:Icon Data="{StaticResource IcoCheck}" Width="16" Height="16" Foreground="White"
                                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            </Button>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Personalizado -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Colores propios" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,12" TextWrapping="Wrap"
                                       Text="Escriba los colores como #RRGGBB. La vista previa cambia mientras escribe; se aplican con el botón." />
                            <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding CustomError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CustomError}" TextWrapping="Wrap" />
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fondo" />
                                    <Grid>
                                        <TextBox Style="{StaticResource FieldTextBox}" Padding="38,7,10,7" FontFamily="{StaticResource FontFamilyMono}"
                                                 Text="{Binding CustomBgHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Color de fondo" />
                                        <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"
                                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{Binding Preview.Background}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tarjetas" />
                                    <Grid>
                                        <TextBox Style="{StaticResource FieldTextBox}" Padding="38,7,10,7" FontFamily="{StaticResource FontFamilyMono}"
                                                 Text="{Binding CustomSurfaceHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Color de tarjetas" />
                                        <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"
                                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{Binding Preview.Surface}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Acento" />
                                    <Grid>
                                        <TextBox Style="{StaticResource FieldTextBox}" Padding="38,7,10,7" FontFamily="{StaticResource FontFamilyMono}"
                                                 Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Color de acento" />
                                        <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"
                                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{Binding Preview.Accent}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding ApplyCustomColorsCommand}" Content="Aplicar colores" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Vista previa en vivo -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Vista previa" Margin="0,0,0,8" />
                    <Border Background="{Binding Preview.Background}" BorderBrush="{Binding Preview.Border}" BorderThickness="1" CornerRadius="14" Padding="16"
                            AutomationProperties.Name="Vista previa del tema">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding Preview.Text}" Text="Consulta de hoy" />
                            <TextBlock FontSize="12" Foreground="{Binding Preview.TextSecondary}" Text="Martes 14 · 3 pacientes en espera" Margin="0,2,0,12" />
                            <Border Background="{Binding Preview.Surface}" BorderBrush="{Binding Preview.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Preview.InfoSubtle}" Margin="0,0,10,0">
                                            <TextBlock Text="AL" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Preview.InfoText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding Preview.Text}" Text="Ana López Pérez" />
                                            <TextBlock FontSize="12" Foreground="{Binding Preview.TextSecondary}" Text="34 años · última visita hace 2 meses" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="{Binding Preview.DangerSubtle}" CornerRadius="8" Padding="10,6" Margin="0,12,0,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding Preview.DangerText}" Text="Alergia: penicilina" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Background="{Binding Preview.Accent}" CornerRadius="8" Padding="14,8">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding Preview.AccentText}" Text="Iniciar consulta" />
                                        </Border>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding Preview.AccentForeground}" Text="Ver expediente" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{Binding Preview.Subtle}" BorderBrush="{Binding Preview.Border}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="13" Foreground="{Binding Preview.Text}" Text="Paracetamol 500 mg × 2" />
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource FontFamilyMono}" Foreground="{Binding Preview.Text}" Text="$84.00" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Preview.ContrastText}" Margin="2,8,0,0" ToolTip="Contraste mínimo recomendado: 4.5:1" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
