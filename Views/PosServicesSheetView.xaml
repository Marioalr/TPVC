<UserControl x:Class="TPVC.Views.PosServicesSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!-- Servicios clínicos: a la izquierda la lista (busca al escribir, categorías como chips), -->
    <!-- a la derecha el elegido con los insumos que se agregan solos.                        -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="980" Height="660" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Servicios" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Consultas, curaciones, inyecciones… con los insumos que usan" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding OpenCreateServiceModalCommand}" Margin="0,0,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,6,0" />
                            <TextBlock Text="Nuevo servicio" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding CloseServicesModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="24,12,24,10">
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="ServiceSearchBox" Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                                 Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="Buscar servicio por nombre, código o descripción"
                                 AutomationProperties.Name="Buscar servicio">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddServiceToCartCommand}" CommandParameter="{Binding SelectedService}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                      Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ServiceCategories}" SelectedItem="{Binding ServiceCategoryFilter, Mode=TwoWay}"
                             AutomationProperties.Name="Categorías de servicio" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Style="{StaticResource PlainList}" Padding="16,0,8,16"
                             ItemsSource="{Binding FilteredServices}"
                             SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                             AutomationProperties.Name="Servicios">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClinicalService}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource TextCaption}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} min">
                                                    <Binding Path="Category" />
                                                    <Binding Path="EstimatedDurationMinutes" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Ningún servicio coincide."
                               Visibility="{Binding FilteredServices.Count, Converter={StaticResource InverseBoolToVis}}" />

                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,1,0,0"
                            CornerRadius="0,0,16,0" Padding="22,18"
                            Visibility="{Binding HasSelectedService, Converter={StaticResource BoolToVis}}">
                        <Grid DataContext="{Binding SelectedService}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Name}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,10">
                                    <Border Style="{StaticResource BadgeInfo}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Category}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding EstimatedDurationMinutes, StringFormat='{}{0} min'}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding Code}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource TextMono}" FontSize="26" FontWeight="Bold" Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,14" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Insumos incluidos" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding DefaultProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ServiceDefaultProduct}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" Text="{Binding Quantity, StringFormat='× {0}'}" Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Sin insumos: solo el honorario."
                                           Visibility="{Binding DefaultProducts.Count, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <Button Style="{StaticResource ButtonPrimary}" MinHeight="44"
                                        Command="{Binding DataContext.AddServiceToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Enter en el buscador">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                                        <TextBlock Text="Agregar a la venta" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ButtonSecondary}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.AddServiceOnlyToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Content="Solo el honorario (sin insumos)" />
                                <Button Style="{StaticResource ButtonSecondary}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.AddServiceToActiveConsultationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.CanChargeToActiveConsultation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Se cobra al terminar la consulta">
                                    <TextBlock Text="{Binding DataContext.ActiveConsultationPatientName, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Agregar a la consulta de {0}'}"
                                               TextTrimming="CharacterEllipsis" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
