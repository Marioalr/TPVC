<UserControl x:Class="TPVC.Views.TursoSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TursoSyncViewModel}"
             d:DesignHeight="900" d:DesignWidth="1050"
             Background="{DynamicResource ThemeBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,40" MaxWidth="920" HorizontalAlignment="Center">

                <!-- Cabecera Principal -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="☁️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Nube y Sincronización Turso" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Sincronización multi-dispositivo ultrarrápida (Win11, Tablet Android y Celular Administrador) sobre el plan 100% gratuito de Turso." 
                                   FontSize="13" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeSuccess}" 
                            BorderThickness="1.5" 
                            CornerRadius="20" 
                            Padding="14,6" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ThemeSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Plan Gratuito Permanente (Máx. 3 dispositivos)" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeSuccess}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tarjeta de Estado en Tiempo Real -->
                <Border Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource ThemeAccent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusMessage}" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastSyncText}" 
                                       FontSize="12.5" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="20,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource PrimaryButton}" 
                                    Command="{Binding SyncNowCommand}" 
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="18,10" 
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sincronizar Ahora" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta 1: Parámetros de Conexión a Turso -->
                <Border Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="1. Configuración de Base de Datos en Turso" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,16" />

                        <!-- Switch Habilitar Sincronización -->
                        <CheckBox Content="Habilitar sincronización con Turso Cloud" 
                                  IsChecked="{Binding IsSyncEnabled}" 
                                  FontSize="13.5" 
                                  FontWeight="SemiBold" 
                                  Foreground="{DynamicResource ThemeText}" 
                                  Margin="0,0,0,18" />

                        <!-- URL de la Base de Datos -->
                        <TextBlock Text="URL de la base de datos Turso (libsql:// o https://):" 
                                   FontSize="12.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding DatabaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource ModernTextBox}" 
                                 Padding="12,10" 
                                 FontSize="13" 
                                 Margin="0,0,0,14" />

                        <!-- Token de Autenticación -->
                        <TextBlock Text="Token de Autenticación de Turso (Bearer Token):" 
                                   FontSize="12.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource ModernTextBox}" 
                                 Padding="12,10" 
                                 FontSize="12" 
                                 FontFamily="Consolas, monospace" 
                                 Margin="0,0,0,14" />

                        <!-- Fila de Acciones de Conexión -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding TestConnectionCommand}" 
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="14,8" 
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Probar Conexión" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource PrimaryButton}" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    Padding="16,8" 
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Guardar Ajustes" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding InitialUploadCommand}" 
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬆" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Subir Base Local a Turso (Migración Inicial)" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Mensaje de prueba de conexión -->
                        <TextBlock Text="{Binding TestConnectionResult}" 
                                   FontSize="12.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeAccent}" 
                                   Margin="0,6,0,0" />

                        <!-- Mensaje de guardado -->
                        <TextBlock Text="{Binding SaveStatusMessage}" 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource ThemeSuccess}" 
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Configuración de este Dispositivo -->
                <Border Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="2. Configuración de Este Dispositivo" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre del equipo:" 
                                           FontSize="12.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource ThemeText}" 
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="12,10" 
                                         FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rol asignado a este equipo:" 
                                           FontSize="12.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource ThemeText}" 
                                           Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding RoleOptions}" 
                                          SelectedValue="{Binding SelectedRole}" 
                                          SelectedValuePath="Role" 
                                          DisplayMemberPath="DisplayName" 
                                          Padding="10,8" 
                                          FontSize="12.5" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox Content="Sincronizar automáticamente en segundo plano tras cambios" 
                                      IsChecked="{Binding AutoSyncOnChanges}" 
                                      FontSize="12.5" 
                                      Foreground="{DynamicResource ThemeText}" 
                                      Margin="0,0,24,0" />
                            <CheckBox Content="Sincronizar al iniciar la aplicación" 
                                      IsChecked="{Binding AutoSyncOnStartup}" 
                                      FontSize="12.5" 
                                      Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Vinculación de Dispositivos Android (Tablet y Celular) -->
                <Border Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="3. Vincular Dispositivos Móviles (Android)" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Genera un código de emparejamiento automático para configurar tus otros 2 dispositivos sin teclear claves:" 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Opción A: Tablet Android -->
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📱" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tablet Android" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Uso clínico y asistente: Expedientes, recetas médicas, notas NOM-004, citas y ventas." 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,0,0,14" />
                                    <Button Style="{DynamicResource PrimaryButton}" 
                                            Command="{Binding OpenPairingModalCommand}" 
                                            CommandParameter="Tablet"
                                            Padding="14,8" 
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="Generar Vinculación Tablet" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Opción B: Celular Android -->
                            <Border Grid.Column="2" 
                                    Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📲" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Celular Android" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Solo Administración: Métricas del día, cortes de caja, consulta de existencias y alertas." 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,0,0,14" />
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding OpenPairingModalCommand}" 
                                            CommandParameter="Mobile"
                                            Padding="14,8" 
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="Generar Vinculación Celular" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 4: Monitor de Cuota Gratuita Permanente (Free Tier Guardian) -->
                <Border Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="24" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Garantía de Cuota Gratuita (Turso Free Tier)" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="14" 
                                Margin="0,0,0,14">
                            <TextBlock Text="{Binding QuotaSummaryText}" 
                                       FontWeight="SemiBold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource ThemeSuccess}" />
                        </Border>

                        <TextBlock Text="{Binding QuotaDetailedText}" 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   TextWrapping="Wrap" 
                                   LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- Botón Guía Turso en 2 Minutos -->
                <Button Style="{DynamicResource OutlineButton}" 
                        Command="{Binding ToggleHelpGuideCommand}" 
                        Padding="16,10" 
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ver Guía Paso a Paso para Crear Turso Gratis en 2 Minutos" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Panel Desplegable Guía Turso -->
                <Border Visibility="{Binding IsHelpGuideOpen, Converter={StaticResource BoolToVis}}" 
                        Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="20" 
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="¿Cómo crear tu base de datos gratis en Turso?" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   Margin="0,0,0,12" />

                        <TextBlock Text="1. Instala el CLI de Turso en tu terminal o PowerShell:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" Padding="10,6" CornerRadius="6" Margin="0,4,0,12">
                            <TextBlock Text="irm https://get.tur.so/install.ps1 | iex   (Windows)&#x0a;curl -sSfL https://get.tur.so/install.sh | bash   (Linux/macOS)" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>

                        <TextBlock Text="2. Inicia sesión con GitHub o email (plan gratis sin tarjeta de crédito):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" Padding="10,6" CornerRadius="6" Margin="0,4,0,12">
                            <TextBlock Text="turso auth login" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>

                        <TextBlock Text="3. Crea la base de datos para la clínica:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" Padding="10,6" CornerRadius="6" Margin="0,4,0,12">
                            <TextBlock Text="turso db create consultorio" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>

                        <TextBlock Text="4. Obtén la URL y el Token:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" Padding="10,6" CornerRadius="6" Margin="0,4,0,0">
                            <TextBlock Text="turso db show consultorio --http-url&#x0a;turso db tokens create consultorio" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Modal Flotante de Vinculación para Android -->
        <Grid Panel.ZIndex="999" Visibility="{Binding IsPairingModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#88000000" />
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Width="600" 
                    MaxHeight="620" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="26">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PairingRoleTitle}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeText}" />
                        <Button Grid.Column="1" Content="✕" Style="{DynamicResource OutlineButton}" Padding="8,4" Command="{Binding ClosePairingModalCommand}" />
                    </Grid>

                    <TextBlock Text="Copia este paquete de configuración y pégalo en la aplicación Android al abrirla para conectarse automáticamente a Turso con este rol:" 
                               FontSize="12.5" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,14" />

                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12" 
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PairingJsonPayload, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     FontFamily="Consolas, monospace" 
                                     FontSize="12" 
                                     Foreground="{DynamicResource ThemeText}" 
                                     TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{DynamicResource PrimaryButton}" 
                                Command="{Binding CopyPairingPayloadCommand}" 
                                Padding="16,8" 
                                Margin="0,0,10,0">
                            <TextBlock Text="📋 Copiar al Portapapeles" FontSize="12.5" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding ClosePairingModalCommand}" 
                                Padding="14,8">
                            <TextBlock Text="Cerrar" FontSize="12.5" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
