<UserControl x:Class="TPVC.Views.TursoSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TursoSyncViewModel}"
             d:DesignHeight="900" d:DesignWidth="1000">

    <!-- Nube y dispositivos: estado de la sincronización con Turso, la conexión (URL y token), este  -->
    <!-- equipo, la vinculación de la tablet y el celular, y la cuota gratuita. Importar y restaurar -->
    <!-- datos se mudó a "Respaldos y datos".                                                        -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="880" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextTitle}" Text="Nube y dispositivos" />
                        <TextBlock Style="{StaticResource TextDetail}" Text="Sincroniza esta computadora, la tablet y el celular con Turso (plan gratuito)" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Top">
                        <TextBlock Text="Plan gratuito · hasta 3 equipos" />
                    </Border>
                </Grid>

                <!-- Estado -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Margin="2,0,14,0" VerticalAlignment="Center"
                                     Style="{StaticResource SyncStatusDot}" Tag="{Binding Status}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextSection}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding LastSyncText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Command="{Binding SyncNowCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoRefresh}" Margin="0,0,8,0" />
                                    <TextBlock Text="Sincronizar ahora" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Conexión -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextSection}" Text="Conexión con Turso" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Style="{StaticResource FieldCheckBox}" IsChecked="{Binding IsSyncEnabled}" Content="Sincronización activada" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="URL de la base (libsql:// o https://)" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding DatabaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="libsql://consultorio-usuario.turso.io" AutomationProperties.Name="URL de la base" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Command="{Binding PasteDatabaseUrlCommand}" Content="Pegar" ToolTip="Pegar la URL copiada" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Token de acceso" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Style="{StaticResource FieldPasswordBox}" helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding AuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsAuthTokenVisible, Converter={StaticResource InverseBoolToVis}}" AutomationProperties.Name="Token de Turso" />
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsAuthTokenVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Token de Turso visible" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding ToggleAuthTokenVisibilityCommand}" ToolTip="Mostrar u ocultar el token" AutomationProperties.Name="Mostrar u ocultar token">
                                <helpers:Icon Data="{StaticResource IconEye}" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}" Command="{Binding PasteAuthTokenCommand}" Content="Pegar" Margin="4,0,0,0" ToolTip="Pegar el token copiado" />
                        </Grid>

                        <WrapPanel>
                            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                    <TextBlock Text="Guardar" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ButtonSecondary}" Command="{Binding TestConnectionCommand}" Margin="0,0,8,8" Content="Probar conexión"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource ButtonGhost}" Command="{Binding InitialUploadCommand}" Margin="0,0,8,8" Content="Sincronización completa"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    ToolTip="Sube todo lo de este equipo y baja todo lo de la nube (la primera vez o si algo quedó desfasado)" />
                        </WrapPanel>

                        <Border Margin="0,6,0,0" Visibility="{Binding TestConnectionResult, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource NoticeDanger}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSuccessSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSuccessText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TestConnectionResult}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource ThemeSuccessText}" Text="{Binding SaveStatusMessage}" Margin="0,6,0,0"
                                   Visibility="{Binding SaveStatusMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Este equipo -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextSection}" Text="Este equipo" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre del equipo" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Uso" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding RoleOptions}" SelectedValue="{Binding SelectedRole}"
                                          SelectedValuePath="Role" DisplayMemberPath="DisplayName" AutomationProperties.Name="Uso del equipo" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding AutoSyncOnChanges}" Content="Sincronizar solo, en segundo plano, después de cada cambio" Margin="0,0,0,8" />
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding AutoSyncOnStartup}" Content="Sincronizar al abrir el programa" />
                    </StackPanel>
                </Border>

                <!-- Vincular tablet y celular -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextSection}" Text="Vincular tablet y celular" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,12" TextWrapping="Wrap"
                                   Text="Genera un código para pegar en la app de Android; se conecta sola, sin escribir la URL ni el token." />
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CardSubtle}" Padding="16" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <helpers:Icon Data="{StaticResource IcoTablet}" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Tablet" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="Consulta y recepción: expedientes, recetas, citas y cobro." />
                                    <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding OpenPairingModalCommand}" CommandParameter="Tablet" Content="Generar código" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardSubtle}" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <helpers:Icon Data="{StaticResource IcoPhone}" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Celular" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="Solo consulta: ventas del día, cortes, existencias y alertas." />
                                    <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding OpenPairingModalCommand}" CommandParameter="Mobile" Content="Generar código" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Cuota -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextSection}" Text="Cuota gratuita" Margin="0,0,0,10" />
                        <Border Style="{StaticResource NoticeSuccess}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding QuotaSummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding QuotaDetailedText}" TextWrapping="Wrap"
                                   Visibility="{Binding QuotaDetailedText, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Guía (plegada) -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Button Style="{StaticResource ButtonGhost}" HorizontalContentAlignment="Stretch" Padding="20,14" Command="{Binding ToggleHelpGuideCommand}"
                                AutomationProperties.Name="Cómo crear la base gratis en Turso">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <helpers:Icon Data="{StaticResource IcoInfo}" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Cómo crear la base gratis en Turso (2 minutos)" />
                                <helpers:Icon Grid.Column="2">
                                    <helpers:Icon.Style>
                                        <Style TargetType="helpers:Icon">
                                            <Setter Property="Data" Value="{StaticResource IcoChevronDown}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHelpGuideOpen}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IcoChevronUp}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </helpers:Icon.Style>
                                </helpers:Icon>
                            </Grid>
                        </Button>
                        <StackPanel Margin="20,0,20,20" Visibility="{Binding IsHelpGuideOpen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="1. Instale la herramienta de Turso (PowerShell):" />
                            <Border Style="{StaticResource CardSubtle}" Padding="10,6" Margin="0,4,0,12">
                                <TextBlock Style="{StaticResource TextMono}" Text="irm https://get.tur.so/install.ps1 | iex" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="2. Entre con GitHub o correo (sin tarjeta):" />
                            <Border Style="{StaticResource CardSubtle}" Padding="10,6" Margin="0,4,0,12">
                                <TextBlock Style="{StaticResource TextMono}" Text="turso auth login" />
                            </Border>
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="3. Cree la base del consultorio:" />
                            <Border Style="{StaticResource CardSubtle}" Padding="10,6" Margin="0,4,0,12">
                                <TextBlock Style="{StaticResource TextMono}" Text="turso db create consultorio" />
                            </Border>
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="4. Copie la URL y cree el token, y péguelos arriba:" />
                            <Border Style="{StaticResource CardSubtle}" Padding="10,6" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource TextMono}" Text="turso db show consultorio --http-url&#x0a;turso db tokens create consultorio" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= HOJA: CÓDIGO DE VINCULACIÓN ======================= -->
        <Grid Panel.ZIndex="60" Visibility="{Binding IsPairingModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SheetScrim}" />
            <Border Style="{StaticResource SheetCard}" Width="600" MaxHeight="620" Padding="24,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextHeading}" Text="{Binding PairingRoleTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding ClosePairingModalCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                            <helpers:Icon Data="{StaticResource IcoClose}" />
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource TextDetail}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Copie este código y péguelo en la app de Android la primera vez que la abra. Contiene el token: no lo comparta." />
                    <Border Style="{StaticResource CardSubtle}" Padding="12" MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PairingJsonPayload, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     CaretBrush="{DynamicResource ThemeText}" SelectionBrush="{DynamicResource ThemeAccent}"
                                     FontFamily="{StaticResource FontFamilyMono}" FontSize="12" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap"
                                     AutomationProperties.Name="Código de vinculación" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding ClosePairingModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding CopyPairingPayloadCommand}" Content="Copiar código" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
