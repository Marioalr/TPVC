<UserControl x:Class="TPVC.Views.MedicalRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}"
             d:DesignHeight="860" d:DesignWidth="1366"
             Focusable="True">

    <!-- ======================================================================== -->
    <!-- PACIENTES: contenedor de páginas (inicio, ficha, alta, consulta), panel   -->
    <!-- de agenda y hojas. Cada pieza es un archivo propio y se crea la primera  -->
    <!-- vez que se muestra: un ContentControl oculto no aplica su plantilla.     -->
    <!-- ======================================================================== -->
    <UserControl.Resources>
        <DataTemplate x:Key="HomePage"><views:PatientsHomeView /></DataTemplate>
        <DataTemplate x:Key="ChartPage"><views:PatientChartView /></DataTemplate>
        <DataTemplate x:Key="FormPage"><views:PatientFormView /></DataTemplate>
        <DataTemplate x:Key="ConsultationPage"><views:ConsultationWorkspaceView Margin="16,14,16,14" /></DataTemplate>
        <DataTemplate x:Key="AgendaPanel"><views:AgendaPanelView /></DataTemplate>
        <DataTemplate x:Key="PrescriptionSheet"><views:PrescriptionSheetView /></DataTemplate>
        <DataTemplate x:Key="SuppliesSheet"><views:SuppliesSheetView /></DataTemplate>
        <DataTemplate x:Key="ServicesSheet"><views:ServicesSheetView /></DataTemplate>
        <DataTemplate x:Key="CatalogSheet"><views:CatalogBrowserSheetView /></DataTemplate>
        <DataTemplate x:Key="PreviewSheet"><views:PrescriptionPreviewSheetView /></DataTemplate>
        <DataTemplate x:Key="CreateServiceSheet"><views:CreateServiceSheetView /></DataTemplate>
        <DataTemplate x:Key="CheckoutSheet"><views:ConsultationCheckoutView /></DataTemplate>
        <DataTemplate x:Key="AllergyDialog"><views:AllergyAlertView /></DataTemplate>
        <DataTemplate x:Key="InfoDialog"><views:InfoDialogView /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= BARRA DE PACIENTES ======================= -->
        <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,12"
                Visibility="{Binding ShowsPatientsTopBar, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding BackToHubCommand}" Margin="0,0,16,0" ToolTip="Volver al inicio de la aplicación">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                        <TextBlock Text="Inicio" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" Foreground="{DynamicResource ThemeText}" Padding="4,2"
                        Command="{Binding GoToPatientsHomeCommand}" ToolTip="Citas de hoy y pacientes recientes">
                    <TextBlock Style="{StaticResource TextHeading}" Text="Pacientes" />
                </Button>
                <Grid Grid.Column="2" MaxWidth="620" Margin="24,0" HorizontalAlignment="Stretch">
                    <TextBox x:Name="PatientSearchBox"
                             Style="{StaticResource FieldTextBox}"
                             Height="44"
                             FontSize="15"
                             Padding="40,7,12,7"
                             Text="{Binding HomeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar paciente por nombre, folio o teléfono"
                             AutomationProperties.Name="Buscar paciente">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenFirstHomeResultCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ToggleAgendaPanelCommand}" Margin="0,0,8,0" ToolTip="Agenda de la semana (panel)">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoCalendar}" Margin="0,0,8,0" />
                            <TextBlock Text="Agenda" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding NewPatientCommand}">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                            <TextBlock Text="Nuevo paciente" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CONSULTA EN CURSO (fuera de ella) ======================= -->
        <Border Grid.Row="1" Style="{StaticResource NoticeWarning}" Margin="24,12,24,0" Padding="14,8"
                Visibility="{Binding ShowsConsultationBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <helpers:Icon Data="{StaticResource IcoClock}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ConsultationBannerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Padding="14,5" MinHeight="0" Content="Volver a la consulta" Command="{Binding ShowConsultationCommand}" />
            </Grid>
        </Border>

        <!-- ======================= PÁGINAS ======================= -->
        <Grid Grid.Row="2">
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HomePage}"
                            Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ChartPage}"
                            Visibility="{Binding IsChartPage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource FormPage}"
                            Visibility="{Binding IsFormPage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ConsultationPage}"
                            Visibility="{Binding IsConsultationPage, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ======================= PANEL DE AGENDA (no oscurece lo de atrás) ======================= -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="50" Focusable="False" HorizontalAlignment="Right"
                        Content="{Binding}" ContentTemplate="{StaticResource AgendaPanel}"
                        Visibility="{Binding IsAgendaPanelOpen, Converter={StaticResource BoolToVis}}" />

        <!-- ======================= HOJAS CON FONDO DIFUSO ======================= -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PrescriptionSheet}"
                        Visibility="{Binding IsPrescriptionModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource SuppliesSheet}"
                        Visibility="{Binding IsSuppliesModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ServicesSheet}"
                        Visibility="{Binding IsServicesModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="300" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CheckoutSheet}"
                        Visibility="{Binding IsPosModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="310" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CatalogSheet}"
                        Visibility="{Binding IsCatalogBrowserModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="320" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PreviewSheet}"
                        Visibility="{Binding IsPrescriptionPdfModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="360" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CreateServiceSheet}"
                        Visibility="{Binding IsCreateServiceModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="450" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource AllergyDialog}"
                        Visibility="{Binding IsAllergyAlertOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="500" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource InfoDialog}"
                        Visibility="{Binding IsInfoModalVisible, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
