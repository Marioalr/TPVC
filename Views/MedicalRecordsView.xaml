<UserControl x:Class="TPVC.Views.MedicalRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}"
             d:DesignHeight="860" d:DesignWidth="1366"
             Focusable="True">

    <!-- ======================================================================== -->
    <!-- PACIENTES: contenedor de páginas (inicio, ficha, alta, consulta), panel   -->
    <!-- de agenda y hojas. Cada pieza es un archivo propio y se crea la primera  -->
    <!-- vez que se muestra: un ContentControl oculto no aplica su plantilla.     -->
    <!-- ======================================================================== -->
    <UserControl.Resources>
        <DataTemplate x:Key="HomePage"><views:PatientsHomeView /></DataTemplate>
        <DataTemplate x:Key="ChartPage"><views:PatientChartView /></DataTemplate>
        <DataTemplate x:Key="FormPage"><views:PatientFormView /></DataTemplate>
        <DataTemplate x:Key="ConsultationPage"><views:ConsultationWorkspaceView Margin="16,14,16,14" /></DataTemplate>
        <DataTemplate x:Key="AgendaPanel"><views:AgendaPanelView /></DataTemplate>
        <DataTemplate x:Key="PrescriptionSheet"><views:PrescriptionSheetView /></DataTemplate>
        <DataTemplate x:Key="SuppliesSheet"><views:SuppliesSheetView /></DataTemplate>
        <DataTemplate x:Key="ServicesSheet"><views:ServicesSheetView /></DataTemplate>
        <DataTemplate x:Key="CatalogSheet"><views:CatalogBrowserSheetView /></DataTemplate>
        <DataTemplate x:Key="PreviewSheet"><views:PrescriptionPreviewSheetView /></DataTemplate>
        <DataTemplate x:Key="ConsultationDetailSheet"><views:ConsultationDetailSheetView /></DataTemplate>
        <DataTemplate x:Key="LabOrderPreviewSheet"><views:LabOrderPreviewSheetView /></DataTemplate>
        <DataTemplate x:Key="CheckoutSheet"><views:ConsultationCheckoutView /></DataTemplate>
        <DataTemplate x:Key="AllergyDialog"><views:AllergyAlertView /></DataTemplate>
        <DataTemplate x:Key="InfoDialog"><views:InfoDialogView /></DataTemplate>
        <DataTemplate x:Key="SendConsultationSheet"><views:SendConsultationSheetView /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= BARRA DE PACIENTES ======================= -->
        <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,12"
                Visibility="{Binding Navigation.ShowsPatientsTopBar, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding BackToHubCommand}" Margin="0,0,16,0" ToolTip="Volver al inicio de la aplicación">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                        <TextBlock Text="Inicio" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" Foreground="{DynamicResource ThemeText}" Padding="4,2"
                        Command="{Binding Navigation.GoToPatientsHomeCommand}" ToolTip="Citas de hoy y pacientes recientes">
                    <TextBlock Style="{StaticResource TextHeading}" Text="Pacientes" />
                </Button>
                <Grid Grid.Column="2" MaxWidth="620" Margin="24,0" HorizontalAlignment="Stretch">
                    <TextBox x:Name="PatientSearchBox"
                             Style="{StaticResource FieldTextBox}"
                             Height="44"
                             FontSize="15"
                             Padding="40,7,40,7"
                             Text="{Binding Home.HomeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar paciente por nombre, folio o teléfono"
                             AutomationProperties.Name="Buscar paciente">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Home.OpenFirstHomeResultCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                    <!-- X dentro del cuadro (solo con texto): borra la búsqueda y deja el cursor en el cuadro.
                         Sin foco propio: el clic no se lleva el cursor del buscador -->
                    <Button Style="{StaticResource ButtonIcon}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                            Focusable="False" Foreground="{DynamicResource ThemeTextSecondary}"
                            Command="{Binding Home.ClearHomeSearchCommand}"
                            Visibility="{Binding Home.HasHomeQuery, Converter={StaticResource BoolToVis}}"
                            ToolTip="Borrar la búsqueda (Esc)" AutomationProperties.Name="Borrar la búsqueda">
                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                    </Button>
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Agenda.ToggleAgendaPanelCommand}" Margin="0,0,8,0" ToolTip="Agenda de la semana (panel)">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoCalendar}" Margin="0,0,8,0" />
                            <TextBlock Text="Agenda" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding PatientForm.NewPatientCommand}">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                            <TextBlock Text="Nuevo paciente" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
        <!-- ======================= CONSULTA RECIBIDA DE OTRO EQUIPO ======================= -->
        <Border Style="{StaticResource Notice}" Margin="24,12,24,0" Padding="16,12"
                Visibility="{Binding Handoff.ShowsIncomingHandoffNotice, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Consulta recibida de otro equipo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <helpers:Icon Data="{StaticResource IcoMonitor}" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Handoff.IncomingHandoffTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Handoff.IncomingHandoffDetail}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Handoff.IncomingHandoffBlockedReason}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Handoff.IncomingHandoffBlockedReason, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Handoff.DismissIncomingHandoffCommand}" Content="Más tarde" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding Handoff.AcceptIncomingHandoffCommand}" IsEnabled="{Binding Handoff.CanAcceptIncomingHandoff}"
                            Content="Continuar aquí" ToolTip="Abrir la consulta en este equipo (el otro la deja de editar)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CONSULTA EN CURSO (fuera de ella) ======================= -->
        <Border Style="{StaticResource NoticeWarning}" Margin="24,12,24,0" Padding="14,8"
                Visibility="{Binding ShowsConsultationBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <helpers:Icon Data="{StaticResource IcoClock}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ConsultationBannerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Padding="14,5" MinHeight="0" Content="Volver a la consulta" Command="{Binding ShowConsultationCommand}" />
            </Grid>
        </Border>
        </StackPanel>

        <!-- ======================= PÁGINAS ======================= -->
        <Grid Grid.Row="2">
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HomePage}"
                            Visibility="{Binding Navigation.IsHomePage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ChartPage}"
                            Visibility="{Binding Navigation.IsChartPage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding PatientForm}" ContentTemplate="{StaticResource FormPage}"
                            Visibility="{Binding Navigation.IsFormPage, Converter={StaticResource BoolToVis}}" />
            <ContentControl Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ConsultationPage}"
                            Visibility="{Binding Navigation.IsConsultationPage, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ======================= PANEL DE AGENDA (no oscurece lo de atrás) ======================= -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="50" Focusable="False" HorizontalAlignment="Right"
                        Content="{Binding}" ContentTemplate="{StaticResource AgendaPanel}"
                        Visibility="{Binding Agenda.IsAgendaPanelOpen, Converter={StaticResource BoolToVis}}" />

        <!-- ======================= HOJAS CON FONDO DIFUSO ======================= -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PrescriptionSheet}"
                        Visibility="{Binding Prescription.IsPrescriptionModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource SuppliesSheet}"
                        Visibility="{Binding Supplies.IsSuppliesModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="250" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ServicesSheet}"
                        Visibility="{Binding ClinicalServices.IsServicesModalOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="300" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CheckoutSheet}"
                        Visibility="{Binding Consultation.IsFinishConsultationOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="310" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource CatalogSheet}"
                        Visibility="{Binding CatalogBrowser.IsCatalogBrowserModalOpen, Converter={StaticResource BoolToVis}}" />
        <!-- Una consulta del historial: detalle por datos y su receta (desde v1.24.0) -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="315" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ConsultationDetailSheet}"
                        Visibility="{Binding ConsultationDetail.IsOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="320" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource PreviewSheet}"
                        Visibility="{Binding Preview.IsPrescriptionPdfModalOpen, Converter={StaticResource BoolToVis}}" />
        <!-- Solicitud de laboratorio de la consulta en curso (desde v1.25.0) -->
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="320" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource LabOrderPreviewSheet}"
                        Visibility="{Binding Labs.IsPreviewOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="370" Focusable="False" Content="{Binding Handoff}" ContentTemplate="{StaticResource SendConsultationSheet}"
                        Visibility="{Binding Handoff.IsSendConsultationSheetOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="450" Focusable="False" Content="{Binding Prescription}" ContentTemplate="{StaticResource AllergyDialog}"
                        Visibility="{Binding Prescription.IsAllergyAlertOpen, Converter={StaticResource BoolToVis}}" />
        <ContentControl Grid.RowSpan="3" Panel.ZIndex="500" Focusable="False" Content="{Binding Info}" ContentTemplate="{StaticResource InfoDialog}"
                        Visibility="{Binding Info.IsInfoModalVisible, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
