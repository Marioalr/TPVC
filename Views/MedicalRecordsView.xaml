<UserControl x:Class="TPVC.Views.MedicalRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1050"
             Focusable="True">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Banner Prominente y de Gran Formato de Módulo en Desarrollo (TODO) -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ThemeSurfaceSubtle}" 
                BorderBrush="{DynamicResource ThemeAccent}" 
                BorderThickness="2" 
                CornerRadius="14" 
                Padding="22,16" 
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Distintivo Activo NOM-004-SSA3 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Background="{DynamicResource ThemeSuccess}" 
                                CornerRadius="6" 
                                Padding="12,4" 
                                Margin="0,0,10,0">
                            <TextBlock Text="● SISTEMA CLÍNICO OPERATIVO (NOM-004-SSA3)" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="White" />
                        </Border>
                        <Border Background="{DynamicResource ThemeBorder}" 
                                CornerRadius="6" 
                                Padding="10,4">
                            <TextBlock Text="EXPEDIENTES Y CONSULTA MÉDICA" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Border>
                    </StackPanel>

                    <!-- Título en Grande -->
                    <TextBlock Text="Expedientes Clínicos y Consulta Médica" 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />

                    <!-- Descripción Explicativa en Grande -->
                    <TextBlock Text="Gestión médica integral de pacientes conforme a la NOM-004-SSA3. Permite administrar expedientes clínicos, registrar notas de evolución con somatometría y cálculo de IMC, emitir recetas médicas con despacho automático al POS y catalogar servicios clínicos." 
                               FontSize="12" 
                               LineHeight="18" 
                               TextWrapping="Wrap" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               MaxWidth="880" 
                               HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Botones Rápidos de Módulo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding BackToHubCommand}" 
                            Margin="0,0,10,0" 
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Volver a Inicio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Agenda de Citas -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding OpenAgendaModalCommand}" 
                            Margin="0,0,10,0" 
                            Padding="14,8"
                            ToolTip="Abrir la agenda y calendario de citas del consultorio (vista de día y semana)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Agenda de Citas" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Ver Expedientes -->
                    <Button Style="{DynamicResource AccentButton}" 
                            Command="{Binding OpenRecordsViewerModalCommand}" 
                            Margin="0,0,10,0" 
                            Padding="14,8"
                            ToolTip="Ver listado y expediente clínico completo de cualquier paciente">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ver Expedientes" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource AccentButton}" 
                            Command="{Binding NewPatientCommand}" 
                            Padding="12,8"
                            ToolTip="Dar de alta un nuevo paciente y su historia clínica completa (NOM-004-SSA3)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Nuevo Paciente" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- EXPEDIENTES CLÍNICOS DE PACIENTES (NOM-004-SSA3)                          -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Banner de Consulta Activa (Visible únicamente cuando hay consulta en curso) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeSurfaceSubtle}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,9" 
                    Margin="0,0,0,10" 
                    Visibility="{Binding HasActiveConsultation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ThemeSuccess}" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" />
                        <TextBlock Text="CONSULTA MÉDICA EN CURSO:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock Text="{Binding ActiveConsultationPatientName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                        <TextBlock Text=" • Folio: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationFolio}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <!-- Cronómetro activo de consulta -->
                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveConsultationElapsedTime}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text=" • Insumos acumulados desde POS: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationItemsCount}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Text=" ($" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="{Binding ActiveConsultationTotalAmount, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Text=")" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource AccentButton}" 
                                Command="{Binding FinalizeConsultationCommand}" 
                                Padding="14,6" 
                                FontSize="11" 
                                ToolTip="Finalizar la consulta y abrir el Punto de Venta (POS) con la Consulta General cargada">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏁" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Finalizar Consulta" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ficha Clínica Detallada del Paciente Seleccionado (Pantalla Completa) -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="16">
                <Grid>
                    <!-- Vista cuando no hay paciente seleccionado -->
                    <Border VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="48,36" 
                            MaxWidth="600"
                            Cursor="Hand"
                            Visibility="{Binding SelectedPatient, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSelectPatientModalCommand}" />
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    CornerRadius="32" 
                                    Width="64" Height="64" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,0,0,16">
                                <Path Data="{StaticResource IconUser}" 
                                      Fill="{DynamicResource ThemeAccent}" 
                                      Width="28" Height="28" 
                                      Stretch="Uniform" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Ningún Paciente Seleccionado" 
                                       FontWeight="Bold" 
                                       FontSize="20" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Para iniciar una consulta médica, registrar notas de evolución o emitir recetas, seleccione un paciente del catálogo. Presione el botón a continuación para abrir la búsqueda." 
                                       FontSize="13" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       TextAlignment="Center" 
                                       TextWrapping="Wrap" 
                                       LineHeight="19" 
                                       HorizontalAlignment="Center" />

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding OpenSelectPatientModalCommand}" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,20,0,0" 
                                    Padding="24,10" 
                                    Cursor="Hand"
                                    ToolTip="Abrir el catálogo de pacientes para buscar, seleccionar o registrar">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconUser}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          Margin="0,0,8,0" 
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Seleccionar Paciente" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Detalle Clínico del Paciente -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Visibility="{Binding SelectedPatient, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Cabecera de Ficha -->
                                <Border Background="{DynamicResource ThemeSurface}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedPatient.FullName}" 
                                                       FontWeight="Bold" 
                                                       FontSize="18" 
                                                       Foreground="{DynamicResource ThemeText}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                                <TextBlock Text="{Binding SelectedPatient.RecordNumber, StringFormat='Folio: {0}'}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource ThemeAccent}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.Age, StringFormat='Edad: {0} años'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.Gender, StringFormat='Sexo: {0}'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.BloodType, StringFormat='Grupo: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            </StackPanel>

                                            <!-- Badge de Alergias -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedPatient.HasAllergies}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Sin alergias reportadas" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedPatient.HasAllergies}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding SelectedPatient.Allergies, StringFormat='⚠️ ALERGIAS: {0}'}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Badge Próxima Consulta Agendada -->
                                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                        BorderBrush="{DynamicResource ThemeAccent}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        Visibility="{Binding SelectedPatient.HasScheduledAppointment, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📅 Cita: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                                        <TextBlock Text="{Binding SelectedPatient.FormattedNextAppointment}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Botones de Acción de Ficha (2 Filas) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Fila 1: Gestión de Paciente y Consulta -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenSelectPatientModalCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Seleccionar otro paciente para ver o editar su expediente">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Cambiar Paciente" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding ViewSelectedPatientRecordCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Ver el expediente clínico completo del paciente">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Ver Expediente" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding EditPatientCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Editar datos generales y clínicos del paciente">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✏️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Editar Ficha" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenScheduleAppointmentModalCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Agendar una próxima consulta o cita médica de seguimiento para este paciente">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📅" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Agendar Nueva Consulta" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding ToggleActiveConsultationCommand}" 
                                                        Padding="13,6" 
                                                        ToolTip="Iniciar o finalizar la consulta médica activa">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconFileMedical}" 
                                                              Fill="{DynamicResource ThemeAccentText}" 
                                                              Width="12" Height="12" 
                                                              Stretch="Uniform" 
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding ConsultationActionButtonText}" FontSize="11" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Fila 2: Órdenes Clínicas (Receta, Insumos y Servicios) -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenPrescriptionModalCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Abrir la receta médica para indicar medicamentos y posología">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="💊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Receta Médica" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenSuppliesModalCommand}" 
                                                        Padding="10,6" 
                                                        Margin="0,0,8,0" 
                                                        ToolTip="Abrir catálogo de insumos y material de curación para agregar a la consulta o enviar al POS">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📦" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Insumos" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenServicesModalCommand}" 
                                                        Padding="10,6" 
                                                        ToolTip="Abrir catálogo de servicios y procedimientos clínicos para agregar a la consulta o enviar al POS">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🩺" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Servicios" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Pestañas de Ficha Clínica: Resumen vs Historial vs Servicios (POS) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Command="{Binding SwitchPatientDetailTabCommand}" 
                                            CommandParameter="Resumen" 
                                            Margin="0,0,8,0" 
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PatientDetailTab}" Value="Resumen">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="📋 Resumen y Nota de Evolución" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <Button Command="{Binding SwitchPatientDetailTabCommand}" 
                                            CommandParameter="Historial" 
                                            Margin="0,0,8,0" 
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PatientDetailTab}" Value="Historial">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding ConsultationsHistory.Count, StringFormat='📜 Historial Clínico ({0})'}" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <Button Command="{Binding SwitchPatientDetailTabCommand}" 
                                            CommandParameter="Servicios" 
                                            Margin="0,0,8,0" 
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PatientDetailTab}" Value="Servicios">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="🩺 Servicios y Cobro (POS)" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Pestaña 4: Evolución de Signos Vitales -->
                                    <Button Command="{Binding SwitchPatientDetailTabCommand}" 
                                            CommandParameter="Evolucion" 
                                            Margin="0,0,8,0" 
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PatientDetailTab}" Value="Evolucion">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="📈 Evolución de Signos Vitales" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Pestaña 5: Citas Programadas del Paciente -->
                                    <Button Command="{Binding SwitchPatientDetailTabCommand}" 
                                            CommandParameter="Citas" 
                                            Padding="14,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PatientDetailTab}" Value="Citas">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding PatientAppointmentsHistory.Count, StringFormat='📅 Citas ({0})'}" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>

                                <!-- VISTA DE PESTAÑA 1: RESUMEN Y CONSULTA MÉDICA (NOM-004-SSA3) -->
                                <StackPanel Visibility="{Binding PatientDetailTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Resumen}">
                                    
                                    <!-- ================================================================= -->
                                    <!-- 1. PANEL DE CONSULTA MÉDICA EN CURSO (LLENADO EN TIEMPO REAL)     -->
                                    <!-- ================================================================= -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeAccent}" 
                                            BorderThickness="2" 
                                            CornerRadius="12" 
                                            Padding="16" 
                                            Margin="0,0,0,14" 
                                            Visibility="{Binding HasActiveConsultation, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <!-- Encabezado de la Consulta Activa -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource ThemeSuccess}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="● CONSULTA ACTIVA EN VIVO" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ActiveConsultationFolio, StringFormat='Folio: {0}'}" FontWeight="Bold" FontSize="14" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccent}" />
                                                        <TextBlock Text=" • Duración: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding ActiveConsultationElapsedTime}" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                    <TextBlock Text="Complete los datos de la nota médica conforme a la NOM-004-SSA3. Puede guardar avances o finalizar directamente." FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding SaveActiveConsultationNoteCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Guardar los avances de la nota clínica en el expediente sin finalizar la consulta">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0" />
                                                            <TextBlock Text="Guardar Nota" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{DynamicResource AccentButton}" Command="{Binding FinalizeConsultationAndOpenPosCommand}" Padding="12,6" ToolTip="Finalizar la consulta médica y enviar las recetas y servicios a cobrar en caja">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🛒" FontSize="12" Margin="0,0,5,0" />
                                                            <TextBlock Text="Finalizar y Cobrar" FontSize="11" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Motivo de la Consulta -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Motivo de la Consulta (Chief Complaint) *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding ConsultationChiefComplaint, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{DynamicResource ModernTextBox}" 
                                                             Padding="8,6" 
                                                             ToolTip="Motivo principal por el que el paciente acude a la consulta médica." />
                                                </StackPanel>
                                            </Border>

                                            <!-- Signos Vitales y Somatometría con Cálculo Automático de IMC -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="📊 Somatometría y Signos Vitales (Cálculo Automático de IMC)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="{DynamicResource ThemeAccent}" CornerRadius="5" Padding="8,3">
                                                            <TextBlock Text="{Binding ConsultationIMC, StringFormat='IMC: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" />
                                                        </Border>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="T.A. (mmHg)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationTA, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Tensión Arterial (ej. 120/80)" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="F.C. (lpm)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationFC, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Frecuencia Cardíaca en lpm" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="F.R. (rpm)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationFR, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Frecuencia Respiratoria en rpm" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="6">
                                                            <TextBlock Text="Temp (°C)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationTemp, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Temperatura corporal en °C" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="8">
                                                            <TextBlock Text="Glucosa (mg/dL)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationGlucose, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Glucosa capilar o sérica (mg/dL)" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="10">
                                                            <TextBlock Text="Peso (kg)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationWeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Peso del paciente en kilogramos" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="12">
                                                            <TextBlock Text="Talla (m)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding ConsultationHeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" ToolTip="Estatura en metros (ej. 1.70)" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Exploración por Aparatos y Sistemas -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="🩺 Interrogatorio y Exploración por Aparatos y Sistemas (NOM-004-SSA3)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,3" />
                                                    <TextBlock Text="Respiratorio, cardiovascular, digestivo, urinario, neurológico, músculo-esquelético y tegumentario." FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6" />
                                                    <TextBox Text="{Binding ConsultationSystemsReview, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{DynamicResource ModernTextBox}" 
                                                             AcceptsReturn="True" 
                                                             TextWrapping="Wrap" 
                                                             MinHeight="55" 
                                                             Padding="8,6" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Exploración Física General y Habitus Exterior -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="🩺 Exploración Física General y Habitus Exterior" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,3" />
                                                    <TextBlock Text="Cabeza, cuello, tórax, abdomen, extremidades, estado neurológico y marcha." FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6" />
                                                    <TextBox Text="{Binding ConsultationPhysicalExam, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{DynamicResource ModernTextBox}" 
                                                             AcceptsReturn="True" 
                                                             TextWrapping="Wrap" 
                                                             MinHeight="50" 
                                                             Padding="8,6" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Diagnóstico Clínico con Autocompletado CIE-10 -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🩺 Diagnóstico Clínico (Catálogo CIE-10 Oficial) *" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Grid.Column="1" Text="Escriba código o patología para autocompletar" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </Grid>
                                                    <TextBox x:Name="ActiveConsultationDiagnosisTextBox" 
                                                             Text="{Binding ConsultationDiagnosis, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{DynamicResource ModernTextBox}" 
                                                             PreviewKeyDown="DiagnosisTextBox_PreviewKeyDown"
                                                             Padding="8,6" />

                                                    <!-- Menú desplegable de sugerencias CIE-10 -->
                                                    <Border Background="{DynamicResource ThemeSurface}" 
                                                            BorderBrush="{DynamicResource ThemeAccent}" 
                                                            BorderThickness="1.5" 
                                                            CornerRadius="8" 
                                                            Margin="0,4,0,0" 
                                                            MaxHeight="220" 
                                                            Visibility="{Binding IsCie10DropdownOpen, Converter={StaticResource BoolToVis}}" 
                                                            SnapsToDevicePixels="True">
                                                        <ListBox x:Name="ActiveCie10SuggestionsListBox" 
                                                                 ItemsSource="{Binding Cie10Suggestions}" 
                                                                 BorderThickness="0" 
                                                                 Background="Transparent" 
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                                                 PreviewKeyDown="Cie10SuggestionsListBox_PreviewKeyDown" 
                                                                 PreviewMouseLeftButtonUp="Cie10SuggestionsListBox_PreviewMouseLeftButtonUp">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="Margin" Value="1" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6" SnapsToDevicePixels="True">
                                                                                    <ContentPresenter />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" />
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Plan Terapéutico e Indicaciones Médicas -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="📋 Plan Terapéutico, Cuidados e Indicaciones Médicas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
                                                        <!-- Plantillas rápidas -->
                                                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AppendGeneralIndicationPresetCommand}" CommandParameter="Hidratación abundante (mínimo 2 litros de agua al día)." Padding="6,2" Margin="0,0,4,0">
                                                                <TextBlock Text="+ Hidratación" FontSize="10" />
                                                            </Button>
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AppendGeneralIndicationPresetCommand}" CommandParameter="Reposo relativo por 48 horas, evitar esfuerzos físicos pesados." Padding="6,2" Margin="0,0,4,0">
                                                                <TextBlock Text="+ Reposo" FontSize="10" />
                                                            </Button>
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AppendGeneralIndicationPresetCommand}" CommandParameter="Dieta blanda baja en grasas, irritantes y condimentos." Padding="6,2" Margin="0,0,4,0">
                                                                <TextBlock Text="+ Dieta blanda" FontSize="10" />
                                                            </Button>
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AppendGeneralIndicationPresetCommand}" CommandParameter="Acudir a urgencias en caso de fiebre persistente &gt; 38.5°C o dificultad respiratoria." Padding="6,2">
                                                                <TextBlock Text="+ Alarma" FontSize="10" />
                                                            </Button>
                                                            <ComboBox ItemsSource="{Binding GeneralMeasureTemplates}"
                                                                      SelectedItem="{Binding SelectedGeneralMeasureTemplate, Mode=TwoWay}"
                                                                      DisplayMemberPath="Title"
                                                                      ToolTip="Medidas generales del consultorio (importadas del Excel)"
                                                                      Width="220"
                                                                      Height="24"
                                                                      FontSize="10"
                                                                      Margin="4,0,0,0"
                                                                      Visibility="{Binding HasGeneralMeasureTemplates, Converter={StaticResource BoolToVis}}" />
                                                        </WrapPanel>
                                                    </Grid>
                                                    <TextBox Text="{Binding ConsultationTreatmentPlan, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{DynamicResource ModernTextBox}" 
                                                             AcceptsReturn="True" 
                                                             TextWrapping="Wrap" 
                                                             MinHeight="55" 
                                                             Padding="8,6" />
                                                </StackPanel>
                                            </Border>



                                            <!-- Botones Inferiores de la Consulta Activa -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Style="{DynamicResource OutlineButton}" Command="{Binding CancelActiveConsultationCommand}" Padding="12,6" ToolTip="Cancelar la consulta en curso">
                                                    <TextBlock Text="Cancelar Consulta" FontSize="11" Foreground="{DynamicResource ThemeError}" />
                                                </Button>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding OpenPrescriptionModalCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Abrir receta médica para indicar medicamentos y posología">
                                                        <TextBlock Text="💊 + Receta" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding OpenSuppliesModalCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Agregar insumos y material de curación">
                                                        <TextBlock Text="📦 + Insumos" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding OpenServicesModalCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Agregar procedimientos y servicios clínicos">
                                                        <TextBlock Text="🩺 + Procedimientos" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Style="{DynamicResource AccentButton}" Command="{Binding FinalizeConsultationAndOpenPosCommand}" Padding="16,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🛒" FontSize="12" Margin="0,0,5,0" />
                                                            <TextBlock Text="Finalizar y Cobrar en POS" FontSize="11" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ================================================================= -->
                                    <!-- 2. BANNER DE INICIO DE CONSULTA (SI NO HAY CONSULTA ACTIVA)       -->
                                    <!-- ================================================================= -->
                                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                            BorderBrush="{DynamicResource ThemeAccent}" 
                                            BorderThickness="1.5" 
                                            CornerRadius="10" 
                                            Padding="16" 
                                            Margin="0,0,0,14"
                                            Visibility="{Binding HasActiveConsultation, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="🩺 Iniciar Consulta Médica con este Paciente" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text="Al iniciar la consulta podrá registrar en tiempo real signos vitales con IMC automático, exploración por aparatos y sistemas, diagnóstico clínico, plan de tratamiento y emitir la receta médica." 
                                                           FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="620" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Command="{Binding StartActiveConsultationCommand}" Padding="18,10" VerticalAlignment="Center" ToolTip="Iniciar una nueva consulta médica activa con este paciente">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🩺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Iniciar Consulta" FontSize="13" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- ================================================================= -->
                                    <!-- 3. EXPEDIENTE CLÍNICO INTEGRAL DEL PACIENTE (NOM-004-SSA3)        -->
                                    <!--    Oculto durante consulta activa para mantener el flujo limpio   -->
                                    <!-- ================================================================= -->
                                    <StackPanel Visibility="{Binding HasActiveConsultation, Converter={StaticResource InverseBoolToVis}}">
                                        <!-- Datos de Contacto y Antecedentes (NOM-004-SSA3) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Columna 1: Contacto y Ubicación -->
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="📞 Información de Contacto y General" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="Teléfono: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.FormattedPhone}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="Correo: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.Email}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="Domicilio: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.Address}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Ocupación: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.Occupation}" FontSize="11" Foreground="{DynamicResource ThemeText}" Margin="0,0,10,0" />
                                                    <TextBlock Text="Religión: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.Religion}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Columna 2: Antecedentes y Emergencia -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="🚨 Emergencia y Antecedentes" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="Contacto de emergencia: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.EmergencyContactName}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.FormattedEmergencyContactPhone}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Enfermedades crónicas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.ChronicDiseases}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Antecedentes Heredofamiliares (AHF) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="🧬 Antecedentes Heredofamiliares (AHF)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPatient.FamilyHistory}" FontSize="11.5" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Antecedentes Personales Patológicos (APP) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="🏥 Antecedentes Personales Patológicos (APP)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Cirugías previas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedPatient.Surgeries}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Transfusiones previas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedPatient.Transfusions}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Hospitalizaciones previas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedPatient.Hospitalizations}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Esquema de vacunación: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedPatient.ImmunizationSchedule}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Antecedentes Gineco-Obstétricos (AGO) (Visible para Mujeres) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12"
                                            Visibility="{Binding SelectedPatient.IsFemale, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="🌸 Antecedentes Gineco-Obstétricos (AGO)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6" />
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Menarca: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.MenarcheAge, StringFormat='{}{0} años'}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="IVSA: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.SexualOnsetAge, StringFormat='{}{0} años'}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Parejas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.SexualPartnersCount}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Periodo: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.PeriodDuration}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Flujo: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.IsPeriodHeavy}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Papanicolaou: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.PapSmear}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Gestas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.PregnanciesCount}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Cesáreas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.CesareansCount}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="Abortos: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding SelectedPatient.AbortionsCount}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <TextBlock Text="¿Embarazo actual?: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="Sí" Visibility="{Binding SelectedPatient.IsCurrentlyPregnant, Converter={StaticResource BoolToVis}}" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                                    <TextBlock Text="No" Visibility="{Binding SelectedPatient.IsCurrentlyPregnant, Converter={StaticResource InverseBoolToVis}}" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding SelectedPatient.GestationalWeeks, StringFormat=' ({0} sem)'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Visibility="{Binding SelectedPatient.IsCurrentlyPregnant, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hitos del Desarrollo Psicomotor (Visible para Niños) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeWarning}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12"
                                            Visibility="{Binding SelectedPatient.IsPediatric, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="👶 Hitos del Desarrollo Psicomotor (Pediátrico)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeWarning}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPatient.DevelopmentalMilestones}" FontSize="11.5" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Antecedentes No Patológicos (APNP) -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="🏡 Antecedentes Personales No Patológicos (APNP)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6" />
                                            <StackPanel Margin="0,0,0,3">
                                                <TextBlock Text="Alimentación y Nutrición: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.Diet}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,3">
                                                <TextBlock Text="Vivienda y Servicios: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.HousingConditions}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Zoonosis / Mascotas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding SelectedPatient.Zoonosis}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Signos Vitales y Diagnóstico de la Última Consulta -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="14" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="📊 Última Visita y Diagnóstico Registrado" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding SelectedPatient.VitalSigns, StringFormat='Signos Vitales: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedPatient.LastDiagnosis, StringFormat='Diagnóstico: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPatient.ClinicalNotes}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>

                                </StackPanel>

                                <!-- VISTA DE PESTAÑA 2: HISTORIAL CLÍNICO DE CONSULTAS (NOM-004-SSA3) -->
                                <StackPanel Visibility="{Binding PatientDetailTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Historial}">
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            CornerRadius="8" 
                                            Padding="18" 
                                            Margin="0,0,0,12" 
                                            Visibility="{Binding ConsultationsHistory.Count, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📋 Sin Consultas Registradas Previamente" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Presione el botón 'Nueva Consulta' arriba para generar la primera nota de evolución médica para este paciente." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Lista de Consultas Previas -->
                                    <ItemsControl ItemsSource="{Binding ConsultationsHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="10" 
                                                        Padding="14" 
                                                        Margin="0,0,0,12">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="{DynamicResource ThemeSurface}" 
                                                                 BorderBrush="{DynamicResource ThemeAccent}" 
                                                                 BorderThickness="1.5">
                                                            <StackPanel MaxWidth="360" Margin="4">
                                                                <TextBlock Text="{Binding Date, StringFormat='📅 Consulta del {0:dd/MM/yyyy HH:mm}'}" 
                                                                           FontWeight="Bold" FontSize="12" 
                                                                           Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6"/>
                                                                <TextBlock Text="{Binding ChiefComplaint, StringFormat='Motivo: {0}'}" 
                                                                           FontSize="11" Foreground="{DynamicResource ThemeText}" 
                                                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding Diagnosis, StringFormat='Diagnóstico: {0}'}" 
                                                                           FontWeight="SemiBold" FontSize="11" 
                                                                           Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding TreatmentPlan, StringFormat='Plan / Indicaciones: {0}'}" 
                                                                           FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel>
                                                        <!-- Cabecera de la Consulta -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <Border Background="{DynamicResource ThemeAccent}" 
                                                                            CornerRadius="4" 
                                                                            Padding="6,2" 
                                                                            Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Folio}" 
                                                                                   FontWeight="Bold" 
                                                                                   FontSize="11" 
                                                                                   FontFamily="Consolas" 
                                                                                   Foreground="{DynamicResource ThemeAccentText}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                                                               FontWeight="SemiBold" 
                                                                               FontSize="12" 
                                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                               VerticalAlignment="Center" />
                                                                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="4" 
                                                                            Padding="6,1.5" 
                                                                            Margin="8,0,0,0" 
                                                                            VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="⏱️ " FontSize="10" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding FormattedScheduleTime}" 
                                                                                       FontSize="11" 
                                                                                       FontWeight="SemiBold" 
                                                                                       Foreground="{DynamicResource ThemeAccent}" 
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ChiefComplaint, StringFormat='Motivo: {0}'}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="14" 
                                                                           Foreground="{DynamicResource ThemeText}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Signos Vitales de esa consulta -->
                                                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                CornerRadius="6" 
                                                                Padding="10,6" 
                                                                Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding VitalSigns}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{DynamicResource ThemeAccent}" />
                                                        </Border>

                                                        <!-- Exploración y Diagnóstico -->
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Diagnosis, StringFormat='Diagnóstico: {0}'}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12" 
                                                                       Foreground="{DynamicResource ThemeText}" 
                                                                       Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding PhysicalExamination, StringFormat='Exploración física: {0}'}" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       TextWrapping="Wrap" 
                                                                       Margin="0,0,0,2" 
                                                                       Visibility="{Binding PhysicalExamination.Length, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding TreatmentPlan, StringFormat='Plan terapéutico: {0}'}" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <!-- Prescripciones emitidas en esta consulta -->
                                                        <Border Background="{DynamicResource ThemeCard}" 
                                                                CornerRadius="6" 
                                                                Padding="10,8" 
                                                                Visibility="{Binding Prescriptions.Count, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <TextBlock Text="💊 Medicamentos Prescritos:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                                                <ItemsControl ItemsSource="{Binding Prescriptions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                                    <TextBlock Text="• " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" />
                                                                                    <TextBlock Text="{Binding MedicineName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeText}" Margin="0,0,6,0" />
                                                                                    <TextBlock Text="{Binding Dosage, StringFormat='({0})'}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1" Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>


                                
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- VISTA DE PESTAÑA 3: SERVICIOS Y PROCEDIMIENTOS (POS) -->
                                <StackPanel Visibility="{Binding PatientDetailTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Servicios}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Columna Izquierda: Catálogo de Servicios y Procedimientos -->
                                        <StackPanel Grid.Column="0">
                                            <Border Background="{DynamicResource ThemeSurface}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14" 
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="🩺 Catálogo de Servicios y Procedimientos" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="14" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Text="Seleccione los servicios realizados al paciente para agregarlos a la cuenta." 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" 
                                                            Style="{DynamicResource OutlineButton}" 
                                                            Command="{Binding OpenCreateServiceModalCommand}" 
                                                            Padding="10,5">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="+" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Nuevo Servicio" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Lista de Servicios Disponibles -->
                                            <ItemsControl ItemsSource="{Binding Services}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ThemeSurface}" 
                                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="8" 
                                                                Padding="12,10" 
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border Background="{DynamicResource ThemeAccent}" 
                                                                                CornerRadius="4" 
                                                                                Padding="5,2" 
                                                                                Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding Code}" 
                                                                                       FontWeight="Bold" 
                                                                                       FontSize="10" 
                                                                                       Foreground="{DynamicResource ThemeAccentText}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Name}" 
                                                                                   FontWeight="Bold" 
                                                                                   FontSize="12" 
                                                                                   Foreground="{DynamicResource ThemeText}" 
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Category, StringFormat='Categoría: {0}'}" 
                                                                               FontSize="11" 
                                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                               Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding EstimatedDurationMinutes, StringFormat='⏱️ Duración estimada: {0} min'}" 
                                                                               FontSize="10" 
                                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" 
                                                                           Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="14" 
                                                                           Foreground="{DynamicResource ThemeAccent}" 
                                                                           VerticalAlignment="Center" 
                                                                           Margin="12,0" />

                                                                <Button Grid.Column="2" 
                                                                        Style="{DynamicResource AccentButton}" 
                                                                        Command="{Binding DataContext.AddServiceToActiveConsultationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}" 
                                                                        Padding="12,6" 
                                                                        VerticalAlignment="Center" 
                                                                        ToolTip="Agregar este servicio a la cuenta de la consulta">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="+" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" />
                                                                        <TextBlock Text="Agregar a Cuenta" FontSize="11" FontWeight="Bold" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Columna Derecha: Resumen de Cuenta para POS -->
                                        <Border Grid.Column="2" 
                                                Background="{DynamicResource ThemeSurface}" 
                                                BorderBrush="{DynamicResource ThemeAccent}" 
                                                BorderThickness="1.5" 
                                                CornerRadius="10" 
                                                Padding="14" 
                                                VerticalAlignment="Top">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="💳 Cuenta de la Consulta (POS)" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="14" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Text="{Binding ActiveConsultation.ItemsCount, StringFormat='{}{0} concepto(s) registrados'}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" 
                                                            Background="{DynamicResource ThemeAccent}" 
                                                            CornerRadius="4" 
                                                            Padding="6,2">
                                                        <TextBlock Text="POS ACTIVO" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ThemeAccentText}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Lista de Conceptos a Cobrar -->
                                                <Border Background="{DynamicResource ThemeBackground}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="8" 
                                                        MaxHeight="260" 
                                                        Margin="0,0,0,12">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding ActiveConsultation.Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{DynamicResource ThemeBorder}" 
                                                                                BorderThickness="0,0,0,1" 
                                                                                Padding="4,6" 
                                                                                Margin="0,0,0,2">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                                                    <TextBlock Text="{Binding Code}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                                </StackPanel>

                                                                                <TextBlock Grid.Column="1" 
                                                                                           Text="{Binding Quantity, StringFormat='x{0}'}" 
                                                                                           FontSize="11" 
                                                                                           FontWeight="SemiBold" 
                                                                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                                           VerticalAlignment="Center" 
                                                                                           Margin="8,0" />

                                                                                <TextBlock Grid.Column="2" 
                                                                                           Text="{Binding Subtotal, StringFormat='{}{0:C}'}" 
                                                                                           FontWeight="Bold" 
                                                                                           FontSize="11" 
                                                                                           Foreground="{DynamicResource ThemeAccent}" 
                                                                                           VerticalAlignment="Center" 
                                                                                           Margin="4,0,8,0" />

                                                                                <Button Grid.Column="3" 
                                                                                        Style="{DynamicResource OutlineButton}" 
                                                                                        Command="{Binding DataContext.RemoveItemFromActiveConsultationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                        CommandParameter="{Binding}" 
                                                                                        Padding="4,2" 
                                                                                        VerticalAlignment="Center" 
                                                                                        ToolTip="Quitar este concepto de la cuenta">
                                                                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                                                </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Text="No hay servicios ni medicamentos agregados a la cuenta aún." 
                                                                       FontStyle="Italic" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       HorizontalAlignment="Center" 
                                                                       Margin="0,12" 
                                                                       Visibility="{Binding ActiveConsultation.ItemsCount, Converter={StaticResource InverseBoolToVis}}" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- Totales -->
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Subtotal:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding ActiveConsultation.Subtotal, StringFormat='{}{0:C}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="IVA (16%):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Text="{Binding ActiveConsultation.Tax, StringFormat='{}{0:C}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,6,0,12">
                                                    <Grid>
                                                        <TextBlock Text="TOTAL A COBRAR:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Text="{Binding ActiveConsultation.Total, StringFormat='{}{0:C}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>

                                                <!-- Botones de Acción de Cobro -->
                                                <Button Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding FinalizeConsultationAndOpenPosCommand}" 
                                                        Padding="14,9" 
                                                        Margin="0,0,0,8" 
                                                        ToolTip="Finalizar la consulta y abrir la ventana del POS para liquidar la cuenta">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🛒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Finalizar y Cobrar en POS" FontSize="12" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding OpenPosModalAsyncCommand}" 
                                                        Padding="12,6" 
                                                        ToolTip="Abrir la ventana completa del POS para agregar insumos o medicamentos adicionales">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="🔍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Abrir POS para Insumos Extras" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- VISTA DE PESTAÑA 4: EVOLUCIÓN DE SIGNOS VITALES (GRÁFICA Y MÉTRICAS) -->
                                <StackPanel Visibility="{Binding PatientDetailTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Evolucion}">
                                    <!-- Tarjeta de Controles y Filtros -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="16" 
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📈 Evolución Histórica de Signos Vitales" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text="Monitoreo de tendencias y curvas clínicas de peso, tensión arterial y glucosa entre consultas" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Filtrar métrica:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Style="{DynamicResource OutlineButton}" Command="{Binding SetVitalSignsFilterCommand}" CommandParameter="Todos" Padding="10,5" Margin="0,0,4,0">
                                                    <TextBlock Text="● Todos" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Style="{DynamicResource OutlineButton}" Command="{Binding SetVitalSignsFilterCommand}" CommandParameter="Peso" Padding="10,5" Margin="0,0,4,0">
                                                    <TextBlock Text="⚖️ Peso" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                </Button>
                                                <Button Style="{DynamicResource OutlineButton}" Command="{Binding SetVitalSignsFilterCommand}" CommandParameter="Presion" Padding="10,5" Margin="0,0,4,0">
                                                    <TextBlock Text="❤️ Presión" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                                                </Button>
                                                <Button Style="{DynamicResource OutlineButton}" Command="{Binding SetVitalSignsFilterCommand}" CommandParameter="Glucosa" Padding="10,5">
                                                    <TextBlock Text="🩸 Glucosa" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Tarjetas KPI con Últimos Valores Registrados -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- KPI 1: Peso -->
                                        <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Último Peso" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding LatestWeightFormatted}" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                                <TextBlock Text="Escala normal: 18.5 - 24.9 IMC" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- KPI 2: Presión Arterial -->
                                        <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Última T.A." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding LatestBPFormatted}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                                                <TextBlock Text="Óptima: &lt; 120/80 mmHg" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- KPI 3: Glucosa -->
                                        <Border Grid.Column="4" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Última Glucosa" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding LatestGlucoseFormatted}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                                <TextBlock Text="Ayuno normal: 70 - 100 mg/dL" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- KPI 4: IMC -->
                                        <Border Grid.Column="6" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Índice Masa (IMC)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TextBlock Text="{Binding LatestIMCFormatted}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,0" />
                                                <TextBlock Text="kg/m² somatometría" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Gráfica Visual de Curvas -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="16" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📊 Gráfica de Tendencia Temporal" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                        <Border Background="#3B82F6" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" />
                                                        <TextBlock Text="Peso (kg)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                        <Border Background="#EF4444" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" />
                                                        <TextBlock Text="T.A. Sistólica" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                        <Border Background="#F59E0B" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" />
                                                        <TextBlock Text="T.A. Diastólica" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" Margin="0,0,5,0" />
                                                        <TextBlock Text="Glucosa (mg/dL)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Lienzo de Gráfica Renderizado en WPF Nativo -->
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Height="220" ClipToBounds="True">
                                                <Grid>
                                                    <!-- Mensaje si no hay puntos -->
                                                    <TextBlock Text="No hay consultas registradas con signos vitales numéricos para este paciente." 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center" 
                                                               Visibility="{Binding HasEnoughPointsForChart, Converter={StaticResource InverseBoolToVis}}" />

                                                    <!-- Curvas polilíneas y puntos -->
                                                    <Canvas Visibility="{Binding HasEnoughPointsForChart, Converter={StaticResource BoolToVis}}">
                                                        <!-- Líneas guía horizontales de fondo -->
                                                        <Line X1="30" Y1="40" X2="620" Y2="40" Stroke="{DynamicResource ThemeBorder}" StrokeDashArray="3,3" StrokeThickness="0.8" />
                                                        <Line X1="30" Y1="100" X2="620" Y2="100" Stroke="{DynamicResource ThemeBorder}" StrokeDashArray="3,3" StrokeThickness="0.8" />
                                                        <Line X1="30" Y1="160" X2="620" Y2="160" Stroke="{DynamicResource ThemeBorder}" StrokeDashArray="3,3" StrokeThickness="0.8" />

                                                        <!-- Curva Peso -->
                                                        <Polyline Points="{Binding WeightPolylinePoints}" Stroke="#3B82F6" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                        <!-- Curva Presión Sistólica -->
                                                        <Polyline Points="{Binding SystolicPolylinePoints}" Stroke="#EF4444" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                        <!-- Curva Presión Diastólica -->
                                                        <Polyline Points="{Binding DiastolicPolylinePoints}" Stroke="#F59E0B" StrokeThickness="2" StrokeDashArray="2,2" StrokeLineJoin="Round" />
                                                        <!-- Curva Glucosa -->
                                                        <Polyline Points="{Binding GlucosePolylinePoints}" Stroke="#10B981" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                    </Canvas>

                                                    <!-- Puntos de datos y etiquetas -->
                                                    <ItemsControl ItemsSource="{Binding ChartPoints}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Canvas Margin="-5,-5,0,0">
                                                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" Stroke="White" StrokeThickness="1.5" ToolTip="{Binding ValueLabel}" />
                                                                </Canvas>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tabla Histórica Detallada de Mediciones -->
                                    <Border Background="{DynamicResource ThemeSurface}" 
                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="📋 Historial Completo de Mediciones Clínicas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,10" />

                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Fecha" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="1" Text="Peso" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="2" Text="T.A." FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="3" Text="Glucosa" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="4" Text="F.C." FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="5" Text="Temp" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    <TextBlock Grid.Column="6" Text="IMC" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding VitalSignsEvolutionPoints}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="100" />
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="80" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding FormattedDate}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding WeightText}" FontSize="12" Foreground="#3B82F6" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Text="{Binding BloodPressureText}" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="3" Text="{Binding GlucoseText}" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="4" Text="{Binding HeartRate, TargetNullValue='--'}" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                                <TextBlock Grid.Column="5" Text="{Binding TempText}" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                                <TextBlock Grid.Column="6" Text="{Binding BMI, StringFormat='{}{0:F1}', TargetNullValue='--'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- VISTA DE PESTAÑA 5: CITAS DEL PACIENTE -->
                                <StackPanel Visibility="{Binding PatientDetailTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Citas}">
                                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📅 Agenda de Citas del Paciente" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text="Historial y próximas consultas programadas con opciones de sincronización y recordatorio" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Command="{Binding OpenNewAppointmentModalCommand}" CommandParameter="{x:Null}" Padding="14,7">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="+" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" />
                                                    <TextBlock Text="Agendar Nueva Cita" FontSize="12" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Lista de Citas del Paciente -->
                                    <ItemsControl ItemsSource="{Binding PatientAppointmentsHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Fecha y Hora -->
                                                        <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding FormattedDate}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Datos de la Cita -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Reason}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                                                <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Notes, StringFormat='Notas: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding DurationMinutes, StringFormat='⏱️ Duración: {0} minutos'}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Botones de Acción: Calendar, WhatsApp, Atender, Cancelar -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Google Calendar -->
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding DataContext.OpenGoogleCalendarTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,6" Margin="0,0,6,0" ToolTip="Agregar a Google Calendar">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="📅" FontSize="11" Margin="0,0,4,0" />
                                                                    <TextBlock Text="Google Calendar" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- WhatsApp -->
                                                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding DataContext.OpenWhatsAppTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,6" Margin="0,0,6,0" ToolTip="Enviar recordatorio por WhatsApp">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="💬" FontSize="11" Margin="0,0,4,0" />
                                                                    <TextBlock Text="WhatsApp" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Marcar Atendida -->
                                                            <Button Style="{DynamicResource GhostButton}" Command="{Binding DataContext.MarkAppointmentAttendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6" Margin="0,0,4,0" ToolTip="Marcar como atendida">
                                                                <TextBlock Text="✓ Atendida" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSuccess}" />
                                                            </Button>

                                                            <!-- Eliminar -->
                                                            <Button Style="{DynamicResource GhostButton}" Command="{Binding DataContext.DeleteAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6" ToolTip="Eliminar cita">
                                                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL: ALTA / EDICIÓN DE EXPEDIENTE CLÍNICO (NOM-004-SSA3)                 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#99000000" 
                Visibility="{Binding IsPatientModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Padding="26,22" 
                    MaxWidth="860" 
                    MaxHeight="750" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal con Stepper de Pasos -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource ThemeAccent}" 
                                            CornerRadius="6" 
                                            Padding="8,3" 
                                            Margin="0,0,8,0">
                                        <TextBlock Text="📋 EXPEDIENTE CLÍNICO" 
                                                   FontWeight="Bold" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeAccentText}" />
                                    </Border>
                                    <TextBlock Text="{Binding PatientModalTitle}" 
                                               FontWeight="Bold" 
                                               FontSize="17" 
                                               Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>
                                <TextBlock Text="Historia clínica integral conforme a los requerimientos oficiales de la NOM-004-SSA3." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                            </StackPanel>

                            <!-- Badges Dinámicos de Perfil Condicional -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeAccent}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        Margin="0,0,6,0"
                                        Visibility="{Binding FormIsFemale, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="♀️ Femenino (AGO Activo)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                </Border>
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeWarning}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,4"
                                        Visibility="{Binding FormIsPediatric, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="👶 Pediátrico (Hitos y Vacunas)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Pestañas de Navegación por Pasos -->
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="4">
                            <UniformGrid Columns="4">
                                <!-- Paso 1: Identificación -->
                                <Button Command="{Binding SetFormPatientStepTabCommand}" 
                                        CommandParameter="Identificacion" 
                                        Padding="6,6" 
                                        Margin="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormPatientActiveTab}" Value="Identificacion">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="1. " FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="Identificación" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Paso 2: AHF y APP -->
                                <Button Command="{Binding SetFormPatientStepTabCommand}" 
                                        CommandParameter="Patologicos" 
                                        Padding="6,6" 
                                        Margin="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormPatientActiveTab}" Value="Patologicos">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="2. " FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="AHF y Patológicos" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Paso 3: Gineco / Hitos -->
                                <Button Command="{Binding SetFormPatientStepTabCommand}" 
                                        CommandParameter="GinecoHitos" 
                                        Padding="6,6" 
                                        Margin="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormPatientActiveTab}" Value="GinecoHitos">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="3. " FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="Gineco / Hitos" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Paso 4: APNP -->
                                <Button Command="{Binding SetFormPatientStepTabCommand}" 
                                        CommandParameter="NoPatologicos" 
                                        Padding="6,6" 
                                        Margin="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormPatientActiveTab}" Value="NoPatologicos">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="4. " FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="No Patológicos (APNP)" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- Formulario con Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Alerta de Error si existe -->
                            <Border Background="#33EF4444" 
                                    BorderBrush="{DynamicResource ThemeError}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="12,8" 
                                    Margin="0,0,0,12" 
                                    Visibility="{Binding FormErrorMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FormErrorMessage}" 
                                           Foreground="{DynamicResource ThemeError}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" />
                            </Border>

                            <!-- ============================================================= -->
                            <!-- PESTAÑA 1: FICHA DE IDENTIFICACIÓN                            -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding FormPatientActiveTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Identificacion}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Columna 1: Datos Personales y Demografía -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DATOS PERSONALES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <TextBlock Text="Folio de Expediente *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormRecordNumber, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 FontFamily="Consolas" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" />

                                        <TextBlock Text="Nombre(s) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Apellido Paterno *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Apellido Materno" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormMaternalLastName, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Edad (Años) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormAgeText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Sexo / Género *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding GenderOptions}" 
                                                          SelectedItem="{Binding FormGender}" 
                                                          Height="36" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ocupación" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormOccupation, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Religión" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormReligion, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Columna 2: Contacto, Ubicación y Emergencia -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="LOCALIZACIÓN Y CONTACTO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Teléfono de Contacto" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Grupo Sangre" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding BloodTypeOptions}" 
                                                          SelectedItem="{Binding FormBloodType}" 
                                                          Height="36" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Correo Electrónico" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" />

                                        <TextBlock Text="Domicilio Habitual" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" />

                                        <TextBlock Text="CONTACTO DE EMERGENCIA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nombre del Contacto" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormEmergencyContactName, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Teléfono Emergencia" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormEmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- PESTAÑA 2: HEREDOFAMILIARES (AHF) Y PATOLÓGICOS (APP)        -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding FormPatientActiveTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Patologicos}">
                                <!-- Antecedentes Heredofamiliares -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🧬 ANTECEDENTES HEREDOFAMILIARES (AHF)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="Diabetes mellitus, hipertensión arterial, cardiopatías, nefropatías, cáncer u oncología, enfermedades psiquiátricas en familiares de primer o segundo grado (padres, abuelos, hermanos)." 
                                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding FormFamilyHistory, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 AcceptsReturn="True" 
                                                 TextWrapping="Wrap" 
                                                 MinHeight="60" 
                                                 Padding="10,6" />
                                    </StackPanel>
                                </Border>

                                <!-- Antecedentes Personales Patológicos -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🏥 ANTECEDENTES PERSONALES PATOLÓGICOS (APP)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Columna APP 1 -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Enfermedades Crónicas / Comorbilidades" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormChronicDiseases, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" 
                                                         Margin="0,0,0,10" />

                                                <TextBlock Text="Cirugías Previas (Quirúrgicos)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormSurgeries, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" 
                                                         Margin="0,0,0,10" />

                                                <TextBlock Text="Transfusiones Previas" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormTransfusions, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                            </StackPanel>

                                            <!-- Columna APP 2 -->
                                            <StackPanel Grid.Column="2">
                                                <Border BorderBrush="{DynamicResource ThemeError}" BorderThickness="1.5" CornerRadius="6" Padding="6,4" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="⚠️ Alergias Medicamentosas / Alimentos *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" Margin="0,0,0,4" />
                                                        <TextBox Text="{Binding FormAllergies, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Style="{DynamicResource ModernTextBox}" 
                                                                 Padding="8,5" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Hospitalizaciones Previas" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormHospitalizations, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" 
                                                         Margin="0,0,0,10" />

                                                <!-- Esquema de Vacunación (Resaltado en Niños) -->
                                                <TextBlock Text="Esquema de Vacunación" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormImmunizationSchedule, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="10,6" />
                                                <TextBlock Text="Para pacientes pediátricos: BCG, HepB, Hexavalente, Rotavirus, Neumococo, SRP." 
                                                           FontSize="10.5" 
                                                           Foreground="{DynamicResource ThemeWarning}" 
                                                           Margin="0,2,0,0" 
                                                           Visibility="{Binding FormIsPediatric, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- PESTAÑA 3: GINECO-OBSTÉTRICOS (AGO) / HITOS DEL DESARROLLO   -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding FormPatientActiveTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=GinecoHitos}">
                                <!-- Sección Mujeres: Antecedentes Gineco-Obstétricos -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeAccent}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12"
                                        Visibility="{Binding FormIsFemale, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="🌸 ANTECEDENTES GINECO-OBSTÉTRICOS (AGO)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Menarca (Edad 1ª Regla)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormMenarcheAge, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Inicio Vida Sexual (IVSA)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormSexualOnsetAge, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Parejas Sexuales" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormSexualPartnersCount, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,5" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Duración Ciclo / Periodo" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormPeriodDuration, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Flujo Menstrual" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding PeriodHeavyOptions}" SelectedItem="{Binding FormIsPeriodHeavy}" Height="34" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Papanicolaou (Fecha/Result)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormPapSmear, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,5" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Obstétricos: Embarazos, Cesáreas, Abortos, Embarazo Actual -->
                                        <TextBlock Text="HISTORIAL OBSTÉTRICO (FÓRMULA G-P-C-A)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,6" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Gestas" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormPregnanciesCount, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cesáreas" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormCesareansCount, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Abortos" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormAbortionsCount, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,5" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding FormIsCurrentlyPregnant}" Content="¿Embarazo actual?" FontWeight="Bold" FontSize="11" Margin="4,14,4,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="8">
                                                <TextBlock Text="Semanas Gestación" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FormGestationalWeeks, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{DynamicResource ModernTextBox}" 
                                                         Padding="6,5"
                                                         IsEnabled="{Binding FormIsCurrentlyPregnant}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Sección Niños: Hitos del Desarrollo Psicomotor -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeWarning}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12"
                                        Visibility="{Binding FormIsPediatric, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="👶 HITOS DEL DESARROLLO PSICOMOTOR (PEDIÁTRICO)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeWarning}" Margin="0,0,0,4" />
                                        <TextBlock Text="Registre edades y progreso clave: sostén cefálico, sedestación (sentarse solo), gateo, bipedestación, edad en que empezó a caminar, primeras palabras y lenguaje, control de esfínteres." 
                                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding FormDevelopmentalMilestones, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 AcceptsReturn="True" 
                                                 TextWrapping="Wrap" 
                                                 MinHeight="70" 
                                                 Padding="10,6" />
                                    </StackPanel>
                                </Border>

                                <!-- Estado cuando no es mujer ni pediátrico -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding FormIsFemale}" Value="False" />
                                                        <Condition Binding="{Binding FormIsPediatric}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ℹ️ Sección No Aplicable Directamente" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Este paciente es un varón adulto. Los antecedentes gineco-obstétricos y los hitos del desarrollo psicomotor pediátrico no aplican obligatoriamente. Puede continuar al siguiente paso de Antecedentes No Patológicos." 
                                                   FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="560" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================= -->
                            <!-- PESTAÑA 4: PERSONALES NO PATOLÓGICOS (APNP)                   -->
                            <!-- ============================================================= -->
                            <StackPanel Visibility="{Binding FormPatientActiveTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=NoPatologicos}">
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14" 
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🏡 ANTECEDENTES PERSONALES NO PATOLÓGICOS (APNP)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <!-- Alimentación -->
                                        <TextBlock Text="Alimentación y Hábitos Dietéticos" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormDiet, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" 
                                                 ToolTip="Frecuencia de comidas, calidad de la dieta, ingesta de líquidos al día." />

                                        <!-- Vivienda -->
                                        <TextBlock Text="Vivienda y Servicios Básicos" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormHousingConditions, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" 
                                                 ToolTip="Tipo de piso/techo, servicios básicos (agua potable, drenaje, luz eléctrica), hacinamiento." />

                                        <!-- Zoonosis y Mascotas -->
                                        <TextBlock Text="Zoonosis y Convivencia con Mascotas / Animales" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormZoonosis, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="10,6" 
                                                 Margin="0,0,0,10" 
                                                 ToolTip="Convivencia con perros, gatos u otros animales de granja, desparasitación y vacunación animal." />

                                        <!-- Notas Clínicas Iniciales -->
                                        <TextBlock Text="Notas Clínicas Iniciales / Observaciones de Ingreso" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormClinicalNotes, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Height="60" 
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True" 
                                                 Padding="10,6" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones de Acción del Modal con Navegación de Pasos -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding ClosePatientModalCommand}" 
                                Padding="16,8">
                            <TextBlock Text="Cancelar" FontSize="13" />
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding PreviousFormPatientStepCommand}" 
                                    Margin="0,0,8,0" 
                                    Padding="14,8">
                                <TextBlock Text="← Anterior" FontSize="12" FontWeight="SemiBold" />
                            </Button>

                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding NextFormPatientStepCommand}" 
                                    Margin="0,0,10,0" 
                                    Padding="14,8">
                                <TextBlock Text="Siguiente →" FontSize="12" FontWeight="SemiBold" />
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding SavePatientModalCommand}" 
                                    Padding="20,8">
                                <TextBlock Text="💾 Guardar Expediente" FontWeight="Bold" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: REGISTRO DE CONSULTA MÉDICA Y NOTA DE EVOLUCIÓN (NOM-004-SSA3)       -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#99000000" 
                Visibility="{Binding IsConsultationModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Padding="26,20" 
                    MaxWidth="860" 
                    MaxHeight="740" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Background="{DynamicResource ThemeAccent}" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="🩺 NOTA MÉDICA" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeAccentText}" />
                            </Border>
                            <TextBlock Text="Nueva Consulta y Nota de Evolución (NOM-004-SSA3)" 
                                       FontWeight="Bold" 
                                       FontSize="17" 
                                       Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Paciente: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Text="{Binding SelectedPatient.FullName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text=" • Folio Expediente: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding SelectedPatient.RecordNumber}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                            <TextBlock Text=" • Alergias: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding SelectedPatient.Allergies}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeError}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Formulario con Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Error Banner -->
                            <Border Background="#33EF4444" 
                                    BorderBrush="{DynamicResource ThemeError}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="12,8" 
                                    Margin="0,0,0,10" 
                                    Visibility="{Binding ConsultationErrorMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ConsultationErrorMessage}" 
                                           Foreground="{DynamicResource ThemeError}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" />
                            </Border>

                            <!-- Folio y Motivo de Consulta -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Folio de Consulta *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ConsultationFolio, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             FontFamily="Consolas" 
                                             Padding="10,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Motivo de la Consulta (Chief Complaint) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ConsultationChiefComplaint, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Somatometría y Signos Vitales (Con cálculo de IMC) -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12,10" 
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📊 Somatometría y Signos Vitales (NOM-004-SSA3)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                        
                                        <!-- Badge de IMC Calculado -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource ThemeAccent}" 
                                                CornerRadius="5" 
                                                Padding="8,3">
                                            <TextBlock Text="{Binding ConsultationIMC, StringFormat='IMC: {0}'}" 
                                                       FontWeight="Bold" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource ThemeAccentText}" />
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="T.A. (mmHg)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationTA, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="F.C. (lpm)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationFC, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="F.R. (rpm)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationFR, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Temp (°C)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationTemp, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="Peso (kg)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationWeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="10">
                                            <TextBlock Text="Talla (m)" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ConsultationHeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="6,4" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Exploración Física -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Exploración Física / Habitus Exterior" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ConsultationPhysicalExam, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Height="48" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         Padding="8,5" />
                            </StackPanel>

                            <!-- Diagnóstico Clínico -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Diagnóstico Clínico (CIE-10 / Análisis) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ConsultationDiagnosis, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="8,5" />
                            </StackPanel>

                            <!-- Plan de Tratamiento e Indicaciones -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Plan Terapéutico e Indicaciones Médicas" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ConsultationTreatmentPlan, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Height="48" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         Padding="8,5" />
                            </StackPanel>

                            <!-- Receta Médica y Fármacos -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="💊 Prescripción de Receta Médica" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8" />

                                    <!-- Fila de Agregar Medicamento -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding NewPrescriptionMedicine, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="6,4" 
                                                 ToolTip="Medicamento / Presentación" />

                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding NewPrescriptionDosage, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 Padding="6,4" 
                                                 ToolTip="Posología (ej. 1 tableta c/8h x 5 días)" />

                                        <TextBox Grid.Column="4" 
                                                 Text="{Binding NewPrescriptionQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 HorizontalContentAlignment="Center" 
                                                 Padding="6,4" 
                                                 ToolTip="Cantidad a surtir" />

                                        <Button Grid.Column="6" 
                                                Style="{DynamicResource AccentButton}" 
                                                Command="{Binding AddPrescriptionItemCommand}" 
                                                Padding="10,4">
                                            <TextBlock Text="+ Recetar" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                    </Grid>

                                    <!-- Lista de Medicamentos agregados a la receta -->
                                    <ItemsControl ItemsSource="{Binding ConsultationPrescriptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="5" 
                                                        Padding="8,5" 
                                                        Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Dosage}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="{DynamicResource ThemeBorder}" CornerRadius="3" Padding="5,1" Margin="8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                                                        </Border>

                                                        <Button Grid.Column="2" 
                                                                Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.RemovePrescriptionItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" 
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ThemeError}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Checkbox Consulta Activa para POS -->
                            <CheckBox IsChecked="{Binding ConsultationStartActivePos}" 
                                      VerticalContentAlignment="Center" 
                                      Margin="4,0,0,0">
                                <TextBlock Text="Iniciar o sincronizar con Consulta Activa en POS para dispensar insumos de inmediato" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones de Acción del Modal -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseConsultationModalCommand}" 
                                Margin="0,0,10,0" 
                                Padding="16,8">
                            <TextBlock Text="Cancelar" FontSize="13" />
                        </Button>

                        <Button Style="{DynamicResource AccentButton}" 
                                Command="{Binding SaveConsultationModalCommand}" 
                                Padding="20,8">
                            <TextBlock Text="Guardar Consulta y Receta" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL INFORMATIVO Y ALERTAS                                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#99000000" 
                Visibility="{Binding IsInfoModalVisible, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Padding="30,26" 
                    MaxWidth="560" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="{DynamicResource ThemeAccent}" 
                            CornerRadius="6" 
                            Padding="12,5" 
                            HorizontalAlignment="Left" 
                            Margin="0,0,0,12">
                        <TextBlock Text="ℹ️ NOTIFICACIÓN CLÍNICA" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeAccentText}" />
                    </Border>
                    <TextBlock Text="Expedientes Clínicos y Consultas" 
                               FontWeight="Bold" 
                               FontSize="19" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding InfoModalMessage}" 
                               FontSize="13" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               TextWrapping="Wrap" 
                               LineHeight="22" 
                               Margin="0,0,0,24" />
                    <Button Style="{DynamicResource AccentButton}" 
                            Command="{Binding DismissInfoModalCommand}" 
                            HorizontalAlignment="Right" 
                            Padding="22,10">
                        <TextBlock Text="Aceptar" FontWeight="Bold" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL / VENTANA: PUNTO DE VENTA (POS) INTEGRADO PARA CONSULTA ACTIVA      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsPosModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="1200" 
                    MaxHeight="730" 
                    Margin="18,12" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Ventana Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="26" Height="26" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconCart}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="13" Height="13" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Punto de Venta - Agregar Insumos y Servicios a Consulta Activa" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <WrapPanel Margin="36,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Paciente: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                <TextBlock Text="{Binding ActiveConsultationPatientName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Text=" • Folio: " FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding ActiveConsultationFolio}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                                <TextBlock Text=" • Agregue ítems o servicios y presione 'Guardar en Consulta Activa'." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="6,0,0,0" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Botón Cerrar Ventana Modal -->
                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding ClosePosModalCommand}" 
                                Padding="12,6" 
                                VerticalAlignment="Center">
                            <TextBlock Text="✕ Cerrar y Volver al Expediente" FontWeight="Bold" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Contenido: POS Reutilizado -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            ClipToBounds="True">
                        <views:PosView DataContext="{Binding PosVM}" />
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: SELECCIONAR / CAMBIAR PACIENTE                                     -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsSelectPatientModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="250">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="800" 
                    MaxHeight="680" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconUser}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding PatientActionButtonText, StringFormat='{}{0} para Expediente'}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Busque y seleccione un paciente registrado o dé de alta un nuevo expediente clínico." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseSelectPatientModalCommand}" 
                                Padding="8,5" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Buscador y Botón Nuevo Paciente -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Input de Búsqueda -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" 
                                      Data="{StaticResource IconSearch}" 
                                      Fill="{DynamicResource ThemeTextSecondary}" 
                                      Width="14" Height="14" 
                                      Stretch="Uniform" 
                                      Margin="4,0,10,0" 
                                      VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" 
                                         x:Name="SelectPatientSearchTextBox"
                                         Text="{Binding SelectPatientSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         VerticalAlignment="Center" 
                                         Foreground="{DynamicResource ThemeText}" />
                                <TextBlock Grid.Column="1" 
                                           Text="Buscar por nombre, folio, teléfono o diagnóstico..." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False" 
                                           Margin="4,0,0,0"
                                           Visibility="{Binding SelectPatientSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                            </Grid>
                        </Border>

                        <!-- Botón Nuevo Paciente -->
                        <Button Grid.Column="2" 
                                Style="{DynamicResource AccentButton}" 
                                Command="{Binding NewPatientFromSelectorCommand}" 
                                Padding="16,8" 
                                ToolTip="Registrar un nuevo paciente y asignarlo al expediente">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" 
                                      Fill="{DynamicResource ThemeAccentText}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Nuevo Paciente" FontWeight="Bold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Lista de Pacientes Seleccionables -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectablePatients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="14,10" 
                                                Margin="4,4,4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Información del Paciente -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="14" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <Border Background="{DynamicResource ThemeBorder}" 
                                                                CornerRadius="4" 
                                                                Padding="6,2" 
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding RecordNumber}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                        <TextBlock Text="{Binding Age, StringFormat='{}{0} años'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding Gender}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text=" • Grupo: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding BloodType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text=" • Tel: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding FormattedPhone}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding LastDiagnosis, StringFormat='Último diagnóstico: {0}'}" 
                                                               FontSize="11" 
                                                               FontStyle="Italic" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               TextTrimming="CharacterEllipsis" 
                                                               Margin="0,2,0,0" />

                                                    <!-- Badges de Alergias y Próxima Cita -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource ThemeError}" 
                                                                CornerRadius="4" 
                                                                Padding="6,2" 
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Allergies, StringFormat='⚠️ ALERGIAS: {0}'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                BorderBrush="{DynamicResource ThemeAccent}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="4" 
                                                                Padding="6,2"
                                                                Visibility="{Binding HasScheduledAppointment, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding FormattedNextAppointment, StringFormat='📅 {0}'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{DynamicResource ThemeAccent}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Botón Seleccionar -->
                                                <Button Grid.Column="1" 
                                                        Style="{DynamicResource AccentButton}" 
                                                        Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Padding="16,8" 
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconCheck}" 
                                                              Fill="{DynamicResource ThemeAccentText}" 
                                                              Width="12" Height="12" 
                                                              Stretch="Uniform" 
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Seleccionar" FontWeight="Bold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Pie de la Modal -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Botón Deseleccionar Paciente si hay uno activo -->
                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding DeselectPatientCommand}" 
                                Padding="12,6" 
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✕ Quitar Selección de Paciente" FontSize="11" Foreground="{DynamicResource ThemeError}" />
                        </Button>

                        <!-- Botón Cerrar -->
                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseSelectPatientModalCommand}" 
                                Padding="16,7">
                            <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

                <!-- ========================================================================= -->
        <!-- MODAL: RECETA MÉDICA INTERACTIVA Y PRESCRIPCIÓN                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsPrescriptionModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="250">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="800" 
                    MaxHeight="680" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="💊" 
                                               FontSize="15" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Receta Médica y Prescripción" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Prescripción de medicamentos con posología e indicaciones oficiales para la receta médica." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding OpenPrescriptionCatalogCommand}" 
                                    Padding="10,6" 
                                    Margin="0,0,8,0" 
                                    ToolTip="Buscar medicamento en el catálogo completo">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" 
                                          Fill="{DynamicResource ThemeAccent}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Buscar en Catálogo" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding ClosePrescriptionModalCommand}" 
                                    Padding="8,5" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Formulario de Captura Rápida de Medicamentos -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Búsqueda / Nombre de Medicamento -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Medicamento *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="PrescriptionSearchTextBox"
                                                 Text="{Binding PrescriptionSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="PrescriptionSearchTextBox_PreviewKeyDown" />
                                        <TextBlock Text="Escriba o busque medicamento..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding PrescriptionSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Indicaciones / Posología -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Indicaciones / Posología" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="PrescriptionDosageTextBox"
                                                 Text="{Binding PrescriptionDosage, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="PrescriptionAuxInput_PreviewKeyDown" />
                                        <TextBlock Text="Ej: 1 tableta c/8h por 5 días..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding PrescriptionDosage, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Cantidad -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="PrescriptionQuantityTextBox"
                                             Text="{Binding PrescriptionQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="6,6" 
                                             HorizontalContentAlignment="Center" 
                                             Background="{DynamicResource ThemeBackground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             Foreground="{DynamicResource ThemeText}"
                                             PreviewKeyDown="PrescriptionAuxInput_PreviewKeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Plantillas del Excel del consultorio: posología frecuente y dosis pediátrica por peso -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Visibility="{Binding HasPosologyTemplates, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="📋 Posología frecuente" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PosologyTemplates}"
                                              SelectedItem="{Binding SelectedPosologyTemplate, Mode=TwoWay}"
                                              DisplayMemberPath="Text"
                                              ToolTip="Elija una plantilla para copiarla a las indicaciones"
                                              Height="32" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding HasPediatricDoseRules, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="👶 Dosis pediátrica por peso" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding PediatricDoseRules}"
                                                  SelectedItem="{Binding SelectedPediatricRule, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  Height="32" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding PediatricWeightText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Peso del paciente en kg"
                                                 FontSize="12"
                                                 Padding="6,6"
                                                 Margin="6,0,0,0"
                                                 HorizontalContentAlignment="Center"
                                                 Background="{DynamicResource ThemeBackground}"
                                                 BorderBrush="{DynamicResource ThemeBorder}"
                                                 Foreground="{DynamicResource ThemeText}" />
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource OutlineButton}"
                                                Command="{Binding ApplyPediatricDoseCommand}"
                                                Content="Usar"
                                                ToolTip="Copiar la dosis calculada a las indicaciones"
                                                Padding="10,4"
                                                Margin="6,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding PediatricDoseResult}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ThemeAccent}"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding PediatricDoseResult, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Indicador de atajos de teclado -->
                            <Border Background="{DynamicResource ThemeSurfaceHighlight}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,5" 
                                    Margin="0,0,0,6">
                                <TextBlock Text="💡 Flechas ↑ ↓ para navegar en la lista, Enter o clic para agregar a la receta, Esc para salir" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                            </Border>

                            <!-- Lista de Sugerencias de Inventario -->
                            <Border Visibility="{Binding IsPrescriptionDropdownOpen, Converter={StaticResource BoolToVis}}" 
                                    Background="{DynamicResource ThemeBackground}" 
                                    BorderBrush="{DynamicResource ThemeAccent}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="2" 
                                    MaxHeight="160">
                                <ListBox x:Name="PrescriptionSuggestionsListBox"
                                         ItemsSource="{Binding PrescriptionProductSuggestions}"
                                         SelectedItem="{Binding SelectedPrescriptionProduct, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="PrescriptionSuggestionsListBox_PreviewKeyDown"
                                         PreviewMouseLeftButtonUp="PrescriptionSuggestionsListBox_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="1.5" 
                                                                CornerRadius="6" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="SelectorArrow" Text="▶ " Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                <ContentPresenter Grid.Column="1" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="SelectorArrow" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding Presentation}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="10,0,10,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:C}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Medicamentos en la Receta -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="8">
                        <Grid>
                            <!-- Lista con scroll -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedPatient.ActivePrescription}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MedicineName}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Text="{Binding Dosage, StringFormat='Indicaciones: {0}'}" 
                                                                   FontSize="11.5" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   Margin="0,3,0,0" 
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                                                        <Border Background="{DynamicResource ThemeBorder}" 
                                                                CornerRadius="4" 
                                                                Padding="8,4" 
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                        </Border>
                                                        <Button Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.AddPrescriptionItemToPosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,4" 
                                                                ToolTip="Agregar este medicamento a la cuenta de la consulta activa para cobro en el POS">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🛒" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Agregar al POS" FontSize="10.5" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" 
                                                            Style="{DynamicResource OutlineButton}" 
                                                            Command="{Binding DataContext.RemovePrescriptionItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="8,5" 
                                                            VerticalAlignment="Center" 
                                                            ToolTip="Quitar medicamento de la receta">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Mensaje si no hay receta -->
                            <Border Background="{DynamicResource ThemeCard}" 
                                    CornerRadius="8" 
                                    Padding="24" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Visibility="{Binding SelectedPatient.ActivePrescription.Count, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💊 No hay medicamentos prescritos aún en esta receta médica." 
                                               FontStyle="Italic" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Escriba o elija un fármaco en el formulario superior para recetar e indicar la posología." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pie de la Modal -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Botón Vista Previa / Generar Receta PDF -->
                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding OpenPrescriptionPdfPreviewCommand}" 
                                Padding="12,6" 
                                HorizontalAlignment="Left" 
                                ToolTip="Generar vista previa e imprimir receta oficial NOM-004-SSA3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFileMedical}" 
                                      Fill="{DynamicResource ThemeAccent}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0">
                                </Path>
                                <TextBlock Text="Generar Receta (PDF)" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Botones de Acción (Cerrar y Guardar) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding ClosePrescriptionModalCommand}" 
                                    Padding="16,7" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding SavePrescriptionModalCommand}" 
                                    Padding="18,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Guardar" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: GESTIÓN DE INSUMOS Y MATERIAL DE CURACIÓN CLÍNICO                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsSuppliesModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="250">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="800" 
                    MaxHeight="680" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="📦" 
                                               FontSize="15" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Insumos y Material de Curación" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Registro y control de consumibles, material de curación y apósitos clínicos del paciente." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding OpenSupplyCatalogCommand}" 
                                    Padding="10,6" 
                                    Margin="0,0,8,0" 
                                    ToolTip="Buscar insumo en el catálogo completo">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" 
                                          Fill="{DynamicResource ThemeAccent}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Buscar en Catálogo" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseSuppliesModalCommand}" 
                                    Padding="8,5" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Formulario de Captura Rápida de Insumos -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Búsqueda / Nombre de Insumo -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Insumo / Material *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SupplySearchTextBox"
                                                 Text="{Binding SupplySearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="SupplySearchTextBox_PreviewKeyDown" />
                                        <TextBlock Text="Escriba o busque insumo..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding SupplySearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Indicaciones / Uso Clínico -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Indicaciones / Uso Clínico" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SupplyInstructionsTextBox"
                                                 Text="{Binding SupplyInstructions, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="SupplyAuxInput_PreviewKeyDown" />
                                        <TextBlock Text="Ej: Aplicar en herida limpia c/12h..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding SupplyInstructions, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Cantidad -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="SupplyQuantityTextBox"
                                             Text="{Binding SupplyQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="6,6" 
                                             HorizontalContentAlignment="Center" 
                                             Background="{DynamicResource ThemeBackground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             Foreground="{DynamicResource ThemeText}"
                                             PreviewKeyDown="SupplyAuxInput_PreviewKeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Indicador de atajos de teclado -->
                            <Border Background="{DynamicResource ThemeSurfaceHighlight}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,5" 
                                    Margin="0,0,0,6">
                                <TextBlock Text="💡 Flechas ↑ ↓ para navegar en la lista, Enter o clic para agregar insumo, Esc para salir" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                            </Border>

                            <!-- Dropdown de Sugerencias de Inventario para Insumos -->
                            <Border Visibility="{Binding IsSupplyDropdownOpen, Converter={StaticResource BoolToVis}}" 
                                    Background="{DynamicResource ThemeBackground}" 
                                    BorderBrush="{DynamicResource ThemeAccent}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="2" 
                                    MaxHeight="160">
                                <ListBox x:Name="SupplySuggestionsListBox"
                                         ItemsSource="{Binding SupplyProductSuggestions}"
                                         SelectedItem="{Binding SelectedSupplyProduct, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="SupplySuggestionsListBox_PreviewKeyDown"
                                         PreviewMouseLeftButtonUp="SupplySuggestionsListBox_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="1.5" 
                                                                CornerRadius="6" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="SelectorArrow" Text="▶ " Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                <ContentPresenter Grid.Column="1" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="SelectorArrow" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding Presentation}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="10,0,10,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:C}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Insumos del Paciente -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedPatient.ActiveSupplies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SupplyName}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <TextBlock Text="{Binding Instructions, StringFormat='Uso/Indicaciones: {0}'}" 
                                                                   FontSize="11.5" 
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                   Margin="0,3,0,0" 
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                                                        <Border Background="{DynamicResource ThemeBorder}" 
                                                                CornerRadius="4" 
                                                                Padding="8,4" 
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Quantity, StringFormat='Cant: {0}'}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                        </Border>
                                                        <Button Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.AddSupplyItemToPosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,4" 
                                                                ToolTip="Cargar este insumo a la cuenta activa de la consulta para cobro en POS">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🛒" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Agregar al POS" FontSize="10.5" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" 
                                                            Style="{DynamicResource OutlineButton}" 
                                                            Command="{Binding DataContext.RemoveSupplyItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="8,5" 
                                                            VerticalAlignment="Center" 
                                                            ToolTip="Quitar insumo de la lista">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Mensaje si no hay insumos -->
                            <Border Background="{DynamicResource ThemeCard}" 
                                    CornerRadius="8" 
                                    Padding="24" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Visibility="{Binding SelectedPatient.ActiveSupplies.Count, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📦 No hay insumos ni material de curación registrados aún en este expediente." 
                                               FontStyle="Italic" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Escriba o elija un insumo en el formulario superior para agregarlo a la atención clínica." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pie de la Modal -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Botones de Acción (Cerrar y Guardar) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseSuppliesModalCommand}" 
                                    Padding="16,7" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding SaveSuppliesModalCommand}" 
                                    Padding="18,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Guardar" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: GESTIÓN DE SERVICIOS Y PROCEDIMIENTOS CLÍNICOS                     -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsServicesModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="250">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="800" 
                    MaxHeight="680" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="🩺" 
                                               FontSize="15" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Servicios y Procedimientos Médicos" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Catálogo y asignación de procedimientos médicos, estudios y servicios clínicos del paciente." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding OpenServiceCatalogCommand}" 
                                    Padding="10,6" 
                                    Margin="0,0,8,0" 
                                    ToolTip="Buscar procedimiento o servicio en el catálogo completo">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" 
                                          Fill="{DynamicResource ThemeAccent}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Buscar en Catálogo" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseServicesModalCommand}" 
                                    Padding="8,5" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Formulario de Captura Rápida de Servicios -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Búsqueda / Nombre de Servicio -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Servicio / Procedimiento *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="ServiceModalSearchTextBox"
                                                 Text="{Binding ServiceModalSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="ServiceModalSearchTextBox_PreviewKeyDown" />
                                        <TextBlock Text="Escriba o busque servicio..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding ServiceModalSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Observaciones / Notas Clínicas -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Notas / Observaciones" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="ServiceModalNotesTextBox"
                                                 Text="{Binding ServiceModalNotes, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="12" 
                                                 Padding="8,6" 
                                                 Background="{DynamicResource ThemeBackground}" 
                                                 BorderBrush="{DynamicResource ThemeBorder}" 
                                                 Foreground="{DynamicResource ThemeText}"
                                                 PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown" />
                                        <TextBlock Text="Ej: Sutura en brazo, curación menor..." 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" 
                                                   IsHitTestVisible="False" 
                                                   Visibility="{Binding ServiceModalNotes, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Cantidad -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="ServiceModalQuantityTextBox"
                                             Text="{Binding ServiceModalQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="6,6" 
                                             HorizontalContentAlignment="Center" 
                                             Background="{DynamicResource ThemeBackground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             Foreground="{DynamicResource ThemeText}"
                                             PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Indicador de atajos de teclado -->
                            <Border Background="{DynamicResource ThemeSurfaceHighlight}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,5" 
                                    Margin="0,0,0,6">
                                <TextBlock Text="💡 Flechas ↑ ↓ para navegar en la lista, Enter o clic para agregar el servicio, Esc para salir" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                            </Border>

                            <!-- Dropdown de Sugerencias del Catálogo de Servicios -->
                            <Border Visibility="{Binding IsServiceModalDropdownOpen, Converter={StaticResource BoolToVis}}" 
                                    Background="{DynamicResource ThemeBackground}" 
                                    BorderBrush="{DynamicResource ThemeAccent}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="2" 
                                    MaxHeight="160">
                                <ListBox x:Name="ServiceSuggestionsListBox"
                                         ItemsSource="{Binding ServiceModalSuggestions}"
                                         SelectedItem="{Binding SelectedServiceModalItem, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="ServiceSuggestionsListBox_PreviewKeyDown"
                                         PreviewMouseLeftButtonUp="ServiceSuggestionsListBox_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="1.5" 
                                                                CornerRadius="6" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="SelectorArrow" Text="▶ " Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                <ContentPresenter Grid.Column="1" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="SelectorArrow" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding Category, StringFormat='Categoría: {0}'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="10,0,10,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:C}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Servicios del Paciente -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedPatient.ActiveServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ServiceName}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   Foreground="{DynamicResource ThemeText}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border Background="{DynamicResource ThemeBorder}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Notes, StringFormat='Notas: {0}'}" 
                                                                       FontSize="11.5" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                                                        <Border Background="{DynamicResource ThemeBorder}" 
                                                                CornerRadius="4" 
                                                                Padding="8,4" 
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Quantity, StringFormat='Cant: {0}'}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                        </Border>
                                                        <Button Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.AddServiceItemToPosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,4" 
                                                                ToolTip="Cargar este servicio al POS para cobro de la consulta">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🛒" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Agregar al POS" FontSize="10.5" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" 
                                                            Style="{DynamicResource OutlineButton}" 
                                                            Command="{Binding DataContext.RemoveServiceItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="8,5" 
                                                            VerticalAlignment="Center" 
                                                            ToolTip="Quitar servicio de la lista">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Mensaje si no hay servicios -->
                            <Border Background="{DynamicResource ThemeCard}" 
                                    CornerRadius="8" 
                                    Padding="24" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Visibility="{Binding SelectedPatient.ActiveServices.Count, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🩺 No hay servicios clínicos registrados aún en este expediente." 
                                               FontStyle="Italic" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Escriba o elija un procedimiento del catálogo en el formulario superior para agregarlo a la consulta." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pie de la Modal -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Botones de Acción (Cerrar y Guardar) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseServicesModalCommand}" 
                                    Padding="16,7" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding SaveServicesModalCommand}" 
                                    Padding="18,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Guardar" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: EXPLORADOR DE CATÁLOGO (MEDICAMENTOS, INSUMOS O SERVICIOS)         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsCatalogBrowserModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="920" 
                    MaxHeight="680" 
                    MinHeight="520" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconSearch}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="13" Height="13" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding CatalogBrowserTitle}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CatalogBrowserSubtitle}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCatalogBrowserCommand}" 
                                Padding="8,5" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Buscador en Catálogo -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8" 
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" 
                                  Data="{StaticResource IconSearch}" 
                                  Fill="{DynamicResource ThemeTextSecondary}" 
                                  Width="13" Height="13" 
                                  Stretch="Uniform" 
                                  Margin="2,0,8,0" 
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" 
                                     x:Name="CatalogBrowserSearchTextBox"
                                     Text="{Binding CatalogBrowserSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     FontSize="13" 
                                     VerticalAlignment="Center" 
                                     Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Grid.Column="1" 
                                       Text="Filtrar por nombre, descripción, código o sustancia..." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False" 
                                       Margin="2,0,0,0"
                                       Visibility="{Binding CatalogBrowserSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>

                    <!-- Contenido del Catálogo -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="8">
                        <Grid>
                            <!-- LISTA DE PRODUCTOS (FÁRMACOS O INSUMOS) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          Visibility="{Binding CatalogBrowserMode, Converter={StaticResource InverseComparisonToVis}, ConverterParameter=Services}">
                                <ItemsControl ItemsSource="{Binding CatalogBrowserFilteredProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Datos del Producto -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="13.5" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="4" 
                                                                    Padding="6,1" 
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Code}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding GenericName}" 
                                                                       FontSize="11.5" 
                                                                       FontStyle="Italic" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text=" • " FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       Visibility="{Binding GenericName, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Presentation}" 
                                                                       FontSize="11.5" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Stock y Precio -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding CurrentStock, StringFormat='Stock: {0}'}" 
                                                                   FontSize="11" 
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource ThemeAccent}" 
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Botón Agregar según modo -->
                                                    <Button Grid.Column="2" 
                                                            Style="{DynamicResource AccentButton}" 
                                                            Command="{Binding DataContext.AddProductFromCatalogBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="12,6" 
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconPlus}" 
                                                                  Fill="{DynamicResource ThemeAccentText}" 
                                                                  Width="11" Height="11" 
                                                                  Stretch="Uniform" 
                                                                  Margin="0,0,6,0" />
                                                            <TextBlock Text="+ Agregar" FontWeight="Bold" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- LISTA DE SERVICIOS CLÍNICOS -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          Visibility="{Binding CatalogBrowserMode, Converter={StaticResource ComparisonToVis}, ConverterParameter=Services}">
                                <ItemsControl ItemsSource="{Binding CatalogBrowserFilteredServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Datos del Servicio -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="13.5" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="4" 
                                                                    Padding="6,1" 
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Code}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Background="{DynamicResource ThemeBorder}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Description}" 
                                                                       FontSize="11.5" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Precio del Servicio -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="13" 
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource ThemeAccent}" />
                                                    </StackPanel>

                                                    <!-- Botón Agregar Servicio -->
                                                    <Button Grid.Column="2" 
                                                            Style="{DynamicResource AccentButton}" 
                                                            Command="{Binding DataContext.AddServiceFromCatalogBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="12,6" 
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconPlus}" 
                                                                  Fill="{DynamicResource ThemeAccentText}" 
                                                                  Width="11" Height="11" 
                                                                  Stretch="Uniform" 
                                                                  Margin="0,0,6,0" />
                                                            <TextBlock Text="+ Agregar Servicio" FontWeight="Bold" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Pie de la Modal Catálogo -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Text="💡 Haga clic en '+ Agregar' en cualquier elemento para incluirlo directamente en el expediente del paciente." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   VerticalAlignment="Center" />
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCatalogBrowserCommand}" 
                                Padding="16,7" 
                                HorizontalAlignment="Right">
                            <TextBlock Text="Cerrar Catálogo" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: AGENDAR NUEVA CONSULTA / CITA MÉDICA                               -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsScheduleAppointmentModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="260">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="640" 
                    MaxHeight="600" 
                    Margin="24" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="📅" 
                                               FontSize="15" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Agendar Nueva Consulta" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Programación de próxima cita o consulta de seguimiento médico del paciente." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseScheduleAppointmentModalCommand}" 
                                Padding="8,5" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Formulario de Agendamiento -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Datos del Paciente -->
                            <Border Background="{DynamicResource ThemeSurface}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14,10" 
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedPatient.FullName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Text="{Binding SelectedPatient.RecordNumber, StringFormat='Expediente: {0}'}" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPatient.FormattedPhone, StringFormat='Tel: {0}'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SelectedPatient.Age, StringFormat='Edad: {0} años'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Fecha y Hora de la Cita -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Selector de Fecha -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Fecha de la Consulta *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding AppointmentDate, Mode=TwoWay}" 
                                                FontSize="12" 
                                                Padding="6,4" 
                                                Background="{DynamicResource ThemeBackground}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>

                                <!-- Horario / Hora Sugerida -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Horario / Hora *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding AppointmentTime, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="8,6" 
                                             Background="{DynamicResource ThemeBackground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>
                            </Grid>

                            <!-- Motivo de la Cita -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Motivo de la Consulta *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AppointmentReason, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="12" 
                                         Padding="8,6" 
                                         Background="{DynamicResource ThemeBackground}" 
                                         BorderBrush="{DynamicResource ThemeBorder}" 
                                         Foreground="{DynamicResource ThemeText}" />
                                
                                <!-- Plantillas rápidas de motivo -->
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding SetAppointmentReasonPresetCommand}" 
                                            CommandParameter="Consulta de Seguimiento y Control" 
                                            Padding="6,3" 
                                            Margin="0,0,6,4">
                                        <TextBlock Text="+ Seguimiento" FontSize="10.5" />
                                    </Button>
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding SetAppointmentReasonPresetCommand}" 
                                            CommandParameter="Revisión de Estudios de Laboratorio" 
                                            Padding="6,3" 
                                            Margin="0,0,6,4">
                                        <TextBlock Text="+ Revisión de Estudios" FontSize="10.5" />
                                    </Button>
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding SetAppointmentReasonPresetCommand}" 
                                            CommandParameter="Valoración Post-Tratamiento" 
                                            Padding="6,3" 
                                            Margin="0,0,6,4">
                                        <TextBlock Text="+ Post-Tratamiento" FontSize="10.5" />
                                    </Button>
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding SetAppointmentReasonPresetCommand}" 
                                            CommandParameter="Curación o Retiro de Puntos" 
                                            Padding="6,3" 
                                            Margin="0,0,6,4">
                                        <TextBlock Text="+ Curación / Puntos" FontSize="10.5" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Notas e Instrucciones para el Paciente -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Notas / Preparación previa para el Paciente" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <TextBox Text="{Binding AppointmentNotes, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="8,6" 
                                             Height="65" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Background="{DynamicResource ThemeBackground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             Foreground="{DynamicResource ThemeText}" />
                                    <TextBlock Text="Ej: Presentarse en ayunas de 8 horas con resultados de biometría hemática..." 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               VerticalAlignment="Top" 
                                               Margin="9,8,0,0" 
                                               IsHitTestVisible="False" 
                                               Visibility="{Binding AppointmentNotes, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                </Grid>
                            </StackPanel>

                            <!-- Cita existente (si aplica) -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,8" 
                                    Margin="0,0,0,4" 
                                    Visibility="{Binding SelectedPatient.HasScheduledAppointment, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="⚠️ Cita actualmente agendada:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                        <TextBlock Text="{Binding SelectedPatient.FormattedNextAppointment}" FontSize="11" Foreground="{DynamicResource ThemeText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Style="{DynamicResource OutlineButton}" 
                                            Command="{Binding CancelScheduledAppointmentCommand}" 
                                            Padding="8,4" 
                                            VerticalAlignment="Center" 
                                            ToolTip="Cancelar la cita agendada de este paciente">
                                        <TextBlock Text="✕ Cancelar Cita" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeError}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pie de la Modal -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseScheduleAppointmentModalCommand}" 
                                    Padding="16,7" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding SaveScheduledAppointmentCommand}" 
                                    Padding="18,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" 
                                          Fill="{DynamicResource ThemeAccentText}" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Agendar Cita" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

<!-- ========================================================================= -->
        <!-- MODAL: VISOR DE EXPEDIENTES CLÍNICOS COMPLETOS                          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsRecordsViewerModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="270">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="980" 
                    MaxHeight="700" 
                    Margin="20" 
                    Padding="22">
                <Grid>
                    <!-- ===================================================== -->
                    <!-- ESTADO 1: LISTADO DE EXPEDIENTES / BÚSQUEDA            -->
                    <!-- ===================================================== -->
                    <Grid Visibility="{Binding ViewingRecordPatient, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Modal (Lista de Pacientes) -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource ThemeAccent}" 
                                            CornerRadius="6" 
                                            Width="28" Height="28" 
                                            Margin="0,0,10,0">
                                        <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Expedientes Clínicos de Pacientes" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>
                                <TextBlock Text="Consulte el expediente médico completo de cualquier paciente registrado o busque por nombre, folio, teléfono o diagnóstico." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           Margin="38,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseRecordsViewerModalCommand}" 
                                    Padding="8,5" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- Buscador en Tiempo Real -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Border Background="{DynamicResource ThemeSurface}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" 
                                          Data="{StaticResource IconSearch}" 
                                          Fill="{DynamicResource ThemeTextSecondary}" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          Margin="4,0,10,0" 
                                          VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding RecordsViewerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             FontSize="13" 
                                             VerticalAlignment="Center" 
                                             Foreground="{DynamicResource ThemeText}" />
                                    <TextBlock Grid.Column="1" 
                                               Text="Buscar paciente por nombre, folio, teléfono o diagnóstico..." 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               VerticalAlignment="Center" 
                                               IsHitTestVisible="False" 
                                               Margin="4,0,0,0"
                                               Visibility="{Binding RecordsViewerSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Lista de Expedientes de Pacientes -->
                        <Border Grid.Row="2" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecordsViewerPatients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="14,10" 
                                                    Margin="4,4,4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Información del Paciente -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="14" 
                                                                       Foreground="{DynamicResource ThemeText}" />
                                                            <Border Background="{DynamicResource ThemeBorder}" 
                                                                    CornerRadius="4" 
                                                                    Padding="6,2" 
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding RecordNumber}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}"
                                                                    BorderBrush="{DynamicResource ThemeBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding ConsultationCount, StringFormat='{}{0} consulta(s)'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                            <TextBlock Text="{Binding Age, StringFormat='{}{0} años'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text="{Binding Gender}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text=" • Grupo: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text="{Binding BloodType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text=" • Tel: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <TextBlock Text="{Binding FormattedPhone}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding LastDiagnosis, StringFormat='Último diagnóstico: {0}'}" 
                                                                       FontSize="11" 
                                                                       FontStyle="Italic" 
                                                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                                                       TextTrimming="CharacterEllipsis" 
                                                                       MaxWidth="500" />
                                                        </StackPanel>

                                                        <!-- Badges de Alergias y Próxima Cita -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Background="{DynamicResource ThemeError}" 
                                                                    CornerRadius="4" 
                                                                    Padding="6,2" 
                                                                    Margin="0,0,6,0"
                                                                    Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Allergies, StringFormat='⚠️ ALERGIAS: {0}'}" 
                                                                           FontSize="10" 
                                                                           FontWeight="Bold" 
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                                                    BorderBrush="{DynamicResource ThemeAccent}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="4" 
                                                                    Padding="6,2"
                                                                    Visibility="{Binding HasScheduledAppointment, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding FormattedNextAppointment, StringFormat='📅 {0}'}" 
                                                                           FontSize="10" 
                                                                           FontWeight="SemiBold" 
                                                                           Foreground="{DynamicResource ThemeAccent}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Botón Ver (en lugar de Seleccionar) -->
                                                    <Button Grid.Column="1" 
                                                            Style="{DynamicResource AccentButton}" 
                                                            Command="{Binding DataContext.ViewPatientRecordDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Padding="18,8" 
                                                            VerticalAlignment="Center"
                                                            ToolTip="Abrir y ver el expediente clínico completo">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconEye}" 
                                                                  Fill="{DynamicResource ThemeAccentText}" 
                                                                  Width="14" Height="14" 
                                                                  Stretch="Uniform" 
                                                                  Margin="0,0,6,0" />
                                                            <TextBlock Text="Ver" FontWeight="Bold" FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Pie de la Lista -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding RecordsViewerPatients.Count, StringFormat='Total de expedientes: {0}'}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1" 
                                    Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding CloseRecordsViewerModalCommand}" 
                                    Padding="16,7">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ===================================================== -->
                    <!-- ESTADO 2: EXPEDIENTE COMPLETO DETALLADO DENTRO DE MODAL-->
                    <!-- ===================================================== -->
                    <Grid Visibility="{Binding ViewingRecordPatient, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera de Ficha en Modal -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Botón Volver a la Lista -->
                            <Button Grid.Column="0" 
                                    Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding BackToRecordsListCommand}" 
                                    Padding="10,6" 
                                    Margin="0,0,12,0" 
                                    VerticalAlignment="Center"
                                    ToolTip="Regresar al listado de expedientes">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="←" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Volver a la Lista" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Título y Datos Clave del Paciente -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ViewingRecordPatient.FullName}" 
                                               FontWeight="Bold" 
                                               FontSize="17" 
                                               Foreground="{DynamicResource ThemeText}" />
                                    <Border Background="{DynamicResource ThemeAccent}" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ViewingRecordPatient.RecordNumber}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ViewingRecordPatient.Age, StringFormat='{}{0} años'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text="{Binding ViewingRecordPatient.Gender}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text=" • Grupo: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text="{Binding ViewingRecordPatient.BloodType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text=" • Tel: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text="{Binding ViewingRecordPatient.FormattedPhone}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Botones Superiores de Acción -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{DynamicResource AccentButton}" 
                                        Command="{Binding SelectViewingPatientForConsultationCommand}" 
                                        Margin="0,0,8,0" 
                                        Padding="12,6" 
                                        ToolTip="Cargar este expediente en la pantalla principal">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🩺" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Cargar en Consulta" FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource OutlineButton}" 
                                        Command="{Binding CloseRecordsViewerModalCommand}" 
                                        Padding="8,5" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Pestañas del Expediente dentro de la Modal -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Command="{Binding SwitchViewingRecordTabCommand}" 
                                    CommandParameter="Resumen" 
                                    Margin="0,0,8,0" 
                                    Padding="14,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewingRecordTab}" Value="Resumen">
                                                <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📋 Resumen y Antecedentes" FontSize="12" FontWeight="SemiBold" />
                            </Button>

                            <Button Command="{Binding SwitchViewingRecordTabCommand}" 
                                    CommandParameter="Historial" 
                                    Padding="14,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewingRecordTab}" Value="Historial">
                                                <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding ViewingPatientConsultations.Count, StringFormat='📜 Historial de Consultas ({0})'}" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <!-- Contenido Scrolleable del Expediente Completo -->
                        <Border Grid.Row="2" 
                                Background="{DynamicResource ThemeSurface}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <!-- PESTAÑA RESUMEN Y ANTECEDENTES -->
                                    <StackPanel Visibility="{Binding ViewingRecordTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Resumen}">
                                        <!-- Alerta de Alergias y Datos Críticos -->
                                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewingRecordPatient.HasAllergies}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓ Sin alergias reportadas conocidas" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ViewingRecordPatient.HasAllergies}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding ViewingRecordPatient.Allergies, StringFormat='⚠️ ALERGIAS REPORTADAS: {0}'}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Información de Contacto y Antecedentes -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Contacto y Domicilio -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="12" 
                                                    Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="📞 Contacto y Localización" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Teléfono: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.FormattedPhone}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Correo: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.Email}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Dirección: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.Address}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Contacto de Emergencia: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.EmergencyContactName}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Teléfono Emergencia: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.FormattedEmergencyContactPhone}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Antecedentes y Patologías -->
                                            <Border Grid.Column="1" 
                                                    Background="{DynamicResource ThemeCard}" 
                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Padding="12" 
                                                    Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="🩺 Antecedentes Clínicos (NOM-004)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Enfermedades Crónicas: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.ChronicDiseases}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Signos Vitales Registrados: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.VitalSigns}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Último Diagnóstico: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.LastDiagnosis}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Última Visita: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        <TextBlock Text="{Binding ViewingRecordPatient.LastVisit, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Notas Clínicas Generales del Expediente -->
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12" 
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📝 Notas Clínicas del Expediente" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding ViewingRecordPatient.ClinicalNotes}" 
                                                           FontSize="12" 
                                                           LineHeight="17" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Receta Médica Activa -->
                                        <Border Background="{DynamicResource ThemeCard}" 
                                                BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="💊 Receta Médica Activa" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding ViewingRecordPatient.ActivePrescription}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource ThemeSurface}" 
                                                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="10,6" 
                                                                    Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                                        <TextBlock Text="{Binding Dosage, StringFormat='Posología: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PESTAÑA HISTORIAL DE CONSULTAS MÉDICAS -->
                                    <StackPanel Visibility="{Binding ViewingRecordTab, Converter={StaticResource ComparisonToVis}, ConverterParameter=Historial}">
                                        <ItemsControl ItemsSource="{Binding ViewingPatientConsultations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeCard}" 
                                                            BorderBrush="{DynamicResource ThemeBorder}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="8" 
                                                            Padding="14,10" 
                                                            Margin="0,0,0,8">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="{DynamicResource ThemeSurface}" 
                                                                     BorderBrush="{DynamicResource ThemeAccent}" 
                                                                     BorderThickness="1.5">
                                                                <StackPanel MaxWidth="360" Margin="4">
                                                                    <TextBlock Text="{Binding Date, StringFormat='📅 Consulta del {0:dd/MM/yyyy HH:mm}'}" 
                                                                               FontWeight="Bold" FontSize="12" 
                                                                               Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="{Binding ChiefComplaint, StringFormat='Motivo: {0}'}" 
                                                                               FontSize="11" Foreground="{DynamicResource ThemeText}" 
                                                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Diagnosis, StringFormat='Diagnóstico: {0}'}" 
                                                                               FontWeight="SemiBold" FontSize="11" 
                                                                               Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding TreatmentPlan, StringFormat='Plan / Indicaciones: {0}'}" 
                                                                               FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <StackPanel>
                                                            <!-- Encabezado de la Consulta -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                                                    <Border Background="{DynamicResource ThemeBorder}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Folio}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Motivo de Consulta y Signos Vitales -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="Motivo: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                <TextBlock Text="{Binding ChiefComplaint}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="Signos Vitales: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                <TextBlock Text="{Binding VitalSigns}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccent}" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Diagnóstico Clínico -->
                                                            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="8,4" Margin="0,2,0,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Diagnóstico: " FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                    <TextBlock Text="{Binding Diagnosis}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Plan de Tratamiento e Indicaciones -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="Tratamiento: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                <TextBlock Text="{Binding TreatmentPlan}" FontSize="11" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Notas de Evolución -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="Notas: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Prescripciones Recetadas -->
                                                            <ItemsControl ItemsSource="{Binding Prescriptions}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="4" Padding="8,4" Margin="0,0,0,3">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                                    <TextBlock Text="💊 " FontSize="10" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding MedicineName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                                                    <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                                    <TextBlock Text="{Binding Dosage}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1" Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Pie del Detalle de Expediente -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding BackToRecordsListCommand}" 
                                    Padding="14,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="←" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Volver a la Lista" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{DynamicResource AccentButton}" 
                                        Command="{Binding SelectViewingPatientForConsultationCommand}" 
                                        Padding="14,7" 
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🩺" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Cargar este Paciente en Pantalla Principal" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource OutlineButton}" 
                                        Command="{Binding CloseRecordsViewerModalCommand}" 
                                        Padding="16,7">
                                    <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: VISTA PREVIA Y GENERACIÓN DE RECETA MÉDICA OFICIAL (NOM-004-SSA3)  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#AA000000" 
                Visibility="{Binding IsPrescriptionPdfModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="300">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="750" 
                    MaxHeight="680" 
                    Margin="20" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" 
                                        CornerRadius="6" 
                                        Width="28" Height="28" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Receta Médica - Vista Previa Oficial (NOM-004-SSA3)" 
                                           FontSize="17" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <TextBlock Text="Formato estandarizado de prescripción médica conforme a la legislación sanitaria vigente." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="38,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding ClosePrescriptionPdfPreviewCommand}" 
                                Padding="8,5" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Documento Simulado (Hoja de Receta) -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ThemeSurface}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Membrete Institucional y Médico -->
                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1.5" Padding="0,0,0,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ClinicName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" />
                                            <TextBlock Text="{Binding DoctorName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding DoctorLicense, StringFormat='Cédula Profesional: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="RECETA MÉDICA INDIVIDUAL" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ThemeAccent}" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectedPatient.RecordNumber, StringFormat='Exp: {0}'}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Ficha de Identificación del Paciente -->
                                <Border Background="{DynamicResource ThemeBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                            <TextBlock Text="Nombre del Paciente:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            <TextBlock Text="{Binding SelectedPatient.FullName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                                            <TextBlock Text="Edad:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            <TextBlock Text="{Binding SelectedPatient.Age, StringFormat='{}{0} años'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                            <TextBlock Text="Sexo:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            <TextBlock Text="{Binding SelectedPatient.Gender}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                            <TextBlock Text="Signos Vitales Registrados:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            <TextBlock Text="{Binding SelectedPatient.VitalSigns}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="Alergias:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            <TextBlock Text="{Binding SelectedPatient.Allergies}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeError}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Símbolo Rp y Lista de Fármacos Prescritos -->
                                <Border Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="℞ PRESCRIPCIÓN MÉDICA Y POSOLOGÍA" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding SelectedPatient.ActivePrescription}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,6,0,8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="● " FontSize="11" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Dosage, StringFormat='   Indicaciones: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Indicaciones de Cuidados Generales y Alarma -->
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="6" Padding="12,8" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ MEDIDAS GENERALES Y DATOS DE ALARMA:" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding PrescriptionGeneralInstructions}" Visibility="{Binding HasCustomGeneralIndications, Converter={StaticResource BoolToVis}}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Consumir abundantes líquidos, mantener reposo relativo, completar el esquema prescrito y acudir de inmediato a valoración médica o urgencias si presenta fiebre persistente, dificultad respiratoria o reacciones adversas." Visibility="{Binding HasCustomGeneralIndications, Converter={StaticResource InverseBoolToVis}}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Firma y Cédula del Médico Tratante -->
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Border BorderBrush="{DynamicResource ThemeTextSecondary}" BorderThickness="0,1,0,0" Width="220" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding DoctorName}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeText}" />
                                        <TextBlock Text="{Binding DoctorLicense, StringFormat='Cédula Profesional: {0}'}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="Firma y Sello del Médico Tratante" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Pie de la Modal con Acciones -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Cumplimiento con NOM-004-SSA3-2012 y Ley General de Salud." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding ClosePrescriptionPdfPreviewCommand}" 
                                    Padding="16,7" 
                                    Margin="0,0,10,0">
                                <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="12" />
                            </Button>

                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding SendPrescriptionToPosCommand}" 
                                    Padding="14,7" 
                                    Margin="0,0,10,0" 
                                    ToolTip="Cargar estos medicamentos al carrito del POS">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cargar Receta a POS" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource OutlineButton}" 
                                    Command="{Binding ExportPrescriptionDocumentCommand}" 
                                    Padding="14,7" 
                                    Margin="0,0,10,0" 
                                    ToolTip="Exportar receta a documento digital HTML/PDF">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Exportar Documento" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource AccentButton}" 
                                    Command="{Binding PrintOrExportPrescriptionPdfCommand}" 
                                    Padding="18,7"
                                    ToolTip="Imprimir receta oficial en impresora física">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖨️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Imprimir Receta" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    

        <!-- ========================================================================= -->
        <!-- MODAL: REGISTRO RÁPIDO DE SIGNOS VITALES Y SOMATOMETRÍA (TODOS OPCIONALES) -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#99000000" 
                Visibility="{Binding IsVitalSignsModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="350">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Padding="26,22" 
                    MaxWidth="720" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Background="{DynamicResource ThemeAccent}" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="🩺 SIGNOS VITALES" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeAccentText}" />
                            </Border>
                            <TextBlock Text="Registro de Signos Vitales y Somatometría" 
                                       FontWeight="Bold" 
                                       FontSize="17" 
                                       Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                        <TextBlock Text="NOM-004-SSA3-2012 • Ningún campo es obligatorio. Registre únicamente los signos evaluados." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </StackPanel>

                    <!-- Formulario de 10 Signos Vitales Disponibles -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" MaxHeight="450">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Columna 1 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tensión Arterial (TA)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignTA, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Ej: 120/80 (formato automático con /)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Frecuencia Cardíaca (FC)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignFC, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Latidos por minuto (lpm)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Frecuencia Respiratoria (FR)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignFR, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Respiraciones por minuto (rpm)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Temperatura Corporal (°C)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignTemp, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Grados Celsius (°C), ej: 36.5" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Saturación de Oxígeno (SpO2)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignSpO2, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Porcentaje (%), ej: 98" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />
                            </StackPanel>

                            <!-- Columna 2 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Peso Corporal (kg)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignWeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Kilogramos (kg), ej: 70.5" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Talla / Estatura (m)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignHeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Metros (m), ej: 1.70" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Índice de Masa Corporal (IMC)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10,8" 
                                        Margin="0,0,0,10">
                                    <TextBlock Text="{Binding VitalSignIMC}" 
                                               FontWeight="SemiBold" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeAccent}" />
                                </Border>

                                <TextBlock Text="Glucosa Capilar (mg/dL)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignGlucose, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Miligramos por decilitro (mg/dL)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />

                                <TextBlock Text="Perímetro de Cintura (cm)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VitalSignWaist, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Padding="10,6" 
                                         Margin="0,0,0,10" />
                                <TextBlock Text="Centímetros (cm)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,-8,0,8" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Acciones -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseVitalSignsModalCommand}" 
                                Padding="16,8" 
                                Margin="0,0,10,0">
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="12" />
                        </Button>
                        <Button Style="{DynamicResource AccentButton}" 
                                Command="{Binding SaveVitalSignsAsyncCommand}" 
                                Padding="18,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Guardar Signos Vitales" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: CREAR SERVICIO CLÍNICO Y ASIGNAR INSUMOS                            -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#CC000000" 
                Visibility="{Binding IsCreateServiceModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Panel.ZIndex="360">
            <Border Background="{DynamicResource ThemeCard}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    MaxWidth="720" 
                    MaxHeight="650" 
                    Margin="24" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Background="{DynamicResource ThemeAccent}" 
                                    CornerRadius="6" 
                                    Padding="8,3" 
                                    Margin="0,0,8,0">
                                <TextBlock Text="🩺 NUEVO SERVICIO" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeAccentText}" />
                            </Border>
                            <TextBlock Text="Crear Servicio Clínico y Asignar Insumos" 
                                       FontWeight="Bold" 
                                       FontSize="17" 
                                       Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                        <TextBlock Text="Ingresa los datos generales del servicio médico e incluye los productos e insumos de inventario que se consumirán por defecto." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </StackPanel>

                    <!-- Formulario con Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Código y Nombre -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Código / Folio *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceCode, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nombre del Servicio Clínico *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Categoría, Precio y Duración -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Categoría" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox Style="{DynamicResource ModernComboBox}" 
                                              ItemsSource="{Binding ServiceCategories}" 
                                              SelectedItem="{Binding NewServiceCategory}" 
                                              Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Precio ($ MXN)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServicePrice, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Duración (min)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewServiceDuration, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{DynamicResource ModernTextBox}" 
                                             Padding="10,6" />
                                </StackPanel>
                            </Grid>

                            <!-- Descripción -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Descripción y Alcance Clínico" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewServiceDescription, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         Height="60" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Padding="10,6" />
                            </StackPanel>

                            <!-- Sección: Asociar Insumos por Defecto -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14" 
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📦 Paquete de Insumos Predeterminados para este Servicio" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource ThemeText}" 
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Selecciona insumos del inventario que se consumirán con este procedimiento:" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               Margin="0,0,0,10" />

                                    <!-- Selector para agregar nuevo insumo al servicio -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Producto -->
                                        <ComboBox Grid.Column="0" 
                                                  Style="{DynamicResource ModernComboBox}" 
                                                  ItemsSource="{Binding AvailableProducts}" 
                                                  SelectedItem="{Binding SelectedProductToAdd}" 
                                                  DisplayMemberPath="Name" 
                                                  Height="36" />

                                        <!-- Cantidad -->
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{DynamicResource ModernTextBox}" 
                                                 HorizontalContentAlignment="Center" 
                                                 Padding="6,6" 
                                                 ToolTip="Cantidad de unidades requeridas" />

                                        <!-- Botón Agregar Insumo -->
                                        <Button Grid.Column="4" 
                                                Style="{DynamicResource AccentButton}" 
                                                Command="{Binding AddProductToNewServiceCommand}" 
                                                Padding="12,6">
                                            <TextBlock Text="+ Agregar" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>

                                    <!-- Lista de insumos vinculados -->
                                    <ItemsControl ItemsSource="{Binding NewServiceDefaultProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" 
                                                        BorderBrush="{DynamicResource ThemeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="8,6" 
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                            <TextBlock Text="{Binding Product.Presentation}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Quantity, StringFormat='Cant: {0}'}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource ThemeAccent}" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="12,0" />

                                                        <Button Grid.Column="2" 
                                                                Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.RemoveProductFromNewServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="6,3" 
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones de Acción -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CloseCreateServiceModalCommand}" 
                                HorizontalAlignment="Left" 
                                Padding="16,7">
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="12" />
                        </Button>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource AccentButton}" 
                                Command="{Binding SaveNewServiceAsyncCommand}" 
                                Padding="18,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Guardar Servicio" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: ALERTA DE ALERGIA A MEDICAMENTO (FARMACOVIGILANCIA / SEGURIDAD)    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#B3000000" 
                Visibility="{Binding IsAllergyAlertOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="#EF4444" 
                    BorderThickness="2.5" 
                    CornerRadius="16" 
                    Padding="26,22" 
                    MaxWidth="580" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de Alerta Roja -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FEE2E2" CornerRadius="24" Width="48" Height="48" Margin="0,0,14,0">
                            <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AllergyAlertTitle}" FontWeight="Bold" FontSize="16" Foreground="#DC2626" />
                            <TextBlock Text="Advertencia clínica de seguridad del paciente" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Style="{DynamicResource GhostButton}" 
                                Command="{Binding CancelAllergyPrescriptionCommand}" 
                                Padding="8,4" 
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Button>
                    </Grid>

                    <!-- Cuerpo del Mensaje de Alerta -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <TextBlock Text="{Binding AllergyAlertMessage}" 
                                       FontSize="13" 
                                       LineHeight="20" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource ThemeText}" />
                        </Border>

                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Alergias registradas en el expediente:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AllergyPatientAllergies}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botones de Acción: Cancelar (Recomendado) o Recetar Bajo Criterio -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cancelar prescripción (Opción segura) -->
                        <Button Grid.Column="0" 
                                Style="{DynamicResource OutlineButton}" 
                                Command="{Binding CancelAllergyPrescriptionCommand}" 
                                Padding="12,9" 
                                ToolTip="Cancelar la adición de este medicamento a la receta">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✕" FontSize="12" Margin="0,0,6,0" FontWeight="Bold" Foreground="#DC2626" />
                                <TextBlock Text="Cancelar Prescripción" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Recetar de todos modos (Bajo criterio médico) -->
                        <Button Grid.Column="2" 
                                Style="{DynamicResource AccentButton}" 
                                Command="{Binding ConfirmOverrideAllergyPrescriptionAsyncCommand}" 
                                Background="#DC2626" 
                                BorderBrush="#DC2626" 
                                Padding="12,9" 
                                ToolTip="Recetar bajo supervisión y criterio médico responsable">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Recetar de Todos Modos" FontSize="12" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- MODAL: AGENDA Y CALENDARIO DE CITAS (VISTA DÍA Y SEMANA)                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#99000000" 
                Visibility="{Binding IsAgendaModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Padding="24,20" 
                    MaxWidth="1080" 
                    MaxHeight="720" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Agenda -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeAccent}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="📅 AGENDA MÉDICA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" />
                                </Border>
                                <TextBlock Text="{Binding AgendaHeaderTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Organización de citas y consultas médicas con vistas de día y semana" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Controles de Navegación y Vistas -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Switcher Día / Semana -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding SwitchAgendaViewCommand}" CommandParameter="Day" Padding="12,5" Margin="0,0,3,0">
                                        <TextBlock Text="Vista Día" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Style="{DynamicResource OutlineButton}" Command="{Binding SwitchAgendaViewCommand}" CommandParameter="Week" Padding="12,5">
                                        <TextBlock Text="Vista Semana" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Navegación Temporal -->
                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AgendaPreviousPeriodCommand}" Padding="10,6" Margin="0,0,4,0" ToolTip="Período anterior">
                                <TextBlock Text="◀" FontSize="11" />
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AgendaTodayCommand}" Padding="12,6" Margin="0,0,4,0">
                                <TextBlock Text="Hoy" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Style="{DynamicResource OutlineButton}" Command="{Binding AgendaNextPeriodCommand}" Padding="10,6" Margin="0,0,10,0" ToolTip="Período siguiente">
                                <TextBlock Text="▶" FontSize="11" />
                            </Button>

                            <!-- Botón Nueva Cita -->
                            <Button Style="{DynamicResource AccentButton}" Command="{Binding OpenNewAppointmentModalCommand}" CommandParameter="{x:Null}" Padding="14,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontWeight="Bold" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Nueva Cita" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- Cerrar Modal -->
                            <Button Style="{DynamicResource GhostButton}" Command="{Binding CloseAgendaModalCommand}" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Contenido según Vista: Día o Semana -->
                    <Grid Grid.Row="1">
                        <!-- VISTA DE DÍA -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding AgendaViewMode, Converter={StaticResource ComparisonToVis}, ConverterParameter=Day}">
                            <StackPanel>
                                <TextBlock Text="No hay citas programadas para este día." 
                                           FontStyle="Italic" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,40" 
                                           Visibility="{Binding DayAppointments.Count, Converter={StaticResource InverseBoolToVis}}" />

                                <ItemsControl ItemsSource="{Binding DayAppointments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Hora y Duración -->
                                                    <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,16,0" VerticalAlignment="Center" MinWidth="90">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Time}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} min'}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Información del Paciente y Cita -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeText}" />
                                                            <Border Background="{DynamicResource ThemeAccent}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding PatientPhone, StringFormat='📞 Tel: {0}'}" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,14,0" />
                                                            <TextBlock Text="{Binding PatientRecordNumber, StringFormat='📁 Exp: {0}'}" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Reason, StringFormat='Motivo: {0}'}" FontSize="12" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Notes, StringFormat='Notas: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" Visibility="{Binding Notes, Converter={StaticResource ComparisonToVis}, ConverterParameter=''}" />
                                                    </StackPanel>

                                                    <!-- Acciones Rápidas -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Botón Google Calendar (TODO) -->
                                                        <Button Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.OpenGoogleCalendarTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="10,6" 
                                                                Margin="0,0,6,0" 
                                                                ToolTip="Sincronizar / Agregar a Google Calendar">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📅" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Text="Calendar" FontSize="11" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Botón WhatsApp (TODO) -->
                                                        <Button Style="{DynamicResource OutlineButton}" 
                                                                Command="{Binding DataContext.OpenWhatsAppTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="10,6" 
                                                                Margin="0,0,6,0" 
                                                                ToolTip="Enviar recordatorio de cita por WhatsApp">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="💬" FontSize="11" Margin="0,0,4,0" />
                                                                <TextBlock Text="WhatsApp" FontSize="11" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Confirmar -->
                                                        <Button Style="{DynamicResource GhostButton}" 
                                                                Command="{Binding DataContext.MarkAppointmentConfirmedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,6" 
                                                                Margin="0,0,4,0" 
                                                                ToolTip="Marcar como Confirmada">
                                                            <TextBlock Text="✓ Conf." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                                                        </Button>

                                                        <!-- Atender -->
                                                        <Button Style="{DynamicResource GhostButton}" 
                                                                Command="{Binding DataContext.MarkAppointmentAttendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,6" 
                                                                Margin="0,0,4,0" 
                                                                ToolTip="Marcar como Atendida">
                                                            <TextBlock Text="✓ Atendida" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSuccess}" />
                                                        </Button>

                                                        <!-- Editar -->
                                                        <Button Style="{DynamicResource GhostButton}" 
                                                                Command="{Binding DataContext.OpenEditAppointmentModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,6" 
                                                                Margin="0,0,4,0" 
                                                                ToolTip="Editar datos de la cita">
                                                            <TextBlock Text="✏️" FontSize="11" />
                                                        </Button>

                                                        <!-- Eliminar -->
                                                        <Button Style="{DynamicResource GhostButton}" 
                                                                Command="{Binding DataContext.DeleteAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Padding="8,6" 
                                                                ToolTip="Eliminar cita">
                                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeError}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VISTA DE SEMANA (7 COLUMNAS) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding AgendaViewMode, Converter={StaticResource ComparisonToVis}, ConverterParameter=Week}">
                            <ItemsControl ItemsSource="{Binding WeekDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Margin="3" Padding="8" MinHeight="420">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Encabezado del Día -->
                                                <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DayOfWeekName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding DayName}" FontSize="10" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding AppointmentsCount, StringFormat='{}{0} citas'}" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Citas en la Columna -->
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Appointments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Time}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccent}" />
                                                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                        <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

                                                                        <!-- Acciones rápidas pequeñas -->
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                                            <Button Style="{DynamicResource GhostButton}" Command="{Binding DataContext.OpenGoogleCalendarTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,2" Margin="0,0,3,0" ToolTip="Google Calendar">
                                                                                <TextBlock Text="📅" FontSize="9" />
                                                                            </Button>
                                                                            <Button Style="{DynamicResource GhostButton}" Command="{Binding DataContext.OpenWhatsAppTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,2" Margin="0,0,3,0" ToolTip="WhatsApp">
                                                                                <TextBlock Text="💬" FontSize="9" />
                                                                            </Button>
                                                                            <Button Style="{DynamicResource GhostButton}" Command="{Binding DataContext.OpenEditAppointmentModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,2" ToolTip="Editar">
                                                                                <TextBlock Text="✏️" FontSize="9" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <!-- Botón para agendar en este día específico -->
                                                <Button Grid.Row="2" 
                                                        Style="{DynamicResource OutlineButton}" 
                                                        Command="{Binding DataContext.OpenNewAppointmentModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Date}" 
                                                        Padding="4,4" 
                                                        Margin="0,6,0,0">
                                                    <TextBlock Text="+ Cita" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- SUBMODAL: CREAR / EDITAR CITA MÉDICA                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#B3000000" 
                Visibility="{Binding IsEditAppointmentModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="2" 
                    CornerRadius="14" 
                    Padding="24,20" 
                    MaxWidth="540" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding EditAppointmentModalTitle}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,16" />

                    <StackPanel Grid.Row="1">
                        <!-- Paciente -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Nombre del Paciente *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditAppointmentPatientName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" />
                        </StackPanel>

                        <!-- Teléfono y No. Expediente -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono (WhatsApp)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditAppointmentPatientPhone, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" ToolTip="10 dígitos para recordatorios por WhatsApp" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="No. Expediente" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditAppointmentPatientRecordNumber, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Fecha, Hora y Duración -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding EditAppointmentDate}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hora *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditAppointmentTime, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" ToolTip="Ej. 10:00 AM o 16:30" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Duración" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditAppointmentDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" ToolTip="Minutos de consulta" />
                            </StackPanel>
                        </Grid>

                        <!-- Motivo y Estado -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Motivo de la Cita *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditAppointmentReason, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Estado" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding EditAppointmentStatus}" SelectedValuePath="Content" Style="{DynamicResource ModernComboBox}" Height="34">
                                    <ComboBoxItem Content="Programada" />
                                    <ComboBoxItem Content="Confirmada" />
                                    <ComboBoxItem Content="Atendida" />
                                    <ComboBoxItem Content="Cancelada" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Notas Adicionales -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Notas / Indicaciones Previas" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditAppointmentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Botones Guardar / Cancelar -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource OutlineButton}" Command="{Binding CloseEditAppointmentModalCommand}" HorizontalAlignment="Left" Padding="16,7">
                            <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Command="{Binding SaveAppointmentModalAsyncCommand}" Padding="18,7">
                            <TextBlock Text="Guardar Cita" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- SUBMODAL: GOOGLE CALENDAR (TODO Y ENLACE DIRECTO)                         -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#B3000000" 
                Visibility="{Binding IsGoogleCalendarTodoModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="#4285F4" 
                    BorderThickness="2" 
                    CornerRadius="14" 
                    Padding="24,20" 
                    MaxWidth="540" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#4285F4" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GOOGLE CALENDAR" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="TODO • Roadmap" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding GoogleCalendarTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding CloseGoogleCalendarTodoCommand}" Padding="6,3" VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,18">
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <TextBlock Text="{Binding GoogleCalendarDetails}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText}" />
                        </Border>
                        <TextBlock Text="💡 Puede abrir el enlace generado para guardar la cita en su Google Calendar web de inmediato con todos los campos pre-llenados." FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource OutlineButton}" Command="{Binding CloseGoogleCalendarTodoCommand}" HorizontalAlignment="Left" Padding="14,7">
                            <TextBlock Text="Cerrar" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Command="{Binding LaunchGoogleCalendarUrlCommand}" Background="#4285F4" BorderBrush="#4285F4" Padding="16,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Abrir en Google Calendar Web" FontSize="12" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ========================================================================= -->
        <!-- SUBMODAL: RECORDATORIO WHATSAPP (TODO Y PLANTILLA WA.ME)                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                Background="#B3000000" 
                Visibility="{Binding IsWhatsAppTodoModalOpen, Converter={StaticResource BoolToVis}}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeSurface}" 
                    BorderBrush="#25D366" 
                    BorderThickness="2" 
                    CornerRadius="14" 
                    Padding="24,20" 
                    MaxWidth="540" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#25D366" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="WHATSAPP RECORDATORIO" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="TODO • Roadmap" FontSize="10" FontWeight="SemiBold" Foreground="#25D366" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Plantilla de Recordatorio de Cita Médica" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Command="{Binding CloseWhatsAppTodoCommand}" Padding="6,3" VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,18">
                        <TextBlock Text="Vista previa del mensaje pre-redactado:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <TextBlock Text="{Binding WhatsAppMessagePreview}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText}" />
                        </Border>
                        <TextBlock Text="Plan de Integración WhatsApp:&#x0a;• Fase 1 (Actual): Apertura directa de chat wa.me con plantilla lista para enviar.&#x0a;• Fase 2 (En desarrollo): Automatización con WhatsApp Business Cloud API para envío masivo 24h previas." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="17" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource OutlineButton}" Command="{Binding CloseWhatsAppTodoCommand}" HorizontalAlignment="Left" Padding="14,7">
                            <TextBlock Text="Cerrar" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Command="{Binding LaunchWhatsAppUrlCommand}" Background="#25D366" BorderBrush="#25D366" Padding="16,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Abrir en WhatsApp (Web / App)" FontSize="12" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>