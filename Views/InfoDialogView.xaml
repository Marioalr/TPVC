<UserControl x:Class="TPVC.Views.InfoDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ========================================================================= -->
    <!-- MODAL INFORMATIVO Y ALERTAS                                               -->
    <!-- ========================================================================= -->
    <Border Background="{DynamicResource ThemeOverlay}" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
        <Border Background="{DynamicResource ThemeSurface}" 
                BorderBrush="{DynamicResource ThemeAccent}" 
                BorderThickness="2" 
                CornerRadius="16" 
                Padding="30,26" 
                MaxWidth="560" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <StackPanel>
                <Border Background="{DynamicResource ThemeAccent}" 
                        CornerRadius="6" 
                        Padding="12,5" 
                        HorizontalAlignment="Left" 
                        Margin="0,0,0,12">
                    <TextBlock Text="ℹ️ NOTIFICACIÓN CLÍNICA" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeAccentText}" />
                </Border>
                <TextBlock Text="Expedientes Clínicos y Consultas" 
                           FontWeight="Bold" 
                           FontSize="19" 
                           Foreground="{DynamicResource ThemeText}" 
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding InfoModalMessage}" 
                           FontSize="13" 
                           Foreground="{DynamicResource ThemeTextSecondary}" 
                           TextWrapping="Wrap" 
                           LineHeight="22" 
                           Margin="0,0,0,24" />
                <Button Style="{DynamicResource AccentButton}" 
                        Command="{Binding DismissInfoModalCommand}" 
                        HorizontalAlignment="Right" 
                        Padding="22,10">
                    <TextBlock Text="Aceptar" FontWeight="Bold" FontSize="13" />
                </Button>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
