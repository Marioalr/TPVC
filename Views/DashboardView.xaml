<UserControl x:Class="TPVC.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            
            <!-- Encabezado del Dashboard con Botones de Actualización -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Título y subtítulo -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panel de Control Médico" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeText}" />
                    <TextBlock Text="{Binding LastUpdatedText}" 
                               FontSize="13" 
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                </StackPanel>

                <!-- Botones de Acción en Inicio: Botón de Actualizar prominente -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Actualizar Datos -->
                    <Button Style="{DynamicResource AccentButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="16,10"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" 
                                  Fill="{DynamicResource ThemeAccentText}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Actualizar Datos" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Comprobar Actualización App -->
                    <Button Style="{DynamicResource OutlineButton}"
                            Command="{Binding CheckAppUpdateCommand}"
                            Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" 
                                  Fill="{DynamicResource ThemeTextSecondary}" 
                                  Width="13" Height="13" 
                                  Stretch="Uniform" 
                                  Margin="0,0,6,0" />
                            <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Notificación de Actualización de Aplicación Disponible (si hay en GitHub) -->
            <Border Style="{DynamicResource CardBorder}"
                    BorderBrush="{DynamicResource ThemeAccent}"
                    Background="{DynamicResource ThemeSurfaceSubtle}"
                    Margin="0,0,0,24"
                    Padding="16,12"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🚀 ¡Hay una nueva versión disponible de la aplicación!" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Text="Puedes descargar la actualización directamente desde el repositorio en GitHub." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" 
                            Style="{DynamicResource AccentButton}" 
                            Command="{Binding OpenUpdateUrlCommand}"
                            Content="Descargar Actualización" 
                            Padding="12,6" />
                </Grid>
            </Border>

            <!-- Tarjetas de Métricas Principales (KPIs) -->
            <UniformGrid Columns="4" Margin="0,0,0,28">
                <!-- Total Productos -->
                <Border Style="{DynamicResource CardBorder}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Total Insumos / Fármacos" 
                                   FontSize="12" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Grid.Row="1" 
                                   Text="{Binding Metrics.TotalProducts}" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource ThemeText}" />
                        <TextBlock Grid.Row="2" 
                                   Text="Artículos registrados activos" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Grid>
                </Border>

                <!-- Stock Bajo -->
                <Border Style="{DynamicResource CardBorder}" Margin="8,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Alertas de Stock Bajo" 
                                   FontSize="12" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Grid.Row="1" 
                                   Text="{Binding Metrics.LowStockCount}" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource ThemeWarning}" />
                        <TextBlock Grid.Row="2" 
                                   Text="Requieren reabastecimiento" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Grid>
                </Border>

                <!-- Próximos a Vencer -->
                <Border Style="{DynamicResource CardBorder}" Margin="8,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Próximos a Caducar (≤60d)" 
                                   FontSize="12" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Grid.Row="1" 
                                   Text="{Binding Metrics.ExpiringSoonCount}" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource ThemeDanger}" />
                        <TextBlock Grid.Row="2" 
                                   Text="Lotes con vencimiento cercano" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Grid>
                </Border>

                <!-- Consumo en Consulta Hoy -->
                <Border Style="{DynamicResource CardBorder}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Consumo en Consulta Hoy" 
                                   FontSize="12" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Grid.Row="1" 
                                   Text="{Binding Metrics.ConsumedInConsultationToday}" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource ThemeAccent}" />
                        <TextBlock Grid.Row="2" 
                                   Text="Unidades utilizadas en consulta" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Sección de Contenido en 2 Columnas -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Alertas de Stock Bajo y Caducidades -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    
                    <!-- Tarjeta Alertas de Stock Bajo -->
                    <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconAlert}" 
                                          Fill="{DynamicResource ThemeWarning}" 
                                          Width="15" Height="15" 
                                          Stretch="Uniform" 
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Insumos con Stock Bajo" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" 
                                        Style="{DynamicResource OutlineButton}"
                                        Content="Ver Catálogo" 
                                        Padding="10,4" 
                                        FontSize="11"
                                        Command="{Binding NavigateToCommand}"
                                        CommandParameter="Inventory" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="13" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding Location, StringFormat='Ubicación: {0}'}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource ThemeWarning}" 
                                                            CornerRadius="4" 
                                                            Padding="8,3">
                                                        <TextBlock Text="{Binding CurrentStock, StringFormat='Stock: {0}'}" 
                                                                   Foreground="White" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{Binding MinStock, StringFormat='Mín: {0}'}" 
                                                               FontSize="10" 
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No hay productos con stock bajo en este momento." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasNoLowStock, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Próximos a Vencer -->
                    <Border Style="{DynamicResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCalendar}" 
                                          Fill="{DynamicResource ThemeDanger}" 
                                          Width="15" Height="15" 
                                          Stretch="Uniform" 
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Lotes con Vencimiento Cercano" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource ThemeText}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" 
                                        Style="{DynamicResource OutlineButton}"
                                        Content="Ver Todos los Lotes" 
                                        Padding="10,4" 
                                        FontSize="11"
                                        Command="{Binding NavigateToCommand}"
                                        CommandParameter="Batches" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ExpiringBatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product.Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="13" 
                                                               Foreground="{DynamicResource ThemeText}" />
                                                    <TextBlock Text="{Binding BatchNumber, StringFormat='Lote: {0}'}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" 
                                                        Background="{DynamicResource ThemeDanger}" 
                                                        CornerRadius="4" 
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               Foreground="White" 
                                                               FontWeight="Bold" 
                                                               FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No hay lotes próximos a vencer registrados." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasNoExpiringBatches, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Columna Derecha: Movimientos y Kardex Reciente -->
                <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistory}" 
                                      Fill="{DynamicResource ThemeAccent}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Movimientos Recientes del Consultorio" 
                                           FontSize="15" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource ThemeText}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" 
                                    Style="{DynamicResource OutlineButton}"
                                    Content="Ver Historial Completo" 
                                    Padding="10,4" 
                                    FontSize="11"
                                    Command="{Binding NavigateToCommand}"
                                    CommandParameter="Movements" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentMovements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ThemeBorder}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text="{Binding MovementTypeDisplay}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource ThemeAccent}" 
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Reason}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0} pzas'}" 
                                                           FontWeight="Bold" 
                                                           FontSize="14" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource ThemeText}" />
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM hh:mm tt}'}" 
                                                           FontSize="11" 
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No hay movimientos registrados recientemente." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasNoRecentMovements, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
