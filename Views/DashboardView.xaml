<UserControl x:Class="TPVC.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Panel del consultorio: lo de hoy y lo que hay que atender (stock bajo, lotes por vencer). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Style="{StaticResource TextTitle}" Text="Panel del consultorio" />
            <TextBlock Style="{StaticResource TextDetail}" Text="Lo de hoy y lo que conviene atender del inventario" Margin="0,4,0,20" />

            <!-- Indicadores -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Ventas de hoy" />
                        <TextBlock Style="{StaticResource TextMono}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"
                                   Text="{Binding Metrics.SalesTodayTotal, StringFormat={}{0:C0}, ConverterCulture=es-MX}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Metrics.SalesTodayCount, StringFormat='{}{0} ticket(s)'}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Usado en consulta hoy" />
                        <TextBlock Style="{StaticResource TextMono}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Text="{Binding Metrics.ConsumedInConsultationToday}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="piezas" />
                    </StackPanel>
                </Border>
                <!-- Valor del inventario al costo (antes: solo el número de productos, que ahora va abajo) -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Valor del inventario" />
                        <TextBlock Style="{StaticResource TextMono}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"
                                   Text="{Binding Metrics.InventoryValue, StringFormat={}{0:C0}, ConverterCulture=es-MX}" />
                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} productos · {1}">
                                    <Binding Path="Metrics.TotalProducts" />
                                    <Binding Path="Metrics.InventoryValueDetail" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Con stock bajo" />
                        <TextBlock Style="{StaticResource TextMono}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Text="{Binding Metrics.LowStockCount}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="por reabastecer" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Lotes por vencer" />
                        <TextBlock Style="{StaticResource TextMono}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Text="{Binding Metrics.ExpiringSoonCount}" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Metrics.ExpiredCount, StringFormat='{}{0} vencido(s)'}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Stock bajo -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextSection}" Text="Stock bajo" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" MinHeight="0" Padding="8,4" Content="Ver productos"
                                        Command="{Binding NavigateToCommand}" CommandParameter="Inventory" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Product}">
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding MinStock, StringFormat='Mínimo {0}'}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource StockBadge}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentStock, StringFormat='Quedan {0}'}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextDetail}" Text="Todo el inventario está por encima del mínimo."
                                       Visibility="{Binding HasNoLowStock, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Lotes por vencer -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextSection}" Text="Lotes por vencer (60 días)" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" MinHeight="0" Padding="8,4" Content="Ver lotes"
                                        Command="{Binding NavigateToCommand}" CommandParameter="Batches" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExpiringBatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ProductBatch}">
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource TextCaption}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}Lote {0} · {1} pieza(s)">
                                                                <Binding Path="BatchNumber" />
                                                                <Binding Path="Quantity" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource BatchStatusBadge}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextDetail}" Text="Ningún lote vence en los próximos 60 días."
                                       Visibility="{Binding HasNoExpiringBatches, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Movimientos recientes -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextSection}" Text="Movimientos recientes" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" MinHeight="0" Padding="8,4" Content="Ver kardex"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Movements" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentMovements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:InventoryMovement}">
                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding MovementTypeDisplay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding Quantity, StringFormat='{}{0} pza(s)'}" />
                                                <TextBlock Style="{StaticResource TextCaption}" TextAlignment="Right" Text="{Binding Date, StringFormat='{}{0:dd/MM HH:mm}'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextDetail}" Text="Todavía no hay movimientos."
                                   Visibility="{Binding HasNoRecentMovements, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
