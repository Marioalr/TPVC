<UserControl x:Class="TPVC.Views.ConsultationCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ========================================================================= -->
    <!-- TERMINAR CONSULTA: nota guardada, receta y el mismo cobro del Punto de     -->
    <!-- Venta (cuenta propia de la consulta). "Volver a la consulta" (o Esc)       -->
    <!-- permite agregar algo que faltó.                                           -->
    <!-- ========================================================================= -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" MaxWidth="1040" MaxHeight="760" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextHeading}" Text="Terminar consulta" />
                            <TextBlock Style="{StaticResource TextDetail}" Margin="0,2,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · duración {1}">
                                        <Binding Path="Active.ActiveConsultationPatientName" />
                                        <Binding Path="Active.ActiveConsultationElapsedTime" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.CloseFinishConsultationCommand}"
                                ToolTip="Regresar a la nota para agregar o corregir algo antes de cobrar (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                                <TextBlock Text="Volver a la consulta" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="24,18,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nota guardada y receta -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NoticeSuccess}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,6,0" />
                                        <TextBlock Text="Nota médica guardada" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Consultation.ConsultationDiagnosis, TargetNullValue='Sin diagnóstico capturado'}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardSubtle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Text="{Binding Session.SelectedPatient.ActivePrescription.Count, StringFormat='Receta · {0} medicamento(s)'}" />
                                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding Session.SelectedPatient.ActivePrescription.Count, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,5" Margin="0,0,6,0" Command="{Binding Preview.PrintOrExportPrescriptionPdfCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:Icon Data="{StaticResource IcoPrint}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Imprimir" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,5" Margin="0,0,6,0" Command="{Binding Preview.OpenPrescriptionPdfPreviewCommand}" Content="Vista previa" />
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,5" Command="{Binding Preview.ExportPrescriptionDocumentCommand}" Content="Guardar PDF" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Sin medicamentos recetados." Margin="0,4,0,0"
                                               Visibility="{Binding Session.SelectedPatient.ActivePrescription.Count, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Style="{StaticResource TextSection}" Text="Cuenta de la consulta" Margin="0,0,0,8" />
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" MinHeight="180">
                            <views:CartLinesView DataContext="{Binding Consultation.Checkout}" />
                        </Border>
                        <TextBlock Grid.Row="3" Style="{StaticResource TextCaption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Al cobrar se descuentan del inventario los medicamentos e insumos entregados. Si quita todos los cargos, la consulta termina sin registrar una venta." />
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0"
                            CornerRadius="0,0,16,0" Padding="20,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <views:PaymentPanelView DataContext="{Binding Consultation.Checkout}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
