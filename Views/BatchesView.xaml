<UserControl x:Class="TPVC.Views.BatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BatchesViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Lotes y caducidades: lo que vence primero arriba (FEFO), filtros como chips y el registro -->
    <!-- de un lote nuevo en un panel lateral.                                                   -->
    <Grid>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Lotes y caducidades" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="Al vender o usar se descuenta primero el lote que vence antes" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding OpenNewBatchModalCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                        <TextBlock Text="Registrar lote" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListBox Grid.Row="1" Style="{StaticResource ChipList}" Margin="0,0,0,12"
                     ItemsSource="{Binding FilterChips}" SelectedItem="{Binding SelectedFilterChip, Mode=TwoWay}"
                     DisplayMemberPath="Text" AutomationProperties.Name="Filtrar lotes" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox Style="{StaticResource PlainList}" Padding="8,6" ItemsSource="{Binding Batches}" AutomationProperties.Name="Lotes">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProductBatch}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Notes}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Notes, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Lote" />
                                        <TextBlock Style="{StaticResource TextMono}" Text="{Binding BatchNumber}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Quedan" />
                                        <TextBlock Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="{Binding Quantity}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Caduca" />
                                        <Border Style="{StaticResource BatchStatusBadge}" HorizontalAlignment="Left">
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:dd/MM/yyyy} · {1}">
                                                        <Binding Path="ExpirationDate" />
                                                        <Binding Path="StatusText" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource ButtonDangerGhost}" MinHeight="0" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Quita el lote y descuenta sus piezas de las existencias">
                                        <StackPanel Orientation="Horizontal">
                                            <helpers:Icon Data="{StaticResource IcoTrash}" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Quitar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No hay lotes con este filtro."
                               Visibility="{Binding Batches.Count, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= PANEL: REGISTRAR LOTE ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="440" Panel.ZIndex="50"
                Visibility="{Binding IsNewBatchModalOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Registrar lote" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Las piezas se suman a las existencias y quedan en el kardex" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseNewBatchModalCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,16">
                        <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding NewBatchError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NewBatchError}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Producto *" />
                        <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding NewBatchSelectedProduct}"
                                  DisplayMemberPath="Name" helpers:TypeAhead.IsEnabled="True" Margin="0,0,0,12" AutomationProperties.Name="Producto"
                                  ToolTip="Despliegue y escriba el nombre para ir directo a él" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Número de lote *" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding NewBatchNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Piezas *" />
                                <TextBox Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center" Text="{Binding NewBatchQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Contenido por paquete (ampolletas, piezas, etc.)" />
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}"
                                     Text="{Binding NewBatchUnitsPerPackageText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="1 (si no se ingresa se asume 1 sola pieza)"
                                     AutomationProperties.Name="Contenido por paquete" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Caducidad *" />
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewBatchExpirationText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="dd/mm/aaaa o mm/aaaa" AutomationProperties.Name="Caducidad" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,4" Margin="0,0,6,6" Content="+6 meses" Command="{Binding AddMonthsToExpirationCommand}" CommandParameter="6" />
                            <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,4" Margin="0,0,6,6" Content="+1 año" Command="{Binding AddMonthsToExpirationCommand}" CommandParameter="12" />
                            <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="10,4" Margin="0,0,6,6" Content="+2 años" Command="{Binding AddMonthsToExpirationCommand}" CommandParameter="24" />
                        </WrapPanel>
                        <Border Style="{StaticResource NoticeWarning}" Margin="0,6,0,12" Visibility="{Binding IsExpirationWarningVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ExpirationWarningMessage}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notas" Margin="0,6,0,6" />
                        <TextBox Style="{StaticResource FieldMultiline}" MinHeight="60" Text="{Binding NewBatchNotes, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="Proveedor, factura…" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseNewBatchModalCommand}" Content="Cancelar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveNewBatchCommand}" Content="Registrar lote" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
