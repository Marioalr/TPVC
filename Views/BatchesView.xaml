<UserControl x:Class="TPVC.Views.BatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:BatchesViewModel}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Control de Lotes y Fechas de Caducidad" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeText}" />
                <TextBlock Text="Monitoreo crítico para insumos médicos y farmacológicos" 
                           FontSize="13" 
                           Foreground="{DynamicResource ThemeTextSecondary}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Style="{DynamicResource AccentButton}" 
                    Command="{Binding OpenNewBatchModalCommand}"
                    Padding="16,9">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPlus}" 
                          Fill="{DynamicResource ThemeAccentText}" 
                          Width="14" Height="14" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0" />
                    <TextBlock Text="Registrar Nuevo Lote" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filtros de Estado de Caducidad -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,0,0,16" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Filtrar por Vencimiento:" 
                           FontWeight="SemiBold" 
                           FontSize="13" 
                           VerticalAlignment="Center" 
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab: Todos -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Todos" 
                            Padding="14,6" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilter}" Value="Todos">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Todos los Lotes" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CountTodos, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Próximos a Vencer -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Proximos" 
                            Padding="14,6" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilter}" Value="Proximos">
                                        <Setter Property="Background" Value="{DynamicResource ThemeWarning}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏳ Próximos a Vencer (≤60d)" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CountProximos, StringFormat=' ({0})'}" FontWeight="Bold" FontSize="11" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Vencidos -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Vencidos" 
                            Padding="14,6" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilter}" Value="Vencidos">
                                        <Setter Property="Background" Value="{DynamicResource ThemeError}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛑 Vencidos" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CountVencidos, StringFormat=' ({0})'}" FontWeight="Bold" FontSize="11" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Vigentes -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Vigentes" 
                            Padding="14,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFilter}" Value="Vigentes">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSuccess}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✅ Vigentes" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CountVigentes, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid de Lotes -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Batches}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° de Lote" Binding="{Binding BatchNumber}" Width="150" />
                    <DataGridTextColumn Header="Insumo / Medicamento" Binding="{Binding Product.Name}" Width="*" />
                    <DataGridTextColumn Header="Cantidad en Lote" Binding="{Binding Quantity}" Width="130" />
                    <DataGridTextColumn Header="Fecha de Caducidad" Binding="{Binding ExpirationDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="150" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="170" />
                    <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="200" />
                    
                    <DataGridTemplateColumn Header="Acción" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource OutlineButton}" 
                                        Content="Eliminar" 
                                        Padding="8,4" 
                                        FontSize="11"
                                        Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Modal Registrar Nuevo Lote -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#66000000"
                Visibility="{Binding IsNewBatchModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorder}" 
                    Width="460" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <TextBlock Text="Registrar Lote de Insumo / Medicamento" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,6" />
                    <TextBlock Text="Asigna un lote y fecha de expiración para control riguroso:" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,16" />

                    <TextBlock Text="Artículo / Medicamento *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox Style="{DynamicResource ModernComboBox}" 
                              ItemsSource="{Binding AvailableProducts}" 
                              SelectedItem="{Binding NewBatchSelectedProduct}" 
                              DisplayMemberPath="Name" 
                              Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Número de Lote *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding NewBatchNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cantidad a Ingresar *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding NewBatchQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Fecha de Caducidad *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding NewBatchExpirationDate}" Margin="0,0,0,10" />

                    <!-- Alerta preventiva si vence en <= 30 días o ya venció -->
                    <Border Background="{DynamicResource ThemeWarning}" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,14" 
                            Visibility="{Binding IsExpirationWarningVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ExpirationWarningMessage}" 
                                   Foreground="White" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Notas del Lote" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Style="{DynamicResource ModernTextBox}" Text="{Binding NewBatchNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource OutlineButton}" 
                                Content="Cancelar" 
                                Command="{Binding CloseNewBatchModalCommand}" 
                                Margin="0,0,10,0" 
                                Padding="16,8" />
                        <Button Style="{DynamicResource AccentButton}" 
                                Content="Guardar Lote" 
                                Command="{Binding SaveNewBatchCommand}" 
                                Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
