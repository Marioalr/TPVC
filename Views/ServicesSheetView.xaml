<UserControl x:Class="TPVC.Views.ServicesSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Servicios y procedimientos de la consulta (inyección, curación, sutura…): se escriben -->
    <!-- (↑↓ y Enter eligen) y se cargan a la cuenta de la consulta con sus insumos.          -->
    <!-- En la consulta en curso, cada servicio cambia sus unidades con − / + y sus insumos    -->
    <!-- solo para esta consulta («Ajustar insumos», pedido del 2026-10-14).                   -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="820" MaxHeight="700" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Servicios y procedimientos" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Inyección, curación, sutura, revisión especial… se cargan a la cuenta de la consulta" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding ClinicalServices.OpenServiceCatalogCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                            ToolTip="Ver todos los servicios">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSearch}" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding ClinicalServices.CloseServicesModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Captura rápida -->
                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Servicio *" />
                            <TextBox x:Name="ServiceModalSearchTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding ClinicalServices.ServiceModalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Escriba para buscar"
                                     PreviewKeyDown="ServiceModalSearchTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="Servicio" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notas" />
                            <TextBox x:Name="ServiceModalNotesTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding ClinicalServices.ServiceModalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. sutura en brazo izquierdo"
                                     PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Notas del servicio" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                            <TextBox x:Name="ServiceModalQuantityTextBox" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                     Text="{Binding ClinicalServices.ServiceModalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Cantidad" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0"
                            Visibility="{Binding ClinicalServices.IsServiceModalDropdownOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter o clic agrega · Esc cierra" Margin="10,4,10,4" />
                            <ListBox x:Name="ServiceSuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="200"
                                     ItemsSource="{Binding ClinicalServices.ServiceModalSuggestions}"
                                     SelectedItem="{Binding ClinicalServices.SelectedServiceModalItem, Mode=TwoWay}"
                                     PreviewKeyDown="ServiceSuggestionsListBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="ServiceSuggestionsListBox_PreviewMouseLeftButtonUp"
                                     AutomationProperties.Name="Sugerencias de servicios">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClinicalService}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="Code" />
                                                            <Binding Path="Category" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lo hecho en la consulta -->
                <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Margin="24,0,24,0" Padding="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActiveServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PatientServiceItem}">
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding ServiceName}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Notes}" TextWrapping="Wrap"
                                                                   Visibility="{Binding Notes, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" FontStyle="Italic" Text="De una consulta anterior: no se cobra en esta"
                                                                   Visibility="{Binding IsFromEarlierConsultation, Converter={StaticResource BoolToVis}}" />
                                                        <!-- Los insumos que cargó este renglón, en una línea (2026-10-14) -->
                                                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="{Binding SuppliesSummary, StringFormat='Insumos: {0}'}"
                                                                   Visibility="{Binding HasSupplies, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource ButtonGhost}" Padding="6,3" Margin="-6,4,0,0" HorizontalAlignment="Left"
                                                                Visibility="{Binding IsFromEarlierConsultation, Converter={StaticResource InverseBoolToVis}}"
                                                                ToolTip="Quitar o agregar insumos solo en esta consulta (el servicio no cambia)"
                                                                AutomationProperties.Name="Ajustar insumos del servicio"
                                                                Command="{Binding DataContext.ClinicalServices.ToggleServiceSuppliesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <helpers:Icon Data="{StaticResource IcoEdit}" Width="12" Height="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="Ajustar insumos" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <!-- Unidades: con − / + en lo de esta consulta; lo de una consulta anterior solo se ve -->
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsFromEarlierConsultation, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsFromEarlierConsultation, Converter={StaticResource InverseBoolToVis}}">
                                                        <Button Style="{StaticResource ButtonIconSecondary}" Width="30" Height="30" ToolTip="Una unidad menos, con sus insumos (en 0 se quita)"
                                                                AutomationProperties.Name="Una unidad menos del servicio"
                                                                Command="{Binding DataContext.ClinicalServices.DecreaseServiceUnitsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="−" FontSize="16" />
                                                        </Button>
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" MinWidth="32" TextAlignment="Center" VerticalAlignment="Center"
                                                                   Text="{Binding Quantity}" AutomationProperties.Name="Unidades del servicio" />
                                                        <Button Style="{StaticResource ButtonIconSecondary}" Width="30" Height="30" ToolTip="Una unidad más, con sus insumos por defecto"
                                                                AutomationProperties.Name="Una unidad más del servicio"
                                                                Command="{Binding DataContext.ClinicalServices.IncreaseServiceUnitsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="+" FontSize="16" />
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" Margin="12,0" VerticalAlignment="Center"
                                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                                    <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar (también de la cuenta, con sus insumos)" AutomationProperties.Name="Quitar servicio"
                                                            Command="{Binding DataContext.ClinicalServices.RemoveServiceItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                    </Button>
                                                </Grid>

                                                <!-- Insumos de este renglón, solo para esta consulta: − / +, X y agregar con la búsqueda -->
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"
                                                        Visibility="{Binding IsEditingSupplies, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                                   Text="Solo en esta consulta: ajuste cuántas piezas individuales (ampolletas, piezas, etc.) se consumen. Si el paquete trae varias piezas, solo se consume esa parte." />
                                                        <!-- Los del renglón o, en uno sin lista (de una versión anterior), los que descontaría quitarlo -->
                                                        <ItemsControl ItemsSource="{Binding DataContext.ClinicalServices.SupplyEditorEntries, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:PatientServiceSupply}">
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding SupplyName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource ButtonIconSecondary}" Width="26" Height="26" ToolTip="Una pieza individual menos (en 0 se quita)"
                                                                                    AutomationProperties.Name="Una pieza menos del insumo"
                                                                                    Command="{Binding DataContext.ClinicalServices.DecreaseServiceSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="−" FontSize="14" />
                                                                            </Button>
                                                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" MinWidth="32" TextAlignment="Center" VerticalAlignment="Center"
                                                                                       Text="{Binding Quantity}" AutomationProperties.Name="Piezas del insumo" />
                                                                            <Button Style="{StaticResource ButtonIconSecondary}" Width="26" Height="26" ToolTip="Una pieza individual más"
                                                                                    AutomationProperties.Name="Una pieza más del insumo"
                                                                                    Command="{Binding DataContext.ClinicalServices.IncreaseServiceSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="+" FontSize="14" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="26" Height="26" ToolTip="Quitar de este servicio (también de la cuenta)"
                                                                                AutomationProperties.Name="Quitar insumo del servicio"
                                                                                Command="{Binding DataContext.ClinicalServices.RemoveServiceSupplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <helpers:Icon Data="{StaticResource IcoClose}" Width="12" Height="12" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Style="{StaticResource TextCaption}" FontStyle="Italic" Text="Sin insumos en esta consulta."
                                                                   Visibility="{Binding DataContext.ClinicalServices.HasSupplyEditorEntries, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}" />
                                                        <TextBox Style="{StaticResource FieldTextBox}" Margin="0,6,0,0"
                                                                 Text="{Binding DataContext.ClinicalServices.ServiceSupplySearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                 helpers:Field.Placeholder="Agregar insumo (por piezas individuales): escriba para buscar"
                                                                 PreviewKeyDown="ServiceSupplySearch_PreviewKeyDown"
                                                                 IsVisibleChanged="ServiceSupplySearch_IsVisibleChanged"
                                                                 AutomationProperties.Name="Agregar insumo al servicio" />
                                                        <Border Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0"
                                                                Visibility="{Binding DataContext.ClinicalServices.IsServiceSupplyDropdownOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter o clic agrega una pieza individual · Esc cierra los insumos" Margin="10,4,10,4" />
                                                                <ListBox Style="{StaticResource PlainList}" MaxHeight="180"
                                                                         ItemsSource="{Binding DataContext.ClinicalServices.ServiceSupplySuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         SelectedItem="{Binding DataContext.ClinicalServices.SelectedServiceSupplySuggestion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                                         SelectionChanged="ServiceSupplySuggestions_SelectionChanged"
                                                                         PreviewMouseLeftButtonUp="ServiceSupplySuggestions_PreviewMouseLeftButtonUp"
                                                                         AutomationProperties.Name="Sugerencias de insumos del servicio">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:Product}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="90" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="{Binding HasMultipleUnitsPerPackage, Converter={StaticResource BoolToVis}}">
                                                                                            <TextBlock Text="{Binding PackageContentText}" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Presentation}" />
                                                                                </StackPanel>
                                                                                <Border Grid.Column="1" Style="{StaticResource StockBadge}" Margin="12,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding StockBadgeText}" />
                                                                                </Border>
                                                                                <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                                                           Text="{Binding IndividualUnitPrice, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding Session.SelectedPatient.ActiveServices.Count, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource TextBody}" Text="Todavía no se ha hecho ningún procedimiento." HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="Escríbalo arriba o ábralo desde el catálogo." HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding ClinicalServices.CloseServicesModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ClinicalServices.SaveServicesModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
