<UserControl x:Class="TPVC.Views.ServicesSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Servicios y procedimientos de la consulta (inyección, curación, sutura…): se escriben -->
    <!-- (↑↓ y Enter eligen) y se cargan a la cuenta de la consulta con sus insumos.          -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="820" MaxHeight="700" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Servicios y procedimientos" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Inyección, curación, sutura, revisión especial… se cargan a la cuenta de la consulta" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding ClinicalServices.OpenServiceCatalogCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                            ToolTip="Ver todos los servicios">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSearch}" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding ClinicalServices.CloseServicesModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Captura rápida -->
                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Servicio *" />
                            <TextBox x:Name="ServiceModalSearchTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding ClinicalServices.ServiceModalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Escriba para buscar"
                                     PreviewKeyDown="ServiceModalSearchTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="Servicio" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notas" />
                            <TextBox x:Name="ServiceModalNotesTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding ClinicalServices.ServiceModalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. sutura en brazo izquierdo"
                                     PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Notas del servicio" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                            <TextBox x:Name="ServiceModalQuantityTextBox" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                     Text="{Binding ClinicalServices.ServiceModalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ServiceModalAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Cantidad" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0"
                            Visibility="{Binding ClinicalServices.IsServiceModalDropdownOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter o clic agrega · Esc cierra" Margin="10,4,10,4" />
                            <ListBox x:Name="ServiceSuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="200"
                                     ItemsSource="{Binding ClinicalServices.ServiceModalSuggestions}"
                                     SelectedItem="{Binding ClinicalServices.SelectedServiceModalItem, Mode=TwoWay}"
                                     PreviewKeyDown="ServiceSuggestionsListBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="ServiceSuggestionsListBox_PreviewMouseLeftButtonUp"
                                     AutomationProperties.Name="Sugerencias de servicios">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClinicalService}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="Code" />
                                                            <Binding Path="Category" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lo hecho en la consulta -->
                <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Margin="24,0,24,0" Padding="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActiveServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PatientServiceItem}">
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding ServiceName}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Notes}" TextWrapping="Wrap"
                                                               Visibility="{Binding Notes, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" Margin="12,0" VerticalAlignment="Center"
                                                           Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                                <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar (también de la cuenta)" AutomationProperties.Name="Quitar servicio"
                                                        Command="{Binding DataContext.ClinicalServices.RemoveServiceItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding Session.SelectedPatient.ActiveServices.Count, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource TextBody}" Text="Todavía no se ha hecho ningún procedimiento." HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="Escríbalo arriba o ábralo desde el catálogo." HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding ClinicalServices.CloseServicesModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ClinicalServices.SaveServicesModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
