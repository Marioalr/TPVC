<UserControl x:Class="TPVC.Views.MainHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainHubViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra Superior de Conmutación de Modo de la Vista Principal -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ThemeSurface}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="0,0,0,1" 
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vista Principal del Consultorio" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="{DynamicResource ThemeText}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0" />
                    <Border Background="{DynamicResource ThemeBorder}" 
                            CornerRadius="4" 
                            Padding="8,2" 
                            VerticalAlignment="Center">
                        <TextBlock Text="Expedientes Clínicos + Punto de Venta" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Border>
                </StackPanel>

                <!-- Selector de Modo de Pantalla: Dividida, Solo Venta, Solo Expedientes -->
                <Border Grid.Column="1" 
                        Background="{DynamicResource ThemeCard}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <!-- Botón Vista Dividida -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="HubViewMode" 
                                     IsChecked="{Binding IsDividedMode}" 
                                     Command="{Binding SetModeCommand}" 
                                     CommandParameter="Divided" 
                                     Padding="10,5" 
                                     Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconColumns}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Vista Dividida" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Botón Solo Venta (POS) -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="HubViewMode" 
                                     IsChecked="{Binding IsPosOnlyMode}" 
                                     Command="{Binding SetModeCommand}" 
                                     CommandParameter="Pos" 
                                     Padding="10,5" 
                                     Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCart}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Venta / Carrito (POS)" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Botón Solo Expedientes (TODO) -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="HubViewMode" 
                                     IsChecked="{Binding IsRecordsOnlyMode}" 
                                     Command="{Binding SetModeCommand}" 
                                     CommandParameter="Records" 
                                     Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFileMedical}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="12" Height="12" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Expedientes (TODO)" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Área de Contenido Según el Modo Activo -->
        <Grid Grid.Row="1">
            <!-- Modo 1: VISTA DIVIDIDA (Expedientes a la izquierda, Venta POS a la derecha) -->
            <Grid Visibility="{Binding IsDividedMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" MinWidth="380" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="5*" MinWidth="480" />
                </Grid.ColumnDefinitions>

                <!-- Panel Izquierdo: Expedientes Clínicos (TODO) -->
                <views:MedicalRecordsView Grid.Column="0" DataContext="{Binding MedicalRecordsVM}" />

                <!-- Divisor Visual -->
                <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorder}" />

                <!-- Panel Derecho: Punto de Venta con Carrito -->
                <views:PosView Grid.Column="2" DataContext="{Binding PosVM}" />
            </Grid>

            <!-- Modo 2: SOLO VENTA / POS (Pantalla Completa) -->
            <Grid Visibility="{Binding IsPosOnlyMode, Converter={StaticResource BoolToVis}}">
                <views:PosView DataContext="{Binding PosVM}" />
            </Grid>

            <!-- Modo 3: SOLO EXPEDIENTES (Pantalla Completa) -->
            <Grid Visibility="{Binding IsRecordsOnlyMode, Converter={StaticResource BoolToVis}}">
                <views:MedicalRecordsView DataContext="{Binding MedicalRecordsVM}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
