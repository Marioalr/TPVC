<UserControl x:Class="TPVC.Views.MainHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainHubViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Estilo interactivo para las Tarjetas Grandes de Acción Principal -->
        <Style x:Key="BigActionCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="32" />
            <Setter Property="MinHeight" Value="360" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="18" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Contenedor Centralizado de la Vista Principal -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera de Bienvenida -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,36">
            <TextBlock Text="Consultorio Médico General" 
                       FontWeight="Bold" 
                       FontSize="28" 
                       Foreground="{DynamicResource ThemeText}" 
                       HorizontalAlignment="Center" />
            <TextBlock Text="Seleccione una acción principal para comenzar la jornada clínica" 
                       FontSize="14" 
                       Foreground="{DynamicResource ThemeTextSecondary}" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Los Dos Botones Grandes (Tipo Cards) -->
        <Grid Grid.Row="1" MaxWidth="920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- CARD 1: NUEVA VENTA (Punto de Venta / Carrito POS) -->
            <!-- ============================================ -->
            <Button Grid.Column="0" 
                    Style="{StaticResource BigActionCardStyle}" 
                    Command="{Binding OpenNewSaleCommand}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ícono de Carrito en Círculo con Acento -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ThemeAccent}" 
                            CornerRadius="36" 
                            Width="72" Height="72" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,18">
                        <Path Data="{StaticResource IconCart}" 
                              Fill="{DynamicResource ThemeAccentText}" 
                              Width="32" Height="32" 
                              Stretch="Uniform" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />
                    </Border>

                    <!-- Título de la Card -->
                    <TextBlock Grid.Row="1" 
                               Text="Nueva Venta" 
                               FontWeight="Bold" 
                               FontSize="23" 
                               Foreground="{DynamicResource ThemeText}" 
                               HorizontalAlignment="Center" />

                    <!-- Subtítulo -->
                    <TextBlock Grid.Row="2" 
                               Text="Punto de Venta / Farmacia" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               Foreground="{DynamicResource ThemeAccent}" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,12" />

                    <!-- Descripción Explicativa -->
                    <TextBlock Grid.Row="3" 
                               Text="Dispensación y venta de medicamentos, curación e insumos con carrito interactivo, cálculo de totales y descuento automático por caducidad (FEFO)." 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontSize="12" 
                               LineHeight="18" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,24" />

                    <!-- Botón / Indicador CTA -->
                    <Border Grid.Row="4" 
                            Background="{DynamicResource ThemeAccent}" 
                            CornerRadius="8" 
                            Padding="20,10" 
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Iniciar Venta" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource ThemeAccentText}" 
                                       Margin="0,0,8,0" />
                            <TextBlock Text="→" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource ThemeAccentText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>

            <!-- ============================================ -->
            <!-- CARD 2: NUEVA CONSULTA (Expedientes Clínicos - TODO) -->
            <!-- ============================================ -->
            <Button Grid.Column="2" 
                    Style="{StaticResource BigActionCardStyle}" 
                    Command="{Binding OpenNewConsultationCommand}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ícono de Expediente Médico en Círculo -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeAccent}" 
                            BorderThickness="1.5" 
                            CornerRadius="36" 
                            Width="72" Height="72" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,18">
                        <Path Data="{StaticResource IconFileMedical}" 
                              Fill="{DynamicResource ThemeAccent}" 
                              Width="32" Height="32" 
                              Stretch="Uniform" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />
                    </Border>

                    <!-- Título de la Card -->
                    <TextBlock Grid.Row="1" 
                               Text="Nueva Consulta" 
                               FontWeight="Bold" 
                               FontSize="23" 
                               Foreground="{DynamicResource ThemeText}" 
                               HorizontalAlignment="Center" />

                    <!-- Subtítulo y Badge TODO -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,12">
                        <TextBlock Text="Expedientes Clínicos" 
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource ThemeAccent}" 
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource ThemeBorder}" 
                                CornerRadius="4" 
                                Padding="6,2" 
                                Margin="8,0,0,0" 
                                VerticalAlignment="Center">
                            <TextBlock Text="TODO" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                        </Border>
                    </StackPanel>

                    <!-- Descripción Explicativa -->
                    <TextBlock Grid.Row="3" 
                               Text="Consulta de expedientes de pacientes, historial clínico, signos vitales, notas médicas de evolución y prescripción de recetas médicas." 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontSize="12" 
                               LineHeight="18" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,24" />

                    <!-- Botón / Indicador CTA -->
                    <Border Grid.Row="4" 
                            Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20,10" 
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Abrir Expedientes" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       Margin="0,0,8,0" />
                            <TextBlock Text="→" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource ThemeAccent}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
