<UserControl x:Class="TPVC.Views.PatientFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}"
             d:DesignHeight="820" d:DesignWidth="1300">

    <UserControl.Resources>
        <Style x:Key="FormNavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Encabezado de sección: título y si es obligatoria -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextSection}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= BARRA SUPERIOR ======================= -->
        <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding CancelPatientFormCommand}" Margin="0,0,16,0" ToolTip="Volver sin guardar">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                        <TextBlock Text="Volver" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextHeading}" Text="{Binding FormPageTitle}" />
                    <TextBlock Style="{StaticResource TextCaption}">
                        <Run Text="Folio" />
                        <Run Text="{Binding FormRecordNumber, Mode=OneWay}" FontFamily="{StaticResource FontFamilyMono}" />
                        <Run Text="· automático" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonGhost}" Command="{Binding CancelPatientFormCommand}" Content="Cancelar" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding SavePatientModalCommand}" Content="Guardar y abrir ficha" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SavePatientAndStartConsultationCommand}" Content="Guardar e iniciar consulta" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error de validación: la sección con el dato que falta se abre sola -->
        <Border Grid.Row="1" Style="{StaticResource NoticeDanger}" Margin="24,12,24,0"
                Visibility="{Binding FormErrorMessage, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <helpers:Icon Data="{StaticResource IcoAlert}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding FormErrorMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= SECCIONES ======================= -->
            <Border Style="{StaticResource Card}" Padding="10,12" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding FormProgressText}" Margin="10,0,10,10" />
                    <ItemsControl ItemsSource="{Binding FormSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PatientFormSection}">
                                <Button x:Name="Nav" Style="{StaticResource FormNavButton}"
                                        Command="{Binding DataContext.OpenFormSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Mark" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource ThemeSurfaceSubtle}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <helpers:Icon x:Name="Check" Data="{StaticResource IcoCheck}" Width="14" Height="14" StrokeThickness="3" Foreground="{DynamicResource ThemeSuccessText}" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TextBody}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Status}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource ThemeSuccessSubtle}" />
                                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter TargetName="Nav" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="10,10,10,0"
                               Text="Solo aparecen los antecedentes que corresponden al sexo y la edad del paciente." />
                </StackPanel>
            </Border>

            <!-- ======================= CONTENIDO ======================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 1. Identificación -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Identificacion">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identificación" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="  · obligatoria" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Identificacion}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre(s) *" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Apellido paterno *" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Apellido materno" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormMaternalLastName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fecha de nacimiento *" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormBirthDateText, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="dd/mm/aaaa" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="{Binding FormAgeDisplay}" Foreground="{DynamicResource ThemeAccentForeground}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Edad (años)" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormAgeText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding FormHasBirthDate}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="Solo si no se conoce la fecha; con fecha se calcula sola." />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sexo *" />
                                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding FormGender}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="Define qué antecedentes se piden." />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Teléfono" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="10 dígitos (WhatsApp)" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ocupación" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormOccupation, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Religión" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormReligion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Alergias y crónicos -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Alergias">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alergias y enfermedades crónicas" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="  · alergias obligatorias" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Alergias}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Alergias *" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormAllergies, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Medicamentos o alimentos (p. ej. penicilina, sulfas)" />
                                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding SetAllergiesDeniedCommand}" Content="Negadas" Margin="8,0,0,0" ToolTip="El paciente niega alergias" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="&quot;Negadas&quot; no es lo mismo que no haber preguntado: vacío se muestra como alergias sin interrogar." />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Enfermedades crónicas" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormChronicDiseases, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Hipertensión, diabetes, asma…" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Grupo sanguíneo" />
                                        <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding FormBloodType}" helpers:TypeAhead.IsEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Contacto y emergencia -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Contacto">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Contacto y emergencia" />
                            </Button>
                            <Grid Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Contacto}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Correo" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Domicilio" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Contacto de emergencia" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormEmergencyContactName, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Nombre y parentesco" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Teléfono de emergencia" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormEmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Heredofamiliares -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Heredofamiliares">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Heredofamiliares" />
                            </Button>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Heredofamiliares}">
                                <TextBox Style="{StaticResource FieldMultiline}" Text="{Binding FormFamilyHistory, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Diabetes, hipertensión, cáncer, cardiopatías… y quién (madre, padre, abuelos)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. Personales patológicos -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Patologicos">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Personales patológicos" />
                            </Button>
                            <Grid Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Patologicos}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cirugías" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormSurgeries, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hospitalizaciones" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormHospitalizations, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Transfusiones" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormTransfusions, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0" Visibility="{Binding FormIsPediatric, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Esquema de vacunación" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormImmunizationSchedule, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. Gineco-obstétricos (solo mujeres de 10 años o más) -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" Visibility="{Binding FormShowsGyneco, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Gineco">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Gineco-obstétricos" />
                            </Button>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Gineco}">
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,16,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Menarca (edad)" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormMenarcheAge, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Inicio de vida sexual" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormSexualOnsetAge, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Parejas sexuales" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormSexualPartnersCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ciclo / duración" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormPeriodDuration, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="28 x 5" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Flujo" />
                                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding PeriodHeavyOptions}" SelectedItem="{Binding FormIsPeriodHeavy}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Papanicolaou (fecha / resultado)" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormPapSmear, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Gestas" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormPregnanciesCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Cesáreas" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormCesareansCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Abortos" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormAbortionsCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding FormIsCurrentlyPregnant}" Content="Embarazo actual" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Width="140" Margin="16,0,0,0" Text="{Binding FormGestationalWeeks, UpdateSourceTrigger=PropertyChanged}"
                                             helpers:Field.Placeholder="Semanas" Visibility="{Binding FormIsCurrentlyPregnant, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 7. Desarrollo (solo menores de 18) -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" Visibility="{Binding FormIsPediatric, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Desarrollo">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Desarrollo y vacunas" />
                            </Button>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Desarrollo}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Hitos del desarrollo" />
                                <TextBox Style="{StaticResource FieldMultiline}" Text="{Binding FormDevelopmentalMilestones, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Sostén cefálico, sedestación, marcha, lenguaje, escolaridad…" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Esquema de vacunación" Margin="0,16,0,6" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding FormImmunizationSchedule, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="BCG, hepatitis B, hexavalente, rotavirus, neumococo, SRP…" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 8. No patológicos -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="NoPatologicos">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="No patológicos" />
                            </Button>
                            <Grid Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=NoPatologicos}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Alimentación" />
                                    <TextBox Style="{StaticResource FieldMultiline}" MinHeight="56" Text="{Binding FormDiet, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Vivienda y servicios" />
                                    <TextBox Style="{StaticResource FieldMultiline}" MinHeight="56" Text="{Binding FormHousingConditions, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Animales / zoonosis" />
                                    <TextBox Style="{StaticResource FieldMultiline}" MinHeight="56" Text="{Binding FormZoonosis, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 9. Notas de ingreso -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding OpenFormSectionCommand}" CommandParameter="Notas">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Notas de ingreso" />
                            </Button>
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding FormOpenSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=Notas}">
                                <TextBox Style="{StaticResource FieldMultiline}" Text="{Binding FormClinicalNotes, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Observaciones al abrir el expediente" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
