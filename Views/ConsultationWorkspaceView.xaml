<UserControl x:Class="TPVC.Views.ConsultationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ===================================================================== -->
    <!-- CONSULTA EN CURSO: secciones en el orden de la entrevista y cuenta de  -->
    <!-- la consulta. Todo se agrega y se cobra aquí, sin ir al Punto de Venta. -->
    <!-- ===================================================================== -->
    <Grid x:Name="ConsultationWorkspace"
          Background="{DynamicResource ThemeCard}"
          PreviewKeyDown="ConsultationWorkspace_PreviewKeyDown"
          >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra superior: paciente, alergias, tiempo y un solo botón para terminar -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.SelectedPatient.FullName}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ThemeText}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1} · {2} · Folio de consulta {3}">
                                    <Binding Path="Session.SelectedPatient.AgeDisplay" />
                                    <Binding Path="Session.SelectedPatient.Gender" />
                                    <Binding Path="Session.SelectedPatient.RecordNumber" />
                                    <Binding Path="Active.ActiveConsultationFolio" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                <Border Style="{StaticResource AllergyBadge}" DataContext="{Binding Session.SelectedPatient}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Style="{StaticResource AllergyBadgeText}" FontSize="12" />
                </Border>
                    <!-- Cronómetro: un clic lo oculta (queda solo el reloj) o lo vuelve a mostrar; se recuerda en este equipo -->
                    <Button Style="{StaticResource ButtonGhost}" Command="{Binding Consultation.ToggleConsultationTimerCommand}"
                            Background="{DynamicResource ThemeSurfaceSubtle}" MinHeight="28" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Duración de la consulta (mostrar u ocultar)">
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Duración de la consulta · clic para ocultarla" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Consultation.IsConsultationTimerVisible}" Value="False">
                                                <Setter Property="Text" Value="Mostrar la duración de la consulta" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoClock}" Width="14" Height="14" />
                            <TextBlock Text="{Binding Active.ActiveConsultationElapsedTime}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Margin="6,0,0,0"
                                       Visibility="{Binding Consultation.IsConsultationTimerVisible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ShowChartFromConsultationCommand}" Padding="10,6" Margin="0,0,6,0" Content="Expediente" ToolTip="Ver el expediente completo: antecedentes, historial y gráfica de signos" />
                    <TextBlock Text="{Binding Autosave.AutosaveStatus}"
                               FontSize="11.5"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               ToolTip="La consulta se guarda sola mientras escribe; si se cierra el programa o se va la luz, se recupera al abrir. Ctrl + S guarda al instante." />
                    <TextBlock Text="{Binding Handoff.SendConsultationHint}" FontSize="11.5" Foreground="{DynamicResource ThemeWarningText}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Handoff.SendConsultationHint, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Handoff.OpenSendConsultationSheetCommand}" Padding="10,6" Margin="0,0,6,0"
                            IsEnabled="{Binding Handoff.CanSendConsultation}"
                            Visibility="{Binding Handoff.ShowsSendConsultationButton, Converter={StaticResource BoolToVis}}"
                            ToolTip="Mandar esta consulta a otro equipo (tablet u otra computadora) para seguirla allá"
                            AutomationProperties.Name="Enviar la consulta a otro equipo">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSend}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Enviar a…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding DiscardActiveConsultationCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Paciente equivocado o se retiró: no guarda la nota ni cobra"
                            Visibility="{Binding Handoff.IsConsultationHandedOff, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Descartar" Foreground="{DynamicResource ThemeDangerText}" />
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding Consultation.FinalizeConsultationCommand}" Padding="18,8" Content="Terminar consulta" ToolTip="Revisar la cuenta y cobrar (Ctrl + Enter)"
                            Visibility="{Binding Handoff.IsConsultationHandedOff, Converter={StaticResource InverseBoolToVis}}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Enviada a otro equipo: aquí solo se puede ver, recuperar o (sin conexión) liberar el equipo -->
        <Border Grid.Row="1" Style="{StaticResource NoticeWarning}" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding Handoff.IsConsultationHandedOff, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <helpers:Icon Data="{StaticResource IcoLock}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Handoff.HandoffBannerText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Handoff.HandoffBannerDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Handoff.HandoffBannerDetail, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource ButtonGhost}" Command="{Binding Handoff.ReleaseHandoffLocallyCommand}" Padding="10,5" MinHeight="0" Margin="0,0,8,0"
                            Foreground="{DynamicResource ThemeWarningText}" FontWeight="SemiBold"
                            Content="Liberar este equipo" ToolTip="Dejar de esperar aquí sin confirmar con la nube"
                            IsEnabled="{Binding Handoff.IsRecoveringHandoff, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding Handoff.CanReleaseHandoffLocally, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Handoff.RecoverHandedOffConsultationCommand}" Padding="14,5" MinHeight="0"
                            IsEnabled="{Binding Handoff.IsRecoveringHandoff, Converter={StaticResource InverseBool}}"
                            Content="Recuperar" ToolTip="Seguir la consulta en este equipo (si el otro aún no la acepta)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Contexto del paciente: lo necesario sin buscarlo -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PACIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock Text="Grupo sanguíneo" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,1" />
                        <TextBlock Text="{Binding Session.SelectedPatient.BloodType}" FontSize="13" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                        <TextBlock Text="Enfermedades crónicas" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,1" />
                        <TextBlock Text="{Binding Session.SelectedPatient.ChronicDiseases}" FontSize="13" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                        <TextBlock Text="Últimos signos vitales" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,1" />
                        <TextBlock Text="{Binding Session.SelectedPatient.VitalSigns}" FontSize="13" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                            Visibility="{Binding Consultation.PreviousConsultation, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMA CONSULTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Text="{Binding Consultation.PreviousConsultation.Date, StringFormat='dd/MM/yyyy'}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding Consultation.PreviousConsultation.Diagnosis}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Consultation.PreviousConsultation.TreatmentPlan}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="ATAJOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBlock Text="Ctrl + ↓  siguiente sección" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text="Ctrl + ↑  sección anterior" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text="Ctrl + Enter  terminar consulta" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text="Ctrl + S  guardar ahora" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Nota de la consulta en el orden de la entrevista -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConsultationSectionsPanel">
                <Border CornerRadius="12" BorderThickness="1" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=1}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding Consultation.SetConsultationSectionCommand}" CommandParameter="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=1}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="1" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=1}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Motivo y padecimiento actual" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource ThemeText}" />
                                    <Grid Visibility="{Binding Consultation.ConsultationSection, Converter={StaticResource InverseComparisonToVis}, ConverterParameter=1}">
                                        <TextBlock Text="{Binding Consultation.ConsultationChiefComplaint}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </Grid>
                                </StackPanel>

                            </Grid>
                        </Button>
                        <StackPanel Margin="54,0,16,14" IsEnabled="{Binding Handoff.IsConsultationEditable}" Visibility="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=1}">
                            <TextBox Text="{Binding Consultation.ConsultationChiefComplaint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="10,8" FontSize="13.5" Margin="0,0,0,8" ToolTip="Motivo de consulta y padecimiento actual" />
                            <WrapPanel>
                                <TextBlock Text="Frecuentes:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Fiebre" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Fiebre" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Tos" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Tos" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Dolor de garganta" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Dolor de garganta" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Rinorrea" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Rinorrea" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Dolor abdominal" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Dolor abdominal" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Diarrea" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Diarrea" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Vómito" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Vómito" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Cefalea" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Cefalea" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Control de niño sano" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Control de niño sano" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.AppendChiefComplaintChipCommand}" MinHeight="0" CommandParameter="Seguimiento" Padding="10,4" Margin="0,0,6,6" FontSize="11.5" Content="Seguimiento" />
                            </WrapPanel>
                            <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.NextConsultationSectionCommand}" Padding="14,6" HorizontalAlignment="Right" Margin="0,4,0,0" Content="Siguiente  →" ToolTip="Ctrl + ↓" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" BorderThickness="1" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=2}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Style="{DynamicResource SectionHeaderButton}" Command="{Binding Consultation.SetConsultationSectionCommand}" CommandParameter="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=2}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToBool}, ConverterParameter=2}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Signos vitales y somatometría" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource ThemeText}" />
                                    <Grid Visibility="{Binding Consultation.ConsultationSection, Converter={StaticResource InverseComparisonToVis}, ConverterParameter=2}">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="T/A {0} · FC {1} · FR {2} · Temp {3} · Peso {4} · Talla {5} · SpO₂ {6}">
                                                    <Binding Path="Consultation.ConsultationTA" />
                                                    <Binding Path="Consultation.ConsultationFC" />
                                                    <Binding Path="Consultation.ConsultationFR" />
                                                    <Binding Path="Consultation.ConsultationTemp" />
                                                    <Binding Path="Consultation.ConsultationWeight" />
                                                    <Binding Path="Consultation.ConsultationHeight" />
                                                    <Binding Path="Consultation.ConsultationSpO2" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource ThemeWarningSubtle}"
                                        Visibility="{Binding Consultation.HasVitalSignsWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Consultation.VitalSignsWarning}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWarningText}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </Border>
                            </Grid>
                        </Button>
                        <StackPanel Margin="54,0,16,14" IsEnabled="{Binding Handoff.IsConsultationEditable}" Visibility="{Binding Consultation.ConsultationSection, Converter={StaticResource ComparisonToVis}, ConverterParameter=2}">
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="T/A (mmHg)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationTA, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Tensión arterial, ej. 120/80" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="FC (lpm)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationFC, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Frecuencia cardiaca" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="FR (rpm)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationFR, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Frecuencia respiratoria" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="Temp (°C)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationTemp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Temperatura" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="Peso (kg)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationWeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Peso en kilogramos" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="Talla (m)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Estatura en metros, ej. 1.70" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="SpO₂ (%)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationSpO2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Saturación de oxígeno" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="Glucosa (mg/dL)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Consultation.ConsultationGlucose, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" Padding="8,6" FontSize="14" ToolTip="Glucosa capilar" />
                                </StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,0,0,4">
                                <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding Consultation.ConsultationIMC, StringFormat='IMC: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                                </Border>
                                <Border Background="{DynamicResource ThemeWarningSubtle}" CornerRadius="6" Padding="10,4" Margin="0,0,8,6" Visibility="{Binding Consultation.HasVitalSignsWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Consultation.VitalSignsWarning}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWarningText}" TextWrapping="Wrap" />
                                </Border>
                            </WrapPanel>
                            <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Consultation.NextConsultationSectionCommand}" Padding="14,6" HorizontalAlignment="Right" Margin="0,4,0,0" Content="Siguiente  →" ToolTip="Ctrl + ↓" />
                        </StackPanel>
                    </StackPanel>
                </Border>
