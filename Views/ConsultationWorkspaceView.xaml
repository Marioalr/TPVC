                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Prescription.OpenPrescriptionModalCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoPill}" Margin="0,0,8,0" />
                                        <TextBlock Text="Medicamento (receta)" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Supplies.OpenSuppliesModalCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                                        <TextBlock Text="Insumo o material" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ClinicalServices.OpenServicesModalCommand}" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoSyringe}" Margin="0,0,8,0" />
                                        <TextBlock Text="Servicio (inyección, curación…)" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Account.ConsultationAccountTotal, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource ThemeText}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Se cobra todo al terminar la consulta." FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeSelectionBackground}" CornerRadius="10" Padding="14,10">
                        <TextBlock Text="¿Aplicó algo más? Inyección, nebulización, curación, sutura o una revisión especial: agréguelo aquí en cuanto lo haga para no olvidar cobrarlo." FontSize="12" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
