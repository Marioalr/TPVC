<UserControl x:Class="TPVC.Views.ConsultationDetailSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:patients="clr-namespace:TPVC.ViewModels.Patients"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ========================================================================= -->
    <!-- HOJA: UNA CONSULTA DEL HISTORIAL (desde v1.24.0)                           -->
    <!-- El detalle por datos y la receta, que se puede corregir e imprimir          -->
    <!-- ========================================================================= -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="880" MaxHeight="740" Padding="0" DataContext="{Binding ConsultationDetail}"
                AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Subtitle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
                    <StackPanel>
                        <!-- Signos vitales -->
                        <StackPanel Visibility="{Binding HasVitals, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TextLabel}" Text="SIGNOS VITALES" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Vitals}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VitalSummary}">
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Label}" />
                                                <TextBlock Style="{StaticResource TextMono}" FontSize="16" FontWeight="Bold" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Motivo, interrogatorio, exploración, diagnóstico, plan y notas -->
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type patients:ConsultationDetailSection}">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource TextLabel}" Text="{Binding Title}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Receta -->
                        <Border Style="{StaticResource CardSubtle}" Padding="16,14" Margin="0,4,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TextSection}" Text="Receta" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsReadingPrescription, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding StartEditPrescriptionCommand}" Margin="0,0,8,0"
                                                IsEnabled="{Binding CanEditPrescription}" ToolTip="Corregir la receta de esta consulta (no cambia lo que se cobró)">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:Icon Data="{StaticResource IcoEdit}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Corregir receta" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ExportPrescriptionCommand}" Margin="0,0,8,0"
                                                IsEnabled="{Binding HasPrescription}" Content="Guardar documento" ToolTip="Guardar la receta para PDF, con la fecha de esta consulta" />
                                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding PrintPrescriptionCommand}" IsEnabled="{Binding HasPrescription}"
                                                ToolTip="Imprimir la receta con la fecha y los signos de esta consulta">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:Icon Data="{StaticResource IcoPrint}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Imprimir" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Lectura -->
                                <StackPanel Visibility="{Binding IsReadingPrescription, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Prescription}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PatientPrescriptionItem}">
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap">
                                                        <Run Text="{Binding MedicineName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding SheetDetail, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Dosage}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Esta consulta no tiene receta."
                                               Visibility="{Binding HasPrescription, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Hay una consulta en curso de este paciente: su receta se corrige dentro de la consulta."
                                               Visibility="{Binding CanEditPrescription, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>

                                <!-- Corrección -->
                                <StackPanel Visibility="{Binding IsEditingPrescription, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding EditLines}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type patients:EditablePrescriptionLine}">
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="2*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding MedicineName, UpdateSourceTrigger=PropertyChanged}"
                                                                         helpers:Field.Placeholder="Genérico, concentración y forma (marca)" AutomationProperties.Name="Medicamento" />
                                                                <TextBox Grid.Column="2" Style="{StaticResource FieldTextBox}" Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}"
                                                                         helpers:Field.Placeholder="Presentación" AutomationProperties.Name="Presentación" />
                                                            </Grid>
                                                            <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}"
                                                                     helpers:Field.Placeholder="Dosis, vía, frecuencia y duración" AutomationProperties.Name="Indicaciones" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Quitar de la receta"
                                                                AutomationProperties.Name="Quitar de la receta"
                                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                            <helpers:Icon Data="{StaticResource IcoTrash}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Agregar medicamento" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewMedicineText, UpdateSourceTrigger=PropertyChanged}"
                                                 helpers:Field.Placeholder="Buscar en el catálogo o escribirlo" AutomationProperties.Name="Agregar medicamento" />
                                        <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" Command="{Binding AddTypedMedicineCommand}" Content="Agregar como está" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding MedicineSuggestions}" Margin="0,4,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Product}">
                                                <Button Style="{DynamicResource SectionHeaderButton}" Padding="10,6"
                                                        Command="{Binding DataContext.AddSuggestedMedicineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding GenericName}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Text="Lo que se cobró en esta consulta no cambia. Si es la última consulta, esta queda como la receta vigente del expediente." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CancelEditPrescriptionCommand}" Content="Cancelar" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SavePrescriptionCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:Icon Data="{StaticResource IcoSave}" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Guardar receta" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,12">
                    <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseCommand}" Content="Cerrar" HorizontalAlignment="Right" />
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
