<UserControl x:Class="TPVC.Views.PrescriptionSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Receta de la consulta: medicamento (↑↓ y Enter eligen), indicaciones con posología       -->
    <!-- frecuente o dosis pediátrica por peso (solo en menores) y "Se surte aquí" para cargarlo -->
    <!-- a la cuenta. Empieza vacía; la receta anterior se repite con un clic.                   -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="860" MaxHeight="740" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Receta" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Medicamentos con su posología; lo que se surte aquí se carga a la cuenta de la consulta" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Prescription.OpenPrescriptionCatalogCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                            ToolTip="Ver todos los medicamentos del inventario">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSearch}" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding Prescription.ClosePrescriptionModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Captura rápida -->
                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Medicamento *" />
                            <TextBox x:Name="PrescriptionSearchTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Prescription.PrescriptionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Nombre o genérico"
                                     PreviewKeyDown="PrescriptionSearchTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="Medicamento" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Indicaciones" />
                            <TextBox x:Name="PrescriptionDosageTextBox" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Prescription.PrescriptionDosage, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. 1 tableta cada 8 horas por 5 días"
                                     PreviewKeyDown="PrescriptionAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Indicaciones" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                            <TextBox x:Name="PrescriptionQuantityTextBox" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                     Text="{Binding Prescription.PrescriptionQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="PrescriptionAuxInput_PreviewKeyDown"
                                     AutomationProperties.Name="Cantidad" />
                        </StackPanel>
                    </Grid>

                    <!-- Plantillas del consultorio: posología frecuente y dosis pediátrica por peso -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding Templates.HasPosologyTemplates, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Posología frecuente" />
                            <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Templates.PosologyTemplates}"
                                      SelectedItem="{Binding Prescription.SelectedPosologyTemplate, Mode=TwoWay}" DisplayMemberPath="Text"
                                      helpers:TypeAhead.IsEnabled="True" AutomationProperties.Name="Posología frecuente"
                                      ToolTip="Despliegue y escriba (ej. &quot;cada 8&quot;): el cursor salta a la opción; Enter la copia a las indicaciones" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding Prescription.ShowsPediatricDose, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dosis pediátrica por peso" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Templates.PediatricDoseRules}"
                                          SelectedItem="{Binding Prescription.SelectedPediatricRule, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                          helpers:TypeAhead.IsEnabled="True" AutomationProperties.Name="Medicamento pediátrico"
                                          ToolTip="Despliegue y escriba el medicamento para ir directo a él" />
                                <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Margin="6,0,0,0" HorizontalContentAlignment="Center"
                                         Text="{Binding Prescription.PediatricWeightText, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="kg" ToolTip="Peso del paciente en kg" AutomationProperties.Name="Peso en kg" />
                                <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Margin="6,0,0,0" Command="{Binding Prescription.ApplyPediatricDoseCommand}"
                                        Content="Usar" ToolTip="Copiar la dosis calculada a las indicaciones" />
                            </Grid>
                            <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource ThemeAccentForeground}" Text="{Binding Prescription.PediatricDoseResult}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding Prescription.PediatricDoseResult, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,10,0,0"
                            Visibility="{Binding Prescription.IsPrescriptionDropdownOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextCaption}" Text="↑ ↓ para elegir · Enter o clic agrega a la receta · Esc cierra" Margin="10,4,10,4" />
                            <ListBox x:Name="PrescriptionSuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="200"
                                     ItemsSource="{Binding Prescription.PrescriptionProductSuggestions}"
                                     SelectedItem="{Binding Prescription.SelectedPrescriptionProduct, Mode=TwoWay}"
                                     PreviewKeyDown="PrescriptionSuggestionsListBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonUp="PrescriptionSuggestionsListBox_PreviewMouseLeftButtonUp"
                                     AutomationProperties.Name="Sugerencias de medicamentos">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Product}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="GenericName" />
                                                            <Binding Path="Presentation" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StockBadge}" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockBadgeText}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- La receta de esta consulta -->
                <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Margin="24,0,24,0" Padding="8">
                    <DockPanel>
                        <!-- La receta empieza vacía; la anterior se repite con un clic -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Notice}" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding Prescription.CanRepeatPreviousPrescription, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Receta anterior" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Prescription.PreviousPrescriptionSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Prescription.RepeatPreviousPrescriptionCommand}"
                                        Padding="12,5" MinHeight="0" Margin="12,0,0,0" Content="Repetir"
                                        ToolTip="Copia a esta receta los medicamentos que falten (revisa alergias y existencias)" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActivePrescription}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PatientPrescriptionItem}">
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding MedicineName}" />
                                                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Dosage}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RecommendedQuantity, StringFormat='× {0}'}" />
                                                    </Border>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                              IsChecked="{Binding DispenseInClinic, Mode=TwoWay}"
                                                              Command="{Binding DataContext.Prescription.ToggleDispenseInClinicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              Visibility="{Binding DataContext.Active.HasActiveConsultation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="Se entrega en el consultorio y se carga a la cuenta de la consulta"
                                                              Content="Se surte aquí" />
                                                    <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar de la receta" AutomationProperties.Name="Quitar medicamento"
                                                            Command="{Binding DataContext.Prescription.RemovePrescriptionItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                        Visibility="{Binding Session.SelectedPatient.ActivePrescription.Count, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Style="{StaticResource TextBody}" Text="Sin medicamentos en esta receta." HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="Escriba el medicamento arriba o ábralo desde el catálogo." HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding Preview.OpenPrescriptionPdfPreviewCommand}"
                                ToolTip="Vista previa de la receta para imprimir o guardar en PDF">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                                <TextBlock Text="Vista previa" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonGhost}" Command="{Binding Prescription.ClosePrescriptionModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding Prescription.SavePrescriptionModalCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                    <TextBlock Text="Guardar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
