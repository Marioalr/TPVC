<UserControl x:Class="TPVC.Views.PrescriptionSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:patients="clr-namespace:TPVC.ViewModels.Patients"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- Receta de la consulta: se elige el medicamento (↑↓ y Enter, clic o el catálogo), se escribe -->
    <!-- su indicación (con las frecuentes dentro del campo, o la dosis pediátrica por peso en       -->
    <!-- menores) y se agrega con Enter o "Agregar". "Se surte aquí" lo carga a la cuenta. Empieza   -->
    <!-- vacía; la receta anterior se repite con un clic y cada renglón cambia su indicación.        -->
    <UserControl.Resources>
        <!-- Indicaciones frecuentes del campo "Indicación" (y de "Cambiar indicación"): la misma tarjeta que las -->
        <!-- sugerencias de medicamentos. Sus elementos no toman el foco: el cursor se queda en el campo.         -->
        <DataTemplate x:Key="FrequentIndicationsDropdown" DataType="{x:Type patients:FrequentIndicationsPicker}">
            <Border Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0"
                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" Text="Indicaciones frecuentes · ↑ ↓ para moverse · Enter o clic la escribe · Esc cierra" Margin="10,4,10,4" />
                    <ListBox Style="{StaticResource PlainList}" MaxHeight="220" Focusable="False"
                             ItemsSource="{Binding Suggestions}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             helpers:IndicationDropdown.IsDropdownList="True"
                             AutomationProperties.Name="Indicaciones frecuentes">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRowItem}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="12,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PrescriptionTemplate}">
                                <TextBlock Style="{StaticResource TextBody}" Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="860" MaxHeight="740" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Receta" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Medicamentos con su posología; lo que se surte aquí se carga a la cuenta de la consulta" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Prescription.OpenPrescriptionCatalogCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                            ToolTip="Ver todos los medicamentos del inventario">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoSearch}" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding Prescription.ClosePrescriptionModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Captura: 1) elegir el medicamento, 2) escribir su indicación, 3) Enter o "Agregar" -->
                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Medicamento *" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Indicación" />
                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="Cantidad" />

                        <!-- Elegido, el buscador lo muestra; la X deshace la elección (o borra lo escrito) -->
                        <Grid Grid.Row="1">
                            <TextBox x:Name="PrescriptionSearchTextBox" Style="{StaticResource FieldTextBox}" Padding="10,7,36,7"
                                     Text="{Binding Prescription.PrescriptionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Genérico, concentración y forma"
                                     ToolTip="Primero el genérico (principio activo) con su concentración y forma; la marca, si la quiere, entre paréntesis. Al elegirlo del catálogo se escribe así solo. Enter lo elige y pasa a la indicación."
                                     PreviewKeyDown="PrescriptionSearchTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="Medicamento" />
                            <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Focusable="False" Foreground="{DynamicResource ThemeTextSecondary}"
                                    Command="{Binding Prescription.ClearChosenMedicineCommand}"
                                    Visibility="{Binding Prescription.PrescriptionSearchText, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Quitar el medicamento y escribir otro" AutomationProperties.Name="Quitar el medicamento">
                                <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <!-- Indicación con las frecuentes dentro del campo: la flecha o ↓ las abren -->
                        <Grid Grid.Row="1" Grid.Column="2">
                            <TextBox x:Name="PrescriptionDosageTextBox" Style="{StaticResource FieldTextBox}" Padding="10,7,36,7"
                                     Text="{Binding Prescription.PrescriptionDosage, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. 1 tableta vía oral cada 8 horas por 5 días"
                                     helpers:IndicationDropdown.Picker="{Binding Prescription.CaptureIndications}"
                                     helpers:IndicationDropdown.EnterCommand="{Binding Prescription.AddPrescriptionCommand}"
                                     ToolTip="Dosis, vía de administración, frecuencia y duración del tratamiento (art. 30 del Reglamento de Insumos para la Salud). ↓ abre las indicaciones frecuentes; Enter agrega el medicamento."
                                     AutomationProperties.Name="Indicación" />
                            <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Focusable="False" Foreground="{DynamicResource ThemeTextSecondary}"
                                    Command="{Binding Prescription.CaptureIndications.ToggleCommand}"
                                    Visibility="{Binding Templates.HasPosologyTemplates, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Indicaciones frecuentes (↓)" AutomationProperties.Name="Indicaciones frecuentes">
                                <helpers:Icon Data="{StaticResource IcoChevronDown}" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <TextBox x:Name="PrescriptionQuantityTextBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                 Text="{Binding Prescription.PrescriptionQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Piezas que se surten aquí (y se cargan a la cuenta). Enter agrega el medicamento."
                                 AutomationProperties.Name="Cantidad">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Prescription.AddPrescriptionCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Row="1" Grid.Column="6" Style="{StaticResource ButtonPrimary}" Command="{Binding Prescription.AddPrescriptionCommand}"
                                ToolTip="Agregar el medicamento con su indicación (Enter en Indicación o Cantidad)" AutomationProperties.Name="Agregar a la receta">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,6,0" />
                                <TextBlock Text="Agregar" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2" Style="{StaticResource TextCaption}" Margin="2,4,0,0" Text="{Binding Prescription.ChosenMedicineCaption}"
                                   Visibility="{Binding Prescription.IsMedicineChosen, Converter={StaticResource BoolToVis}}" />

                        <!-- «Mostrar (Paracetamol)»: el principio activo entre paréntesis después de la marca (2026-10-21); -->
                        <!-- solo con un medicamento de marca elegido. Empieza con la última elección de este equipo.        -->
                        <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Style="{StaticResource FieldCheckBox}" Margin="2,6,0,0" HorizontalAlignment="Left"
                                  IsChecked="{Binding Prescription.ShowChosenActiveIngredient, Mode=TwoWay}"
                                  Content="{Binding Prescription.ChosenActiveIngredientToggleText}"
                                  Visibility="{Binding Prescription.HasChosenActiveIngredient, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Escribir el principio activo entre paréntesis después de la marca. El siguiente medicamento empieza con lo que elija aquí."
                                  AutomationProperties.Name="Mostrar el principio activo" />

                        <!-- Sugerencias de medicamentos: con existencias primero -->
                        <Border Grid.Row="3" Grid.ColumnSpan="7" Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0"
                                Visibility="{Binding Prescription.IsPrescriptionDropdownOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Con existencias primero · ↑ ↓ para moverse · Enter o clic lo elige y pasa a la indicación · Esc cierra la lista" Margin="10,4,10,4" />
                                <ListBox x:Name="PrescriptionSuggestionsListBox" Style="{StaticResource PlainList}" MaxHeight="200"
                                         ItemsSource="{Binding Prescription.PrescriptionProductSuggestions}"
                                         SelectedItem="{Binding Prescription.SelectedPrescriptionProduct, Mode=TwoWay}"
                                         PreviewKeyDown="PrescriptionSuggestionsListBox_PreviewKeyDown"
                                         PreviewMouseLeftButtonUp="PrescriptionSuggestionsListBox_PreviewMouseLeftButtonUp"
                                         AutomationProperties.Name="Sugerencias de medicamentos">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Product}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource TextCaption}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                                <Binding Path="GenericName" />
                                                                <Binding Path="Presentation" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource StockBadge}" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockBadgeText}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <ContentControl Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5" Focusable="False"
                                        Content="{Binding Prescription.CaptureIndications}" ContentTemplate="{StaticResource FrequentIndicationsDropdown}" />
                    </Grid>

                    <!-- Dosis pediátrica por peso (plantillas del consultorio, solo en menores): "Usar" la escribe en la indicación -->
                    <StackPanel Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" Visibility="{Binding Prescription.ShowsPediatricDose, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Dosis pediátrica por peso" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Templates.PediatricDoseRules}"
                                      SelectedItem="{Binding Prescription.SelectedPediatricRule, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                      helpers:TypeAhead.IsEnabled="True" AutomationProperties.Name="Medicamento pediátrico"
                                      ToolTip="Despliegue y escriba el medicamento para ir directo a él" />
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Margin="6,0,0,0" HorizontalContentAlignment="Center"
                                     Text="{Binding Prescription.PediatricWeightText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="kg" ToolTip="Peso del paciente en kg" AutomationProperties.Name="Peso en kg" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Margin="6,0,0,0" Command="{Binding Prescription.ApplyPediatricDoseCommand}"
                                    Content="Usar" ToolTip="Copiar la dosis calculada a la indicación" />
                        </Grid>
                        <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource ThemeAccentForeground}" Text="{Binding Prescription.PediatricDoseResult}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding Prescription.PediatricDoseResult, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- La receta de esta consulta -->
                <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Margin="24,0,24,0" Padding="8">
                    <DockPanel>
                        <!-- La receta empieza vacía; la anterior se repite con un clic -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Notice}" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding Prescription.CanRepeatPreviousPrescription, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Receta anterior" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Prescription.PreviousPrescriptionSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Command="{Binding Prescription.RepeatPreviousPrescriptionCommand}"
                                        Padding="12,5" MinHeight="0" Margin="12,0,0,0" Content="Repetir"
                                        ToolTip="Copia a esta receta los medicamentos que falten (revisa alergias y existencias)" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActivePrescription}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PatientPrescriptionItem}">
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding MedicineName}" />
                                                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Dosage}" TextWrapping="Wrap">
                                                            <TextBlock.Visibility>
                                                                <MultiBinding Converter="{StaticResource InverseSameItemToVis}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Prescription.SheetIndication.Item" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <!-- «Mostrar (Paracetamol)» del renglón: quita o pone el paréntesis y guarda -->
                                                        <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                  IsChecked="{Binding ShowsActiveIngredient, Mode=TwoWay}"
                                                                  Command="{Binding DataContext.Prescription.ToggleActiveIngredientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  Content="{Binding ActiveIngredientToggleText}"
                                                                  Visibility="{Binding HasActiveIngredient, Converter={StaticResource BoolToVis}}"
                                                                  ToolTip="Escribir el principio activo entre paréntesis después de la marca"
                                                                  AutomationProperties.Name="Mostrar el principio activo" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RecommendedQuantity, StringFormat='× {0}'}" />
                                                    </Border>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource FieldCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                              IsChecked="{Binding DispenseInClinic, Mode=TwoWay}"
                                                              Command="{Binding DataContext.Prescription.ToggleDispenseInClinicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              Visibility="{Binding DataContext.Active.HasActiveConsultation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="Se entrega en el consultorio y se carga a la cuenta de la consulta"
                                                              Content="Se surte aquí" />
                                                    <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Cambiar indicación" AutomationProperties.Name="Cambiar indicación"
                                                            Command="{Binding DataContext.Prescription.SheetIndication.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoEdit}" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar de la receta" AutomationProperties.Name="Quitar medicamento"
                                                            Command="{Binding DataContext.Prescription.RemovePrescriptionItemFromPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                    </Button>

                                                    <!-- Cambiar indicación: el renglón se vuelve un campo con las frecuentes; Enter o Guardar, Esc o Cancelar -->
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource SameItemToVis}">
                                                                <Binding />
                                                                <Binding Path="DataContext.Prescription.SheetIndication.Item" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid>
                                                                <TextBox Style="{StaticResource FieldTextBox}" Padding="10,7,36,7"
                                                                         Text="{Binding DataContext.Prescription.SheetIndication.Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                         helpers:Field.Placeholder="Nueva indicación"
                                                                         helpers:IndicationDropdown.Picker="{Binding DataContext.Prescription.SheetIndication.Picker, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         helpers:IndicationDropdown.EnterCommand="{Binding DataContext.Prescription.SheetIndication.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         helpers:IndicationDropdown.FocusWhenShown="True"
                                                                         ToolTip="↓ abre las indicaciones frecuentes; Enter guarda; Esc deja la que tenía"
                                                                         AutomationProperties.Name="Nueva indicación" />
                                                                <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Focusable="False" Foreground="{DynamicResource ThemeTextSecondary}"
                                                                        Command="{Binding DataContext.Prescription.SheetIndication.Picker.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Visibility="{Binding DataContext.Templates.HasPosologyTemplates, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Indicaciones frecuentes (↓)" AutomationProperties.Name="Indicaciones frecuentes">
                                                                    <helpers:Icon Data="{StaticResource IcoChevronDown}" Width="14" Height="14" />
                                                                </Button>
                                                            </Grid>
                                                            <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Margin="8,0,0,0" Padding="12,6"
                                                                    Command="{Binding DataContext.Prescription.SheetIndication.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    ToolTip="Guardar la indicación (Enter)" AutomationProperties.Name="Guardar indicación">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <helpers:Icon Data="{StaticResource IcoCheck}" Width="14" Height="14" Margin="0,0,6,0" />
                                                                    <TextBlock Text="Guardar" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource ButtonGhost}" Margin="4,0,0,0" Content="Cancelar"
                                                                    Command="{Binding DataContext.Prescription.SheetIndication.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    ToolTip="Dejar la indicación que tenía (Esc)" />
                                                        </Grid>
                                                        <ContentControl Focusable="False"
                                                                        Content="{Binding DataContext.Prescription.SheetIndication.Picker, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        ContentTemplate="{StaticResource FrequentIndicationsDropdown}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                                        Visibility="{Binding Session.SelectedPatient.ActivePrescription.Count, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Style="{StaticResource TextBody}" Text="Sin medicamentos en esta receta." HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource TextCaption}" Text="Elija el medicamento arriba (o en el catálogo), escriba su indicación y pulse Agregar." HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Command="{Binding Preview.OpenPrescriptionPdfPreviewCommand}"
                                ToolTip="Vista previa de la receta para imprimir o guardar en PDF">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                                <TextBlock Text="Vista previa" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonGhost}" Command="{Binding Prescription.ClosePrescriptionModalCommand}" Content="Cerrar" Margin="0,0,8,0" />
                            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding Prescription.SavePrescriptionModalCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                    <TextBlock Text="Guardar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
