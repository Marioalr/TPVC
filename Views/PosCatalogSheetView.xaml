<UserControl x:Class="TPVC.Views.PosCatalogSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!-- Catálogo completo: busca al escribir, categorías como chips y lista que solo crea las -->
    <!-- filas visibles. Enter agrega el primero; doble clic agrega el de la fila.            -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="940" Height="680" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextHeading}" Text="Catálogo" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding CatalogSummary}" VerticalAlignment="Bottom" Margin="12,0,0,4" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseCatalogModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="24,12,24,8">
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="CatalogSearchBox" Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                                 Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="Buscar en el catálogo: nombre, genérico, código o ubicación"
                                 AutomationProperties.Name="Buscar en el catálogo">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddFirstCatalogProductCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                      Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding CatalogSelectedCategory, Mode=TwoWay}"
                             DisplayMemberPath="Name" AutomationProperties.Name="Categorías" />
                </StackPanel>

                <ListBox x:Name="ProductsList" Grid.Row="2" Style="{StaticResource PlainList}" Padding="16,0"
                         ItemsSource="{Binding CatalogFilteredProducts}"
                         MouseDoubleClick="ProductsList_MouseDoubleClick"
                         AutomationProperties.Name="Productos">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Product}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource BadgeInfo}" Margin="8,0,0,0" Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Refrigerar" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} · {3}">
                                                <Binding Path="Code" />
                                                <Binding Path="GenericName" />
                                                <Binding Path="Presentation" />
                                                <Binding Path="Location" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StockBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StockBadgeText}" />
                                </Border>
                                <TextBlock Grid.Column="2" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                <!-- Revisión 20: se agrega aunque no tenga existencias (se avisa sin bloquear) -->
                                <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Margin="16,0,0,0"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoPlus}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Agregar" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="No hay productos con ese texto en esta categoría."
                           Visibility="{Binding CatalogFilteredProducts.Count, Converter={StaticResource InverseBoolToVis}}" />

                <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                   Text="Enter agrega el primero con existencias · doble clic agrega el de la fila · F2 o Esc cierra" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextBody}" VerticalAlignment="Center">
                            <Run Text="En la cuenta:" />
                            <Run Text="{Binding TotalCartAmount, StringFormat={}{0:C2}, ConverterCulture=es-MX, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
