<UserControl x:Class="TPVC.Views.MovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MovementsViewModel}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Kardex e Historial de Movimientos" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeText}" />
                <TextBlock Text="Trazabilidad completa de consumos en consulta, entradas y ajustes" 
                           FontSize="13" 
                           Foreground="{DynamicResource ThemeTextSecondary}" 
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Barra de Búsqueda y Filtro -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,0,0,16" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Style="{DynamicResource ModernTextBox}" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Buscar por insumo, motivo o responsable..." />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalMovementsCount, StringFormat='{}{0} registros'}" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,14,0" 
                               VerticalAlignment="Center" />
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding LoadMovementsCommand}" 
                            Padding="10,6">
                        <Path Data="{StaticResource IconRefresh}" 
                              Fill="{DynamicResource ThemeTextSecondary}" 
                              Width="12" Height="12" 
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid de Kardex -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Movements}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" Width="150" />
                    <DataGridTextColumn Header="Insumo / Medicamento" Binding="{Binding Product.Name}" Width="*" />
                    <DataGridTextColumn Header="Tipo de Movimiento" Binding="{Binding MovementTypeDisplay}" Width="170" />
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90" />
                    <DataGridTextColumn Header="Antes" Binding="{Binding StockBefore}" Width="70" />
                    <DataGridTextColumn Header="Después" Binding="{Binding StockAfter}" Width="70" />
                    <DataGridTextColumn Header="Motivo / Consulta" Binding="{Binding Reason}" Width="200" />
                    <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
