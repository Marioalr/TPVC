<UserControl x:Class="TPVC.Views.MovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MovementsViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Kardex: cada entrada, venta, consumo, baja y ajuste, con las existencias antes y después. -->
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TextTitle}" Text="Kardex" />
            <TextBlock Style="{StaticResource TextDetail}" Margin="0,4,0,0">
                <Run Text="Entradas, ventas, consumos, bajas y ajustes ·" />
                <Run Text="{Binding ResultsSummary, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,0,10">
                <TextBox Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         helpers:Field.Placeholder="Buscar por producto, código, motivo, folio o responsable"
                         AutomationProperties.Name="Buscar en el kardex" />
                <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                              Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
            </Grid>
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                     AutomationProperties.Name="Tipo de movimiento" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,8">
                    <Grid TextElement.Foreground="{DynamicResource ThemeTextSecondary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextLabel}" Text="Fecha" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextLabel}" Text="Producto y motivo" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextLabel}" Text="Cantidad" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextLabel}" Text="Existencias" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TextLabel}" Text="Responsable" Margin="16,0,0,0" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" Padding="8,4" ItemsSource="{Binding Movements}" AutomationProperties.Name="Movimientos">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:InventoryMovement}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Date, StringFormat='{}{0:HH:mm}'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding MovementTypeDisplay}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextMono}">
                                            <Setter Property="Text" Value="{Binding Quantity, StringFormat='−{0}'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEntry}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Quantity, StringFormat='+{0}'}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSuccessText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Style="{StaticResource TextMono}" VerticalAlignment="Center" TextAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} → {1}">
                                            <Binding Path="StockBefore" />
                                            <Binding Path="StockAfter" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Style="{StaticResource TextDetail}" Text="{Binding Responsible}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No hay movimientos con este filtro."
                           Visibility="{Binding Movements.Count, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
