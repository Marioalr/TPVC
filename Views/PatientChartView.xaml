<UserControl x:Class="TPVC.Views.PatientChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:patients="clr-namespace:TPVC.ViewModels.Patients"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}"
             d:DesignHeight="800" d:DesignWidth="1300">

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= ENCABEZADO ======================= -->
        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Avatar}" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Top" TextElement.FontSize="20">
                    <TextBlock Text="{Binding Session.SelectedPatient.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Session.SelectedPatient.FullName}" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Chart.SelectedPatientMeta}" Margin="0,2,0,8" />
                    <WrapPanel>
                        <Border Style="{StaticResource AllergyBadge}" DataContext="{Binding Session.SelectedPatient}" Margin="0,0,8,4">
                            <TextBlock Style="{StaticResource AllergyBadgeText}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource BadgeWarning}" Margin="0,0,8,4"
                                Visibility="{Binding Session.SelectedPatient.HasChronicDiseases, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Session.SelectedPatient.ChronicBadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,8,4" Visibility="{Binding Chart.HasNextAppointment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Chart.NextAppointmentText}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding Agenda.ScheduleForSelectedPatientCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoCalendar}" Margin="0,0,8,0" />
                            <TextBlock Text="Agendar cita" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ChartPrimaryActionCommand}" Padding="18,7" Margin="0,0,8,0" Content="{Binding Chart.ChartPrimaryActionText}" />
                    <Button Style="{StaticResource ButtonDangerGhost}" Command="{Binding Chart.DeletePatientCommand}" Margin="0,0,8,0"
                            ToolTip="Eliminar este expediente clínico" AutomationProperties.Name="Eliminar expediente">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoTrash}" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Eliminar" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonIconSecondary}" helpers:MenuOnClick.IsEnabled="True"
                            Tag="{Binding}" ToolTip="Más acciones" AutomationProperties.Name="Más acciones">
                        <helpers:Icon Data="{StaticResource IcoMore}" StrokeThickness="3" />
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DsContextMenu}">
                                <MenuItem Header="Editar expediente" Command="{Binding PatientForm.EditPatientCommand}" />
                                <MenuItem Header="Ver receta" Command="{Binding Preview.OpenPrescriptionPdfPreviewCommand}" />
                                <MenuItem Header="Eliminar expediente" Command="{Binding Chart.DeletePatientCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CUERPO ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lo esencial y antecedentes -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextLabel}" Text="LO ESENCIAL" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Chart.LatestVitals}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VitalSummary}">
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Label}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource TextMono}" FontSize="18" FontWeight="Bold" Text="{Binding Value}" />
                                                    <TextBlock x:Name="Trend" Style="{StaticResource TextCaption}" Text="{Binding Trend}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                <Setter TargetName="Trend" Property="Foreground" Value="{DynamicResource ThemeWarningText}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextCaption}" Text="Sin signos vitales registrados en consultas."
                                       Visibility="{Binding Chart.HasLatestVitals, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,8" />

                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Última receta" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Chart.ChartPrescription}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PatientPrescriptionItem}">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Style="{StaticResource TextBody}" Text="{Binding MedicineName}" />
                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Dosage}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextCaption}" Text="Sin receta registrada. La receta se hace dentro de la consulta."
                                       Visibility="{Binding Chart.HasActivePrescription, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Resultados de laboratorio (paso 8.12b): el PDF o las fotos de cada resultado -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" AutomationProperties.Name="Resultados de laboratorio"
                            Visibility="{Binding LabResults.IsAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextLabel}" Text="RESULTADOS DE LABORATORIO" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Padding="10,4" MinHeight="0"
                                        Command="{Binding LabResults.StartAddCommand}" AutomationProperties.Name="Agregar resultado"
                                        Visibility="{Binding LabResults.CanAdd, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoPlus}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Agregar" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Agregar: los archivos ya elegidos, de qué estudio es, el laboratorio y la fecha -->
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                    Visibility="{Binding LabResults.IsAddFormOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <helpers:Icon Data="{StaticResource IcoFile}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding LabResults.NewFilesText}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource FieldTextBox}" Margin="0,0,0,6" AutomationProperties.Name="Estudio"
                                             Text="{Binding LabResults.NewTitle, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Estudio (ej. Biometría hemática)" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Margin="0,0,0,6" AutomationProperties.Name="Laboratorio"
                                             Text="{Binding LabResults.NewLaboratory, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Laboratorio (opcional)" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Margin="0,0,0,6" AutomationProperties.Name="Fecha del resultado"
                                             Text="{Binding LabResults.NewDateText, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Fecha dd/mm/aaaa" helpers:DateMask.IsEnabled="True" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Margin="0,0,0,8" AutomationProperties.Name="Notas del resultado"
                                             Text="{Binding LabResults.NewNotes, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Notas (opcional)"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top" />
                                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource ThemeDangerText}" Text="{Binding LabResults.FormError}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding LabResults.HasFormError, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ButtonGhost}" Content="Cancelar" Command="{Binding LabResults.CancelAddCommand}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource ButtonPrimary}" Content="Guardar" Command="{Binding LabResults.SaveNewCommand}" AutomationProperties.Name="Guardar resultado" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding LabResults.Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type patients:LabResultItem}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding DayText}" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding YearText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText}"
                                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding StatusText}" Foreground="{DynamicResource ThemeTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ButtonSecondary}" Content="Abrir" Padding="10,4" MinHeight="0" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.LabResults.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Abrir el resultado: {0}'}" />
                                                <Button Style="{StaticResource ButtonIconSecondary}" ToolTip="Quitar del expediente"
                                                        Command="{Binding DataContext.LabResults.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Quitar el resultado: {0}'}">
                                                    <helpers:Icon Data="{StaticResource IcoTrash}" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       Text="Sin resultados. Agregue el PDF del laboratorio o fotos de las hojas."
                                       Visibility="{Binding LabResults.HasItems, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextLabel}" Text="ANTECEDENTES (NOM-004)" Margin="16,14,16,6" />
                            <ItemsControl ItemsSource="{Binding Chart.AntecedentSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AntecedentSection}">
                                        <StackPanel>
                                            <Border Style="{StaticResource Divider}" />
                                            <Button Style="{DynamicResource SectionHeaderButton}"
                                                    Command="{Binding DataContext.Chart.ToggleAntecedentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <helpers:Icon x:Name="Chevron" Grid.Column="1" Data="{StaticResource IcoChevronDown}" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Button>
                                            <StackPanel x:Name="Details" Margin="14,0,14,14" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource TextDetail}" Foreground="{DynamicResource ThemeText}" Text="{Binding Detail}" LineHeight="20" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="Sin datos capturados." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5" MinHeight="0"
                                                        Command="{Binding DataContext.EditAntecedentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <helpers:Icon Data="{StaticResource IcoEdit}" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="Editar esta sección" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource IcoChevronUp}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Historial único -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,14,18,8" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextSection}" Text="Historial" Margin="0,4,16,6" VerticalAlignment="Top" />
                            <ListBox Grid.Column="1" Style="{StaticResource ChipList}" ItemsSource="{Binding Chart.TimelineFilters}" SelectedItem="{Binding Chart.TimelineFilter}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBox Style="{StaticResource FieldTextBox}" Width="220" Margin="0,0,8,6"
                                         Text="{Binding Chart.TimelineSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Buscar en el historial" />
                                <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding Chart.IsVitalsChartVisible}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:Icon Data="{StaticResource IcoChart}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Gráfica de signos" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="18,12" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" MaxHeight="420"
                            Visibility="{Binding Chart.IsVitalsChartVisible, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <!-- La gráfica se crea solo mientras se muestra: oculta no gasta nada al abrir
                                 un expediente con años de consultas -->
                            <ContentControl Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Content" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chart.IsVitalsChartVisible}" Value="True">
                                                <Setter Property="Content" Value="{Binding VitalsChart}" />
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <views:VitalSignsChartView />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </ScrollViewer>
                    </Border>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Chart.Timeline}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="18,4,18,12">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- Una tarjeta por consulta (desde v1.24.0): su fecha y el resumen de sus datos; un clic abre la hoja
                                 con el detalle por datos. Las citas, como renglón propio -->
                            <DataTemplate DataType="{x:Type models:TimelineEntry}">
                                <Grid Margin="0,6">
                                    <Button x:Name="Card" Style="{DynamicResource SectionHeaderButton}" Padding="0"
                                            Command="{Binding DataContext.ConsultationDetail.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Consultation}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Abrir la consulta: {0}'}">
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding DayText}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding YearText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource BadgeInfo}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding KindText}" />
                                                        </Border>
                                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="560" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:TimelineLine}">
                                                                <TextBlock Style="{StaticResource TextDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1">
                                                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Style="{StaticResource TextMono}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding Side}" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="Ver detalle" Foreground="{DynamicResource ThemeAccentForeground}" VerticalAlignment="Center" />
                                                        <helpers:Icon Data="{StaticResource IcoChevronRight}" Width="14" Height="14" Margin="4,0,0,0" Foreground="{DynamicResource ThemeAccentForeground}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <!-- Una cita: un renglón sin hoja de detalle -->
                                    <Border x:Name="AppointmentRow" Visibility="Collapsed" Padding="14,10" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding DayText}" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding YearText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding KindText}" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Detail}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConsultation}" Value="False">
                                        <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AppointmentRow" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="18,24" Visibility="{Binding Chart.HasTimeline, Converter={StaticResource InverseBoolToVis}}">
                        <helpers:Icon Data="{StaticResource IcoHistory}" Width="28" Height="28" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource TextBody}" Text="Sin registros en el historial con este filtro." Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
