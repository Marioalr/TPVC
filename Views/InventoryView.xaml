<UserControl x:Class="TPVC.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Productos: busca al escribir, filtros como chips y lista que solo crea las filas visibles. -->
    <!-- Alta, edición, entradas y consumos en un panel lateral (sin ventanas aparte).            -->
    <Grid>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Productos" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="{Binding ResultsSummary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding NewProductCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                        <TextBlock Text="Nuevo producto" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Grid Margin="0,0,0,10">
                    <TextBox Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar por nombre, genérico, código o ubicación"
                             AutomationProperties.Name="Buscar producto" />
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,6,6" IsChecked="{Binding FilterLowStock}" Content="Stock bajo" />
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,12,6" IsChecked="{Binding FilterExpiring}" Content="Por caducar" />
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             DisplayMemberPath="Name" AutomationProperties.Name="Categorías" />
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox x:Name="ProductsList" Style="{StaticResource PlainList}" Padding="8,6"
                             ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             MouseDoubleClick="ProductsList_MouseDoubleClick"
                             AutomationProperties.Name="Productos">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Product}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource BadgeInfo}" Margin="8,0,0,0" Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Refrigerar" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                    <Binding Path="Code" />
                                                    <Binding Path="GenericName" />
                                                    <Binding Path="Presentation" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Category.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StockBadge}" VerticalAlignment="Center">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="CurrentStock" />
                                                    <Binding Path="Unit" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="3" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Content="Entrada" ToolTip="Registrar una entrada (compra o reposición)"
                                                Command="{Binding DataContext.OpenQuickEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" Width="32" Height="32" Margin="4,0,0,0"
                                                helpers:MenuOnClick.IsEnabled="True"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Más acciones" AutomationProperties.Name="Más acciones">
                                            <helpers:Icon Data="{StaticResource IcoMore}" StrokeThickness="3" />
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource DsContextMenu}">
                                                    <MenuItem Header="Editar" Command="{Binding PlacementTarget.Tag.EditProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Registrar consumo (sin cobro)" Command="{Binding PlacementTarget.Tag.OpenQuickConsumptionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Dar de baja del catálogo" Command="{Binding PlacementTarget.Tag.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Products.Count, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" Text="Ningún producto con estos filtros." HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Quite un filtro o cambie la búsqueda." HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= PANEL: ALTA / EDICIÓN ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="460" Panel.ZIndex="50"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid DataContext="{Binding Editor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextHeading}">
                                <Setter Property="Text" Value="Editar producto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter Property="Text" Value="Nuevo producto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CancelCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,16">
                        <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource NoticeSuccess}" Margin="0,0,0,12" Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Código *" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre comercial *" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Genérico (principio activo)" />
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Presentación" />
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="Ej. Caja con 20 tabletas de 500 mg" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Categoría *" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Unidad" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding CommonUnits}" SelectedItem="{Binding Unit}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Precio de venta ($)" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ubicación" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Ej. Estante A1" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Existencias" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Mínimo" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ideal" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding OptimalStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Cambiar las existencias aquí queda en el kardex como ajuste. Para compras use Entrada." />
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding RequiresRefrigeration}" Content="Requiere refrigeración" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notas" />
                        <TextBox Style="{StaticResource FieldMultiline}" MinHeight="60" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CancelCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= PANEL: ENTRADA O CONSUMO ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="420" Panel.ZIndex="50"
                Visibility="{Binding IsQuickActionOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextHeading}">
                                    <Setter Property="Text" Value="Entrada" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuickConsumptionMode}" Value="True">
                                            <Setter Property="Text" Value="Consumo sin cobro" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding SelectedProduct.Name}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseQuickActionCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Margin="24,0,24,16">
                    <Border Style="{StaticResource CardSubtle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding SelectedProduct.CurrentStock, StringFormat='Existencias actuales: {0}'}" />
                    </Border>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                    <TextBox Style="{StaticResource FieldTextBox}" FontSize="18" Height="44" HorizontalContentAlignment="Center"
                             Text="{Binding QuickActionQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="Cantidad" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Motivo" />
                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding QuickActionNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Queda registrado en el kardex. Lo que se usa con un paciente se carga mejor a la cuenta de su consulta."
                               Visibility="{Binding IsQuickConsumptionMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseQuickActionCommand}" Content="Cancelar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ConfirmQuickActionCommand}" Content="Registrar" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
