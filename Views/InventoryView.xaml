<UserControl x:Class="TPVC.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:InventoryViewModel}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado y Botón de Creación -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Catálogo de Insumos y Medicamentos" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeText}" />
                <TextBlock Text="Control interno de inventario, stock y consumo médico" 
                           FontSize="13" 
                           Foreground="{DynamicResource ThemeTextSecondary}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource AccentButton}" 
                        Click="NewProduct_Click"
                        Padding="16,9">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" 
                              Fill="{DynamicResource ThemeAccentText}" 
                              Width="14" Height="14" 
                              Stretch="Uniform" 
                              Margin="0,0,8,0" />
                        <TextBlock Text="Nuevo Insumo / Fármaco" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de Filtros y Búsqueda -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,0,0,16" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de búsqueda con botón de limpiar -->
                <Grid Grid.Column="0">
                    <TextBox Style="{DynamicResource ModernTextBox}" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Buscar por nombre, código o genérico..." 
                             Padding="10,6,28,6" />
                    <Button Command="{Binding ClearSearchCommand}" 
                            Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}}" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Margin="0,0,8,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Padding="4"
                            ToolTip="Limpiar búsqueda">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Button>
                </Grid>

                <!-- Combo de Categorías -->
                <ComboBox Grid.Column="2" 
                          Style="{DynamicResource ModernComboBox}"
                          ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}" 
                          DisplayMemberPath="Name" />

                <!-- Filtros rápidos -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding FilterLowStock}" 
                              Content="Solo Stock Bajo ⚠️" 
                              Margin="0,0,18,0"
                              FontSize="12" 
                              FontWeight="Medium"
                              Foreground="{DynamicResource ThemeText}" />
                    <CheckBox IsChecked="{Binding FilterExpiring}" 
                              Content="Próximos a Caducar ⏳" 
                              FontSize="12" 
                              FontWeight="Medium"
                              Foreground="{DynamicResource ThemeText}" />
                </StackPanel>

                <!-- Contador de resultados -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalResultsCount, StringFormat='{}{0} artículos'}" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla DataGrid de Productos -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}" 
                      SelectedItem="{Binding SelectedProduct}">
                <DataGrid.Columns>
                    <!-- Código -->
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100" />
                    
                    <!-- Nombre y Principio Activo -->
                    <DataGridTemplateColumn Header="Artículo e Insumo" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding GenericName}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Presentación -->
                    <DataGridTextColumn Header="Presentación" Binding="{Binding Presentation}" Width="160" />

                    <!-- Categoría -->
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category.Name}" Width="160" />

                    <!-- Ubicación -->
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="130" />

                    <!-- Stock Actual con Badge -->
                    <DataGridTemplateColumn Header="Stock Actual" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentStock}" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Margin="0,0,4,0"
                                               Foreground="{DynamicResource ThemeText}" />
                                    <TextBlock Text="{Binding Unit}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               Margin="0,0,8,0" 
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource ThemeWarning}" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bajo" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Precio de Venta -->
                    <DataGridTemplateColumn Header="Precio" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,0,8,0" 
                                           Foreground="{DynamicResource ThemeAccent}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones Rápidas -->
                    <DataGridTemplateColumn Header="Acciones Rápidas" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Consumo rápido en consulta -->
                                    <Button Style="{DynamicResource SuccessButton}" 
                                            Content="⚡ Consumo" 
                                            Padding="8,4" 
                                            FontSize="11" 
                                            Margin="0,0,6,0"
                                            ToolTip="Registrar consumo durante consulta médica"
                                            Command="{Binding DataContext.OpenQuickConsumptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" />

                                    <!-- Entrada rápida -->
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Content="+ Entrada" 
                                            Padding="8,4" 
                                            FontSize="11" 
                                            Margin="0,0,6,0"
                                            ToolTip="Registrar entrada de insumos"
                                            Command="{Binding DataContext.OpenQuickEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" />

                                    <!-- Editar -->
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Content="✏️" 
                                            Padding="8,4" 
                                            FontSize="11" 
                                            Margin="0,0,6,0"
                                            ToolTip="Editar información de producto"
                                            Click="EditProduct_Click" />

                                    <!-- Eliminar -->
                                    <Button Style="{DynamicResource OutlineButton}" 
                                            Content="🗑️" 
                                            Padding="8,4" 
                                            FontSize="11" 
                                            ToolTip="Desactivar producto"
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Overlay de Acción Rápida (Consumo / Entrada) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#66000000"
                Visibility="{Binding IsQuickActionOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorder}" 
                    Width="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding QuickActionTitle}" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,6" />
                    <TextBlock Text="Indica la cantidad a descontar o añadir al inventario del consultorio:" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,16" />

                    <TextBlock Text="Cantidad *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Style="{DynamicResource ModernTextBox}" 
                             Text="{Binding QuickActionQuantity, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,14" />

                    <TextBlock Text="Motivo o Procedimiento" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Style="{DynamicResource ModernTextBox}" 
                             Text="{Binding QuickActionNotes, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource OutlineButton}" 
                                Content="Cancelar" 
                                Command="{Binding CloseQuickActionCommand}" 
                                Margin="0,0,10,0" 
                                Padding="16,8" />
                        <Button Style="{DynamicResource AccentButton}" 
                                Content="Confirmar" 
                                Command="{Binding ConfirmQuickActionCommand}" 
                                Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
