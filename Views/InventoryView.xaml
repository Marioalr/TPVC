<UserControl x:Class="TPVC.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Productos: busca al escribir, filtros como chips y lista que solo crea las filas visibles. -->
    <!-- Alta, edición, entradas y consumos en un panel lateral (sin ventanas aparte).            -->
    <Grid>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Productos" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="{Binding ResultsSummary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding OpenOrderEntryCommand}" Margin="0,0,8,0"
                            ToolTip="Pegar el correo del pedido del proveedor e ingresar todos sus productos juntos">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoClipboard}" Margin="0,0,8,0" />
                            <TextBlock Text="Ingresar pedido" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding NewProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,8,0" />
                            <TextBlock Text="Nuevo producto" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Grid Margin="0,0,0,10">
                    <TextBox Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar por nombre, genérico, código o ubicación"
                             AutomationProperties.Name="Buscar producto" />
                    <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,6,6" IsChecked="{Binding FilterLowStock}" Content="Stock bajo" />
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,12,6" IsChecked="{Binding FilterExpiring}" Content="Por caducar" />
                    <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             DisplayMemberPath="Name" AutomationProperties.Name="Categorías" />
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox x:Name="ProductsList" Style="{StaticResource PlainList}" Padding="8,6"
                             ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             MouseDoubleClick="ProductsList_MouseDoubleClick"
                             AutomationProperties.Name="Productos">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Product}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource BadgeInfo}" Margin="8,0,0,0" Visibility="{Binding RequiresRefrigeration, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Refrigerar" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="{Binding HasMultipleUnitsPerPackage, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PackageContentText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                    <Binding Path="Code" />
                                                    <Binding Path="GenericName" />
                                                    <Binding Path="Presentation" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Category.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StockBadge}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                        <!-- Bajo el mínimo o agotado: además del color, el icono de aviso -->
                                        <helpers:Icon Data="{StaticResource IcoAlert}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                                      Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StockBadgeText}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right"
                                                   Text="{Binding Price, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                        <TextBlock Style="{StaticResource TextCaption}" TextAlignment="Right" Visibility="{Binding HasCost, Converter={StaticResource BoolToVis}}"
                                                   Text="{Binding EffectiveUnitCost, StringFormat='costo {0:C2}', ConverterCulture=es-MX}" ToolTip="Costo por unidad (con IVA si no lo incluía)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ButtonSecondary}" MinHeight="0" Padding="12,5" Content="Entrada" ToolTip="Registrar una entrada (compra o reposición)"
                                                Command="{Binding DataContext.OpenQuickEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ButtonIcon}" Width="32" Height="32" Margin="4,0,0,0"
                                                helpers:MenuOnClick.IsEnabled="True"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Más acciones" AutomationProperties.Name="Más acciones">
                                            <helpers:Icon Data="{StaticResource IcoMore}" StrokeThickness="3" />
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource DsContextMenu}">
                                                    <MenuItem Header="Editar" Command="{Binding PlacementTarget.Tag.EditProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Registrar consumo (sin cobro)" Command="{Binding PlacementTarget.Tag.OpenQuickConsumptionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Dar de baja del catálogo" Command="{Binding PlacementTarget.Tag.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Products.Count, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" Text="Ningún producto con estos filtros." HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Quite un filtro o cambie la búsqueda." HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= PANEL: ALTA / EDICIÓN ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="460" Panel.ZIndex="50"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid DataContext="{Binding Editor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextHeading}">
                                <Setter Property="Text" Value="Editar producto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter Property="Text" Value="Nuevo producto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CancelCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,16">
                        <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource NoticeSuccess}" Margin="0,0,0,12" Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Código *" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre comercial *" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Genérico (principio activo)" />
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Presentación" />
                        <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="Ej. Caja con 20 tabletas de 500 mg" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Categoría *" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Unidad" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding CommonUnits}" SelectedItem="{Binding Unit}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Contenido por paquete (ampolletas, piezas, etc.)" />
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}"
                                     Text="{Binding UnitsPerPackageText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="1 (si no se ingresa se asume 1 sola pieza)"
                                     AutomationProperties.Name="Contenido por paquete"
                                     ToolTip="Cuántas piezas individuales (ampolletas, tabletas, sobres, etc.) contiene cada paquete para poder consumir solo una parte en servicios." />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding IndividualUnitPriceSummary}"
                                       Visibility="{Binding IndividualUnitPriceSummary, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Precio de venta ($)" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Costo por unidad ($)" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Costo por unidad" ToolTip="Lo que se le paga al proveedor por unidad" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,14">
                            <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding CostExcludesVat}" Content="El costo no incluye IVA (se suma 16 %)"
                                      ToolTip="Para material de curación e insumos con IVA. Los medicamentos van sin IVA: déjela desmarcada." />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding ProfitText}"
                                       Visibility="{Binding ProfitText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ubicación" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Ej. Estante A1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Clave del proveedor" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Ej. WAN014" AutomationProperties.Name="Clave del proveedor"
                                         ToolTip="El SKU con que llega en el pedido del proveedor. «Ingresar pedido» la guarda sola." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Existencias" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Mínimo" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ideal" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding OptimalStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Cambiar las existencias aquí queda en el kardex como ajuste. Para compras use Entrada." />
                        <CheckBox Style="{StaticResource FieldCheckBox}" IsChecked="{Binding RequiresRefrigeration}" Content="Requiere refrigeración" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notas" />
                        <TextBox Style="{StaticResource FieldMultiline}" MinHeight="60" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CancelCommand}" Content="Cerrar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= PANEL: ENTRADA O CONSUMO ======================= -->
        <Border Style="{StaticResource SidePanel}" Width="420" Panel.ZIndex="50"
                Visibility="{Binding IsQuickActionOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="24,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextHeading}">
                                    <Setter Property="Text" Value="Entrada" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuickConsumptionMode}" Value="True">
                                            <Setter Property="Text" Value="Consumo sin cobro" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding SelectedProduct.Name}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseQuickActionCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Margin="24,0,24,16">
                    <Border Style="{StaticResource CardSubtle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource TextDetail}" Text="{Binding SelectedProduct.CurrentStock, StringFormat='Existencias actuales: {0}'}" />
                    </Border>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cantidad" />
                    <TextBox Style="{StaticResource FieldTextBox}" FontSize="18" Height="44" HorizontalContentAlignment="Center"
                             Text="{Binding QuickActionQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="Cantidad" />
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsQuickConsumptionMode, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Contenido por paquete (ampolletas, piezas, etc.)" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding QuickEntryUnitsPerPackageText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:Field.Placeholder="1 (si no se ingresa se conserva o asume 1)"
                                 AutomationProperties.Name="Contenido por paquete" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Motivo" />
                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding QuickActionNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Queda registrado en el kardex. Lo que se usa con un paciente se carga mejor a la cuenta de su consulta."
                               Visibility="{Binding IsQuickConsumptionMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseQuickActionCommand}" Content="Cancelar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ConfirmQuickActionCommand}" Content="Registrar" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= HOJA: INGRESAR PEDIDO DEL PROVEEDOR ======================= -->
        <Grid Panel.ZIndex="60" Visibility="{Binding IsOrderEntryOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SheetScrim}" />
            <Border Style="{StaticResource SheetCard}" MaxWidth="1120" HorizontalAlignment="Stretch" MaxHeight="760" Padding="0" DataContext="{Binding OrderEntry}"
                    AutomationProperties.Name="Ingresar pedido">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="24,20,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextHeading}" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource TextDetail}" Text="{Binding SummaryText}" Margin="0,2,0,0"
                                       Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"
                                VerticalAlignment="Top" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <helpers:Icon Data="{StaticResource IcoClose}" />
                        </Button>
                    </Grid>

                    <!-- Paso 1: pegar el correo -->
                    <StackPanel Grid.Row="1" Margin="24,0,24,16" Visibility="{Binding IsPasting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Copie del correo del proveedor la parte «Detalles de la Compra», con la tabla de productos (Producto, SKU, Cantidad y Total) y el resumen, y péguela aquí. Por ahora se lee el formato de los correos de LUIN." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Proveedor" />
                        <TextBox Style="{StaticResource FieldTextBox}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12"
                                 Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Proveedor" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Correo del pedido" />
                        <TextBox Style="{StaticResource FieldMultiline}" Height="300" AcceptsTab="True" FontFamily="{StaticResource FontFamilyMono}" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo del pedido"
                                 helpers:Field.Placeholder="Pegue aquí el correo (Ctrl+V)" />
                        <Border Style="{StaticResource NoticeDanger}" Margin="0,12,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- Paso 2: revisar los renglones -->
                    <Grid Grid.Row="1" Margin="24,0,24,12" Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource NoticeWarning}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalCheckOk}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSuccessSubtle}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSuccessText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TotalCheckText}" TextWrapping="Wrap" />
                            </Border>
                            <Border Style="{StaticResource NoticeWarning}" Margin="0,0,0,8" Visibility="{Binding DuplicateWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DuplicateWarning}" TextWrapping="Wrap" />
                            </Border>
                            <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding HasNewProducts, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource TextBody}" Text="Categoría de los productos nuevos:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Style="{StaticResource FieldComboBox}" Width="280" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryForNew}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="Categoría de los productos nuevos" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Encabezados de la tabla -->
                        <Grid Grid.Row="1" Margin="8,0,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextCaption}" Text="En el correo" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}" Text="Producto en TPVC" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TextCaption}" Text="Cant." Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TextCaption}" Text="Pzas/paq." Margin="8,0,0,0" ToolTip="Piezas individuales por paquete (ampolletas, piezas, etc.; vacío = 1)" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TextCaption}" Text="Costo u." Margin="8,0,0,0" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TextCaption}" Text="Lote (opcional)" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="6" Style="{StaticResource TextCaption}" Text="Caducidad" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="7" Style="{StaticResource TextCaption}" Text="Total" TextAlignment="Right" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource CardSubtle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="8,4" AutomationProperties.Name="Renglones del pedido">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SupplierOrderLineViewModel}">
                                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.1*" />
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="108" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Description}" TextWrapping="Wrap" />
                                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Sku}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding DataContext.ProductChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Label" TextSearch.TextPath="Label"
                                                                      AutomationProperties.Name="Producto en TPVC">
                                                                <ComboBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ComboBox.ItemsPanel>
                                                            </ComboBox>
                                                            <TextBlock Text="{Binding MatchText}" Margin="2,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeWarningText}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="2" Style="{StaticResource FieldTextBox}" Margin="8,0,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad" />
                                                        <TextBox Grid.Column="3" Style="{StaticResource FieldTextBox}" Margin="8,0,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                                                 Text="{Binding UnitsPerPackageText, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="1"
                                                                 AutomationProperties.Name="Contenido por paquete"
                                                                 ToolTip="Cuántas piezas o ampolletas contiene cada paquete (vacío = 1)" />
                                                        <TextBox Grid.Column="4" Style="{StaticResource FieldTextBox}" Margin="8,0,0,0" VerticalAlignment="Top" FontFamily="{StaticResource FontFamilyMono}"
                                                                 Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Costo por unidad"
                                                                 ToolTip="Total del renglón entre la cantidad; se puede corregir" />
                                                        <TextBox Grid.Column="5" Style="{StaticResource FieldTextBox}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                 Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" helpers:Field.Placeholder="Sin lote" />
                                                        <TextBox Grid.Column="6" Style="{StaticResource FieldTextBox}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                 Text="{Binding ExpirationText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caducidad" helpers:Field.Placeholder="mm/aaaa" />
                                                        <TextBlock Grid.Column="7" Style="{StaticResource TextMono}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0"
                                                                   Text="{Binding LineTotalText}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Error}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeDangerText}" FontSize="12" TextWrapping="Wrap"
                                                               Visibility="{Binding Error, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                        <Grid>
                            <TextBlock Style="{StaticResource TextBody}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding LinesTotalText, StringFormat='Total del pedido: {0}'}"
                                       Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ButtonGhost}" Command="{Binding BackToPasteCommand}" Content="Volver a pegar" Margin="0,0,8,0"
                                        Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding PasteFromClipboardCommand}" Content="Pegar del portapapeles" Margin="0,0,8,0"
                                        Visibility="{Binding IsPasting, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ReadOrderCommand}" Content="Leer pedido"
                                        Visibility="{Binding IsPasting, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                <Button Style="{StaticResource ButtonPrimary}" Command="{Binding ConfirmCommand}" Content="Ingresar pedido"
                                        Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanConfirm}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
