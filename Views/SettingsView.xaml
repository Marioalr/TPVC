<UserControl x:Class="TPVC.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32" MaxWidth="850" HorizontalAlignment="Left">
            
            <!-- Encabezado -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Configuración y Personalización" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeText}" />
                <TextBlock Text="Ajusta el tema visual (colores de acento y fondo) y actualiza la aplicación" 
                           FontSize="13" 
                           Foreground="{DynamicResource ThemeTextSecondary}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Sección 1: Modo de Fondo -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Modo de Fondo de la Aplicación" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="Selecciona el entorno que mejor se adapte a la iluminación del consultorio" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <!-- Botón Modo Claro -->
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding SelectModeCommand}" 
                                CommandParameter="Claro"
                                Padding="18,12" 
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☀️ Modo Claro Clínico" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Botón Modo Oscuro -->
                        <Button Style="{DynamicResource OutlineButton}" 
                                Command="{Binding SelectModeCommand}" 
                                CommandParameter="Oscuro"
                                Padding="18,12" 
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌙 Modo Oscuro" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Personalización Avanzada de Fondo (Hex) -->
                    <Border BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,1,0,0" 
                            Padding="0,14,0,0" 
                            Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Color de Fondo (Hex):" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" 
                                     Style="{DynamicResource ModernTextBox}" 
                                     Text="{Binding CustomBgHex, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3" Text="Superficie (Hex):" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="4" 
                                     Style="{DynamicResource ModernTextBox}" 
                                     Text="{Binding CustomSurfaceHex, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="6" 
                                    Style="{DynamicResource AccentButton}" 
                                    Content="Aplicar Fondos" 
                                    Command="{Binding ApplyCustomColorsCommand}" 
                                    Padding="14,6" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sección 2: Color de Acento -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Color de Acento" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="Color representativo utilizado en botones principales, selecciones y elementos destacados:" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,16" />

                    <!-- Paleta de Colores Rápidos -->
                    <ItemsControl ItemsSource="{Binding PaletteOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource OutlineButton}" 
                                        Margin="0,0,10,10" 
                                        Padding="14,8"
                                        Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Hex}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" 
                                                CornerRadius="8" 
                                                Background="{Binding Hex}" 
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selector Hex Personalizado de Acento -->
                    <Border BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="0,1,0,0" 
                            Padding="0,14,0,0" 
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Acento Hex libre:" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Margin="0,0,10,0" />
                            <TextBox Style="{DynamicResource ModernTextBox}" 
                                     Text="{Binding CurrentAccentHex, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="120" 
                                     Margin="0,0,10,0" />
                            <Button Style="{DynamicResource AccentButton}" 
                                    Content="Guardar Acento" 
                                    Command="{Binding SelectAccentCommand}" 
                                    CommandParameter="{Binding CurrentAccentHex}" 
                                    Padding="14,6" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sección 3: Actualizaciones de la Aplicación (Único lugar donde reside la actualización) -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Actualización de la Aplicación" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="Comprueba y aplica las últimas mejoras del sistema:" 
                               FontSize="12" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion, StringFormat='Versión instalada: v{0}'}" 
                                       FontWeight="SemiBold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text="{Binding UpdateStatusMessage}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{DynamicResource AccentButton}" 
                                Command="{Binding CheckUpdatesCommand}" 
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" 
                                      Fill="{DynamicResource ThemeAccentText}" 
                                      Width="13" Height="13" 
                                      Stretch="Uniform" 
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Buscar Actualizaciones" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Tarjeta cuando hay actualización disponible -->
                    <Border Style="{DynamicResource CardBorder}" 
                            Background="{DynamicResource ThemeSurfaceSubtle}"
                            BorderBrush="{DynamicResource ThemeAccent}"
                            Margin="0,6,0,0"
                            Padding="14"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="¡Nueva versión disponible para instalar!" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource ThemeAccent}" />
                                    <TextBlock Text="{Binding LatestVersion, StringFormat='Versión nueva: v{0}'}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeText}" 
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Style="{DynamicResource AccentButton}" 
                                        Content="Descargar e Instalar" 
                                        Command="{Binding DownloadAndInstallUpdateCommand}" 
                                        Padding="14,6" />
                            </Grid>

                            <!-- Barra de progreso si está descargando -->
                            <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <ProgressBar Height="8" Value="{Binding DownloadProgress}" Maximum="100" />
                                <TextBlock Text="{Binding DownloadProgress, StringFormat='Descargando actualización: {0}%'}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Configuración de Token para Despliegues Privados (Producción) -->
                    <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,10" 
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="🔒 Autenticación para Repositorio Privado en Producción" 
                                       FontWeight="SemiBold" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       Margin="0,0,0,3" />
                            <TextBlock Text="Nota para producción: Si el repositorio es privado, configure un Personal Access Token (PAT) de GitHub con permiso 'repo' para que este equipo pueda consultar y descargar nuevas versiones automáticamente. En repositorios públicos este campo no es requerido." 
                                       FontSize="11" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" 
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         Text="{Binding GitHubToken, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBox}" 
                                         FontFamily="Consolas" 
                                         FontSize="12" 
                                         Padding="10,6" />
                                <Button Grid.Column="2" 
                                        Style="{DynamicResource OutlineButton}" 
                                        Command="{Binding SaveGitHubTokenCommand}" 
                                        Content="Guardar Token" 
                                        Padding="14,6" />
                            </Grid>
                            <TextBlock Text="{Binding TokenStatusMessage}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeAccent}" 
                                       Margin="0,5,0,0" 
                                       Visibility="{Binding TokenStatusMessage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sección 4: Base de Datos Local y Respaldos -->
            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Base de Datos Local y Respaldos" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="Los datos se guardan en este equipo. Cada día, al abrir la aplicación, se crea un respaldo automático y se conservan los últimos 14." 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,12" />

                    <TextBlock Text="{Binding LastBackupText}" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeText}" 
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DatabasePath, StringFormat='Base de datos: {0}'}" 
                               FontSize="11" 
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,0,0,12" />

                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource AccentButton}" 
                                Content="Respaldar Ahora" 
                                Command="{Binding BackupNowCommand}" 
                                Padding="14,6" 
                                Margin="0,0,8,8"
                                FontSize="12" />
                        <Button Style="{DynamicResource OutlineButton}" 
                                Content="Abrir Carpeta de Respaldos" 
                                Command="{Binding OpenBackupFolderCommand}" 
                                Padding="14,6" 
                                Margin="0,0,8,8"
                                FontSize="12" />
                        <Button Style="{DynamicResource OutlineButton}" 
                                Content="Abrir Carpeta de Base de Datos" 
                                Click="OpenDbFolder_Click" 
                                Padding="14,6" 
                                Margin="0,0,8,8"
                                FontSize="12" />
                        <Button Style="{DynamicResource OutlineButton}" 
                                Content="Ver Bitácora de Errores" 
                                Command="{Binding OpenLogsFolderCommand}" 
                                Padding="14,6" 
                                Margin="0,0,8,8"
                                FontSize="12" />
                    </WrapPanel>

                    <TextBlock Text="{Binding BackupStatusMessage}" 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeAccent}" 
                               Visibility="{Binding BackupStatusMessage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
