<UserControl x:Class="TPVC.Views.PrescriptionPreviewSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ========================================================================= -->
    <!-- MODAL: VISTA PREVIA DE LA RECETA (igual a la impresión y al PDF)           -->
    <!-- ========================================================================= -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="900" MaxHeight="720" Padding="24,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Vista previa de la receta" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Así se imprime o se guarda: media carta horizontal, con el formato de su receta de Excel" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding ClosePrescriptionPdfPreviewCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- La hoja (media carta horizontal: 816 x 528 a 96 ppp) a escala. Es papel: se ve como sale
                     impresa (siempre en claro) con cualquier tema. Mismo acomodo que PrintingService.Prescription:
                     encabezado, Paciente · Edad · Fecha, Alergias y signos, medicamentos | medidas generales y pie.
                     Con muchos medicamentos la hoja crece (al imprimir pasan a otra hoja) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                        <Border Width="816" MinHeight="528" Padding="22.66,18.91" BorderThickness="1"
                                Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                                TextElement.Foreground="{DynamicResource ThemeText}"
                                TextElement.FontFamily="Neue Haas Grotesk Text Pro, Segoe UI, Arial"
                                TextElement.FontSize="13.333">
                            <Border.Resources>
                                <!-- Tinta sobre papel blanco (≥ 4.5:1, también sobre el sombreado de los campos) -->
                                <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ThemeText" Color="#000000" />
                                <SolidColorBrush x:Key="ThemeTextSecondary" Color="#5A687D" />
                                <SolidColorBrush x:Key="ThemeBorder" Color="#CBD5E1" />
                                <SolidColorBrush x:Key="ThemeAccentForeground" Color="#0369A1" />
                                <SolidColorBrush x:Key="ThemeDangerText" Color="#991B1B" />
                                <!-- Sombreado gris muy claro de los campos, como en la hoja del Excel -->
                                <SolidColorBrush x:Key="PaperFill" Color="#F0F0F0" />

                                <Style x:Key="PaperLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="10,0,6,0" />
                                </Style>
                                <Style x:Key="PaperField" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PaperFill}" />
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="MinHeight" Value="20" />
                                </Style>
                                <Style x:Key="PaperValue" TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="PaperCentered" TargetType="Viewbox">
                                    <Setter Property="Stretch" Value="Uniform" />
                                    <Setter Property="StretchDirection" Value="DownOnly" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Height" Value="20" />
                                    <Setter Property="Margin" Value="139,0" />
                                </Style>
                            </Border.Resources>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="92" />
                                    <RowDefinition Height="13" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="13" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Encabezado: escudo, nombre (grande), universidad y cédula, trazo de signos vitales -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="76" Height="76" Margin="0,4,0,0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Source="{Binding Clinic.CrestImagePath, Converter={StaticResource ImageFile}}" />
                                    <StackPanel Grid.Column="1">
                                        <Viewbox Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Clinic.DoctorName}" FontFamily="Frosted Breath, Segoe Script, Segoe UI" FontSize="32"
                                                       Foreground="{DynamicResource ThemeAccentForeground}" VerticalAlignment="Center" />
                                        </Viewbox>
                                        <Viewbox Style="{StaticResource PaperCentered}">
                                            <TextBlock Text="{Binding Clinic.University}" VerticalAlignment="Center" />
                                        </Viewbox>
                                        <Viewbox Style="{StaticResource PaperCentered}" Visibility="{Binding Clinic.DoctorLicense, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Clinic.DoctorLicense, StringFormat='Cédula Profesional {0}'}" VerticalAlignment="Center" />
                                        </Viewbox>
                                    </StackPanel>
                                    <Image Grid.Column="1" Width="131" Height="44" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Source="{Binding Clinic.HeaderImagePath, Converter={StaticResource ImageFile}}" />
                                </Grid>

                                <!-- Paciente · Edad · Fecha -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <!-- Nombre y alergias toman lo que sobra; los demás campos miden lo que su
                                             valor, con el mínimo de la celda del Excel (igual que al imprimir) -->
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PaperLabel}" Margin="0,0,6,0" Text="Paciente:" />
                                    <Border Grid.Column="1" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.FullName}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Style="{StaticResource PaperLabel}" Text="Edad:" />
                                    <Border Grid.Column="3" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.AgeDisplay}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Style="{StaticResource PaperLabel}" Text="Fecha:" />
                                    <Border Grid.Column="5" Style="{StaticResource PaperField}">
                                        <!-- La fecha del día (la pone el código al abrir la vista previa) -->
                                        <TextBlock x:Name="PrescriptionDate" Style="{StaticResource PaperValue}" />
                                    </Border>
                                </Grid>

                                <!-- Alergias · T/A · Temp · Peso · Talla · SpO2 (lo que no se registró queda en blanco) -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="52" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="56" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="48" />
                                    </Grid.ColumnDefinitions>
                                    <!-- En rojo solo si tiene alergias: "Negadas" o "No interrogadas" no son una alarma -->
                                    <TextBlock Text="Alergias:" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PaperLabel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Session.SelectedPatient.HasAllergies}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Column="1" Style="{StaticResource PaperField}">
                                        <TextBlock Text="{Binding Session.SelectedPatient.AllergySummary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PaperValue}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Session.SelectedPatient.HasAllergies}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Style="{StaticResource PaperLabel}" Text="T/A:" />
                                    <Border Grid.Column="3" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.VitalSigns, Converter={StaticResource PrescriptionVital}, ConverterParameter=TA}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Style="{StaticResource PaperLabel}" Text="Temp:" />
                                    <Border Grid.Column="5" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.VitalSigns, Converter={StaticResource PrescriptionVital}, ConverterParameter=Temp}" />
                                    </Border>
                                    <TextBlock Grid.Column="6" Style="{StaticResource PaperLabel}" Text="Peso:" />
                                    <Border Grid.Column="7" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.VitalSigns, Converter={StaticResource PrescriptionVital}, ConverterParameter=Peso}" />
                                    </Border>
                                    <TextBlock Grid.Column="8" Style="{StaticResource PaperLabel}" Text="Talla:" />
                                    <Border Grid.Column="9" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.VitalSigns, Converter={StaticResource PrescriptionVital}, ConverterParameter=Talla}" />
                                    </Border>
                                    <TextBlock Grid.Column="10" Style="{StaticResource PaperLabel}" Text="SpO2%:" />
                                    <Border Grid.Column="11" Style="{StaticResource PaperField}">
                                        <TextBlock Style="{StaticResource PaperValue}" Text="{Binding Session.SelectedPatient.VitalSigns, Converter={StaticResource PrescriptionVital}, ConverterParameter=SpO2}" />
                                    </Border>
                                </Grid>

                                <!-- Medicamentos con su posología debajo (izquierda) y medidas generales (derecha) -->
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PaperFill}" Padding="8,6">
                                        <ItemsControl ItemsSource="{Binding Session.SelectedPatient.ActivePrescription}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,16">
                                                        <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Dosage}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource PaperFill}" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="Medidas generales:" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <!-- Lo mismo que se imprime: el plan e indicaciones que escribió el médico, o el texto general -->
                                            <TextBlock Text="{Binding PrescriptionIndications}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Pie: WhatsApp + teléfono y ubicación + domicilio -->
                                <Grid Grid.Row="8" TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="6*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PaperFill}" MinHeight="27" Padding="8,2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Clinic.ClinicPhone, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{x:Static helpers:PrescriptionImages.WhatsApp}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Clinic.ClinicPhone}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource PaperFill}" MinHeight="27" Padding="8,2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Clinic.ClinicAddress, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{x:Static helpers:PrescriptionImages.Location}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Clinic.ClinicAddress}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Viewbox>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left" Command="{Binding ClosePrescriptionPdfPreviewCommand}" Content="Cerrar" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ExportPrescriptionDocumentCommand}" Margin="0,0,8,0"
                                ToolTip="Guardar la receta como documento (HTML/PDF)">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar documento" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding PrintOrExportPrescriptionPdfCommand}" ToolTip="Imprimir la receta">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoPrint}" Margin="0,0,8,0" />
                                <TextBlock Text="Imprimir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
