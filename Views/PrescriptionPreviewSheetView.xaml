<UserControl x:Class="TPVC.Views.PrescriptionPreviewSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicalRecordsViewModel}">

    <!-- ========================================================================= -->
    <!-- MODAL: VISTA PREVIA Y GENERACIÓN DE RECETA MÉDICA OFICIAL (NOM-004-SSA3)  -->
    <!-- ========================================================================= -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="760" MaxHeight="720" Padding="24,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Vista previa de la receta" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Así se imprime o se guarda (formato NOM-004-SSA3)" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding ClosePrescriptionPdfPreviewCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <!-- Documento Simulado (Hoja de Receta): es papel, así que se ve como sale impresa (siempre
                     en claro) con cualquier tema; estos colores tapan los del tema solo dentro de la hoja -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource ThemeSurface}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <Border.Resources>
                        <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ThemeBackground" Color="#F8FAFC" />
                        <SolidColorBrush x:Key="ThemeSurfaceSubtle" Color="#F1F5F9" />
                        <SolidColorBrush x:Key="ThemeText" Color="#0F172A" />
                        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#5A687D" />
                        <SolidColorBrush x:Key="ThemeBorder" Color="#E2E8F0" />
                        <SolidColorBrush x:Key="ThemeAccentForeground" Color="#0369A1" />
                        <SolidColorBrush x:Key="ThemeFocus" Color="#0369A1" />
                        <SolidColorBrush x:Key="ThemeDangerText" Color="#991B1B" />
                    </Border.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Membrete Institucional y Médico -->
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1.5" Padding="0,0,0,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Clinic.ClinicName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccentForeground}" />
                                        <TextBlock Text="{Binding Clinic.DoctorName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Clinic.DoctorLicense, StringFormat='Cédula Profesional: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeFocus}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="RECETA MÉDICA INDIVIDUAL" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ThemeAccentForeground}" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.RecordNumber, StringFormat='Exp: {0}'}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Ficha de Identificación del Paciente -->
                            <Border Background="{DynamicResource ThemeBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                        <TextBlock Text="Nombre del Paciente:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding SelectedPatient.FullName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                                        <TextBlock Text="Edad:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding SelectedPatient.AgeDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                        <TextBlock Text="Sexo:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding SelectedPatient.Gender}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                        <TextBlock Text="Signos Vitales Registrados:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <TextBlock Text="{Binding SelectedPatient.VitalSigns}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Alergias:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <!-- En rojo solo si tiene alergias: "Negadas" o "No interrogadas" no son una alarma -->
                                        <TextBlock Text="{Binding SelectedPatient.AllergySummary}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPatient.HasAllergies}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Símbolo Rp y Lista de Fármacos Prescritos -->
                            <Border Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="℞ PRESCRIPCIÓN MÉDICA Y POSOLOGÍA" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeAccentForeground}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedPatient.ActivePrescription}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,6,0,8" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="● " FontSize="11" Foreground="{DynamicResource ThemeAccentForeground}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeText}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Dosage, StringFormat='   Indicaciones: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding RecommendedQuantity, StringFormat='Cant: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Indicaciones de Cuidados Generales y Alarma -->
                            <Border Background="{DynamicResource ThemeSurfaceSubtle}" CornerRadius="6" Padding="12,8" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="MEDIDAS GENERALES Y DATOS DE ALARMA:" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <!-- Lo mismo que se imprime: el plan e indicaciones que escribió el médico, o el texto general -->
                                    <TextBlock Text="{Binding PrescriptionIndications}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Firma y Cédula del Médico Tratante -->
                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource ThemeTextSecondary}" BorderThickness="0,1,0,0" Width="220" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Clinic.DoctorName}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeText}" />
                                    <TextBlock Text="{Binding Clinic.DoctorLicense, StringFormat='Cédula Profesional: {0}'}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <TextBlock Text="Firma y Sello del Médico Tratante" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left" Command="{Binding ClosePrescriptionPdfPreviewCommand}" Content="Cerrar" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonSecondary}" Command="{Binding ExportPrescriptionDocumentCommand}" Margin="0,0,8,0"
                                ToolTip="Guardar la receta como documento (HTML/PDF)">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar documento" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding PrintOrExportPrescriptionPdfCommand}" ToolTip="Imprimir la receta">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoPrint}" Margin="0,0,8,0" />
                                <TextBlock Text="Imprimir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
