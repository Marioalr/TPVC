<UserControl x:Class="TPVC.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UpdatesViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Acerca de y actualizaciones: versión instalada, buscar e instalar la nueva (verificada con -->
    <!-- SHA-256), el token para repositorios privados (plegado) y la carpeta de registros.        -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource TextTitle}" Text="Acerca de y actualizaciones" />
                <TextBlock Style="{StaticResource TextDetail}" Text="Versión instalada y nuevas versiones" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Versión y búsqueda -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource ThemeAccentStrong}" Margin="0,0,16,0">
                            <TextBlock Text="TPVC" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextSection}" Text="{Binding AppVersion, StringFormat='Versión {0}'}" />
                            <TextBlock Style="{StaticResource TextDetail}" Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Command="{Binding CheckUpdatesCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoRefresh}" Margin="0,0,8,0" />
                                <TextBlock Text="Buscar actualización" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Versión nueva disponible -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16" BorderBrush="{DynamicResource ThemeAccentStrong}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource BadgeInfo}" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="Nueva versión" />
                            </Border>
                            <TextBlock Style="{StaticResource TextHeading}" Text="{Binding LatestVersion, StringFormat='TPVC {0}'}" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="Se descarga, se verifica que el archivo sea el original y se instala. El programa se cierra y vuelve a abrir solo." TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding DownloadAndInstallUpdateCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoCheck}" Margin="0,0,8,0" />
                                <TextBlock Text="Instalar ahora" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="6" Value="{Binding DownloadProgress}" Maximum="100" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding DownloadProgress, StringFormat='Descargando… {0}%'}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ReleaseNotes, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Qué trae" Margin="0,0,0,6" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource TextBody}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Registros -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextSection}" Text="Registros del programa" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Si algo falla, estos archivos ayudan a saber qué pasó." Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource TextCaption}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding LogDirectory}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonGhost}" Command="{Binding OpenLogsFolderCommand}" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoFile}" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir carpeta" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Token de GitHub (plegado) -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Button Style="{StaticResource ButtonGhost}" HorizontalContentAlignment="Stretch" Padding="20,14" Command="{Binding ToggleTokenSectionCommand}"
                            AutomationProperties.Name="Acceso a versiones privadas">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <helpers:Icon Data="{StaticResource IcoLock}" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="Acceso a versiones privadas" />
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                            <Setter Property="Text" Value="Solo si el repositorio es privado. Sin token se usa el público." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGitHubToken}" Value="True">
                                                    <Setter Property="Text" Value="Token guardado en este equipo." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <helpers:Icon Grid.Column="2">
                                <helpers:Icon.Style>
                                    <Style TargetType="helpers:Icon">
                                        <Setter Property="Data" Value="{StaticResource IcoChevronDown}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTokenSectionOpen}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IcoChevronUp}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </helpers:Icon.Style>
                            </helpers:Icon>
                        </Grid>
                    </Button>
                    <StackPanel Margin="20,0,20,20" Visibility="{Binding IsTokenSectionOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Token personal de GitHub (PAT) con permiso de lectura del repositorio. Se guarda cifrado en este equipo." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Style="{DynamicResource ModernPasswordBox}" helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding GitHubToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsGitHubTokenVisible, Converter={StaticResource InverseBoolToVis}}" AutomationProperties.Name="Token de GitHub" />
                            <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}"
                                     Text="{Binding GitHubToken, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsGitHubTokenVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Token de GitHub visible" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Command="{Binding ToggleGitHubTokenVisibilityCommand}" ToolTip="Mostrar u ocultar" AutomationProperties.Name="Mostrar u ocultar token">
                                <helpers:Icon Data="{StaticResource IcoLock}" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}" Command="{Binding PasteGitHubTokenCommand}" Content="Pegar" Margin="4,0,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveGitHubTokenCommand}" Content="Guardar token" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding TokenStatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
