<UserControl x:Class="TPVC.Views.ClinicProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ClinicProfileViewModel}"
             d:DesignHeight="850" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32" MaxWidth="880" HorizontalAlignment="Left">
            
            <!-- Encabezado -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Datos de Consultorio y Médico" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeText}" />
                    <TextBlock Text="Información oficial utilizada en el membrete de recetas (NOM-004-SSA3), tickets de cobro y cortes de caja." 
                               FontSize="12.5" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Botón Principal: Guardar / Editar -->
                <Button Grid.Column="1" 
                        Style="{DynamicResource AccentButton}" 
                        Command="{Binding ToggleEditOrSaveCommand}" 
                        Padding="22,10" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" 
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="✏️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" 
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{Binding ActionButtonText}" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Banner de Estado -->
            <Border Background="{DynamicResource ThemeSurfaceSubtle}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,10" 
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeText}" 
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- TARJETA 1: DATOS DEL MÉDICO -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,18" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🩺" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Datos del Médico Titular" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccent}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Nombre del Médico -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Nombre Completo del Médico *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Nombre y apellidos del médico titular" />
                        </StackPanel>

                        <!-- Cédula Profesional -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cédula Profesional *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ProfessionalLicense, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Número de cédula profesional registrada ante la Dirección General de Profesiones" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Especialidad -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Especialidad / Título Profesional" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Ej. Médico Cirujano, Medicina General, Pediatría" />
                        </StackPanel>

                        <!-- Universidad / Institución -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Institución Educativa / Universidad" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding University, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Institución que expidió el título profesional" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TARJETA 2: DATOS DEL CONSULTORIO / CLÍNICA -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,18" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🏥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Datos del Consultorio o Clínica" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccent}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Nombre del Consultorio -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Nombre del Consultorio o Clínica *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsEditing}"
                                 Style="{DynamicResource ModernTextBox}" 
                                 Padding="10,8" 
                                 ToolTip="Nombre comercial o razón del consultorio" />
                    </StackPanel>

                    <!-- Domicilio -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Domicilio Completo (Calle, Número, Colonia, Ciudad, C.P.)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsEditing}"
                                 Style="{DynamicResource ModernTextBox}" 
                                 Padding="10,8" 
                                 ToolTip="Dirección física del consultorio" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Teléfono -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Teléfono de Contacto" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Teléfono de citas o urgencias" />
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Correo Electrónico" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="Email de contacto o facturación" />
                        </StackPanel>

                        <!-- RFC -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RFC / Identificación Fiscal" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditing}"
                                     Style="{DynamicResource ModernTextBox}" 
                                     Padding="10,8" 
                                     ToolTip="RFC del médico o consultorio (opcional)" />
                        </StackPanel>
                    </Grid>

                    <!-- Leyenda adicional en recetas -->
                    <StackPanel>
                        <TextBlock Text="Leyenda o Notas al pie de Recetas y Tickets" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdditionalNotes, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsEditing}"
                                 Style="{DynamicResource ModernTextBox}" 
                                 Padding="10,8" 
                                 ToolTip="Ej. Horario de atención: Lun a Vie 9:00 a 19:00 hrs. Citas al 55-XXXX-XXXX" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Botón Inferior Secundario (para comodidad en formularios largos) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource AccentButton}" 
                        Command="{Binding ToggleEditOrSaveCommand}" 
                        Padding="26,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" 
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="✏️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" 
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{Binding ActionButtonText}" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
