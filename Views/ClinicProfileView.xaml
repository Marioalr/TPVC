<UserControl x:Class="TPVC.Views.ClinicProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ClinicProfileViewModel}"
             d:DesignHeight="800" d:DesignWidth="1000">

    <!-- Médico y consultorio: los datos que salen en recetas, tickets y cortes de caja, con una -->
    <!-- vista previa del encabezado de la receta. Se editan con "Editar" y se guardan juntos.    -->
    <UserControl.Resources>
        <Style x:Key="ProfileField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="IsReadOnly" Value="{Binding IsEditing, Converter={StaticResource InverseBool}}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Médico y consultorio" />
                    <TextBlock Style="{StaticResource TextDetail}" Text="Aparecen en recetas, tickets y cortes de caja" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding ToggleEditOrSaveCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <helpers:Icon Margin="0,0,8,0">
                            <helpers:Icon.Style>
                                <Style TargetType="helpers:Icon">
                                    <Setter Property="Data" Value="{StaticResource IcoSave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IcoEdit}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </helpers:Icon.Style>
                        </helpers:Icon>
                        <TextBlock Text="{Binding ActionButtonText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Notice}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Médico" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre completo" />
                            <TextBox Style="{StaticResource ProfileField}" Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Ej. Dra. Ana López Pérez" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cédula profesional" />
                                    <TextBox Style="{StaticResource ProfileField}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding ProfessionalLicense, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Especialidad" />
                                    <TextBox Style="{StaticResource ProfileField}" Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}" helpers:Field.Placeholder="Medicina general" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Universidad" />
                            <TextBox Style="{StaticResource ProfileField}" Margin="0" Text="{Binding University, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Ej. Benemérita Universidad Autónoma de Puebla" />
                        </StackPanel>
                    </Border>

                    <!-- Membrete de la receta: las dos imágenes de arriba (se toman del Excel al importarlo) -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Membrete de la receta" />
                            <TextBlock Style="{StaticResource TextDetail}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Text="Se toman de su Excel al importarlo, o elíjalas aquí (PNG o JPG). Se guardan al presionar Guardar." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Escudo / logotipo" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Arriba a la izquierda" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Muestra en papel blanco, como sale impresa -->
                                        <Border Width="72" Height="72" Background="#FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                            <Image Stretch="Uniform" Source="{Binding CrestImagePath, Converter={StaticResource ImageFile}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ButtonSecondary}" Content="Elegir…" HorizontalAlignment="Left"
                                                    Command="{Binding ChooseCrestImageCommand}" ToolTip="Elegir el escudo o logotipo (PNG o JPG)" />
                                            <Button Style="{StaticResource ButtonGhost}" Content="Quitar" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Command="{Binding ClearCrestImageCommand}" ToolTip="La receta sale sin escudo"
                                                    Visibility="{Binding HasCrestImage, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Imagen del encabezado" />
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Arriba a la derecha (trazo de signos vitales)" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="120" Height="72" Background="#FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                            <Image Stretch="Uniform" Source="{Binding HeaderImagePath, Converter={StaticResource ImageFile}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ButtonSecondary}" Content="Elegir…" HorizontalAlignment="Left"
                                                    Command="{Binding ChooseHeaderImageCommand}" ToolTip="Elegir la imagen del encabezado (PNG o JPG)" />
                                            <Button Style="{StaticResource ButtonGhost}" Content="Quitar" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Command="{Binding ClearHeaderImageCommand}" ToolTip="La receta sale sin imagen en el encabezado"
                                                    Visibility="{Binding HasHeaderImage, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Consultorio" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre del consultorio" />
                            <TextBox Style="{StaticResource ProfileField}" Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dirección" />
                            <TextBox Style="{StaticResource ProfileField}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Teléfono" />
                                    <TextBox Style="{StaticResource ProfileField}" Margin="0" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Correo" />
                                    <TextBox Style="{StaticResource ProfileField}" Margin="0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="RFC" />
                                    <TextBox Style="{StaticResource ProfileField}" Margin="0" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSection}" Text="Notas al pie de la receta" Margin="0,0,0,12" />
                            <TextBox Style="{StaticResource FieldMultiline}" MinHeight="70" IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                     Text="{Binding AdditionalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Horario de atención, indicaciones generales…" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Vista previa del encabezado y el pie de la receta (en papel blanco, como sale impresa) -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="Así sale en la receta" Margin="0,0,0,8" />
                    <Border Background="#FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            TextElement.Foreground="#000000" TextElement.FontSize="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="52" Height="52" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Top"
                                       Source="{Binding CrestImagePath, Converter={StaticResource ImageFile}}"
                                       Visibility="{Binding HasCrestImage, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewDoctorName}" TextWrapping="Wrap" TextAlignment="Center"
                                               FontFamily="Frosted Breath, Segoe Script, Segoe UI" FontSize="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0369A1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDoctorName}" Value="False">
                                                        <Setter Property="Foreground" Value="#5A687D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding University}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"
                                               Visibility="{Binding University, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ProfessionalLicense, StringFormat='Cédula Profesional {0}'}" TextAlignment="Center"
                                               Visibility="{Binding ProfessionalLicense, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                            <Image Width="131" Height="44" Margin="0,6,0,0" Stretch="Uniform" HorizontalAlignment="Right"
                                   Source="{Binding HeaderImagePath, Converter={StaticResource ImageFile}}"
                                   Visibility="{Binding HasHeaderImage, Converter={StaticResource BoolToVis}}" />
                            <!-- Pie de la receta: teléfono (WhatsApp) y domicilio (ubicación) -->
                            <Border Background="#F0F0F0" Padding="8,4" Margin="0,10,0,0" Visibility="{Binding Phone, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="{x:Static helpers:PrescriptionImages.WhatsApp}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Phone}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F0F0F0" Padding="8,4" Margin="0,6,0,0" Visibility="{Binding Address, Converter={StaticResource BoolToVis}}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Static helpers:PrescriptionImages.Location}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Address}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lo demás sale en tickets y cortes de caja -->
                    <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="En tickets y cortes de caja" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding PreviewClinicName}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClinicName}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource TextDetail}" Text="{Binding Specialty}" TextWrapping="Wrap" Visibility="{Binding Specialty, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Address}" TextWrapping="Wrap" Visibility="{Binding Address, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Phone, StringFormat='Tel. {0}'}" Visibility="{Binding Phone, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Email}" Visibility="{Binding Email, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
