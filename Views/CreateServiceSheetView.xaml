<UserControl x:Class="TPVC.Views.CreateServiceSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!-- Nuevo servicio clínico con sus insumos por defecto (hoja del Punto de Venta). -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="720" MaxHeight="720" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextHeading}" Text="Nuevo servicio" />
                            <TextBlock Style="{StaticResource TextDetail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Consulta, curación, inyección… con los insumos que se usan cada vez (se agregan solos al cargarlo)." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseCreateServiceModalCommand}"
                                ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                            <helpers:Icon Data="{StaticResource IcoClose}" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Código" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}"
                                         Text="{Binding NewServiceCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre *" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}"
                                         helpers:Field.Placeholder="Ej. Aplicación de inyección intramuscular" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Categoría" />
                                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding ServiceCategories}" SelectedItem="{Binding NewServiceCategory}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Precio ($)" />
                                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontFamilyMono}"
                                         Text="{Binding NewServicePrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Duración (min)" />
                                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding NewServiceDuration, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción" />
                        <TextBox Style="{StaticResource FieldMultiline}" MinHeight="64" Margin="0,0,0,18"
                                 Text="{Binding NewServiceDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Style="{StaticResource CardSubtle}" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextSection}" Text="Insumos que usa (piezas individuales)" />
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                           Text="Opcional. Ingrese cuántas piezas individuales (ampolletas, piezas, etc.) consume el servicio; si el paquete trae varias, solo se consume esa parte." />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProductToAdd}"
                                              DisplayMemberPath="Name" helpers:TypeAhead.IsEnabled="True" AutomationProperties.Name="Insumo"
                                              ToolTip="Despliegue y escriba el nombre para ir directo a él" />
                                    <TextBox Grid.Column="2" Style="{StaticResource FieldTextBox}" HorizontalContentAlignment="Center"
                                             Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Piezas individuales que consume el servicio" AutomationProperties.Name="Cantidad" />
                                    <Button Grid.Column="4" Style="{StaticResource ButtonSecondary}" Command="{Binding AddProductToNewServiceCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <helpers:Icon Data="{StaticResource IcoPlus}" Margin="0,0,6,0" />
                                            <TextBlock Text="Agregar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding NewServiceDefaultProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ServiceDefaultProduct}">
                                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Product.Name}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Product.Presentation}" />
                                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding PackageSummary}"
                                                                   Visibility="{Binding PackageSummary, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='× {0} pza(s)'}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Style="{StaticResource ButtonIcon}" Width="30" Height="30" ToolTip="Quitar" AutomationProperties.Name="Quitar insumo"
                                                            Command="{Binding DataContext.RemoveProductFromNewServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <helpers:Icon Data="{StaticResource IcoClose}" Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Sin insumos: solo se cobra el honorario."
                                           Visibility="{Binding NewServiceDefaultProducts.Count, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseCreateServiceModalCommand}" Content="Cancelar" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveNewServiceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSave}" Margin="0,0,8,0" />
                                <TextBlock Text="Guardar servicio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
