<UserControl x:Class="TPVC.Views.ConfigurationShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ConfigurationShellViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- DataTemplates para resolución automática de Vistas Administrativas -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchesViewModel}">
            <views:BatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <views:MovementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClinicProfileViewModel}">
            <views:ClinicProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TursoSyncViewModel}">
            <views:TursoSyncView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel Lateral de Navegación y Configuración -->
        <Border Grid.Column="0" 
                Background="{DynamicResource ThemeSurface}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera del Panel Lateral -->
                <StackPanel Grid.Row="0" Margin="4,0,4,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <Border Background="{DynamicResource ThemeAccent}" 
                                CornerRadius="8" 
                                Width="34" Height="34" 
                                Margin="0,0,10,0">
                            <TextBlock Text="+" 
                                       FontWeight="Bold" 
                                       FontSize="22" 
                                       Foreground="{DynamicResource ThemeAccentText}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="0,-2,0,0" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TPVC" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="{DynamicResource ThemeText}" />
                            <TextBlock Text="Configuración y Ajustes" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón Destacado: Volver a Inicio (Hub de las 3 Cards) -->
                    <Button Style="{DynamicResource OutlineButton}" 
                            Command="{Binding BackToHubCommand}" 
                            Padding="12,8" 
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="←" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Volver a Inicio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Menú de Opciones de Administración y Configuración -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- 1. Resumen / Métricas (Dashboard) -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDashboard}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Panel y Métricas" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Inventario e Insumos -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=Inventory, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="Inventory">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPill}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Inventario e Insumos" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Lotes y Caducidades -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=Batches, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="Batches">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCalendar}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Lotes y Caducidades" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Kardex de Movimientos -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=Movements, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="Movements">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Kardex de Movimientos" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Datos de Consultorio y Médico -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=ClinicProfile, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="ClinicProfile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🩺" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Datos del Médico y Clínica" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 6. Temas y Ajustes -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="15" Height="15" 
                                      Stretch="Uniform" 
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Temas y Ajustes" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 7. Nube y Sincronización Turso -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=TursoSync, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="TursoSync">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☁️" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nube y Turso Cloud" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 8. Muestra del lenguaje visual (revisión de temas) -->
                        <RadioButton Style="{DynamicResource NavRadioButton}" 
                                     GroupName="ConfigNav"
                                     IsChecked="{Binding ActiveSubViewName, Converter={StaticResource ComparisonToBool}, ConverterParameter=DesignSystem, Mode=OneWay}"
                                     Command="{Binding NavigateSubViewCommand}" 
                                     CommandParameter="DesignSystem">
                            <StackPanel Orientation="Horizontal">
                                <helpers:Icon Data="{StaticResource IcoSun}" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Componentes" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie del Panel Lateral -->
                <StackPanel Grid.Row="2" Margin="4,0,4,4">
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Sistema de Consultorio" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock Text="{Binding AppVersion}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeAccent}" 
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área de Contenido de la Vista Administrativa Seleccionada -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentSubView, Converter={StaticResource CachedView}}" />
    </Grid>
</UserControl>
