<UserControl x:Class="TPVC.Views.ConfigurationShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:views="clr-namespace:TPVC.Views"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConfigurationShellViewModel}"
             d:DesignHeight="800" d:DesignWidth="1300">

    <!-- ======================================================================== -->
    <!-- CONFIGURACIÓN: menú agrupado (Resumen, Inventario, Consultorio, Sistema) -->
    <!-- con un resumen de una línea por sección y un buscador que lleva directo  -->
    <!-- a cualquier ajuste. Cada página se crea al abrirla.                      -->
    <!-- ======================================================================== -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><views:InventoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchesViewModel}"><views:BatchesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}"><views:MovementsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesCatalogViewModel}"><views:ServicesCatalogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClinicProfileViewModel}"><views:ClinicProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppearanceViewModel}"><views:AppearanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataManagementViewModel}"><views:DataManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><views:UpdatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TursoSyncViewModel}"><views:TursoSyncView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesignSystemViewModel}"><views:DesignSystemView /></DataTemplate>

        <!-- Elemento del menú: icono, título y resumen; el activo con barra de acento -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,0,0,2">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8,10,8">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Mark" Width="3" CornerRadius="2" Margin="3,10" HorizontalAlignment="Left"
                                    Background="{DynamicResource ThemeFocus}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="16,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ButtonSecondary}" Command="{Binding BackToHubCommand}" Margin="0,0,12,0" ToolTip="Volver al inicio de la aplicación">
                        <StackPanel Orientation="Horizontal">
                            <helpers:Icon Data="{StaticResource IcoChevronLeft}" Margin="0,0,6,0" />
                            <TextBlock Text="Inicio" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Style="{StaticResource TextHeading}" Text="Configuración" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,4,12">
                    <TextBox x:Name="SettingsSearchBox" Style="{StaticResource FieldTextBox}" Padding="36,7,10,7"
                             Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:Field.Placeholder="Buscar un ajuste (ej. modo oscuro)"
                             AutomationProperties.Name="Buscar un ajuste">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenFirstSettingCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <helpers:Icon Data="{StaticResource IcoSearch}" HorizontalAlignment="Left" Margin="12,0,0,0"
                                  Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <Grid>
                        <!-- Menú agrupado -->
                        <ItemsControl ItemsSource="{Binding SectionGroups}" Visibility="{Binding IsSearchingSettings, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigSectionGroup}">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource TextLabel}" Foreground="{DynamicResource ThemeTextSecondary}" Text="{Binding Name}" Margin="10,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ConfigSectionItem}">
                                                    <Button Style="{StaticResource NavItem}"
                                                            Command="{Binding DataContext.NavigateSubViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Key}"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <helpers:Icon Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}" Width="18" Height="18"
                                                                          Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource ThemeTextSecondary}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Summary, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Resultados del buscador -->
                        <StackPanel Visibility="{Binding IsSearchingSettings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding SettingsSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettingEntry}">
                                        <Button Style="{StaticResource ButtonGhost}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,2"
                                                Foreground="{DynamicResource ThemeText}"
                                                Command="{Binding DataContext.OpenSettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Description}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextDetail}" Margin="10,8" TextWrapping="Wrap" Text="Ningún ajuste coincide. Pruebe con otra palabra."
                                       Visibility="{Binding HasNoSettingsResults, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Style="{StaticResource TextCaption}" Margin="10,10,0,0" Text="{Binding AppVersion, StringFormat='TPVC {0}'}" />
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentSubView}" Focusable="False" />
    </Grid>
</UserControl>
