<UserControl x:Class="TPVC.Views.PosSalesHistorySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TPVC.ViewModels"
             xmlns:models="clr-namespace:TPVC.Models"
             xmlns:helpers="clr-namespace:TPVC.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}">

    <!-- Tickets: los últimos 50 o uno por folio; a la derecha su detalle para reimprimir o -->
    <!-- cancelarlo (la mercancía vuelve al inventario).                                  -->
    <Border Style="{StaticResource SheetScrim}">
        <Border Style="{StaticResource SheetCard}" Width="1020" Height="680" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="24,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="Tickets" />
                        <TextBlock Style="{StaticResource TextCaption}" Text="Los últimos 50 · busque uno por folio para reimprimirlo o cancelarlo" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonIcon}" Command="{Binding CloseTicketHistoryModalCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" VerticalAlignment="Top">
                        <helpers:Icon Data="{StaticResource IcoClose}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="24,12,24,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="FolioSearchBox" Style="{StaticResource FieldTextBox}" Height="44" Padding="40,7,12,7" FontFamily="{StaticResource FontFamilyMono}"
                                     Text="{Binding TicketSearchFolio, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Field.Placeholder="Folio (TKT-20261007-0001) · vacío muestra los últimos"
                                     AutomationProperties.Name="Folio del ticket">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchTicketByFolioCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <helpers:Icon Data="{StaticResource IcoSearch}" Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0"
                                          Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Height="44" Margin="10,0,0,0" Command="{Binding SearchTicketByFolioCommand}" Content="Buscar" />
                    </Grid>
                    <Border Style="{StaticResource NoticeWarning}" Margin="0,10,0,0" Padding="12,6"
                            Visibility="{Binding TicketHistoryStatusMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TicketHistoryStatusMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Style="{StaticResource PlainList}" Padding="16,0,8,16"
                             ItemsSource="{Binding RecentSales}"
                             SelectedItem="{Binding SelectedSaleForDetail, Mode=TwoWay}"
                             AutomationProperties.Name="Tickets">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Sale}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextMono}" FontWeight="SemiBold" Text="{Binding Folio}" />
                                            <Border Style="{StaticResource BadgeDanger}" Margin="8,0,0,0" Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Cancelado" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:dd/MM HH:mm} · {1} · {2}">
                                                    <Binding Path="Date" />
                                                    <Binding Path="PatientName" />
                                                    <Binding Path="PaymentMethod" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Total, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource TextDetail}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Todavía no hay ventas."
                               Visibility="{Binding RecentSales.Count, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Detalle del ticket elegido -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,1,0,0"
                            CornerRadius="0,0,16,0" Padding="22,18"
                            Visibility="{Binding SelectedSaleForDetail, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid DataContext="{Binding SelectedSaleForDetail}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextHeading}" FontFamily="{StaticResource FontFamilyMono}" Text="{Binding Folio}" />
                                    <TextBlock Style="{StaticResource TextDetail}" Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:dddd d MMM yyyy, HH:mm} · {1} · atendió {2}" ConverterCulture="es-MX">
                                                <Binding Path="Date" />
                                                <Binding Path="PaymentMethod" />
                                                <Binding Path="Cashier" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding PatientName, StringFormat='Cliente: {0}'}" Margin="0,4,0,12" />
                                    <Border Style="{StaticResource NoticeDanger}" Margin="0,0,0,12" Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding CancelledAt, StringFormat='Cancelado el {0:dd/MM/yyyy HH:mm}'}" />
                                            <TextBlock Text="{Binding CancellationReason}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SaleItem}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding ProductName}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} × {1:C2}" ConverterCulture="es-MX">
                                                                    <Binding Path="Quantity" />
                                                                    <Binding Path="UnitPrice" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" Text="{Binding Subtotal, StringFormat={}{0:C2}, ConverterCulture=es-MX}" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextSection}" Text="Total" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextMono}" FontSize="22" FontWeight="Bold" Text="{Binding Total, StringFormat={}{0:C2}, ConverterCulture=es-MX}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ButtonDangerGhost}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.RequestCancelSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanCancelSelectedSale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                Content="Cancelar y devolver al inventario" />
                                        <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}"
                                                Command="{Binding DataContext.ReprintSelectedTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:Icon Data="{StaticResource IcoPrint}" Margin="0,0,8,0" />
                                                <TextBlock Text="Ver / reimprimir" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Confirmar la cancelación sin salir del historial -->
                            <Border Style="{StaticResource Card}" VerticalAlignment="Bottom" Padding="16"
                                    Visibility="{Binding IsCancelConfirmModalOpen, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.2" Color="#0F172A" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextSection}" Text="{Binding SelectedSaleForDetail.Folio, StringFormat='¿Cancelar el ticket {0}?'}" />
                                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                               Text="Los productos regresan al inventario y el ticket queda marcado como cancelado (no se borra)." />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Motivo" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Style="{StaticResource ButtonGhost}" Command="{Binding CloseCancelConfirmModalCommand}" Content="Volver" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource ButtonDanger}" Command="{Binding ConfirmCancelSaleCommand}" Content="Cancelar ticket" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
