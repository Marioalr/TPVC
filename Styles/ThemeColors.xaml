<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Valores por defecto (Modo Claro + Acento Azul Médico) -->
    <SolidColorBrush x:Key="ThemeBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceSubtle" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ThemeText" Color="#0F172A" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#64748B" />
    <SolidColorBrush x:Key="ThemeBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#0284C7" />
    <SolidColorBrush x:Key="ThemeAccentHover" Color="#0369A1" />
    <SolidColorBrush x:Key="ThemeAccentPressed" Color="#075985" />
    <SolidColorBrush x:Key="ThemeAccentText" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ThemeSuccess" Color="#10B981" />
    <SolidColorBrush x:Key="ThemeWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="ThemeDanger" Color="#EF4444" />

</ResourceDictionary>
