<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:TPVC.Converters"
                    xmlns:helpers="clr-namespace:TPVC.Helpers">

    <!-- Vistas reutilizables por ViewModel (navegación sin reconstruir pantallas) -->
    <helpers:CachedViewConverter x:Key="CachedView" />

    <!-- Converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:ComparisonToBoolConverter x:Key="ComparisonToBool" />
    <conv:ComparisonToVisibilityConverter x:Key="ComparisonToVis" />
    <conv:ComparisonToVisibilityConverter x:Key="InverseComparisonToVis" Invert="True" />
    <!-- "Cambiar indicación": el renglón que se corrige muestra el campo en lugar del texto -->
    <conv:SameItemToVisibilityConverter x:Key="SameItemToVis" />
    <conv:SameItemToVisibilityConverter x:Key="InverseSameItemToVis" Invert="True" />
    <helpers:ResourceLookupConverter x:Key="ResourceLookup" />
    <!-- Receta: imágenes del membrete (ruta → imagen) y signos vitales con unidades, como al imprimir -->
    <helpers:ImageFileConverter x:Key="ImageFile" />
    <helpers:PrescriptionVitalConverter x:Key="PrescriptionVital" />

