    <!-- Foco de teclado: solo aparece al navegar con Tab (no al hacer clic) -->
    <Style x:Key="DsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource ThemeFocus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ TEXTO ============================ -->
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextSection" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextDetail" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDetail}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo de grupo: "LO ESENCIAL", "HOY" (escribir el texto en mayúsculas) -->
    <Style x:Key="TextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
    </Style>
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
    </Style>

    <!-- ============================ BOTONES ============================ -->
    <ControlTemplate x:Key="DsButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Botones de relleno sólido: deshabilitados no se desvanecen (el texto blanco quedaba en 2:1),
         pasan a gris suave con texto secundario, que se lee en cualquier tema -->
    <ControlTemplate x:Key="DsSolidButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Border>
            <!-- Contorno de deshabilitado encima: no cambia el tamaño del botón -->
            <Border x:Name="DisabledOutline" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}" CornerRadius="8"
                    SnapsToDevicePixels="True" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="DisabledOutline" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template" Value="{StaticResource DsButtonTemplate}" />
    </Style>

    <!-- Una sola acción principal por pantalla -->
    <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource DsSolidButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForeground}" />
        <Setter Property="Padding" Value="10,7" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource DsSolidButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Acción destructiva discreta (Descartar, Quitar) -->
    <Style x:Key="ButtonDangerGhost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" />
        <!-- Borde fijo de 1 (transparente): al pulsar solo cambia de color y el botón no crece -->
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Solo icono: siempre con ToolTip y AutomationProperties.Name -->
    <Style x:Key="ButtonIcon" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ButtonIconSecondary" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
    </Style>

    <!-- Icono sobre el aviso flotante: el aviso va invertido, así que hover y pulsado salen de su propio texto -->
    <Style x:Key="ButtonIconToast" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeToastText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeToastHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeToastPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Encabezado de sección plegable (consulta, expediente): botón plano a todo lo ancho.
         El foco de teclado es el anillo del sistema de diseño; al hacer clic no se queda "encendido". -->
    <Style x:Key="SectionHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ CAMPOS ============================ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDetail}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldError" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />
                        <TextBlock x:Name="Placeholder"
                                   Text="{Binding Path=(helpers:Field.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <!-- El TextBox ya aplica su Padding al texto: aquí no se repite -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                        <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource ThemeFocus}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldMultiline" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Gemelo de FieldTextBox para tokens y contraseñas: el botón de mostrar/ocultar los
         intercambia, así que el tamaño y el anillo de foco tienen que ser iguales -->
    <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                        <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource ThemeFocus}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                        </Trigger>
                        <!-- El valor elegido se marca con fondo y negrita; el que tomará Enter, con el borde de foco -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="FieldComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <helpers:Icon Data="{StaticResource IcoChevronDown}" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource ThemeTextSecondary}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Lista desplegable con el tema (la de WPF se ve clara en modo oscuro). No editable. -->
    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7,32,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton x:Name="Toggle"
                                      Template="{StaticResource FieldComboBoxToggleTemplate}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                        <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource ThemeFocus}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="DropDown"
                                    Background="{DynamicResource ThemeCard}"
                                    BorderBrush="{DynamicResource ThemeBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cualquier lista desplegable sin estilo toma la del tema (la de Windows es clara en modo oscuro) -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource FieldComboBox}" />

    <Style x:Key="FieldCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{DynamicResource ThemeControlBorder}" Background="{DynamicResource ThemeSurface}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <helpers:Icon x:Name="Mark" Data="{StaticResource IcoCheck}" Width="12" Height="12" StrokeThickness="3.5"
                                          Foreground="{DynamicResource ThemeAccentText}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource FieldCheckBox}" />

    <Style x:Key="FieldRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                BorderBrush="{DynamicResource ThemeControlBorder}" Background="{DynamicResource ThemeSurface}" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ThemeAccentText}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource FieldRadio}" />

    <!-- ============================ CHIPS ============================ -->
    <!-- Selección única entre pocas opciones (filtros, forma de pago): ListBox con SelectedItem -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDetail}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="999" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource ThemeBorderStrong}" Background="{DynamicResource ThemeSurface}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                        </Trigger>
                        <!-- En modo oscuro el relleno de acento casi no se separa de la tarjeta: el borde de foco
                             (3:1) marca la elección. Sin negrita: cambiaría el ancho y movería los demás chips -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encendido/apagado independiente (p. ej. "Gráfica de signos") -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDetail}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="999" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ CONTENEDORES ============================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardSubtle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource ThemeInfoSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeInfoText}" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- Distintivos: el texto hijo hereda color y tamaño -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource ThemeInfoSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeInfoText}" />
    </Style>
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource ThemeSuccessSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSuccessText}" />
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource ThemeWarningSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeWarningText}" />
    </Style>
    <Style x:Key="BadgeDanger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
    </Style>
    <Style x:Key="BadgeDangerSolid" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource ThemeDanger}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeAccentText}" />
    </Style>

    <!-- Estado de un lote (DataContext = ProductBatch): verde vigente, ámbar por vencer, rojo vencido -->
    <Style x:Key="BatchStatusBadge" TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="ProximoAVencer">
                <Setter Property="Background" Value="{DynamicResource ThemeWarningSubtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeWarningText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Vencido">
                <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Existencias de un producto (DataContext = Product): verde, ámbar si quedan pocas, rojo si no hay -->
    <Style x:Key="StockBadge" TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeWarningSubtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeWarningText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Avisos dentro de la pantalla (no interrumpen) -->
    <!-- Punto de estado de la sincronización (Tag = TursoSyncStatus): el mismo en la barra de estado
         y en Configuración. El texto de al lado dice el estado; el color solo lo refuerza. -->
    <Style x:Key="SyncStatusDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource ThemeTextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Idle}">
                <Setter Property="Fill" Value="{DynamicResource ThemeStatusSuccess}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Success}">
                <Setter Property="Fill" Value="{DynamicResource ThemeStatusSuccess}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Syncing}">
                <Setter Property="Fill" Value="{DynamicResource ThemeAccentForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Offline}">
                <Setter Property="Fill" Value="{DynamicResource ThemeStatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Paused}">
                <Setter Property="Fill" Value="{DynamicResource ThemeStatusWarning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:TursoSyncStatus.Error}">
                <Setter Property="Fill" Value="{DynamicResource ThemeStatusDanger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Notice" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{DynamicResource ThemeInfoSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeInfoText}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeDetail}" />
    </Style>
    <Style x:Key="NoticeSuccess" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource ThemeSuccessSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSuccessText}" />
    </Style>
    <Style x:Key="NoticeWarning" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource ThemeWarningSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeWarningText}" />
    </Style>
    <Style x:Key="NoticeDanger" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource ThemeDangerSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDangerText}" />
    </Style>

    <!-- Hojas: fondo difuso + ventana centrada, o panel lateral sin oscurecer -->
    <Style x:Key="SheetScrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlay}" />
    </Style>
    <Style x:Key="SheetCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#0F172A" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SidePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.14" Color="#0F172A" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aviso breve (toast) -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeToastBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeToastText}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#0F172A" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ LISTAS ============================ -->
    <Style x:Key="ListRowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <!-- La fila elegida lleva una barra, no solo un tinte: el tinte casi no se distingue del hover -->
                        <Border x:Name="Mark" Width="3" CornerRadius="2" Margin="3,9" HorizontalAlignment="Left"
                                Background="{DynamicResource ThemeFocus}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista ligera: solo crea las filas visibles -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListRowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <!-- ============================ MENÚS ============================ -->
    <Style x:Key="DsMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}" MinWidth="200" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelectionBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsContextMenu" TargetType="ContextMenu">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DsMenuItem}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barras de desplazamiento delgadas con colores del tema (las de Windows salían claras en
         modo oscuro). Implícito: aplica a toda la aplicación. -->
    <Style x:Key="DsScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ThemeControlBorder}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DsScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DsScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DsScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DsScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DsScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DsScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DsScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Barras de progreso con el tema (las de Windows: pista gris clara y relleno verde fijo) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForeground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
