<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:TPVC.Helpers"
                    xmlns:models="clr-namespace:TPVC.Models">

    <!-- ===================================================================================== -->
    <!-- LENGUAJE VISUAL COMÚN (fase 1 del rediseño)                                           -->
    <!-- Colores: solo claves del tema con DynamicResource (Styles/ThemeColors.xaml).          -->
    <!-- Letra: 6 tamaños. Espaciado: múltiplos de 4. Radios: 8 controles, 12 tarjetas.       -->
    <!-- Iconos: geometrías Ico* (cuadrícula 24×24) dibujadas con helpers:Icon.               -->
    <!-- Este diccionario solo usa StaticResource para claves definidas antes en él mismo.    -->
    <!-- ===================================================================================== -->

    <!-- Tipografía -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeDetail">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSection">16</sys:Double>
    <sys:Double x:Key="FontSizeHeading">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <FontFamily x:Key="FontFamilyUi">Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Radios -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusSheet">16</CornerRadius>

