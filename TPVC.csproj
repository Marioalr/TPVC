<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.20.5</Version>
    <AssemblyVersion>1.20.5.0</AssemblyVersion>
    <FileVersion>1.20.5.0</FileVersion>
    <Authors>Marioalr</Authors>
    <Company>TPVC</Company>
    <Product>TPVC - Sistema de Inventario para Consultorio Médico</Product>
    <Description>Sistema de control de inventario clínico y farmacológico para consultorio de medicina general con base de datos local SQLite y personalización de temas.</Description>
    <Copyright>Copyright © 2026 Marioalr</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Al publicar (instalador y zip) el código va ya compilado para Windows x64: el programa
         abre más rápido porque no tiene que compilarlo cada vez que arranca -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Las pruebas usan el mapeo interno de la sincronización (SyncSchema) para generar el contrato -->
  <ItemGroup>
    <InternalsVisibleTo Include="TPVC.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- Iconos fijos del pie de la receta (WhatsApp y ubicación), los mismos de la hoja RECETA del médico.
       Recurso incrustado: los leen la impresión, la vista previa y el HTML/PDF (también en las pruebas) -->
  <ItemGroup>
    <None Remove="Resources\Receta\*.png" />
    <EmbeddedResource Include="Resources\Receta\*.png" LogicalName="TPVC.Receta.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
    <Page Remove="installer\**" />
    <ApplicationDefinition Remove="installer\**" />
  </ItemGroup>

</Project>
